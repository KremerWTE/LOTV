@using Microsoft.AspNetCore.Components.Web
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LOTV Ministry — Staff Portal</title>
    <base href="/" />
    <link rel="stylesheet" href="css/lotv-admin.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="Lotv.Web.styles.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@_renderMode" />
</head>

<body>
    <!--
      #app wrapper: functionally a no-op (Routes would render fine without
      it), kept as a real content-readiness signal for the E2E suite. With
      prerendering off, the initial HTTP response ships this div empty - it
      only gets populated once the interactive circuit connects and Routes
      actually renders - so "#app:not(:empty)" means the same thing it did
      under WASM. Found the hard way: E2ETestBase's WaitForBlazorAsync used
      to wait for a WASM-only loading spinner to disappear, which (with no
      spinner markup left, and prerendering off) resolved instantly instead
      of waiting for anything - tests then raced real content and failed
      intermittently (e.g. checking for an <h1> before Routes had rendered
      one). This div gives that wait something real to key off again.
    -->
    <div id="app">
        <Routes @rendermode="@_renderMode" />
    </div>

    <div id="blazor-error-ui">
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
    <script>
      window.downloadCsv = function (filename, content) {
        var bom = '\uFEFF';
        var blob = new Blob([bom + content], { type: 'text/csv;charset=utf-8;' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url; a.download = filename;
        document.body.appendChild(a); a.click();
        document.body.removeChild(a); URL.revokeObjectURL(url);
      };
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="js/lotv-map.js"></script>
    <script src="js/lotv-app.js"></script>
    <script>window.lotvTheme && window.lotvTheme.init();</script>
    <link rel="manifest" href="/manifest.webmanifest" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    // Prerendering is off: this app's whole auth model restores the JWT
    // session via JS interop (reads the refresh token from sessionStorage),
    // and JS interop is unavailable during the static prerender pass -
    // that pass would always see an anonymous user and 302 to /login before
    // the real interactive circuit (with working JS interop) ever gets a
    // chance to restore the session. Confirmed live: a bare curl with no
    // session got a real 302 to /login for a protected route, and even a
    // logged-in browser hard-reloading one flashed through /login first.
    private static readonly InteractiveServerRenderMode _renderMode = new(prerender: false);
}
