@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (_open)
{
  <div @onclick="() => _open = false"
       style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:300;display:flex;align-items:flex-start;justify-content:center;padding-top:80px;">
    <div @onclick:stopPropagation="true"
         style="width:90%;max-width:520px;background:white;border-radius:12px;box-shadow:0 12px 40px rgba(0,0,0,.25);overflow:hidden;">
      <div style="padding:14px 18px;border-bottom:1px solid var(--border);">
        <input @ref="_input" class="form-input" placeholder="Jump to…  (Esc to close)"
               @bind="_query" @bind:event="oninput" @onkeydown="HandleKey"
               style="border:none;outline:none;font-size:1rem;width:100%;padding:0;" />
      </div>
      <ul role="listbox" style="list-style:none;margin:0;padding:6px 0;max-height:60vh;overflow-y:auto;">
        @{ var matches = Filtered.ToList(); var showRecents = string.IsNullOrWhiteSpace(_query) && _recent.Count > 0; }
        @if (matches.Count == 0)
        {
          <li style="padding:14px;color:var(--text-light);text-align:center;font-size:.86rem;">No matches.</li>
        }
        @if (showRecents)
        {
          <li style="padding:6px 18px;font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);">Recents</li>
        }
        @for (var i = 0; i < matches.Count; i++)
        {
          if (showRecents && i == _recent.Count)
          {
            <li style="padding:6px 18px 6px;margin-top:4px;border-top:1px solid var(--border);font-size:.66rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);">All pages</li>
          }
          var idx = i;
          var m = matches[idx];
          <li role="option" aria-selected="@(idx == _highlight)"
              style="padding:10px 18px;cursor:pointer;background:@(idx == _highlight ? "var(--bg)" : "transparent");display:flex;align-items:center;gap:12px;"
              @onclick="() => Run(m)" @onmouseover="() => _highlight = idx">
            <div style="font-size:1.1rem;width:24px;text-align:center;">@(string.IsNullOrEmpty(m.Icon) ? IconFor(m.Path) : m.Icon)</div>
            <div style="flex:1;">
              <div style="font-weight:600;font-size:.88rem;color:var(--navy);">@m.Title</div>
              <div style="font-size:.74rem;color:var(--text-light);font-family:monospace;">@m.Path</div>
            </div>
          </li>
        }
      </ul>
    </div>
  </div>
}

@code {
  private record Cmd(string Title, string Path, string? Action = null, string Icon = "");
  private static readonly Cmd[] Actions =
  {
    new("Toggle dark mode",     "action:theme",    "theme",   "🌗"),
    new("Toggle sidebar",       "action:sidebar",  "sidebar", "↔"),
    new("Sign out",              "action:logout",   "logout",  "🚪"),
    new("Copy current URL",     "action:copyurl",  "copyurl", "🔗"),
  };

  private static string IconFor(string path) => path switch
  {
    "/admin/dashboard" or "/admin/hq" or "/admin/hq-board" => "📊",
    "/admin/cases" or "/admin/kanban" or "/admin/queue" or "/admin/my-queue" or "/admin/workload" => "💼",
    "/admin/families" => "👪",
    "/admin/donations" or "/admin/by-donor" or "/admin/by-diocese" or "/admin/by-channel" or "/admin/by-city" or "/admin/by-amount" => "💰",
    "/admin/allocations" => "📁",
    "/admin/impact" or "/admin/impact-report" => "📈",
    "/admin/export" => "⬇",
    "/admin/volunteers" or "/admin/volunteer-schedule" => "🤝",
    "/admin/recurring" or "/admin/pledges" or "/admin/sponsorships" => "🔁",
    "/admin/events" or "/admin/retreats" => "🎉",
    "/admin/wishlist" or "/admin/inventory" => "📦",
    "/admin/audit" or "/admin/webhooks" or "/admin/migrations" or "/admin/push-subscriptions" => "🔧",
    "/admin/chapters" or "/admin/chapter-analytics" => "🏛",
    "/admin/volunteer-certifications" or "/admin/volunteer-skills" => "📋",
    "/admin/grants" => "💵",
    "/admin/notification-prefs" => "🔔",
    "/admin/campaigns" => "🎯",
    "/admin/pledge-renewals" => "📅",
    "/admin/staff-tasks" => "✅",
    "/admin/announcements" => "📣",
    "/admin/sms-log" => "📱",
    "/admin/financial" => "💹",
    "/admin/expenses" => "🧾",
    "/admin/budget" => "💰",
    "/admin/api-keys" => "🔑",
    "/admin/year-end" => "📊",
    "/admin/cases/new" => "➕",
    "/admin/volunteers/pending" => "⏳",
    "/admin/cases/overdue" => "🚨",
    "/admin/donors/retention" => "🔄",
    "/admin/reports/history" => "📜",
    "/admin/resources/flow" => "📈",
    "/admin/settings" or "/admin/users" or "/admin/diocese-data" or "/admin/health" => "⚙",
    "/admin/reconciliation" or "/admin/reports/schedule" => "📋",
    "/admin/notifications" or "/admin/marketing" => "✉",
    _ => "📄",
  };
  private static readonly Cmd[] All =
  {
    new("Dashboard", "/admin/dashboard"),
    new("HQ Dashboard", "/admin/hq"),
    new("HQ Operations Board", "/admin/hq-board"),
    new("Cases", "/admin/cases"),
    new("Kanban Board", "/admin/kanban"),
    new("Unassigned Queue", "/admin/queue"),
    new("My Queue", "/admin/my-queue"),
    new("Workload", "/admin/workload"),
    new("Families", "/admin/families"),
    new("All Donations", "/admin/donations"),
    new("By Donor", "/admin/by-donor"),
    new("By Diocese", "/admin/by-diocese"),
    new("By Channel", "/admin/by-channel"),
    new("By City", "/admin/by-city"),
    new("By Amount", "/admin/by-amount"),
    new("Allocations", "/admin/allocations"),
    new("Impact Dashboard", "/admin/impact"),
    new("Impact Report", "/admin/impact-report"),
    new("Export", "/admin/export"),
    new("Volunteers", "/admin/volunteers"),
    new("Volunteer Schedule", "/admin/volunteer-schedule"),
    new("Recurring", "/admin/recurring"),
    new("Pledges", "/admin/pledges"),
    new("Sponsorships", "/admin/sponsorships"),
    new("Events", "/admin/events"),
    new("Retreats", "/admin/retreats"),
    new("Wish List", "/admin/wishlist"),
    new("Inventory", "/admin/inventory"),
    new("Audit Log", "/admin/audit"),
    new("Webhook Events", "/admin/webhooks"),
    new("DB Migrations", "/admin/migrations"),
    new("Push Subscriptions", "/admin/push-subscriptions"),
    new("Settings", "/admin/settings"),
    new("Users", "/admin/users"),
    new("Diocese Data", "/admin/diocese-data"),
    new("Health", "/admin/health"),
    new("Reconciliation", "/admin/reconciliation"),
    new("Scheduled Reports", "/admin/reports/schedule"),
    new("Send Notification", "/admin/notifications"),
    new("Marketing Email", "/admin/marketing"),
    new("Chapter Management", "/admin/chapters"),
    new("Chapter Analytics", "/admin/chapter-analytics"),
    new("Volunteer Certifications", "/admin/volunteer-certifications"),
    new("Grants", "/admin/grants"),
    new("Notification Preferences", "/admin/notification-prefs"),
    new("Campaigns", "/admin/campaigns"),
    new("Pledge Renewals", "/admin/pledge-renewals"),
    new("Staff Tasks", "/admin/staff-tasks"),
    new("Announcements", "/admin/announcements"),
    new("Volunteer Skill Directory", "/admin/volunteer-skills"),
    new("Pledges", "/admin/pledges"),
    new("Recurring Donations", "/admin/recurring"),
    new("Resource Inventory", "/admin/inventory"),
    new("SMS Log", "/admin/sms-log"),
    new("Financial Overview", "/admin/financial"),
    new("Chapter Expenses", "/admin/expenses"),
    new("Budget Summary", "/admin/budget"),
    new("API Keys", "/admin/api-keys"),
    new("Year-End Giving", "/admin/year-end"),
    new("New Case Intake", "/admin/cases/new"),
    new("Volunteer Pending Onboarding", "/admin/volunteers/pending"),
    new("Overdue Cases", "/admin/cases/overdue"),
    new("Donor Retention LYBUNT SYBUNT", "/admin/donors/retention"),
    new("Report Run History", "/admin/reports/history"),
    new("Resource Flow Dashboard", "/admin/resources/flow"),
  };

  private bool _open;
  private string _query = "";
  private int _highlight;
  private ElementReference _input;
  private DotNetObjectReference<CommandPalette>? _ref;

  private List<string> _recent = new();

  private IEnumerable<Cmd> Filtered
  {
    get
    {
      var combined = All.Concat(Actions);
      if (string.IsNullOrWhiteSpace(_query))
      {
        var recent = _recent.Select(p => combined.FirstOrDefault(c => c.Path == p)).Where(c => c is not null).Cast<Cmd>().ToList();
        var rest   = combined.Where(c => !_recent.Contains(c.Path));
        return recent.Concat(rest);
      }
      return combined.Where(c => c.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
                                  c.Path.Contains(_query, StringComparison.OrdinalIgnoreCase));
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _ref = DotNetObjectReference.Create(this);
      try { await JS.InvokeVoidAsync("lotvCmdK.attach", _ref); } catch { }
      try
      {
        var json = await JS.InvokeAsync<string?>("localStorage.getItem", "lotv.cmdkRecent");
        if (!string.IsNullOrEmpty(json))
          _recent = System.Text.Json.JsonSerializer.Deserialize<List<string>>(json) ?? new();
      }
      catch { }
    }
    if (_open)
      try { await _input.FocusAsync(); } catch { }
  }

  [JSInvokable]
  public void Open() { _open = true; _query = ""; _highlight = 0; InvokeAsync(StateHasChanged); }

  private async Task HandleKey(KeyboardEventArgs e)
  {
    var n = Filtered.Count();
    switch (e.Key)
    {
      case "Escape":   _open = false; break;
      case "ArrowDown": if (n > 0) _highlight = (_highlight + 1) % n; break;
      case "ArrowUp":   if (n > 0) _highlight = (_highlight - 1 + n) % n; break;
      case "Enter":     var sel = Filtered.ElementAtOrDefault(_highlight); if (sel is not null) await Run(sel); break;
    }
  }

  private async Task Run(Cmd cmd)
  {
    _open = false;
    _recent.Remove(cmd.Path);
    _recent.Insert(0, cmd.Path);
    if (_recent.Count > 5) _recent = _recent.Take(5).ToList();
    try { await JS.InvokeVoidAsync("localStorage.setItem", "lotv.cmdkRecent", System.Text.Json.JsonSerializer.Serialize(_recent)); } catch { }

    if (cmd.Action is null) { Nav.NavigateTo(cmd.Path); return; }
    switch (cmd.Action)
    {
      case "theme":
        try
        {
          var current = await JS.InvokeAsync<string>("lotvTheme.get");
          await JS.InvokeVoidAsync("lotvTheme.set", current == "dark" ? "light" : "dark");
        }
        catch { }
        break;
      case "sidebar":
        try
        {
          var s = await JS.InvokeAsync<string?>("localStorage.getItem", "lotv.sidebar");
          await JS.InvokeVoidAsync("localStorage.setItem", "lotv.sidebar", s == "collapsed" ? "expanded" : "collapsed");
          Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        catch { }
        break;
      case "logout":
        Nav.NavigateTo("/login?logout=1", forceLoad: true);
        break;
      case "copyurl":
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", Nav.Uri); } catch { }
        break;
    }
  }

  public async ValueTask DisposeAsync()
  {
    try { await JS.InvokeVoidAsync("lotvCmdK.detach"); } catch { }
    _ref?.Dispose();
  }
}
