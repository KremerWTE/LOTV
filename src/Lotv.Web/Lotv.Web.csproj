<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Serilog.Sinks.MSSqlServer" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lotv.Core\Lotv.Core.csproj" />
  </ItemGroup>

  <!-- The public intake form has one source of truth: docs/duda-embed/prayer-care-intake.html
       (what gets pasted into Duda). It is copied to Forms/ - deliberately NOT wwwroot, so it is never
       served as a static .html file - and Program.cs serves it at /request-prayer-care-package.
       The copy is committed so publish picks it up even on a fresh checkout. -->
  <ItemGroup>
    <None Update="Forms\**\*.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="SyncIntakeFormPage" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\..\docs\duda-embed\prayer-care-intake.html"
          DestinationFiles="$(MSBuildThisFileDirectory)Forms\prayer-care-intake.html"
          SkipUnchangedFiles="true"
          Condition="Exists('$(MSBuildThisFileDirectory)..\..\docs\duda-embed\prayer-care-intake.html')" />
  </Target>

</Project>
