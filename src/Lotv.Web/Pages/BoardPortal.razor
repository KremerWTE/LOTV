@page "/board/portal"
@layout PublicLayout
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Board Portal — LOTV Ministry</PageTitle>

@if (!Auth.IsAuthenticated || Auth.UserRole != "Board")
{
  <div style="max-width:480px;margin:100px auto;padding:0 24px;text-align:center;">
    <p style="color:var(--text-mid);">This portal is for Board members only.</p>
    <a href="/login" style="color:var(--navy);font-weight:700;">Sign in →</a>
  </div>
}
else
{
  <div style="max-width:1000px;margin:0 auto;padding:40px 24px 80px;">
    <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
      <div>
        <h1 style="font-family:var(--ff-head);color:var(--navy);font-size:1.7rem;margin:0 0 6px;">Board Portal</h1>
        <p style="color:var(--text-mid);font-size:.9rem;margin:0;">High-level ministry performance — read-only governance summary</p>
      </div>
      <button class="btn btn-sm" @onclick="SignOut">Sign Out</button>
    </div>

    @if (_loading)
    {
      <p style="color:var(--text-light);">Loading…</p>
    }
    else
    {
      <!-- KPI TILES -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:32px;">
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Total Donations</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--navy);">@_summary?.TotalDonations.ToString("C0")</div>
        </div></div>
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Donations This Month</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--green);">@_summary?.DonationsThisMonth.ToString("C0")</div>
        </div></div>
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Families Served</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--navy);">@_summary?.FamiliesServed</div>
        </div></div>
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Open Cases</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--amber);">@_summary?.OpenCases</div>
        </div></div>
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Fulfilled Cases</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--green);">@_summary?.FulfilledCases</div>
        </div></div>
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Active Volunteers</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--navy);">@_summary?.ActiveVolunteers</div>
        </div></div>
        <div class="panel"><div class="panel-body">
          <div style="font-size:.72rem;text-transform:uppercase;letter-spacing:.06em;color:var(--text-light);margin-bottom:6px;">Dioceses Reached</div>
          <div style="font-size:1.5rem;font-weight:700;color:var(--navy);">@_summary?.Dioceses</div>
        </div></div>
      </div>

      <!-- MONEY FLOW + RESOURCES -->
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:20px;margin-bottom:24px;">
        <div class="panel">
          <div class="panel-header">Money Flow by Category</div>
          <div class="panel-body">
            @if (_moneyFlow.Count == 0)
            {
              <p style="color:var(--text-light);font-size:.86rem;">No allocated funds yet.</p>
            }
            else
            {
              @foreach (var m in _moneyFlow)
              {
                <div style="margin-bottom:12px;">
                  <div style="display:flex;justify-content:space-between;font-size:.86rem;margin-bottom:4px;">
                    <span>@m.Category</span>
                    <strong>@m.Amount.ToString("C0") (@m.Percentage%)</strong>
                  </div>
                  <div style="background:var(--bg);border-radius:6px;height:6px;overflow:hidden;">
                    <div style="background:var(--gold);height:100%;width:@(m.Percentage)%;"></div>
                  </div>
                </div>
              }
            }
          </div>
        </div>
        <div class="panel">
          <div class="panel-header">Resource Distribution</div>
          <div class="panel-body">
            @if (_resources.Count == 0)
            {
              <p style="color:var(--text-light);font-size:.86rem;">No resource inventory recorded yet.</p>
            }
            else
            {
              @foreach (var r in _resources)
              {
                <div style="margin-bottom:12px;">
                  <div style="display:flex;justify-content:space-between;font-size:.86rem;margin-bottom:4px;">
                    <span>@r.ResourceType</span>
                    <strong>@r.Quantity units (@r.Percentage%)</strong>
                  </div>
                  <div style="background:var(--bg);border-radius:6px;height:6px;overflow:hidden;">
                    <div style="background:var(--green);height:100%;width:@(r.Percentage)%;"></div>
                  </div>
                </div>
              }
            }
          </div>
        </div>
      </div>

      <!-- 12-MONTH TREND -->
      <div class="panel">
        <div class="panel-header">12-Month Trend</div>
        <div class="panel-body" style="overflow-x:auto;">
          <table class="data-table">
            <thead>
              <tr><th>Month</th><th>Donations</th><th>Cases Fulfilled</th></tr>
            </thead>
            <tbody>
              @foreach (var t in _timeline)
              {
                <tr>
                  <td>@t.Period</td>
                  <td>@t.Donations.ToString("C0")</td>
                  <td>@t.RequestsFulfilled</td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    }
  </div>
}

@code {
  private bool _loading = true;
  private BoardSummaryDto? _summary;
  private List<BoardMoneyFlowDto> _moneyFlow = new();
  private List<BoardResourceDto> _resources = new();
  private List<BoardTimelinePointDto> _timeline = new();

  protected override async Task OnInitializedAsync()
  {
    if (!Auth.IsAuthenticated || Auth.UserRole != "Board") return;

    _summary   = await Api.GetBoardSummaryAsync();
    _moneyFlow = await Api.GetBoardMoneyFlowAsync();
    _resources = await Api.GetBoardResourcesAsync();
    _timeline  = await Api.GetBoardTimelineAsync();
    _loading   = false;
  }

  private void SignOut()
  {
    Auth.Logout();
    Nav.NavigateTo("/login", forceLoad: true);
  }
}
