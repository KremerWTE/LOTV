@page "/login"
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Staff Login — LOTV Ministry</PageTitle>

<div style="min-height:100vh;background:linear-gradient(135deg,var(--navy) 0%,#1a3a6e 100%);display:flex;align-items:center;justify-content:center;padding:24px;">
  <div style="width:100%;max-width:400px;">

    <!-- LOGO -->
    <div style="text-align:center;margin-bottom:32px;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;border:3px solid rgba(255,255,255,.3);margin:0 auto 14px;">&#127803;</div>
      <div style="font-family:var(--ff-head);font-size:1.4rem;font-weight:700;color:white;">LOTV Ministry</div>
      <div style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:4px;letter-spacing:.06em;text-transform:uppercase;">Staff Portal</div>
    </div>

    <!-- CARD -->
    <div style="background:white;border-radius:16px;padding:36px 36px 32px;box-shadow:0 24px 48px rgba(0,0,0,.3);">
      <h2 style="font-family:var(--ff-head);font-size:1.2rem;color:var(--navy);margin:0 0 24px;text-align:center;">Sign in to your account</h2>

      <div class="form-group" style="margin-bottom:16px;">
        <label class="form-label">Email Address</label>
        <input class="form-input" type="email" @bind="_email" @onkeydown="OnKeyDown"
               placeholder="you@lotvministry.org" style="font-size:.9rem;" />
      </div>

      <div class="form-group" style="margin-bottom:20px;">
        <label class="form-label">Password</label>
        <input class="form-input" type="password" @bind="_password" @onkeydown="OnKeyDown"
               placeholder="••••••••" style="font-size:.9rem;" />
      </div>

      @if (!string.IsNullOrEmpty(_error))
      {
        <div style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#b91c1c;margin-bottom:16px;">
          &#9888; @_error
        </div>
      }

      <button class="btn btn-primary" style="width:100%;padding:13px;font-size:.95rem;font-weight:700;"
              @onclick="DoLogin" disabled="@_loading">
        @(_loading ? "Signing in…" : "Sign In")
      </button>

      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);font-size:.76rem;color:var(--text-light);text-align:center;line-height:1.6;">
        Demo credentials:<br />
        <strong style="color:var(--text-mid);">mary.roberts@lotvministry.org</strong> / <strong style="color:var(--text-mid);">lotv2026!</strong>
      </div>
    </div>

    <div style="text-align:center;margin-top:20px;">
      <a href="/" style="font-size:.78rem;color:rgba(255,255,255,.5);text-decoration:none;">
        &larr; Return to public site
      </a>
    </div>
  </div>
</div>

@code {
  private string _email    = "";
  private string _password = "";
  private string _error    = "";
  private bool   _loading;

  protected override void OnInitialized()
  {
    if (Auth.IsAuthenticated)
      Nav.NavigateTo("/admin/dashboard", replace: true);
  }

  private async Task DoLogin()
  {
    _error   = "";
    _loading = true;
    StateHasChanged();

    await Task.Delay(400); // simulate network

    if (Auth.Login(_email, _password))
      Nav.NavigateTo("/admin/dashboard", replace: true);
    else
    {
      _error   = "Invalid email or password.";
      _loading = false;
    }
  }

  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter") await DoLogin();
  }
}
