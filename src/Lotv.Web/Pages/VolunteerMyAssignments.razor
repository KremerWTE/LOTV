@page "/volunteer/my-assignments"
@inject ApiService Api

<PageTitle>My Assignments — LOTV Volunteer</PageTitle>

<!-- NAV -->
<div style="background:var(--navy);color:white;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;">
  <div style="font-family:var(--ff-head);font-size:1rem;font-weight:700;">LOTV Ministry — Volunteer Portal</div>
  <div style="display:flex;gap:16px;">
    <a href="/volunteer/dashboard" style="color:white;font-size:.84rem;text-decoration:none;opacity:.8;">Dashboard</a>
    <a href="/volunteer/available" style="color:white;font-size:.84rem;text-decoration:none;opacity:.8;">Available Requests</a>
    <a href="/volunteer/my-assignments" style="color:white;font-size:.84rem;text-decoration:none;font-weight:600;">My Assignments</a>
    <a href="/volunteer/history" style="color:white;font-size:.84rem;text-decoration:none;opacity:.8;">History</a>
  </div>
</div>

<div style="max-width:900px;margin:0 auto;padding:32px 24px;">

  <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 20px;">My Assignments</h2>

  @if (_loading)
  {
    <Loading Message="Loading your assignments…" />
  }
  else
  {
    <!-- FILTER CHIPS -->
    <div class="filter-bar" style="margin-bottom:16px;">
      @foreach (var f in new[]{"Active","Overdue","All","Fulfilled"})
      { <button class="filter-chip @(_filter == f ? "active" : "")" aria-pressed="@(_filter == f)" @onclick="() => _filter = f">@f</button> }
    </div>

    @if (!Filtered.Any())
    {
      <div class="panel" style="text-align:center;padding:40px;color:var(--text-light);">
        No assignments match this filter.
      </div>
    }
    else
    {
      @foreach (var req in Filtered)
      {
        <div class="panel" style="margin-bottom:14px;">
          <div style="padding:14px 18px 0;display:flex;justify-content:space-between;align-items:flex-start;gap:10px;">
            <div>
              <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                <span style="font-weight:700;color:var(--navy);">@req.Category Assistance — Family #@req.FamilyId</span>
                <span class="badge @GetBadge(req.Status)" style="font-size:.66rem;">@req.Status</span>
                @if (req.IsOverdue)
                { <span class="badge badge-overdue" style="font-size:.66rem;">OVERDUE</span> }
              </div>
              <div style="font-size:.76rem;color:var(--text-light);">
                Assigned @req.CreatedAt.ToString("MMM d, yyyy")
                @if (req.DueDate.HasValue)
                { <span> · Due @req.DueDate.Value.ToString("MMM d, yyyy")</span> }
              </div>
            </div>
            <a href="/volunteer/request/@req.Id" class="btn btn-sm">Manage</a>
          </div>

          <!-- QUICK STATUS UPDATE -->
          @if (req.Status is CaseStatus.InProgress or CaseStatus.AwaitingShipment)
          {
            <div style="padding:12px 18px 14px;display:flex;gap:8px;flex-wrap:wrap;">
              @if (req.Status == CaseStatus.InProgress)
              {
                <button class="btn btn-sm btn-primary" @onclick="() => MarkAsync(req, CaseStatus.AwaitingShipment)">&#128230; Ready to Ship</button>
              }
              <button class="btn btn-sm" style="background:var(--green);color:white;" @onclick="() => MarkAsync(req, CaseStatus.Fulfilled)">&#9989; Mark Complete</button>
            </div>
          }
        </div>
      }
    }
  }
</div>

@code {
  private List<PackageRequest> _all = [];
  private bool _loading = true;
  private string _filter = "Active";

  private IEnumerable<PackageRequest> Filtered => _filter switch
  {
    "Active"    => _all.Where(r => r.Status is CaseStatus.InProgress or CaseStatus.AwaitingShipment or CaseStatus.Shipped).OrderBy(r => r.DueDate),
    "Overdue"   => _all.Where(r => r.IsOverdue).OrderBy(r => r.CreatedAt),
    "Fulfilled" => _all.Where(r => r.Status == CaseStatus.Fulfilled).OrderByDescending(r => r.UpdatedAt),
    _           => _all.OrderByDescending(r => r.UpdatedAt)
  };

  protected override async Task OnInitializedAsync()
  {
    _loading = true;
    _all = await Api.GetRequestsAsync();
    _loading = false;
  }

  private async Task MarkAsync(PackageRequest req, CaseStatus newStatus)
  {
    await Api.UpdateRequestStatusAsync(req.Id, newStatus);
    req.Status = newStatus;
  }

  private static string GetBadge(CaseStatus s) => s switch
  {
    CaseStatus.InProgress       => "badge-shipped",
    CaseStatus.AwaitingShipment => "badge-onhold",
    CaseStatus.Shipped          => "badge-onhold",
    CaseStatus.Fulfilled        => "badge-delivered",
    _                           => "badge-new"
  };
}
