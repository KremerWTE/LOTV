@page "/donor/portal"
@layout PublicLayout
@inject ApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Donor Portal — LOTV Ministry</PageTitle>

<div style="max-width:980px;margin:48px auto 80px;padding:0 24px;">

  @if (DonorId is null or 0)
  {
    <div class="panel">
      <div class="panel-body" style="text-align:center;padding:48px 24px;">
        <div style="font-size:2.4rem;margin-bottom:14px;">🔒</div>
        <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 12px;">Sign In Required</h2>
        <p style="color:var(--text-mid);margin:0 0 18px;">Use your magic-link email to access your donor portal.</p>
        <a href="/donor/login" class="btn btn-primary">Go to sign-in</a>
      </div>
    </div>
  }
  else
  {
    <div style="display:flex;align-items:center;gap:18px;margin-bottom:24px;">
      <div style="width:72px;height:72px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;overflow:hidden;border:2px solid var(--border);flex-shrink:0;">
        @if (!string.IsNullOrEmpty(_avatarUrl))
        {
          <img src="@_avatarUrl" alt="" style="width:100%;height:100%;object-fit:cover;" />
        }
        else
        {
          <span style="font-size:1.8rem;color:var(--text-light);">👤</span>
        }
      </div>
      <div style="flex:1;">
        <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;">
          <h1 style="font-family:var(--ff-head);color:var(--navy);margin:0;">Welcome back.</h1>
          @if (_sessionExpiresIn is not null)
          {
            <span title="Magic-link session expiry"
                  style="font-size:.74rem;background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:3px 10px;color:var(--text-light);">
              ⏱ @_sessionExpiresIn
            </span>
          }
        </div>
        <input type="file" @ref="_fileInput" accept="image/*" style="display:none;" @onchange="OnAvatarSelected" />
        <button class="btn btn-sm" type="button" @onclick="PickAvatar" style="margin-top:6px;">@(_avatarUrl is null ? "Add photo" : "Change photo")</button>
        @if (_avatarUrl is not null)
        {
          <button class="btn btn-sm" type="button" @onclick="RemoveAvatar" style="margin-top:6px;margin-left:6px;">Remove</button>
        }
      </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin-bottom:28px;">
      <div class="kpi"><div class="kpi-label">Total Given</div><div class="kpi-value"><Money Amount="@_total" /></div></div>
      <div class="kpi"><div class="kpi-label">Gifts</div><div class="kpi-value">@_count</div></div>
      <div class="kpi"><div class="kpi-label">Last Gift</div><div class="kpi-value" style="font-size:1.05rem;">@(_last?.ToString("MMM d, yyyy") ?? "—")</div></div>
    </div>

    @if (_recurring.Any(r => r.Status == "Active"))
    {
      <div class="panel" style="margin-bottom:20px;">
        <div class="panel-header">Active Monthly Gifts</div>
        <div class="panel-body" style="padding:0;">
          @foreach (var r in _recurring.Where(r => r.Status == "Active"))
          {
            <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 18px;border-top:1px solid var(--border);">
              <div>
                <strong style="color:var(--green-dark);"><Money Amount="@r.Amount" /></strong>
                <span style="color:var(--text-light);font-size:.82rem;margin-left:8px;">@r.Frequency · next @r.NextChargeDate.ToString("MMM d")</span>
              </div>
              <button class="btn btn-sm" type="button" @onclick="() => CancelRecurring(r.Id)">Cancel</button>
            </div>
          }
        </div>
      </div>
    }

    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;">
      <a href="/donor/impact?DonorId=@DonorId" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">📊</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">My Impact</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Full giving history, families helped, category breakdown.</p>
        </div>
      </a>
      <a href="/donor/recurring?DonorId=@DonorId" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">🔄</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Recurring Gifts</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Pause, resume, change amount, or cancel monthly gifts.</p>
        </div>
      </a>
      <a href="/donor/receipts?DonorId=@DonorId" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">📄</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Tax Receipts</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Download receipts and year-end giving statements.</p>
        </div>
      </a>
      <a href="@($"/my-profile?DonorId={DonorId}")" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">⚙</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Update Profile</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Edit your name, email, address, and contact preferences.</p>
        </div>
      </a>

      <a href="/give" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">💕</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Make Another Gift</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Continue supporting families in their hardest moments.</p>
        </div>
      </a>
      <a href="@($"{Api.BaseUrl}/api/public/v1/donations/year-end/{DonorId}/{DateTime.UtcNow.Year}?format=pdf")" target="_blank" rel="noopener" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">🤗</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Year-End Statement (@DateTime.UtcNow.Year)</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Download a PDF tax statement for this year's giving.</p>
        </div>
      </a>

      @if (_status?.HasStripeCustomer == true)
      {
        <button type="button" class="panel" style="text-align:left;border:1px solid var(--border);background:white;cursor:pointer;" @onclick="OpenBillingPortal">
          <div class="panel-body">
            <div style="font-size:1.4rem;margin-bottom:8px;">💳</div>
            <strong style="font-family:var(--ff-head);color:var(--navy);">Manage Card &amp; Billing</strong>
            <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Update your card or view Stripe invoices.</p>
          </div>
        </button>
      }
    </div>
  }
</div>

@code {
  [Parameter, SupplyParameterFromQuery] public int? DonorId { get; set; }

  private decimal _total;
  private int _count;
  private DateTime? _last;
  private string? _avatarUrl;
  private ElementReference _fileInput;
  private string? _sessionExpiresIn;
  private List<RecurringScheduleDto> _recurring = new();
  private ApiService.DonorPortalStatusDto? _status;

  private async Task CancelRecurring(int id)
  {
    if (await Api.CancelDonorRecurringAsync(id))
    {
      _recurring = await Api.GetDonorRecurringAsync(DonorId!.Value);
    }
  }

  private async Task PickAvatar() => await JS.InvokeVoidAsync("lotvUpload.click", _fileInput);

  private async Task OnAvatarSelected()
  {
    if (DonorId is null) return;
    try
    {
      var dataUrl = await JS.InvokeAsync<string?>("lotvUpload.readDataUrl", _fileInput);
      if (string.IsNullOrEmpty(dataUrl)) return;
      if (await Api.UpdateDonorAvatarAsync(DonorId.Value, dataUrl)) _avatarUrl = dataUrl;
    }
    catch { }
  }

  private async Task RemoveAvatar()
  {
    if (DonorId is null) return;
    if (await Api.UpdateDonorAvatarAsync(DonorId.Value, null)) _avatarUrl = null;
  }

  private async Task OpenBillingPortal()
  {
    if (DonorId is null) return;
    string? token = null;
    try { token = await JS.InvokeAsync<string?>("sessionStorage.getItem", "lotv.donorToken"); } catch { }
    if (string.IsNullOrEmpty(token)) { Nav.NavigateTo("/donor/login"); return; }
    var url = await Api.CreateBillingPortalUrlAsync(DonorId.Value, token);
    if (!string.IsNullOrEmpty(url)) Nav.NavigateTo(url, forceLoad: true);
  }

  protected override async Task OnInitializedAsync()
  {
    if (DonorId is null or 0) return;
    _recurring = await Api.GetDonorRecurringAsync(DonorId.Value);
    _status    = await Api.GetDonorPortalStatusAsync(DonorId.Value);
    var impact = await Api.GetPublicDonorImpactAsync(DonorId.Value);
    if (impact is not null)
    {
      _total = impact.TotalGiven;
      _count = impact.GiftCount;
      _last  = impact.DonationHistory.OrderByDescending(d => d.Date).FirstOrDefault()?.Date;
    }
    try
    {
      // Refresh session if we have a token (sliding-window).
      var token = await JS.InvokeAsync<string?>("sessionStorage.getItem", "lotv.donorToken");
      if (!string.IsNullOrEmpty(token))
      {
        var newExp = await Api.RefreshDonorSessionAsync(token);
        if (newExp is not null)
        {
          await JS.InvokeVoidAsync("sessionStorage.setItem", "lotv.donorTokenExpires", newExp.Value.ToString("O"));
        }
      }
      var iso = await JS.InvokeAsync<string?>("sessionStorage.getItem", "lotv.donorTokenExpires");
      if (DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var exp))
      {
        var remaining = exp - DateTime.UtcNow;
        _sessionExpiresIn = remaining.TotalDays >= 1
          ? $"{(int)remaining.TotalDays}d remaining"
          : remaining.TotalHours >= 1
            ? $"{(int)remaining.TotalHours}h remaining"
            : $"{Math.Max(0, (int)remaining.TotalMinutes)}m remaining";
      }
    }
    catch { }
  }
}
