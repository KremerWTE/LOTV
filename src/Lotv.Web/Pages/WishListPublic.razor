@page "/wish-list"
@layout PublicLayout
@inject ApiService Api

<PageTitle>Family Wish List — LOTV Ministry</PageTitle>

<div style="max-width:860px;margin:0 auto;padding:40px 24px;">

  <div style="text-align:center;margin-bottom:36px;">
    <h1 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 10px;">Family Wish List</h1>
    <p style="color:var(--text-mid);font-size:.95rem;max-width:520px;margin:0 auto;line-height:1.7;">
      These are specific items families have asked for. Your donation of one of these items brings
      real, tangible comfort during one of the hardest seasons of life.
    </p>
  </div>

  <!-- Category filters -->
  <div class="filter-bar" style="justify-content:center;margin-bottom:28px;">
    @foreach (var cat in Categories)
    {
      <button class="filter-chip @(_cat == cat ? "active" : "")" aria-pressed="@(_cat == cat)" @onclick="() => _cat = cat">@cat</button>
    }
  </div>

  <!-- Items grid -->
  @{
    var visible = _items.Where(i => _cat == "All" || i.Category == _cat).ToList();
  }

  @if (!visible.Any())
  {
    <div style="text-align:center;padding:48px;color:var(--text-light);font-size:.88rem;">
      No open requests in this category right now. Check back soon or browse another category.
    </div>
  }
  else
  {
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px;margin-bottom:40px;">
      @foreach (var item in visible)
      {
        int pct = item.QuantityRequested > 0 ? (int)(item.QuantityFulfilled * 100.0 / item.QuantityRequested) : 0;
        bool full = item.QuantityFulfilled >= item.QuantityRequested;
        <div style="border:1px solid var(--border);border-radius:14px;background:white;overflow:hidden;
                    box-shadow:0 2px 8px rgba(0,0,0,.05);@(full ? "opacity:.6;" : "")">
          <!-- Category color strip -->
          <div style="height:4px;background:@CatColor(item.Category);"></div>

          <div style="padding:20px;">
            <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;
                        color:@CatColor(item.Category);margin-bottom:8px;">
              @item.Category
            </div>
            <div style="font-weight:700;color:var(--navy);font-size:.95rem;margin-bottom:6px;line-height:1.4;">
              @item.Title
            </div>
            @if (!string.IsNullOrEmpty(item.Description))
            {
              <p style="color:var(--text-mid);font-size:.82rem;margin:0 0 14px;line-height:1.5;">@item.Description</p>
            }

            <!-- Progress -->
            <div style="margin-bottom:14px;">
              <div style="display:flex;justify-content:space-between;font-size:.74rem;color:var(--text-light);margin-bottom:4px;">
                @if (full)
                { <span style="color:#2d6a2d;font-weight:700;">✓ Fully fulfilled — thank you!</span> }
                else
                { <span>@item.QuantityFulfilled of @item.QuantityRequested fulfilled</span> }
                <span>@pct%</span>
              </div>
              <div class="progress-bar">
                <div class="progress-fill" style="width:@pct%;background:@(full ? "#2d6a2d" : CatColor(item.Category));"></div>
              </div>
            </div>

            @if (!full)
            {
              <button class="btn btn-primary" style="width:100%;font-size:.85rem;"
                      @onclick="() => { _donateItem = item; _donateQty = 1; }">
                I'll Donate This →
              </button>
            }
          </div>
        </div>
      }
    </div>
  }

  <!-- Impact prompt -->
  <div style="background:linear-gradient(135deg,#f0faf0,#e8f4e8);border-radius:16px;padding:32px;text-align:center;">
    <div style="font-size:1.8rem;margin-bottom:12px;">🌻</div>
    <h3 style="font-family:var(--ff-head);color:#2d6a2d;margin:0 0 10px;">Every item matters.</h3>
    <p style="color:var(--text-mid);font-size:.88rem;line-height:1.8;max-width:480px;margin:0 auto 20px;">
      Can't find the right item? A monetary donation lets our team purchase exactly what each family needs.
    </p>
    <a href="/give" class="btn btn-primary" style="font-size:.9rem;padding:12px 28px;background:#2d6a2d;border-color:#2d6a2d;">
      Make a Monetary Gift →
    </a>
  </div>

</div>

<!-- Donate modal -->
@if (_donateItem is not null)
{
  <div style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:2000;display:flex;align-items:center;justify-content:center;padding:24px;">
    <div style="background:white;border-radius:16px;max-width:460px;width:100%;padding:32px;">
      <h3 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 6px;">Fulfill This Request</h3>
      <p style="color:var(--text-mid);font-size:.84rem;margin:0 0 20px;line-height:1.5;">@_donateItem.Title</p>

      <div class="form-group">
        <label class="form-label">Quantity you'll donate</label>
        <input class="form-input" type="number" @bind="_donateQty" min="1"
               max="@_donateItem.QuantityRemaining" style="max-width:100px;" />
        <span style="font-size:.78rem;color:var(--text-light);margin-left:8px;">
          (up to @_donateItem.QuantityRemaining needed)
        </span>
      </div>

      <div class="form-group">
        <label class="form-label">Your name (optional — shown as donor credit)</label>
        <input class="form-input" @bind="_donorName" placeholder="Anonymous" />
      </div>

      <div style="background:#f0faf0;border-radius:8px;padding:12px 16px;font-size:.82rem;color:#2d6a2d;margin-bottom:20px;line-height:1.6;">
        <strong>Next step:</strong> Our chapter coordinator will reach out within 24 hours with drop-off or shipping instructions.
      </div>

      @if (_donateSent)
      {
        <div style="background:#f0faf0;border:1px solid #a8d8a8;border-radius:8px;padding:14px 18px;font-size:.85rem;color:#2d6a2d;text-align:center;margin-bottom:16px;">
          ✓ Thank you! We'll be in touch within 24 hours.
        </div>
      }

      <div style="display:flex;gap:10px;justify-content:flex-end;">
        <button class="btn" @onclick="() => { _donateItem = null; _donateSent = false; }">
          @(_donateSent ? "Close" : "Cancel")
        </button>
        @if (!_donateSent)
        {
          <button class="btn btn-primary" style="background:#2d6a2d;border-color:#2d6a2d;" @onclick="SubmitDonateAsync">
            Confirm Pledge
          </button>
        }
      </div>
    </div>
  </div>
}

@code {
  private string _cat = "All";
  private PublicWishListItemDto? _donateItem;
  private int    _donateQty  = 1;
  private string _donorName  = "";
  private bool   _donateSent;
  private List<PublicWishListItemDto> _items = [];

  private static readonly string[] Categories =
    { "All", "Knitted Blanket", "Memory Box", "Grief Book", "Baby Clothing", "Care Package", "Photo Album", "Journal / Keepsake", "Other" };

  protected override async Task OnInitializedAsync()
  {
    _items = await Api.GetPublicWishListAsync();
  }

  private async Task SubmitDonateAsync()
  {
    await Task.CompletedTask; // Pledge acknowledgement — coordinator follows up
    _donateSent = true;
  }

  private static string CatColor(string cat) => cat switch
  {
    "Knitted Blanket"    => "var(--green)",
    "Memory Box"         => "var(--navy)",
    "Grief Book"         => "#5a2d9a",
    "Baby Clothing"      => "#0891b2",
    "Care Package"       => "#c07000",
    "Photo Album"        => "#b91c1c",
    "Journal / Keepsake" => "#7c3aed",
    _                    => "#888"
  };
}
