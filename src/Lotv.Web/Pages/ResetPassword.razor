@page "/reset-password"
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Reset Password — LOTV Ministry</PageTitle>

<div style="min-height:100vh;background:linear-gradient(135deg,var(--navy) 0%,#1a3a6e 100%);display:flex;align-items:center;justify-content:center;padding:24px;">
  <div style="width:100%;max-width:400px;">

    <div style="text-align:center;margin-bottom:32px;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;border:3px solid rgba(255,255,255,.3);margin:0 auto 14px;">🌻</div>
      <div style="font-family:var(--ff-head);font-size:1.4rem;font-weight:700;color:white;">LOTV Ministry</div>
      <div style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:4px;letter-spacing:.06em;text-transform:uppercase;">Staff Portal</div>
    </div>

    <div style="background:white;border-radius:16px;padding:36px 36px 32px;box-shadow:0 24px 48px rgba(0,0,0,.3);">
      <h2 style="font-family:var(--ff-head);font-size:1.2rem;color:var(--navy);margin:0 0 24px;text-align:center;">Choose a new password</h2>

      @if (string.IsNullOrEmpty(_username) || string.IsNullOrEmpty(_token))
      {
        <div style="background:#fff3cd;border-radius:8px;padding:14px 16px;font-size:.86rem;color:#856404;text-align:center;">
          ⚠ This reset link is invalid or incomplete. Request a new one from the
          <a href="/forgot-password" style="color:#856404;font-weight:600;">forgot password</a> page.
        </div>
      }
      else if (_done)
      {
        <div style="background:var(--green-pale);border-radius:8px;padding:14px 16px;font-size:.86rem;color:var(--green-dark);text-align:center;margin-bottom:16px;">
          ✓ Password updated — you can now sign in.
        </div>
        <a href="/login" class="btn btn-primary" style="display:block;text-align:center;width:100%;padding:13px;font-size:.95rem;font-weight:700;">Go to Sign In</a>
      }
      else
      {
        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label" for="rp-password">New Password</label>
          <input id="rp-password" class="form-input" type="password" @bind="_newPassword"
                 placeholder="At least 12 characters" style="font-size:.9rem;"
                 autocomplete="new-password" aria-required="true" />
        </div>
        <div class="form-group" style="margin-bottom:20px;">
          <label class="form-label" for="rp-confirm">Confirm Password</label>
          <input id="rp-confirm" class="form-input" type="password" @bind="_confirmPassword" @onkeydown="OnKeyDown"
                 placeholder="Re-enter new password" style="font-size:.9rem;"
                 autocomplete="new-password" aria-required="true" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
          <div role="alert" aria-live="assertive" style="background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#b91c1c;margin-bottom:16px;">
            ⚠ @_error
          </div>
        }

        <button class="btn btn-primary" style="width:100%;padding:13px;font-size:.95rem;font-weight:700;"
                @onclick="SubmitAsync" disabled="@_loading">
          @(_loading ? "Saving…" : "Set New Password")
        </button>
      }

      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);text-align:center;">
        <a href="/login" style="font-size:.82rem;color:var(--green);text-decoration:none;font-weight:600;">← Back to sign in</a>
      </div>
    </div>
  </div>
</div>

@code {
  [SupplyParameterFromQuery(Name = "u")] [Parameter] public string? Username { get; set; }
  [SupplyParameterFromQuery(Name = "t")] [Parameter] public string? Token { get; set; }

  private string _username = "";
  private string _token = "";
  private string _newPassword = "";
  private string _confirmPassword = "";
  private string _error = "";
  private bool _loading;
  private bool _done;

  protected override void OnInitialized()
  {
    _username = Username ?? "";
    _token = Token ?? "";
  }

  private async Task SubmitAsync()
  {
    _error = "";
    if (_newPassword.Length < 12)
    { _error = "Password must be at least 12 characters."; return; }
    if (_newPassword != _confirmPassword)
    { _error = "Passwords don't match."; return; }

    _loading = true;
    var (ok, error) = await Auth.ResetPasswordAsync(_username, _token, _newPassword);
    _loading = false;
    if (ok) _done = true;
    else _error = error ?? "Failed to reset password.";
  }

  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter") await SubmitAsync();
  }
}
