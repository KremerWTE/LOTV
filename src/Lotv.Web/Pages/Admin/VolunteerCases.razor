@page "/admin/volunteers/{Id:int}/cases"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Volunteer Cases — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>@(_volunteer?.FullName ?? $"Volunteer #{Id}") — Cases</h2>
    <p>All cases assigned to this volunteer</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/volunteers/@Id" class="btn btn-sm">← Volunteer</a>
    <a href="/admin/cases/assigned" class="btn btn-sm">By Assignee</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128203;</div>
      <div class="kpi-label">Active Cases</div>
      <div class="kpi-value" style="color:var(--amber)">@_open.Count</div>
    </div>
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">&#9888;</div>
      <div class="kpi-label">Overdue</div>
      <div class="kpi-value" style="color:var(--red)">@_open.Count(c => c.DueDate.HasValue && c.DueDate.Value.Date < DateTime.Today)</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#9989;</div>
      <div class="kpi-label">Fulfilled (All Time)</div>
      <div class="kpi-value" style="color:var(--green)">@(_volunteer?.TotalCasesFulfilled ?? 0)</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128680;</div>
      <div class="kpi-label">Urgent</div>
      <div class="kpi-value" style="color:var(--navy)">@_open.Count(c => c.Priority == RequestPriority.Urgent)</div>
    </div>
  </div>

  @if (_open.Any())
  {
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h3>Active Cases</h3></div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">#</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Family</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Priority</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Due</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var c in _open.OrderBy(c => c.DueDate ?? DateTime.MaxValue))
            {
              var isOverdue = c.DueDate.HasValue && c.DueDate.Value.Date < DateTime.Today;
              <tr style="border-top:1px solid var(--border);@(isOverdue ? "background:#fef2f2;" : "")">
                <td style="padding:10px 16px;font-size:.78rem;color:var(--text-light);">#@c.Id</td>
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/cases/@c.Id" style="color:var(--navy);">@(c.Family?.FullName ?? $"Family #{c.FamilyId}")</a>
                </td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@PriorityClass(c.Priority)" style="font-size:.68rem;">@c.Priority</span>
                </td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@c.Status</td>
                <td style="padding:10px 16px;font-size:.82rem;color:@(isOverdue ? "var(--red)" : "var(--text-light)");">
                  @(c.DueDate?.ToString("MMM d") ?? "—")
                  @if (isOverdue) { <span style="font-size:.7rem;"> ⚠</span> }
                </td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/cases/@c.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }

  @if (_closed.Any())
  {
    <div class="panel">
      <div class="panel-head">
        <h3>Completed Cases</h3>
        <span style="font-size:.8rem;color:var(--text-light);">@_closed.Count total</span>
      </div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <tbody>
            @foreach (var c in _closed.OrderByDescending(c => c.UpdatedAt).Take(10))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:8px 16px;font-size:.78rem;color:var(--text-light);">#@c.Id</td>
                <td style="padding:8px 16px;font-size:.84rem;font-weight:600;opacity:.8;">
                  <a href="/admin/cases/@c.Id" style="color:var(--navy);">@(c.Family?.FullName ?? $"Family #{c.FamilyId}")</a>
                </td>
                <td style="padding:8px 16px;">
                  <span class="badge badge-@StatusClass(c.Status)" style="font-size:.68rem;">@c.Status</span>
                </td>
                <td style="padding:8px 16px;font-size:.82rem;color:var(--text-light);">@c.UpdatedAt.ToString("MMM d, yyyy")</td>
              </tr>
            }
            @if (_closed.Count > 10)
            {
              <tr style="border-top:1px solid var(--border);">
                <td colspan="4" style="padding:8px 16px;font-size:.76rem;color:var(--text-light);text-align:center;">
                  + @(_closed.Count - 10) more completed cases
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }

  @if (!_open.Any() && !_closed.Any())
  {
    <div class="panel">
      <div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">No cases assigned to this volunteer.</div>
    </div>
  }
}

@code {
  [Parameter] public int Id { get; set; }
  private Volunteer? _volunteer;
  private List<PackageRequest> _open = [];
  private List<PackageRequest> _closed = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var volTask  = Api.GetVolunteerByIdAsync(Id);
    var caseTask = Api.GetRequestsAsync(status: null, overdue: null, familyId: null);
    await Task.WhenAll(volTask, caseTask);
    _volunteer = await volTask;
    var all    = await caseTask;
    var mine   = all.Where(c => c.AssignedToId == Id).ToList();
    _open      = mine.Where(c => c.Status != CaseStatus.Fulfilled && c.Status != CaseStatus.Cancelled).ToList();
    _closed    = mine.Where(c => c.Status == CaseStatus.Fulfilled || c.Status == CaseStatus.Cancelled).ToList();
    _loading   = false;
  }

  private static string PriorityClass(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "cancelled",
    RequestPriority.High   => "onhold",
    RequestPriority.Normal => "new",
    RequestPriority.Low    => "fulfilled",
    _                      => "new"
  };

  private static string StatusClass(CaseStatus s) => s switch
  {
    CaseStatus.Fulfilled  => "fulfilled",
    CaseStatus.Cancelled  => "cancelled",
    _                     => "new"
  };
}
