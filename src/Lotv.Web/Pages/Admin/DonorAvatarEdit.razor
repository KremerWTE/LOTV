@page "/admin/donors/{DonorId:int}/avatar"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Donor Avatar — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Update Avatar</h2><p>@(_donor?.FullName ?? $"Donor #{DonorId}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors/@DonorId" class="btn btn-sm">← Donor Profile</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_donor is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Donor #@DonorId not found.</div></div>
}
else
{
  @if (_saved)
  {
    <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--green);font-weight:600;">
        ✓ Avatar updated.
        <a href="/admin/donors/@DonorId" style="color:var(--green);margin-left:8px;">Back to profile →</a>
      </div>
    </div>
  }
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  <div style="max-width:480px;">
    <div class="panel">
      <div class="panel-head"><h3>Avatar URL</h3></div>
      <div class="panel-body">
        @if (!string.IsNullOrEmpty(_donor.AvatarUrl))
        {
          <div style="display:flex;align-items:center;gap:16px;margin-bottom:16px;padding:12px;background:var(--bg);border-radius:6px;">
            <img src="@_donor.AvatarUrl" alt="Current avatar"
                 style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:2px solid var(--border);"
                 onerror="this.style.display='none'" />
            <div>
              <div style="font-size:.78rem;color:var(--text-light);">Current avatar</div>
              <div style="font-size:.76rem;word-break:break-all;color:var(--text-mid);">@_donor.AvatarUrl</div>
            </div>
          </div>
        }

        <div class="form-group">
          <label class="form-label">Avatar URL</label>
          <input class="form-input" @bind="_avatarUrl" placeholder="https://example.com/photo.jpg (leave blank to clear)" />
          <div style="font-size:.72rem;color:var(--text-light);margin-top:3px;">
            Must be a publicly accessible HTTPS URL. Leave blank to remove the current avatar.
          </div>
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
          <a href="/admin/donors/@DonorId" class="btn btn-sm">Cancel</a>
          <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Update Avatar")</button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public int DonorId { get; set; }

  private Lotv.Core.Models.Donor? _donor;
  private string _avatarUrl = "";
  private bool _loading = true, _busy, _saved;
  private string _error = "";

  protected override async Task OnInitializedAsync()
  {
    _donor = await Api.GetDonorAsync(DonorId);
    if (_donor is not null) _avatarUrl = _donor.AvatarUrl ?? "";
    _loading = false;
  }

  private async Task Save()
  {
    _error = ""; _saved = false;
    var url = string.IsNullOrWhiteSpace(_avatarUrl) ? null : _avatarUrl.Trim();
    _busy = true;
    var ok = await Api.UpdateDonorAvatarAsync(DonorId, url);
    _busy = false;
    if (ok)
    {
      _saved = true;
      if (_donor is not null) _donor.AvatarUrl = url;
    }
    else _error = "Failed to update avatar. Please try again.";
  }
}
