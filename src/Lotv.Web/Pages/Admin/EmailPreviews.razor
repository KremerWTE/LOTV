@page "/admin/email-previews"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Request Emails — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Request Emails</h2>
    <p>Every email a prayer care request sends, shown with sample information — to the family and to Whitney and the team.</p>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body">Loading…</div></div>
}
else if (_data is null)
{
  <div class="alert alert-danger">Couldn't load the email previews. Check that the API is running, then reload.</div>
}
else
{
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-body" style="font-size:.84rem;color:var(--text-mid);">
      <strong>Team emails go to:</strong>
      @foreach (var r in _data.TeamRecipients)
      { <span class="badge badge-new" style="margin-left:6px;">@r</span> }
      <div style="margin-top:6px;font-size:.78rem;color:var(--text-light);">
        Set by the <code>Notifications:IntakeTeamEmails</code> setting (comma-separated) on the API — add Whitney and the rest of the team there.
        Reasons for requests and family stories are never included in email.
      </div>
    </div>
  </div>

  @foreach (var audience in _data.Emails.Select(e => e.Audience).Distinct())
  {
    <h3 style="font-family:var(--ff-head);color:var(--navy);margin:24px 0 12px;">
      @(audience == "Family" ? "To the family (or the person who referred them)" : audience == "Volunteer" ? "To the volunteer" : "To Whitney and the team")
    </h3>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(440px,1fr));gap:20px;">
      @foreach (var email in _data.Emails.Where(e => e.Audience == audience))
      {
        <div class="panel" data-email="@email.Key">
          <div class="panel-head" style="flex-direction:column;align-items:flex-start;gap:2px;">
            <h3 style="margin:0;">@email.Name</h3>
            <div style="font-size:.74rem;color:var(--text-light);font-weight:400;">Sent: @email.When</div>
          </div>
          <div class="panel-body" style="padding:0;">
            <div style="padding:10px 16px;font-size:.8rem;border-bottom:1px solid var(--border);background:var(--bg);">
              <span style="color:var(--text-light);">Subject:</span> <strong>@email.Subject</strong>
            </div>
            <iframe title="@email.Name" srcdoc="@email.Html" sandbox="" style="display:block;width:100%;height:700px;border:0;background:#f4f7fb;"></iframe>
          </div>
        </div>
      }
    </div>
  }
}

@code {
  private EmailPreviewsDto? _data;
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    _data = await Api.GetEmailPreviewsAsync();
    _loading = false;
  }
}
