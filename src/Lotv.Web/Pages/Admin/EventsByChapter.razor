@page "/admin/events/by-chapter"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Events by Chapter — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Events by Chapter</h2><p>Ministry events distributed across chapters</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events" class="btn btn-sm">← All Events</a>
    <a href="/admin/events/by-type" class="btn btn-sm">By Type</a>
    <a href="/admin/events/upcoming" class="btn btn-sm">Upcoming</a>
    <a href="/admin/events/new" class="btn btn-sm btn-primary">+ Add Event</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#127881;</div>
      <div class="kpi-label">Total Events</div>
      <div class="kpi-value" style="color:var(--navy)">@_events.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#127968;</div>
      <div class="kpi-label">Chapters</div>
      <div class="kpi-value" style="color:var(--green)">@_chapterMap.Count</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128197;</div>
      <div class="kpi-label">Upcoming</div>
      <div class="kpi-value" style="color:var(--amber)">@_events.Count(e => e.Date.Date >= DateTime.Today && e.Status != EventStatus.Cancelled)</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128100;</div>
      <div class="kpi-label">Total Registered</div>
      <div class="kpi-value" style="color:var(--green)">@_events.Sum(e => e.Registered)</div>
    </div>
  </div>

  @foreach (var g in _events.GroupBy(e => e.ChapterId).OrderByDescending(g => g.Count()))
  {
    var chName   = _chapterMap.TryGetValue(g.Key, out var n) ? n : $"Chapter #{g.Key}";
    var upcoming = g.Count(e => e.Date.Date >= DateTime.Today && e.Status != EventStatus.Cancelled);
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head">
        <h3>
          @chName
          <span style="font-size:.78rem;font-weight:400;color:var(--text-light);"> — @g.Count() events</span>
          @if (upcoming > 0) { <span class="badge badge-new" style="font-size:.68rem;margin-left:8px;">@upcoming upcoming</span> }
        </h3>
        <a href="/admin/chapters/@g.Key" style="font-size:.8rem;color:var(--navy);">View chapter →</a>
      </div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Event</th>
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Type</th>
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Date</th>
              <th style="padding:8px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Registered</th>
              <th style="padding:8px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var e in g.OrderByDescending(e => e.Date).Take(8))
            {
              var isPast   = e.Date.Date < DateTime.Today;
              var isFull   = e.Capacity.HasValue && e.Registered >= e.Capacity.Value;
              <tr style="border-top:1px solid var(--border);@(isPast ? "opacity:.7;" : "")">
                <td style="padding:8px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/events/@e.Id" style="color:var(--navy);">@e.Title</a>
                  @if (e.IsVirtual) { <span style="font-size:.68rem;color:var(--text-light);margin-left:4px;">virtual</span> }
                </td>
                <td style="padding:8px 16px;font-size:.8rem;color:var(--text-light);">@e.Type</td>
                <td style="padding:8px 16px;">
                  <span class="badge badge-@StatusClass(e.Status)" style="font-size:.68rem;">@e.Status</span>
                </td>
                <td style="padding:8px 16px;font-size:.82rem;color:var(--text-light);">@e.Date.ToString("MMM d, yyyy")</td>
                <td style="padding:8px 16px;font-size:.82rem;text-align:right;color:@(isFull ? "var(--red)" : "var(--text-light)");">
                  @e.Registered@(e.Capacity.HasValue ? $"/{e.Capacity}" : "")
                </td>
                <td style="padding:8px 16px;text-align:center;">
                  <a href="/admin/events/@e.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
            @if (g.Count() > 8)
            {
              <tr style="border-top:1px solid var(--border);">
                <td colspan="6" style="padding:8px 16px;font-size:.78rem;color:var(--text-light);text-align:center;">
                  + @(g.Count() - 8) more events
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }

  @if (!_events.Any())
  {
    <div class="panel">
      <div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">No events found.</div>
    </div>
  }
}

@code {
  private List<MinistryEvent> _events = [];
  private Dictionary<int, string> _chapterMap = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var evtTask  = Api.GetEventsAsync();
    var chapTask = Api.GetChaptersAdminAsync();
    await Task.WhenAll(evtTask, chapTask);
    _events = await evtTask;
    var chapters = await chapTask;
    _chapterMap  = chapters.ToDictionary(c => c.Id, c => c.Name);
    _loading = false;
  }

  private static string StatusClass(EventStatus s) => s switch
  {
    EventStatus.Published  => "new",
    EventStatus.Open       => "new",
    EventStatus.Completed  => "fulfilled",
    EventStatus.Cancelled  => "cancelled",
    EventStatus.Draft      => "onhold",
    EventStatus.Closed     => "onhold",
    _                      => "new"
  };
}
