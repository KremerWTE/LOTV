@page "/admin/cases-hub"
@layout AdminLayout

<PageTitle>Cases — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Cases</h2>
    <p>All case views — pipeline, queues, and analytics in one place</p>
  </div>
</div>

<div class="tab-bar" style="display:flex;gap:4px;margin-bottom:20px;background:white;border:1px solid var(--border);border-radius:var(--radius, 10px);padding:4px;width:fit-content;flex-wrap:wrap;">
  @foreach (var t in _tabs)
  {
    <button class="tab-btn @(_active == t.Key ? "active" : "")"
            style="padding:8px 16px;border-radius:7px;border:none;background:@(_active == t.Key ? "var(--green)" : "none");color:@(_active == t.Key ? "white" : "var(--text-mid)");font-size:.85rem;font-weight:500;cursor:pointer;"
            @onclick="() => _active = t.Key">
      @t.Label
    </button>
  }
</div>

@switch (_active)
{
  case "list":
    <Cases />
    break;
  case "kanban":
    <Kanban />
    break;
  case "historical":
    <Historical />
    break;
  case "mothers-day":
    <MothersDay />
    break;
  case "bereavement":
    <FollowUpTrackers />
    break;
  case "unassigned":
    <Queue />
    break;
  case "my-queue":
    <MyQueue />
    break;
  case "overdue":
    <OverdueCases />
    break;
  case "bulk":
    <CaseBulkUpdate />
    break;
  case "analytics":
    <CaseAnalytics />
    break;
  case "at-risk":
    <CaseEscalationReport />
    break;
}

@code {
  private record TabDef(string Key, string Label);

  // "New Case" isn't here — it's a create action, not a view to switch
  // between, and stays a standalone sidebar link so it's always one click.
  private readonly List<TabDef> _tabs =
  [
    new("list", "All Cases"),
    new("kanban", "Kanban Board"),
    new("historical", "Historical"),
    new("mothers-day", "Mother's Day Mailing"),
    new("bereavement", "Bereavement Follow-Up"),
    new("unassigned", "Unassigned Queue"),
    new("my-queue", "My Work Queue"),
    new("overdue", "Overdue"),
    new("bulk", "Bulk Update"),
    new("analytics", "Analytics"),
    new("at-risk", "At Risk"),
  ];

  private string _active = "list";
}
