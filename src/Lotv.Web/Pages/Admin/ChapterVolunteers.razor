@page "/admin/chapters/{Id:int}/volunteers"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Volunteers — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Volunteers</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/volunteers/new" class="btn btn-sm btn-primary">+ New Volunteer</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <!-- KPIs -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">👤</div>
      <div class="kpi-label">Total</div>
      <div class="kpi-value" style="color:var(--navy)">@_volunteers.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">✅</div>
      <div class="kpi-label">Active</div>
      <div class="kpi-value" style="color:var(--green)">@_volunteers.Count(v => v.Status == VolunteerStatus.Active)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">📦</div>
      <div class="kpi-label">Total Cases</div>
      <div class="kpi-value" style="color:var(--amber)">@_volunteers.Sum(v => v.ActiveCases)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Volunteers (@_volunteers.Count)</h3>
      <select class="form-input" style="width:160px;font-size:.82rem;padding:5px 10px;" @bind="_statusFilter">
        <option value="">All statuses</option>
        <option value="Active">Active</option>
        <option value="Inactive">Inactive</option>
        <option value="Pending">Pending</option>
        <option value="Suspended">Suspended</option>
      </select>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!Filtered.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">@(_volunteers.Any() ? "No volunteers match filter." : "No volunteers in this chapter yet.")</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Name</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Email</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);">Active Cases</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Joined</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var v in Filtered.OrderBy(v => v.LastName))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">@v.FullName</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@v.Email</td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@(v.Status == VolunteerStatus.Active ? "fulfilled" : "cancelled")" style="font-size:.68rem;">@v.Status</span>
                </td>
                <td style="padding:10px 16px;text-align:center;font-size:.84rem;font-weight:600;color:@(v.ActiveCases > 0 ? "var(--navy)" : "var(--text-light)");">@v.ActiveCases</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@v.JoinedDate.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/volunteers/@v.Id" style="font-size:.78rem;color:var(--navy);">Profile</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<Volunteer> _volunteers = [];
  private string _statusFilter = "";
  private bool _loading = true;

  private IEnumerable<Volunteer> Filtered => string.IsNullOrWhiteSpace(_statusFilter)
    ? _volunteers
    : _volunteers.Where(v => v.Status.ToString() == _statusFilter);

  protected override async Task OnInitializedAsync()
  {
    var chapTask = Api.GetChaptersAdminAsync();
    var volTask  = Api.GetVolunteersAsync();
    await Task.WhenAll(chapTask, volTask);
    var chapters   = await chapTask;
    _chapter       = chapters.FirstOrDefault(c => c.Id == Id);
    var all        = await volTask;
    _volunteers    = all.Where(v => v.ChapterId == Id).ToList();
    _loading = false;
  }
}
