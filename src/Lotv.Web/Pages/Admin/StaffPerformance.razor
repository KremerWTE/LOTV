@page "/admin/staff/performance"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Staff Performance — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Staff Performance</h2><p>Task completion rates, case resolution, and workload across all staff</p></div>
  <div class="page-hd-actions">
    <a href="/admin/users" class="btn btn-sm">← All Users</a>
    <a href="/admin/workload" class="btn btn-sm">Workload View</a>
    <a href="/admin/staff-tasks" class="btn btn-sm">All Tasks</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Loading performance data…" />
}
else
{
  <!-- ORG KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">👥</div>
      <div class="kpi-label">Active Staff</div>
      <div class="kpi-value" style="color:var(--navy)">@_staff.Count(u => u.IsActive)</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">☑</div>
      <div class="kpi-label">Tasks Completed</div>
      <div class="kpi-value" style="color:var(--green)">@_tasks.Count(t => t.Status == "Completed")</div>
      <div class="kpi-change">of @_tasks.Count total</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">⏳</div>
      <div class="kpi-label">Tasks Overdue</div>
      <div class="kpi-value" style="color:var(--amber)">@_tasks.Count(t => t.DueDate < DateTime.Now && t.Status != "Completed")</div>
    </div>
    <div class="kpi-card kpi-blush">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Completion Rate</div>
      <div class="kpi-value" style="color:var(--blush)">@_completionRate%</div>
      <div class="kpi-change">tasks completed on time</div>
    </div>
  </div>

  <!-- FILTER CHIPS -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
    <span style="font-size:.8rem;font-weight:600;color:var(--text-mid);align-self:center;">Sort by:</span>
    @foreach (var (key, label) in new[] { ("tasks","Tasks Done"), ("rate","Completion Rate"), ("load","Case Load"), ("name","Name") })
    {
      <button class="chip @(_sort == key ? "chip-active" : "")" @onclick="() => _sort = key">@label</button>
    }
  </div>

  <!-- STAFF PERFORMANCE CARDS -->
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;margin-bottom:20px;">
    @foreach (var row in SortedRows)
    {
      var loadColor = row.ActiveCases >= 5 ? "var(--red)" : row.ActiveCases >= 3 ? "var(--amber)" : "var(--green)";
      var rateColor = row.CompletionRate >= 80 ? "var(--green)" : row.CompletionRate >= 50 ? "var(--amber)" : "var(--red)";
      <div class="panel" style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/staff/{row.Id}/summary")'>
        <div class="panel-body" style="padding:14px 16px;">
          <div style="display:flex;gap:10px;align-items:flex-start;margin-bottom:10px;">
            <div style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--navy),#1e3a5f);display:flex;align-items:center;justify-content:center;font-size:.85rem;color:white;font-weight:700;flex-shrink:0;">
              @Initials(row.Name)
            </div>
            <div style="flex:1;min-width:0;">
              <div style="font-weight:700;font-size:.88rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@row.Name</div>
              <div style="font-size:.7rem;color:var(--text-light);">@row.Role</div>
            </div>
            @if (row.CompletionRate >= 90)
            { <span title="Top Performer" style="font-size:1rem;">⭐</span> }
          </div>

          <!-- COMPLETION RATE -->
          <div style="display:flex;justify-content:space-between;font-size:.72rem;margin-bottom:3px;">
            <span>Task completion</span>
            <span style="font-weight:700;color:@rateColor;">@row.CompletionRate%</span>
          </div>
          <div class="progress-bar" style="height:6px;margin-bottom:8px;">
            <div class="progress-fill" style="width:@row.CompletionRate%;background:@rateColor;"></div>
          </div>

          <!-- STATS ROW -->
          <div style="display:flex;gap:8px;font-size:.72rem;flex-wrap:wrap;">
            <span style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:2px 8px;">
              ✅ @row.TasksDone done
            </span>
            <span style="background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:2px 8px;color:@loadColor;">
              📋 @row.ActiveCases cases
            </span>
            @if (row.OverdueTasks > 0)
            {
              <span style="background:#fee2e2;color:var(--red);border-radius:8px;padding:2px 8px;font-weight:600;">
                ⚠️ @row.OverdueTasks overdue
              </span>
            }
          </div>
        </div>
      </div>
    }
    @if (!_rows.Any())
    {
      <div class="panel" style="grid-column:1/-1;">
        <div class="panel-body" style="text-align:center;padding:40px;color:var(--text-light);">No staff data found.</div>
      </div>
    }
  </div>

  <!-- TASK BREAKDOWN TABLE -->
  <div class="panel">
    <div class="panel-head">
      <h3>Task Breakdown by Staff</h3>
      <a href="/admin/staff-tasks" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">All Tasks &rarr;</a>
    </div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Staff Member</th>
            <th style="text-align:right;">Total Tasks</th>
            <th style="text-align:right;">Completed</th>
            <th style="text-align:right;">Open</th>
            <th style="text-align:right;">Overdue</th>
            <th style="text-align:right;">Cases</th>
            <th>Rate</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var row in SortedRows)
          {
            var rateColor = row.CompletionRate >= 80 ? "var(--green)" : row.CompletionRate >= 50 ? "var(--amber)" : "var(--red)";
            <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/staff/{row.Id}/summary")'>
              <td style="font-weight:600;">@row.Name</td>
              <td style="text-align:right;color:var(--text-mid);">@row.TotalTasks</td>
              <td style="text-align:right;color:var(--green);font-weight:600;">@row.TasksDone</td>
              <td style="text-align:right;color:var(--text-mid);">@row.TasksOpen</td>
              <td style="text-align:right;font-weight:@(row.OverdueTasks > 0 ? "700" : "400");color:@(row.OverdueTasks > 0 ? "var(--red)" : "var(--text-light)");">@row.OverdueTasks</td>
              <td style="text-align:right;color:var(--navy);">@row.ActiveCases</td>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div class="progress-bar" style="flex:1;height:6px;">
                    <div class="progress-fill" style="width:@row.CompletionRate%;background:@rateColor;"></div>
                  </div>
                  <span style="font-size:.7rem;font-weight:700;color:@rateColor;width:32px;text-align:right;">@row.CompletionRate%</span>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private record PerfRow(string Id, string Name, string Role, int TotalTasks, int TasksDone,
      int TasksOpen, int OverdueTasks, int ActiveCases, int CompletionRate);

  private bool _loading = true;
  private string _sort = "rate";
  private List<StaffUserDto> _staff = [];
  private List<StaffTaskDto> _tasks = [];
  private List<WorkloadRowDto> _workload = [];
  private List<PerfRow> _rows = [];
  private int _completionRate;

  private IEnumerable<PerfRow> SortedRows => _sort switch
  {
    "tasks" => _rows.OrderByDescending(r => r.TasksDone),
    "load"  => _rows.OrderByDescending(r => r.ActiveCases),
    "name"  => _rows.OrderBy(r => r.Name),
    _       => _rows.OrderByDescending(r => r.CompletionRate)
  };

  protected override async Task OnInitializedAsync()
  {
    var staffTask = Api.GetUsersAsync();
    var taskTask  = Api.GetStaffTasksAsync();
    var wlTask    = Api.GetWorkloadAsync();
    await Task.WhenAll(staffTask, taskTask, wlTask);

    _staff    = (await staffTask).Where(u => u.IsActive && u.Role is UserRole.ChapterStaff or UserRole.ChapterAdmin or UserRole.HQAdmin).ToList();
    _tasks    = await taskTask;
    _workload = await wlTask;
    var now   = DateTime.Now;

    _rows = _staff.Select(u =>
    {
      var myTasks    = _tasks.Where(t => t.AssignedToName == u.FullName).ToList();
      var done       = myTasks.Count(t => t.Status == "Completed");
      var open       = myTasks.Count(t => t.Status != "Completed" && t.Status != "Cancelled");
      var overdue    = myTasks.Count(t => t.DueDate.HasValue && t.DueDate < now && t.Status != "Completed");
      var wl         = _workload.FirstOrDefault(w => w.FullName == u.FullName);
      var rate       = myTasks.Count > 0 ? (int)(done * 100.0 / myTasks.Count) : 100;
      return new PerfRow(u.Id, u.FullName ?? u.Email ?? u.Id, u.Role.ToString(),
          myTasks.Count, done, open, overdue, wl?.ActiveCases ?? 0, rate);
    }).ToList();

    _completionRate = _rows.Any() ? (int)_rows.Average(r => r.CompletionRate) : 0;
    _loading = false;
  }

  private static string Initials(string name)
  {
    var p = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    return p.Length >= 2 ? $"{p[0][0]}{p[^1][0]}" : name.Length > 0 ? name[0].ToString() : "S";
  }
}
