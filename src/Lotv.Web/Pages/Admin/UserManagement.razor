@page "/admin/users"
@layout AdminLayout
@inject ApiService Api
@inject AuthService Auth

<PageTitle>User Management — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>User Management</h2><p>Staff accounts and role permissions</p></div>
  <div class="page-hd-actions">
    <button class="btn btn-primary btn-sm" @onclick="OpenAdd">+ Invite User</button>
  </div>
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr><th></th><th>Name</th><th>Username</th><th>Recovery Email</th><th>Role</th><th>Status</th><th>Last Login</th><th></th></tr>
      </thead>
      <tbody>
        @foreach (var u in _users)
        {
          var isMe = u.Id == _myId;
          <tr style="@(isMe ? "background:var(--green-pale);" : "")">
            <td style="width:42px;">
              @if (!string.IsNullOrEmpty(u.AvatarUrl))
              {
                <img src="@u.AvatarUrl" alt="" style="width:32px;height:32px;border-radius:50%;object-fit:cover;border:1px solid var(--border);" />
              }
              else
              {
                <div style="width:32px;height:32px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;font-size:.74rem;font-weight:700;color:var(--text-mid);">@Initials(u)</div>
              }
            </td>
            <td>
              <strong>@(u.FullName ?? u.UserName ?? u.Id)</strong>
              @if (isMe) { <span class="badge badge-fulfilled" style="font-size:.6rem;margin-left:6px;">You</span> }
            </td>
            <td style="font-size:.78rem;color:var(--text-light);">@u.UserName</td>
            <td style="font-size:.78rem;color:var(--text-light);">
              @if (string.IsNullOrEmpty(u.Email))
              { <span style="color:var(--amber);">Not set</span> }
              else
              { @u.Email }
            </td>
            <td><span class="badge @RoleBadge(u.Role)" style="font-size:.68rem;">@u.Role</span></td>
            <td>
              @if (u.IsActive)
              { <span class="badge badge-fulfilled">Active</span> }
              else
              { <span class="badge badge-onhold">Inactive</span> }
            </td>
            <td style="font-size:.76rem;color:var(--text-light);">—</td>
            <td style="display:flex;gap:6px;">
              @if (!isMe)
              {
                <button class="btn btn-sm" @onclick="() => OpenEdit(u)">Edit</button>
                <button class="btn btn-sm" title="Send test push" @onclick="() => PushTest(u)">🔔</button>
                @if (!string.IsNullOrEmpty(u.AvatarUrl))
                {
                  <button class="btn btn-sm" title="Clear avatar" @onclick="() => ClearAvatar(u)">Clear 📷</button>
                }
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<!-- DRAWER -->
@if (_drawerOpen)
{
  <div class="drawer-overlay" @onclick="CloseDrawer"></div>
  <div class="drawer">
    <div class="drawer-head">
      <h3>@(_editUser == null ? "Invite User" : "Edit User")</h3>
      <button class="drawer-close" @onclick="CloseDrawer">✕</button>
    </div>
    <div class="drawer-body">
      @if (_editUser is not null)
      {
        <div class="form-group">
          <label class="form-label">User</label>
          <div style="padding:9px 12px;background:var(--bg);border-radius:8px;font-size:.86rem;">@(_editUser.FullName ?? _editUser.UserName ?? _editUser.Id)</div>
        </div>
        <div class="form-group">
          <label class="form-label">Username (sign-in)</label>
          <div style="padding:9px 12px;background:var(--bg);border-radius:8px;font-size:.86rem;">@_editUser.UserName</div>
        </div>
      }
      <div class="form-group">
        <label class="form-label">Role</label>
        <select class="form-input" @bind="_formRole">
          @foreach (var r in Enum.GetValues<UserRole>())
          { <option value="@r">@r</option> }
        </select>
      </div>
      @if (_editUser is not null)
      {
        <div class="form-group">
          <label class="form-label">Recovery Email</label>
          <input class="form-input" @bind="_formEmail" placeholder="name@example.com (optional — needed for forgot-password)" />
        </div>
      }
      @if (!string.IsNullOrEmpty(_formError))
      { <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;">⚠ @_formError</div> }
    </div>
    <div class="drawer-footer">
      <button class="btn btn-primary" @onclick="SaveAsync">@(_editUser == null ? "Send Invite" : "Save")</button>
      <button class="btn" @onclick="CloseDrawer">Cancel</button>
    </div>
  </div>
}

@if (_toast != null)
{
  <div style="position:fixed;bottom:24px;right:24px;background:var(--navy);color:white;padding:12px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:.88rem;font-weight:600;z-index:600;">
    ✓ @_toast
  </div>
}

@code {
  private List<StaffUserDto> _users = [];
  private bool _drawerOpen;
  private StaffUserDto? _editUser;
  private UserRole _formRole = UserRole.ChapterStaff;
  private string? _formEmail;
  private string _formError  = "";
  private string? _toast;
  private string _myId = "";

  protected override async Task OnInitializedAsync()
  {
    _myId = Auth.UserId;
    _users = await Api.GetUsersAsync();
  }

  private void OpenAdd()
  {
    _editUser   = null;
    _formRole   = UserRole.ChapterStaff;
    _formEmail  = null;
    _formError  = "";
    _drawerOpen = true;
  }

  private void OpenEdit(StaffUserDto u)
  {
    _editUser   = u;
    _formRole   = u.Role;
    _formEmail  = u.Email;
    _formError  = "";
    _drawerOpen = true;
  }

  private async Task SaveAsync()
  {
    _formError = "";
    if (_editUser == null) { await ShowToast("Invite not yet supported — use the register endpoint."); _drawerOpen = false; return; }

    if (_formRole != _editUser.Role)
      await Api.UpdateUserRoleAsync(_editUser.Id, _formRole, _editUser.ChapterId);

    if (_formEmail != _editUser.Email)
    {
      var (ok, error) = await Api.UpdateUserEmailAsync(_editUser.Id, _formEmail);
      if (!ok) { _formError = error ?? "Failed to update email."; return; }
    }

    _users = await Api.GetUsersAsync();
    _drawerOpen = false;
    await ShowToast("Saved");
  }

  private void CloseDrawer() { _drawerOpen = false; _formError = ""; }

  private async Task PushTest(StaffUserDto u)
  {
    var ok = await Api.SendTestPushToUserAsync(u.Id);
    await ShowToast(ok ? $"Test push sent to {u.FullName ?? u.UserName ?? u.Email}" : "Could not send test push");
  }

  private async Task ClearAvatar(StaffUserDto u)
  {
    if (await Api.ClearUserAvatarAsync(u.Id))
    {
      _users = await Api.GetUsersAsync();
      await ShowToast("Avatar cleared");
    }
  }

  private static string Initials(StaffUserDto u)
  {
    var name = u.FullName ?? u.Email ?? u.Id;
    if (string.IsNullOrWhiteSpace(name)) return "?";
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    return string.Concat(parts.Take(2).Select(p => p[0])).ToUpperInvariant();
  }

  private async Task ShowToast(string msg)
  {
    _toast = msg;
    StateHasChanged();
    await Task.Delay(2500);
    _toast = null;
  }

  private static string RoleBadge(UserRole role) => role switch
  {
    UserRole.HQAdmin       => "badge-fulfilled",
    UserRole.ChapterAdmin  => "badge-shipped",
    UserRole.ChapterStaff  => "badge-inprogress",
    UserRole.Volunteer     => "badge-new",
    _                      => "badge-onhold"
  };
}
