@page "/admin/by-channel"
@layout AdminLayout
@inject IMockDataService Data

<PageTitle>Donations by Channel — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Donations by Channel</h2><p>Breakdown of giving by source / method</p></div>
</div>

<!-- DATE FILTER -->
<div class="filter-bar" style="margin-bottom:20px;">
  @foreach (var f in new[]{"All Time","This Year","This Month","Last Month"})
  { <button class="filter-chip @(_dateFilter == f ? "active" : "")" @onclick="() => SetFilter(f)">@f</button> }
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:24px;">
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128184;</div>
    <div class="kpi-label">Total Raised</div>
    <div class="kpi-value" style="color:var(--green)">@_total.ToString("C0")</div>
  </div>
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#127873;</div>
    <div class="kpi-label">Total Gifts</div>
    <div class="kpi-value" style="color:var(--navy)">@_rows.Sum(r => r.Count)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#127942;</div>
    <div class="kpi-label">Top Channel</div>
    <div class="kpi-value" style="color:var(--amber);font-size:1.1rem;">@(_rows.FirstOrDefault()?.Channel ?? "—")</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#9889;</div>
    <div class="kpi-label">Avg Gift Size</div>
    <div class="kpi-value" style="color:var(--gold)">@(_rows.Sum(r => r.Count) > 0 ? (_total / _rows.Sum(r => r.Count)).ToString("C0") : "—")</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:28px;">
  @foreach (var row in _rows)
  {
    var pct = _total > 0 ? (int)(row.Amount / _total * 100) : 0;
    <div class="panel">
      <div class="panel-body" style="text-align:center;">
        <div style="font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--text-light);margin-bottom:8px;">@row.Channel</div>
        <div style="font-family:var(--ff-head);font-size:1.8rem;font-weight:700;color:var(--green);margin-bottom:4px;">@row.Amount.ToString("C0")</div>
        <div style="font-size:.8rem;color:var(--text-mid);margin-bottom:12px;">@row.Count gift@(row.Count != 1 ? "s" : "")</div>
        <div class="progress-bar"><div class="progress-fill" style="width:@pct%;"></div></div>
        <div style="font-size:.7rem;color:var(--text-light);margin-top:4px;">@pct% of total</div>
      </div>
    </div>
  }
</div>

<div class="panel">
  <div class="panel-head"><h3>@_dateFilter — Donations by Channel</h3></div>
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead><tr><th>Channel</th><th>Gifts</th><th>Total</th><th>Avg Gift</th><th>% of Total</th></tr></thead>
      <tbody>
        @foreach (var row in _rows)
        {
          var pct2 = _total > 0 ? (row.Amount / _total * 100m) : 0;
          <tr>
            <td><strong>@row.Channel</strong></td>
            <td>@row.Count</td>
            <td style="font-weight:700;color:var(--green);">@row.Amount.ToString("C0")</td>
            <td style="color:var(--text-mid);">@(row.Count > 0 ? (row.Amount / row.Count).ToString("C0") : "—")</td>
            <td>
              <div style="display:flex;align-items:center;gap:8px;">
                <div class="progress-bar" style="width:80px;"><div class="progress-fill" style="width:@((int)pct2)%;"></div></div>
                <span style="font-size:.76rem;color:var(--text-light);">@pct2.ToString("F1")%</span>
              </div>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  private record ChannelRow(string Channel, int Count, decimal Amount);
  private List<ChannelRow> _rows = [];
  private decimal _total;
  private string _dateFilter = "All Time";

  protected override void OnInitialized() => Recalculate();

  private void SetFilter(string f) { _dateFilter = f; Recalculate(); }

  private void Recalculate()
  {
    var now = DateTime.UtcNow;
    var source = _dateFilter switch
    {
      "This Year"  => Data.GetDonations().Where(d => d.Date.Year == now.Year),
      "This Month" => Data.GetDonations().Where(d => d.Date.Year == now.Year && d.Date.Month == now.Month),
      "Last Month" => Data.GetDonations().Where(d => d.Date.Year == now.AddMonths(-1).Year && d.Date.Month == now.AddMonths(-1).Month),
      _            => Data.GetDonations().AsEnumerable()
    };
    _rows = source
      .GroupBy(d => d.Channel.ToString())
      .Select(g => new ChannelRow(g.Key, g.Count(), g.Sum(d => d.Amount)))
      .OrderByDescending(r => r.Amount)
      .ToList();
    _total = _rows.Sum(r => r.Amount);
  }
}
