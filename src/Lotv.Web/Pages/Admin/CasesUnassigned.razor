@page "/admin/cases/unassigned"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Unassigned Cases — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Unassigned Cases</h2><p>Open cases awaiting volunteer assignment</p></div>
  <div class="page-hd-actions">
    <a href="/admin/cases" class="btn btn-sm">← All Cases</a>
    <a href="/admin/cases/assigned" class="btn btn-sm">By Assignee</a>
    <a href="/admin/cases/by-priority" class="btn btn-sm">By Priority</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">&#10067;</div>
      <div class="kpi-label">Unassigned</div>
      <div class="kpi-value" style="color:var(--red)">@_unassigned.Count</div>
    </div>
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">&#9888;</div>
      <div class="kpi-label">Overdue</div>
      <div class="kpi-value" style="color:var(--red)">@_unassigned.Count(c => c.DueDate.HasValue && c.DueDate.Value.Date < DateTime.Today)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128680;</div>
      <div class="kpi-label">Urgent</div>
      <div class="kpi-value" style="color:var(--amber)">@_unassigned.Count(c => c.Priority == RequestPriority.Urgent)</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#127968;</div>
      <div class="kpi-label">Chapters Affected</div>
      <div class="kpi-value" style="color:var(--navy)">@_unassigned.Select(c => c.ChapterId).Distinct().Count()</div>
    </div>
  </div>

  @if (!_unassigned.Any())
  {
    <div class="panel" style="border-left:4px solid var(--green);">
      <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">
        ✓ All open cases have been assigned.
      </div>
    </div>
  }
  else
  {
    <div class="panel">
      <div class="panel-head">
        <h3>Unassigned Open Cases</h3>
        <span style="font-size:.8rem;color:var(--text-light);">Ordered by priority then due date</span>
      </div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">#</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Family</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Priority</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Chapter</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Due</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var c in _unassigned.OrderBy(c => PriorityOrder(c.Priority)).ThenBy(c => c.DueDate ?? DateTime.MaxValue))
            {
              var isOverdue = c.DueDate.HasValue && c.DueDate.Value.Date < DateTime.Today;
              var chName    = _chapterMap.TryGetValue(c.ChapterId, out var n) ? n : $"#{c.ChapterId}";
              <tr style="border-top:1px solid var(--border);@(isOverdue ? "background:#fef2f2;" : "")">
                <td style="padding:10px 16px;font-size:.78rem;color:var(--text-light);">#@c.Id</td>
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/cases/@c.Id" style="color:var(--navy);">@(c.Family?.FullName ?? $"Family #{c.FamilyId}")</a>
                </td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@PriorityClass(c.Priority)" style="font-size:.68rem;">@c.Priority</span>
                </td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@c.Status</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@chName</td>
                <td style="padding:10px 16px;font-size:.82rem;color:@(isOverdue ? "var(--red)" : "var(--text-light)");">
                  @(c.DueDate?.ToString("MMM d") ?? "—")
                  @if (isOverdue) { <span style="font-size:.7rem;"> ⚠</span> }
                </td>
                <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                  <a href="/admin/cases/@c.Id/assign" style="font-size:.78rem;color:var(--navy);margin-right:8px;">Assign</a>
                  <a href="/admin/cases/@c.Id" style="font-size:.78rem;color:var(--text-light);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
}

@code {
  private List<PackageRequest> _unassigned = [];
  private Dictionary<int, string> _chapterMap = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var caseTask = Api.GetRequestsAsync(status: null, overdue: null, familyId: null);
    var chapTask = Api.GetChaptersAdminAsync();
    await Task.WhenAll(caseTask, chapTask);
    var all      = await caseTask;
    _unassigned  = all.Where(c =>
      string.IsNullOrEmpty(c.AssignedTo) &&
      c.Status != CaseStatus.Fulfilled &&
      c.Status != CaseStatus.Cancelled).ToList();
    var chapters  = await chapTask;
    _chapterMap   = chapters.ToDictionary(c => c.Id, c => c.Name);
    _loading      = false;
  }

  private static int PriorityOrder(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => 0,
    RequestPriority.High   => 1,
    RequestPriority.Normal => 2,
    RequestPriority.Low    => 3,
    _                      => 99
  };

  private static string PriorityClass(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "cancelled",
    RequestPriority.High   => "onhold",
    RequestPriority.Normal => "new",
    RequestPriority.Low    => "fulfilled",
    _                      => "new"
  };
}
