@page "/admin/chapters/{Id:int}/donations"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Donations — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Donations</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/donations/new" class="btn btn-sm btn-primary">+ Log Donation</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <!-- KPIs -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Total Raised</div>
      <div class="kpi-value" style="color:var(--green)">@_donations.Sum(d => d.Amount).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#127873;</div>
      <div class="kpi-label">Gift Count</div>
      <div class="kpi-value" style="color:var(--navy)">@_donations.Count</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">Unique Donors</div>
      <div class="kpi-value" style="color:var(--amber)">@_donations.Select(d => d.DonorId).Distinct().Count()</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">&#128200;</div>
      <div class="kpi-label">Avg Gift</div>
      <div class="kpi-value" style="font-size:.9rem;">@(_donations.Any() ? (_donations.Sum(d => d.Amount) / _donations.Count).ToString("C0") : "—")</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Donations (@_donations.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      @if (!_donations.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No donations recorded for this chapter.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Date</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Donor</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Amount</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Channel</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Campaign</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var d in _donations.OrderByDescending(d => d.Date))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;white-space:nowrap;">@d.Date.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/donors/@d.DonorId" style="color:var(--navy);">@(d.Donor?.FullName ?? $"Donor #{d.DonorId}")</a>
                </td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@d.Amount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@d.Channel.ToDisplayName()</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(d.Campaign ?? "—")</td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/donations/@d.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr style="border-top:2px solid var(--border);background:var(--bg);font-weight:700;">
              <td colspan="2" style="padding:10px 16px;font-size:.84rem;">Total</td>
              <td style="padding:10px 16px;font-size:.92rem;text-align:right;color:var(--green);">@_donations.Sum(d => d.Amount).ToString("C0")</td>
              <td colspan="3"></td>
            </tr>
          </tfoot>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<Donation> _donations = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var chapTask = Api.GetChaptersAdminAsync();
    var donTask  = Api.GetDonationsAsync();
    await Task.WhenAll(chapTask, donTask);
    var chapters  = await chapTask;
    _chapter      = chapters.FirstOrDefault(c => c.Id == Id);
    var all       = await donTask;
    _donations    = all.Where(d => d.ChapterId == Id).ToList();
    _loading = false;
  }
}
