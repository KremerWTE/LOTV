@page "/admin/events/{Id:int}/revenue"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Event Revenue — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Event Revenue</h2><p>@(_event?.Title ?? $"Event #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events/@Id" class="btn btn-sm">← Event Detail</a>
    <a href="/admin/events/@Id/attendees" class="btn btn-sm">Attendees</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  @if (_revenue is not null)
  {
    <!-- KPI STRIP -->
    <div class="kpi-grid" style="margin-bottom:20px;">
      <div class="kpi-card kpi-navy">
        <div class="kpi-icon">🎛</div>
        <div class="kpi-label">Ticket Revenue</div>
        <div class="kpi-value" style="color:var(--navy)">@_revenue.Tickets.ToString("C0")</div>
      </div>
      <div class="kpi-card kpi-amber">
        <div class="kpi-icon">💷</div>
        <div class="kpi-label">Auction Revenue</div>
        <div class="kpi-value" style="color:var(--amber)">@_revenue.Auction.ToString("C0")</div>
      </div>
      <div class="kpi-card kpi-green">
        <div class="kpi-icon">💰</div>
        <div class="kpi-label">Total Revenue</div>
        <div class="kpi-value" style="color:var(--green);font-size:1.6rem;">@_revenue.Total.ToString("C0")</div>
      </div>
      @if (_event?.GoalAmount > 0)
      {
        <div class="kpi-card">
          <div class="kpi-icon">📈</div>
          <div class="kpi-label">Goal Progress</div>
          <div class="kpi-value" style="font-size:1.1rem;color:@(_revenue.Total >= _event.GoalAmount ? "var(--green)" : "var(--amber)");">
            @((_revenue.Total / _event.GoalAmount!.Value * 100m).ToString("F0"))%
          </div>
        </div>
      }
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
      <!-- Revenue Breakdown -->
      <div class="panel">
        <div class="panel-head"><h3>Revenue Breakdown</h3></div>
        <div class="panel-body">
          <table style="width:100%;border-collapse:collapse;">
            <tbody>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0;font-size:.84rem;">Ticket Sales</td>
                <td style="padding:10px 0;font-size:.92rem;font-weight:700;text-align:right;color:var(--navy);">@_revenue.Tickets.ToString("C0")</td>
                <td style="padding:10px 0;font-size:.78rem;color:var(--text-light);text-align:right;padding-left:10px;">
                  @(_revenue.Total > 0 ? (_revenue.Tickets / _revenue.Total * 100m).ToString("F0") : "0")%
                </td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:10px 0;font-size:.84rem;">Silent Auction</td>
                <td style="padding:10px 0;font-size:.92rem;font-weight:700;text-align:right;color:var(--amber);">@_revenue.Auction.ToString("C0")</td>
                <td style="padding:10px 0;font-size:.78rem;color:var(--text-light);text-align:right;padding-left:10px;">
                  @(_revenue.Total > 0 ? (_revenue.Auction / _revenue.Total * 100m).ToString("F0") : "0")%
                </td>
              </tr>
              <tr style="font-weight:700;">
                <td style="padding:10px 0;font-size:.86rem;">Total</td>
                <td style="padding:10px 0;font-size:1rem;text-align:right;color:var(--green);">@_revenue.Total.ToString("C0")</td>
                <td style="padding:10px 0;font-size:.78rem;color:var(--text-light);text-align:right;padding-left:10px;">100%</td>
              </tr>
            </tbody>
          </table>

          @if (_revenue.Total > 0)
          {
            <div style="margin-top:16px;">
              @{
                var ticketPct = (double)(_revenue.Total > 0 ? _revenue.Tickets / _revenue.Total * 100 : 0);
                var auctionPct = (double)(_revenue.Total > 0 ? _revenue.Auction / _revenue.Total * 100 : 0);
              }
              <div style="font-size:.74rem;color:var(--text-light);margin-bottom:6px;">Revenue Mix</div>
              <div style="height:10px;border-radius:5px;overflow:hidden;display:flex;">
                <div style="width:@(ticketPct.ToString("F0"))%;background:var(--navy);"></div>
                <div style="width:@(auctionPct.ToString("F0"))%;background:var(--amber);"></div>
              </div>
              <div style="display:flex;gap:14px;margin-top:6px;font-size:.72rem;color:var(--text-light);">
                <span>■ Tickets</span>
                <span style="color:var(--amber);">■ Auction</span>
              </div>
            </div>
          }
        </div>
      </div>

      <!-- Event Info -->
      @if (_event is not null)
      {
        <div class="panel">
          <div class="panel-head"><h3>Event Details</h3></div>
          <div class="panel-body">
            <div style="font-size:.78rem;color:var(--text-light);margin-bottom:4px;">Date</div>
            <div style="font-size:.86rem;font-weight:600;margin-bottom:12px;">@_event.Date.ToString("MMMM d, yyyy")</div>

            @if (_event.TicketPrice.HasValue && _event.TicketPrice > 0)
            {
              <div style="font-size:.78rem;color:var(--text-light);margin-bottom:4px;">Ticket Price</div>
              <div style="font-size:.86rem;margin-bottom:12px;">@_event.TicketPrice.Value.ToString("C0")</div>
            }

            @if (_event.Capacity.HasValue)
            {
              <div style="font-size:.78rem;color:var(--text-light);margin-bottom:4px;">Capacity</div>
              <div style="font-size:.86rem;margin-bottom:12px;">@_event.Capacity</div>
            }

            @if (_event.GoalAmount > 0)
            {
              <div style="font-size:.78rem;color:var(--text-light);margin-bottom:4px;">Revenue Goal</div>
              <div style="font-size:.86rem;margin-bottom:12px;">@_event.GoalAmount!.Value.ToString("C0")</div>
              <div style="background:var(--bg);border-radius:6px;height:8px;overflow:hidden;">
                <div style="height:100%;width:@(Math.Min(100m, _revenue.Total / _event.GoalAmount!.Value * 100m).ToString("F0"))%;background:var(--green);border-radius:6px;"></div>
              </div>
            }

            <div style="margin-top:14px;display:flex;gap:8px;flex-wrap:wrap;">
              <a href="/admin/events/@Id/attendees" class="btn btn-sm">View Attendees</a>
              @if (_event.Status != EventStatus.Cancelled)
              {
                <a href="/admin/events/@Id/auction" class="btn btn-sm">Auction Items</a>
              }
            </div>
          </div>
        </div>
      }
    </div>
  }
  else
  {
    <div class="panel">
      <div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">No revenue data available for this event.</div>
    </div>
  }
}

@code {
  [Parameter] public int Id { get; set; }

  private MinistryEvent? _event;
  private EventRevenueDto? _revenue;
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var eventTask   = Api.GetEventAsync(Id);
    var revenueTask = Api.GetEventRevenueAsync(Id);
    await Task.WhenAll(eventTask, revenueTask);
    _event   = await eventTask;
    _revenue = await revenueTask;
    _loading = false;
  }
}
