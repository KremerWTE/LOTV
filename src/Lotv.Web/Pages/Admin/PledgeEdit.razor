@page "/admin/pledges/{Id:int}/edit"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Edit Pledge — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Edit Pledge</h2><p>Pledge #@Id</p></div>
  <div class="page-hd-actions">
    <a href="/admin/pledges/@Id" class="btn btn-sm">← Pledge Detail</a>
    <a href="/admin/pledges" class="btn btn-sm">All Pledges</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_pledge is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Pledge #@Id not found.</div></div>
}
else
{
  @if (_saved)
  {
    <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--green);font-weight:600;">Pledge updated. <a href="/admin/pledges/@Id" style="color:var(--green);">View detail →</a></div>
    </div>
  }
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  <div style="max-width:640px;">
    <div class="panel">
      <div class="panel-head"><h3>Pledge Details</h3></div>
      <div class="panel-body">
        <div style="margin-bottom:14px;padding:10px 12px;background:var(--bg);border-radius:6px;font-size:.82rem;">
          Donor: <strong>@(_pledge.Donor?.FullName ?? $"Donor #{_pledge.DonorId}")</strong>
        </div>

        <div class="form-group">
          <label class="form-label">Pledged Amount *</label>
          <input class="form-input" type="number" step="50" min="1" @bind="_pledgedAmount" />
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Target Date *</label>
          <input class="form-input" type="date" @bind="_targetDate" />
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Campaign / Fund</label>
          <input class="form-input" @bind="_campaign" placeholder="General Fund" />
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Status</label>
          <select class="form-input" @bind="_status">
            @foreach (var s in Enum.GetValues<PledgeStatus>())
            {
              <option value="@s">@s</option>
            }
          </select>
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Notes</label>
          <textarea class="form-input" rows="3" @bind="_notes" placeholder="Internal notes…"></textarea>
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
          <a href="/admin/pledges/@Id" class="btn btn-sm">Cancel</a>
          <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save Changes")</button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private DonorPledge? _pledge;
  private bool _loading = true, _busy, _saved;
  private string _error = "";
  private decimal _pledgedAmount;
  private DateTime _targetDate = DateTime.Today.AddYears(1);
  private string _campaign = "", _notes = "";
  private PledgeStatus _status;

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetPledgesAsync();
    _pledge = all.FirstOrDefault(p => p.Id == Id);
    if (_pledge is not null)
    {
      _pledgedAmount = _pledge.PledgedAmount;
      _targetDate    = _pledge.TargetDate;
      _campaign      = _pledge.Campaign ?? "";
      _notes         = _pledge.Notes ?? "";
      _status        = _pledge.Status;
    }
    _loading = false;
  }

  private async Task Save()
  {
    _error = ""; _saved = false;
    if (_pledgedAmount <= 0) { _error = "Pledged amount must be greater than 0."; return; }

    _busy = true;
    var updated = new DonorPledge
    {
      Id             = Id,
      DonorId        = _pledge!.DonorId,
      ChapterId      = _pledge.ChapterId,
      PledgedAmount  = _pledgedAmount,
      FulfilledAmount = _pledge.FulfilledAmount,
      TargetDate     = _targetDate,
      Status         = _status,
      Campaign       = string.IsNullOrWhiteSpace(_campaign) ? null : _campaign,
      Notes          = string.IsNullOrWhiteSpace(_notes) ? null : _notes,
      CreatedAt      = _pledge.CreatedAt,
      UpdatedAt      = DateTime.UtcNow,
    };
    var ok = await Api.UpdatePledgeAsync(Id, updated);
    _busy = false;
    if (ok) { _saved = true; _pledge = updated; }
    else _error = "Save failed. Please try again.";
  }
}
