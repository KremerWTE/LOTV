@page "/admin/donations"
@layout AdminLayout
@inject ApiService Api

<PageTitle>All Donations — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>All Donations</h2>
    <p>Complete donation ledger — all channels, all time</p>
  </div>
  <div class="page-hd-actions">
    <button class="btn btn-primary btn-sm" @onclick="OpenAdd">+ Record Donation</button>
    <a href="/admin/by-channel" class="btn btn-sm">By Channel</a>
    <a href="/admin/by-donor"   class="btn btn-sm">By Donor</a>
  </div>
</div>

<!-- SUMMARY STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">💸</div>
    <div class="kpi-label">Total Raised</div>
    <div class="kpi-value" style="color:var(--green)"><Money Amount="@_all.Sum(d => d.Amount)" /></div>
  </div>
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">📅</div>
    <div class="kpi-label">This Month</div>
    <div class="kpi-value" style="color:var(--navy)"><Money Amount="@_thisMonth" /></div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">⏳</div>
    <div class="kpi-label">Unallocated</div>
    <div class="kpi-value" style="color:var(--amber)"><Money Amount="@_unallocated" /></div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">🔄</div>
    <div class="kpi-label">Recurring Gifts</div>
    <div class="kpi-value" style="color:var(--gold)">@_all.Count(d => d.IsRecurring)</div>
  </div>
</div>

<!-- FILTER BAR -->
<div class="filter-bar">
  @foreach (var f in _filters)
  {
    <button class="filter-chip @(_activeFilter == f ? "active" : "")" aria-pressed="@(_activeFilter == f)" @onclick="() => _activeFilter = f">@f</button>
  }
  <input class="form-input" style="width:180px;font-size:.82rem;padding:5px 12px;" placeholder="🔍 Donor or campaign..." @bind="_search" @bind:event="oninput" />
</div>

<!-- TABLE -->
<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      @if (_selected.Count > 0)
      {
        <caption style="caption-side:top;text-align:left;background:var(--green-pale);border:1px solid var(--green);padding:8px 14px;border-radius:8px;margin-bottom:8px;">
          <span style="font-size:.84rem;">@_selected.Count selected</span>
          <button class="btn btn-sm" style="margin-left:10px;" @onclick='() => BulkSet("Allocated")'>Mark Allocated</button>
          <button class="btn btn-sm" @onclick='() => BulkSet("Unallocated")'>Mark Unallocated</button>
          <select class="form-input" style="width:auto;display:inline-block;font-size:.76rem;padding:4px 8px;margin-left:6px;" @bind="_bulkChannel">
            @foreach (var ch in Enum.GetValues<DonationChannel>())
            { <option value="@ch.ToString()">@ch</option> }
          </select>
          <button class="btn btn-sm" @onclick="BulkSetChannel">Set Channel</button>
          <button class="btn btn-sm" @onclick="() => { _selected.Clear(); _bulkError = null; }">Clear</button>
          @if (!string.IsNullOrEmpty(_bulkError))
          { <div style="color:var(--red);font-size:.78rem;margin-top:6px;">⚠ @_bulkError</div> }
        </caption>
      }
      <thead>
        <tr>
          <th style="width:24px;" title="Select all visible rows (does not include hidden rows beyond the current page)">
            <input type="checkbox" aria-label="Select all visible rows"
                   checked="@(_selected.Count > 0 && _selected.Count == Filtered.Take(_visible).Count())"
                   @onchange="@(e => ToggleAll((bool)e.Value!))" />
          </th>
          <th>#</th>
          <th>Donor</th>
          <th>Diocese</th>
          <th style="cursor:pointer;user-select:none;" @onclick='() => Sort("Amount")'>
            Amount @SortArrow("Amount")
          </th>
          <th style="cursor:pointer;user-select:none;" @onclick='() => Sort("Date")'>
            Date @SortArrow("Date")
          </th>
          <th>Channel</th>
          <th>Campaign</th>
          <th>Status</th>
          <th>Allocation</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @foreach (var d in Filtered.Take(_visible))
        {
          <tr>
            <td style="width:24px;"><input type="checkbox" checked="@_selected.Contains(d.Id)"
                @onclick="@((MouseEventArgs e) => ToggleClick(d.Id, e))" /></td>
            <td style="font-size:.74rem;color:var(--text-light);">#@d.Id</td>
            <td><strong>@(d.Donor?.FullName ?? "—")</strong></td>
            <td style="font-size:.78rem;color:var(--text-mid);">@(d.Donor?.DioceseName ?? "—")</td>
            <td style="font-weight:700;color:var(--green);"><Money Amount="@d.Amount" /></td>
            <td style="font-size:.78rem;color:var(--text-light);">@d.Date.ToString("MMM d, yyyy")</td>
            <td><span class="badge badge-new" style="font-size:.68rem;">@d.Channel</span></td>
            <td style="font-size:.78rem;color:var(--text-mid);">@(d.Campaign ?? "—")</td>
            <td>
              @switch (d.ContributionStatus)
              {
                case ContributionStatus.Processed:
                  <span class="badge badge-fulfilled" style="font-size:.68rem;">Processed</span>
                  break;
                case ContributionStatus.Pending:
                  <span class="badge badge-inprogress" style="font-size:.68rem;">Pending</span>
                  break;
                case ContributionStatus.Failed:
                  <span class="badge badge-cancelled" style="font-size:.68rem;">Failed</span>
                  break;
                default:
                  <span class="badge badge-onhold" style="font-size:.68rem;">Refunded</span>
                  break;
              }
            </td>
            <td>
              @switch (d.AllocationStatus)
              {
                case AllocationStatus.Allocated:
                  <span class="badge badge-fulfilled">Allocated</span>
                  break;
                case AllocationStatus.PendingReview:
                  <span class="badge badge-inprogress">Pending</span>
                  break;
                default:
                  <span class="badge badge-onhold">Unallocated</span>
                  break;
              }
            </td>
            <td>
              @if (d.AllocationStatus == AllocationStatus.Unallocated)
              { <button class="btn btn-sm btn-navy" @onclick="() => Allocate(d)">Allocate</button> }
            </td>
          </tr>
        }
        @if (Filtered.Count() > _visible)
        {
          <tr><td colspan="11" style="text-align:center;padding:14px;border-top:1px solid var(--border);">
            <button class="btn btn-sm" data-autoload @onclick="() => _visible += 50">Load 50 more (@(Filtered.Count() - _visible) hidden)</button>
          </td></tr>
        }
      </tbody>
    </table>
  </div>
</div>

<!-- RECORD DONATION DRAWER -->
@if (_showAdd)
{
  <div class="drawer-overlay" @onclick="CloseAdd"></div>
  <div class="drawer">
    <div class="drawer-head">
      <h3>Record Donation</h3>
      <button class="drawer-close" @onclick="CloseAdd">✕</button>
    </div>
    <div class="drawer-body">

      <div class="form-group">
        <label class="form-label">Donor *</label>
        <select class="form-input" @bind="_dDonorId">
          <option value="0">— Select existing donor —</option>
          @foreach (var d in _allDonors)
          { <option value="@d.Id">@d.FullName (@d.Email)</option> }
        </select>
        @if (_dDonorId == 0)
        {
          <input class="form-input" style="margin-top:6px;" @bind="_dDonorName" placeholder="Or type name for anonymous / new donor" />
        }
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">Amount *</label>
          <input class="form-input" type="number" step="0.01" @bind="_dAmount" placeholder="0.00" />
        </div>
        <div class="form-group">
          <label class="form-label">Date *</label>
          <input class="form-input" type="date" @bind="_dDate" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Channel</label>
        <select class="form-input" @bind="_dChannel">
          @foreach (var c in Enum.GetValues<DonationChannel>())
          { <option value="@c">@c.ToDisplayName()</option> }
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Campaign</label>
        <input class="form-input" @bind="_dCampaign" placeholder="e.g. Gala 2025, Year-End Appeal" />
      </div>

      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chk-recurring" @bind="_dIsRecurring" />
        <label for="chk-recurring" class="form-label" style="margin:0;">Recurring monthly gift</label>
      </div>

      <div class="form-group">
        <label class="form-label">Notes</label>
        <textarea class="form-textarea" @bind="_dNotes" placeholder="Internal notes..."></textarea>
      </div>

      @if (!string.IsNullOrEmpty(_addError))
      { <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;">⚠ @_addError</div> }

    </div>
    <div class="drawer-footer">
      <button class="btn btn-primary" @onclick="SaveDonation">Save Donation</button>
      <button class="btn" @onclick="CloseAdd">Cancel</button>
    </div>
  </div>
}

@if (_savedToast)
{
  <div style="position:fixed;bottom:24px;right:24px;background:var(--green);color:white;padding:12px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:.88rem;font-weight:600;z-index:600;">
    ✓ Donation recorded
  </div>
}

@code {
  private List<Donation> _all = [];
  private List<Donor> _allDonors = [];
  private decimal _thisMonth;
  private decimal _unallocated;
  private string _activeFilter = "All";
  private string _search = "";
  private string _sortCol = "Date";
  private bool _sortDesc = true;
  private bool _showAdd;
  private bool _savedToast;

  // Add-donation form state
  private int _dDonorId;
  private string _dDonorName = "";
  private decimal _dAmount;
  private DateTime _dDate = DateTime.Today;
  private DonationChannel _dChannel = DonationChannel.Online;
  private string _dCampaign = "";
  private bool _dIsRecurring;
  private string _dNotes = "";
  private string _addError = "";
  private int _visible = 50;
  private HashSet<int> _selected = new();
  private int _lastSelectedId;

  private void ToggleClick(int id, MouseEventArgs e)
  {
    var visible = Filtered.Take(_visible).Select(d => d.Id).ToList();
    if (e.ShiftKey && _lastSelectedId != 0 && visible.Contains(_lastSelectedId))
    {
      var i1 = visible.IndexOf(_lastSelectedId);
      var i2 = visible.IndexOf(id);
      if (i1 >= 0 && i2 >= 0)
      {
        var (lo, hi) = i1 <= i2 ? (i1, i2) : (i2, i1);
        for (var k = lo; k <= hi; k++) _selected.Add(visible[k]);
      }
    }
    else
    {
      if (_selected.Contains(id)) _selected.Remove(id); else _selected.Add(id);
    }
    _lastSelectedId = id;
  }
  private void ToggleAll(bool on)
  {
    _selected.Clear();
    if (on) foreach (var d in Filtered.Take(_visible)) _selected.Add(d.Id);
  }
  private string? _bulkError;
  private async Task BulkSet(string status)
  {
    var n = await Api.BulkAllocateAsync(_selected.ToArray(), status);
    if (n > 0) { _bulkError = null; _selected.Clear(); _all = await Api.GetDonationsAsync(); }
    else { _bulkError = $"Failed to update {_selected.Count} donation(s). Please try again."; }
  }

  private string _bulkChannel = nameof(DonationChannel.Online);
  private async Task BulkSetChannel()
  {
    var n = await Api.BulkChannelAsync(_selected.ToArray(), _bulkChannel);
    if (n > 0) { _bulkError = null; _selected.Clear(); _all = await Api.GetDonationsAsync(); }
    else { _bulkError = $"Failed to update channel for {_selected.Count} donation(s). Please try again."; }
  }

  private readonly string[] _filters = ["All", "This Month", "Online", "Check", "Gala", "Unallocated", "Recurring", "One-time"];

  private IEnumerable<Donation> Filtered
  {
    get
    {
      var now = DateTime.UtcNow;
      var q = _all.Where(d =>
      {
        var matchFilter = _activeFilter switch
        {
          "This Month" => d.Date.Year == now.Year && d.Date.Month == now.Month,
          "Online"     => d.Channel == DonationChannel.Online,
          "Check"      => d.Channel == DonationChannel.Check,
          "Gala"       => d.Channel == DonationChannel.Gala,
          "Unallocated"=> d.AllocationStatus == AllocationStatus.Unallocated,
          "Recurring"  => d.IsRecurring,
          "One-time"   => !d.IsRecurring,
          _            => true
        };
        var matchSearch = string.IsNullOrEmpty(_search) ||
          (d.Donor?.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
          (d.Campaign?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
        return matchFilter && matchSearch;
      });
      return (_sortCol, _sortDesc) switch
      {
        ("Amount", true)  => q.OrderByDescending(d => d.Amount),
        ("Amount", false) => q.OrderBy(d => d.Amount),
        (_, true)         => q.OrderByDescending(d => d.Date),
        _                 => q.OrderBy(d => d.Date),
      };
    }
  }

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    var now = DateTime.UtcNow;
    _allDonors   = await Api.GetDonorsAsync();
    var donorMap = _allDonors.ToDictionary(d => d.Id);
    _all = (await Api.GetDonationsAsync())
      .Select(d => { if (donorMap.TryGetValue(d.DonorId, out var donor)) d.Donor = donor; return d; })
      .ToList();
    _thisMonth   = _all.Where(d => d.Date.Year == now.Year && d.Date.Month == now.Month).Sum(d => d.Amount);
    _unallocated = _all.Where(d => d.AllocationStatus == AllocationStatus.Unallocated).Sum(d => d.Amount);
  }

  private void OpenAdd()
  {
    _dDonorId    = 0;
    _dDonorName  = "";
    _dAmount     = 0;
    _dDate       = DateTime.Today;
    _dChannel    = DonationChannel.Online;
    _dCampaign   = "";
    _dIsRecurring = false;
    _dNotes      = "";
    _addError    = "";
    _showAdd     = true;
  }

  private void CloseAdd() { _showAdd = false; _addError = ""; }

  private async Task SaveDonation()
  {
    if (_dAmount <= 0) { _addError = "Amount must be greater than zero."; return; }
    if (_dDonorId == 0 && string.IsNullOrWhiteSpace(_dDonorName))
    { _addError = "Select an existing donor or enter a donor name."; return; }

    int donorId = _dDonorId;

    if (donorId == 0)
    {
      var parts = _dDonorName.Trim().Split(' ', 2);
      var newDonor = new Donor
      {
        FirstName = parts[0], LastName = parts.Length > 1 ? parts[1] : "",
        FirstGiftDate = _dDate, LastGiftDate = _dDate
      };
      var created = await Api.CreateDonorAsync(newDonor);
      if (created is null) { _addError = "Failed to create donor record."; return; }
      donorId = created.Id;
    }

    var donation = new Donation
    {
      DonorId = donorId, Amount = _dAmount, Date = _dDate,
      Channel = _dChannel,
      Campaign = string.IsNullOrWhiteSpace(_dCampaign) ? null : _dCampaign,
      IsRecurring = _dIsRecurring,
      Notes = string.IsNullOrWhiteSpace(_dNotes) ? null : _dNotes,
      AllocationStatus = AllocationStatus.Unallocated
    };
    await Api.CreateDonationAsync(donation);

    _showAdd = false;
    await LoadAsync();
    _savedToast = true;
    StateHasChanged();
    await Task.Delay(2500);
    _savedToast = false;
  }

  private async Task Allocate(Donation d)
  {
    d.AllocationStatus = AllocationStatus.PendingReview;
    await Api.UpdateDonationAsync(d.Id, d);
    await LoadAsync();
    _savedToast = true;
    StateHasChanged();
    await Task.Delay(2500);
    _savedToast = false;
  }

  private void Sort(string col)
  {
    if (_sortCol == col) _sortDesc = !_sortDesc;
    else { _sortCol = col; _sortDesc = true; }
  }

  private string SortArrow(string col) =>
    _sortCol != col ? "↕" : _sortDesc ? "↓" : "↑";
}
