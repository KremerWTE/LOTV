@page "/admin/donors/{DonorId:int}/pledges"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Donor Pledges — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Donor Pledges</h2><p>@(_donor?.FullName ?? $"Donor #{DonorId}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors/@DonorId" class="btn btn-sm">← Donor Profile</a>
    <a href="/admin/pledges/new" class="btn btn-sm btn-primary">+ New Pledge</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <!-- KPIs -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📋</div>
      <div class="kpi-label">Total Pledges</div>
      <div class="kpi-value" style="color:var(--navy)">@_pledges.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">💰</div>
      <div class="kpi-label">Total Pledged</div>
      <div class="kpi-value" style="color:var(--green)">@_pledges.Sum(p => p.PledgedAmount).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Total Fulfilled</div>
      <div class="kpi-value" style="color:var(--amber)">@_pledges.Sum(p => p.FulfilledAmount).ToString("C0")</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">⏳</div>
      <div class="kpi-label">Open Pledges</div>
      <div class="kpi-value">@_pledges.Count(p => p.Status == PledgeStatus.Active || p.Status == PledgeStatus.Overdue)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Pledges (@_pledges.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      @if (!_pledges.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No pledges on file for this donor.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Target Date</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Pledged</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Fulfilled</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Remaining</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Campaign</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var p in _pledges.OrderByDescending(p => p.CreatedAt))
            {
              <tr style="border-top:1px solid var(--border);@(p.IsOverdue ? "background:#fffbeb;" : "")">
                <td style="padding:10px 16px;font-size:.84rem;@(p.IsOverdue ? "color:var(--red);font-weight:600;" : "")">
                  @p.TargetDate.ToString("MMM d, yyyy")@(p.IsOverdue ? " ⚠" : "")
                </td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--navy);">@p.PledgedAmount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.88rem;text-align:right;color:var(--green);">@p.FulfilledAmount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.88rem;text-align:right;color:@(p.RemainingAmount > 0 ? "var(--amber)" : "var(--green)");">@p.RemainingAmount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(p.Campaign ?? "—")</td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@StatusBadge(p.Status)" style="font-size:.68rem;">@p.Status</span>
                </td>
                <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                  <a href="/admin/pledges/@p.Id/payment" style="font-size:.78rem;color:var(--green);margin-right:6px;">Pay</a>
                  <a href="/admin/pledges/@p.Id/edit" style="font-size:.78rem;color:var(--navy);">Edit</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int DonorId { get; set; }

  private Lotv.Core.Models.Donor? _donor;
  private List<DonorPledge> _pledges = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var donorTask  = Api.GetDonorAsync(DonorId);
    var pledgeTask = Api.GetPledgesAsync();
    await Task.WhenAll(donorTask, pledgeTask);
    _donor   = await donorTask;
    var all  = await pledgeTask;
    _pledges = all.Where(p => p.DonorId == DonorId).ToList();
    _loading = false;
  }

  private static string StatusBadge(PledgeStatus s) => s switch
  {
    PledgeStatus.Active    => "new",
    PledgeStatus.Fulfilled => "fulfilled",
    PledgeStatus.Overdue   => "pending",
    PledgeStatus.Cancelled => "cancelled",
    PledgeStatus.Lapsed    => "cancelled",
    _                      => "new"
  };
}
