@page "/admin/chapters/{Id:int}/campaigns"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Campaigns — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Campaigns</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/campaigns" class="btn btn-sm">All Campaigns</a>
    <a href="/admin/campaigns/new" class="btn btn-sm btn-primary">+ New Campaign</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">🎯</div>
      <div class="kpi-label">Campaigns</div>
      <div class="kpi-value" style="color:var(--navy)">@_campaigns.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">💰</div>
      <div class="kpi-label">Total Raised</div>
      <div class="kpi-value" style="color:var(--green)">@_campaigns.Sum(c => c.Raised).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Total Goal</div>
      <div class="kpi-value" style="color:var(--amber)">@_campaigns.Where(c => c.GoalAmount > 0).Sum(c => c.GoalAmount).ToString("C0")</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">✅</div>
      <div class="kpi-label">Active</div>
      <div class="kpi-value" style="color:var(--green)">@_campaigns.Count(c => c.Status == "Active")</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Campaigns (@_campaigns.Count)</h3>
      <select class="form-input" style="width:160px;font-size:.82rem;padding:5px 10px;" @bind="_filter">
        <option value="all">All</option>
        <option value="Active">Active</option>
        <option value="Completed">Completed</option>
        <option value="Draft">Draft</option>
      </select>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!Filtered.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No campaigns match.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Campaign</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Raised</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Goal</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Progress</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var c in Filtered)
            {
              var pct = c.GoalAmount > 0 ? Math.Min(100m, c.Raised / c.GoalAmount * 100m) : 0m;
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/campaigns/@c.Id" style="color:var(--navy);">@c.Name</a>
                </td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@c.Raised.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.82rem;text-align:right;color:var(--text-light);">@(c.GoalAmount > 0 ? c.GoalAmount.ToString("C0") : "—")</td>
                <td style="padding:10px 16px;min-width:140px;">
                  @if (c.GoalAmount > 0)
                  {
                    <div style="background:var(--border);border-radius:4px;height:6px;overflow:hidden;margin-bottom:2px;">
                      <div style="background:var(--green);height:6px;width:@pct.ToString("F1")%;"></div>
                    </div>
                    <div style="font-size:.72rem;color:var(--text-light);">@pct.ToString("F0")%</div>
                  }
                  else
                  {
                    <span style="color:var(--text-light);font-size:.78rem;">No goal set</span>
                  }
                </td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@StatusClass(c.Status)" style="font-size:.68rem;">@c.Status</span>
                </td>
                <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                  <a href="/admin/campaigns/@c.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                  <span style="color:var(--border);margin:0 4px;">|</span>
                  <a href="/admin/campaigns/@c.Id/donations" style="font-size:.78rem;color:var(--navy);">Gifts</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<CampaignDto> _campaigns = [];
  private string _filter = "all";
  private bool _loading = true;

  private IEnumerable<CampaignDto> Filtered => _filter == "all"
    ? _campaigns.OrderByDescending(c => c.Raised)
    : _campaigns.Where(c => c.Status == _filter).OrderByDescending(c => c.Raised);

  protected override async Task OnInitializedAsync()
  {
    var chapTask = Api.GetChaptersAdminAsync();
    var campTask = Api.GetCampaignsAsync();
    await Task.WhenAll(chapTask, campTask);
    var chapters  = await chapTask;
    _chapter      = chapters.FirstOrDefault(c => c.Id == Id);
    var all       = await campTask;
    _campaigns    = all.Where(c => c.ChapterId == Id).ToList();
    _loading = false;
  }

  private static string StatusClass(string status) => status switch
  {
    "Active"    => "new",
    "Completed" => "fulfilled",
    "Draft"     => "onhold",
    "Paused"    => "onhold",
    _           => "new"
  };
}
