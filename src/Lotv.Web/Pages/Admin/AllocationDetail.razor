@page "/admin/allocations/{Id:int}"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Allocation Detail — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Allocation Detail</h2><p>Allocation #@Id</p></div>
  <div class="page-hd-actions">
    <a href="/admin/allocations" class="btn btn-sm">← Allocations</a>
    @if (_alloc is not null)
    {
      <a href="/admin/allocations/@Id/edit" class="btn btn-sm">Edit</a>
    }
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_alloc is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Allocation #@Id not found.</div></div>
}
else
{
  <!-- Amount KPI -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Amount</div>
      <div class="kpi-value" style="color:var(--green)">@_alloc.Amount.ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#127981;</div>
      <div class="kpi-label">Status</div>
      <div class="kpi-value" style="font-size:1rem;color:var(--navy)">@_alloc.Status</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">&#128197;</div>
      <div class="kpi-label">Created</div>
      <div class="kpi-value" style="font-size:.9rem;">@_alloc.CreatedAt.ToString("MMM d, yyyy")</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Allocation Details</h3></div>
    <div class="panel-body">
      <table style="width:100%;border-collapse:collapse;">
        @Row("ID", $"#{_alloc.Id}")
        @Row("Donation ID", $"#{_alloc.DonationId}")
        @Row("Allocated To", _alloc.AllocatedTo)
        @Row("Amount", _alloc.Amount.ToString("C0"))
        @Row("Status", _alloc.Status.ToString())
        @if (_alloc.ApprovedBy is not null)
        {
          @Row("Approved By", _alloc.ApprovedBy)
          @Row("Approved At", _alloc.ApprovedAt?.ToString("MMM d, yyyy h:mm tt") ?? "—")
        }
        @if (!string.IsNullOrEmpty(_alloc.Notes))
        {
          @Row("Notes", _alloc.Notes)
        }
        @Row("Created", _alloc.CreatedAt.ToString("MMM d, yyyy"))
      </table>
    </div>
  </div>

  @if (_alloc.Donation is not null)
  {
    <div class="panel" style="margin-top:16px;">
      <div class="panel-head"><h3>Linked Donation</h3></div>
      <div class="panel-body" style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;">
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Donor</div>
          <div style="font-weight:700;"><a href="/admin/donors/@_alloc.Donation.DonorId" style="color:var(--navy);">@(_alloc.Donation.Donor?.FullName ?? $"Donor #{_alloc.Donation.DonorId}")</a></div>
        </div>
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Date</div>
          <div style="font-size:.84rem;">@_alloc.Donation.Date.ToString("MMM d, yyyy")</div>
        </div>
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Gift Amount</div>
          <div style="font-weight:700;color:var(--green);">@_alloc.Donation.Amount.ToString("C0")</div>
        </div>
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Channel</div>
          <div style="font-size:.84rem;">@_alloc.Donation.Channel.ToDisplayName()</div>
        </div>
        <a href="/admin/donations/@_alloc.DonationId" class="btn btn-sm" style="margin-left:auto;">View Donation</a>
      </div>
    </div>
  }
}

@code {
  [Parameter] public int Id { get; set; }

  private FundAllocation? _alloc;
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetAllocationsAsync();
    _alloc = all.FirstOrDefault(a => a.Id == Id);
    _loading = false;
  }

  private RenderFragment Row(string label, string value) => __builder =>
  {
    __builder.OpenElement(0, "tr");
    __builder.AddAttribute(1, "style", "border-bottom:1px solid var(--border);");
    __builder.OpenElement(2, "td");
    __builder.AddAttribute(3, "style", "padding:10px 16px;font-size:.78rem;color:var(--text-light);width:160px;font-weight:600;");
    __builder.AddContent(4, label);
    __builder.CloseElement();
    __builder.OpenElement(5, "td");
    __builder.AddAttribute(6, "style", "padding:10px 16px;font-size:.84rem;");
    __builder.AddContent(7, value);
    __builder.CloseElement();
    __builder.CloseElement();
  };
}
