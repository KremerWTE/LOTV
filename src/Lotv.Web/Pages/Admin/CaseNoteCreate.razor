@page "/admin/cases/{Id:int}/notes/new"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Add Case Note — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Add Case Note</h2><p>Case #@Id</p></div>
  <div class="page-hd-actions">
    <a href="/admin/cases/@Id" class="btn btn-sm">← Case Detail</a>
  </div>
</div>

@if (_saved)
{
  <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--green);font-weight:600;">
      Note added. <a href="/admin/cases/@Id" style="color:var(--green);">Back to case →</a>
    </div>
  </div>
}
@if (!string.IsNullOrEmpty(_error))
{
  <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--red);">@_error</div>
  </div>
}

<div style="max-width:580px;">
  <div class="panel">
    <div class="panel-head"><h3>New Note</h3></div>
    <div class="panel-body">
      <div class="form-group">
        <label class="form-label">Note *</label>
        <textarea class="form-input" rows="6" @bind="_content"
                  placeholder="Describe the contact, update, or action taken…"></textarea>
      </div>

      <div class="form-group" style="margin-top:12px;display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chkInternal" @bind="_isInternal" style="width:16px;height:16px;" />
        <label for="chkInternal" style="font-size:.84rem;cursor:pointer;">
          Internal note (staff-only, not visible to family or volunteer)
        </label>
      </div>

      <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
        <a href="/admin/cases/@Id" class="btn btn-sm">Cancel</a>
        <button class="btn btn-primary" @onclick="Submit" disabled="@_busy">@(_busy ? "Saving…" : "Add Note")</button>
      </div>
    </div>
  </div>
</div>

@code {
  [Parameter] public int Id { get; set; }

  private string _content = "";
  private bool _isInternal = true, _busy, _saved;
  private string _error = "";

  private async Task Submit()
  {
    _error = "";
    if (string.IsNullOrWhiteSpace(_content)) { _error = "Note content is required."; return; }

    _busy = true;
    var ok = await Api.AddRequestNoteAsync(Id, _content, _isInternal);
    _busy = false;
    if (ok) { _saved = true; _content = ""; }
    else _error = "Failed to save note. Please try again.";
  }
}
