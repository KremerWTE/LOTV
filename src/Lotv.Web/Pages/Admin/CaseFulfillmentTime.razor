@page "/admin/cases/fulfillment-time"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Case Fulfillment Time — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Fulfillment Time Analysis</h2><p>How long cases take from open to fulfilled, by reason and volunteer</p></div>
  <div class="page-hd-actions">
    <a href="/admin/cases" class="btn btn-sm">← All Cases</a>
    <a href="/admin/cases/by-reason" class="btn btn-sm">By Reason</a>
    <a href="/admin/cases/heat-map" class="btn btn-sm">Heat Map</a>
    <a href="/admin/workload" class="btn btn-sm">Workload</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Calculating fulfillment times…" />
}
else if (!_fulfilled.Any())
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">No fulfilled cases to analyze yet.</div></div>
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">☑</div>
      <div class="kpi-label">Fulfilled Cases</div>
      <div class="kpi-value" style="color:var(--green)">@_fulfilled.Count</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">🕐</div>
      <div class="kpi-label">Avg Days to Fulfill</div>
      <div class="kpi-value" style="color:var(--navy)">@_avgDays</div>
      <div class="kpi-change">all fulfilled cases</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">⚡</div>
      <div class="kpi-label">Fastest (Median)</div>
      <div class="kpi-value" style="color:var(--green)">@_medianDays d</div>
      <div class="kpi-change">50th percentile</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">🚫</div>
      <div class="kpi-label">Slowest 10%</div>
      <div class="kpi-value" style="color:var(--amber)">@_p90Days d</div>
      <div class="kpi-change">90th percentile</div>
    </div>
  </div>

  <!-- BY REASON -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">
      <h3>Average Days by Reason</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Lower is faster — target ≤ 14 days</span>
    </div>
    <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
      @{ var maxR = _byReason.Any() ? _byReason.Max(r => r.AvgDays) : 1.0; }
      @foreach (var r in _byReason.OrderBy(r => r.AvgDays))
      {
        var pct   = maxR > 0 ? (int)(r.AvgDays * 100.0 / maxR) : 0;
        var color = r.AvgDays <= 7 ? "var(--green)" : r.AvgDays <= 14 ? "var(--amber)" : "var(--red)";
        <div>
          <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:4px;">
            <span style="font-weight:600;">@r.Reason</span>
            <span style="font-weight:700;color:@color;">@r.AvgDays d avg · @r.Count cases</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width:@pct%;background:@color;"></div>
          </div>
        </div>
      }
    </div>
  </div>

  <!-- BY VOLUNTEER + DISTRIBUTION -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

    <!-- TOP VOLUNTEERS BY SPEED -->
    <div class="panel">
      <div class="panel-head">
        <h3>Fastest Volunteers (avg days)</h3>
        <a href="/admin/volunteers/leaderboard" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">Leaderboard &rarr;</a>
      </div>
      <div class="panel-body" style="padding:0;">
        <table class="data-table">
          <thead><tr><th>Volunteer</th><th>Fulfilled</th><th>Avg Days</th><th>Rating</th></tr></thead>
          <tbody>
            @foreach (var v in _byVolunteer.OrderBy(v => v.AvgDays).Take(10))
            {
              <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/volunteers/{v.VolunteerId}/impact")'>
                <td style="font-weight:600;">@v.Name</td>
                <td>@v.Count</td>
                <td style="font-weight:700;color:@(v.AvgDays <= 7 ? "var(--green)" : v.AvgDays <= 14 ? "var(--amber)" : "var(--red)");">@v.AvgDays d</td>
                <td>
                  @for (int i = 0; i < Math.Min(5, (int)(10.0 / Math.Max(v.AvgDays, 1))); i++)
                  {
                    <span style="color:var(--gold);font-size:.8rem;">★</span>
                  }
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- DURATION DISTRIBUTION -->
    <div class="panel">
      <div class="panel-head"><h3>Duration Distribution</h3></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:8px;">
        @foreach (var b in _distBuckets)
        {
          var pct = _fulfilled.Any() ? (int)(b.Count * 100.0 / _fulfilled.Count) : 0;
          <div>
            <div style="display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:3px;">
              <span style="font-weight:600;">@b.Label</span>
              <span style="color:var(--text-mid);">@b.Count cases (@pct%)</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width:@pct%;background:@b.Color;"></div>
            </div>
          </div>
        }
      </div>
    </div>

  </div>

  <!-- SLOWEST CASES -->
  <div class="panel">
    <div class="panel-head">
      <h3>Slowest Fulfilled Cases (top 15)</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Review for process improvements</span>
    </div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead><tr><th>Family</th><th>Reason</th><th>Assigned To</th><th>Days Taken</th><th>Fulfilled</th></tr></thead>
        <tbody>
          @foreach (var c in _fulfilled.OrderByDescending(c => (c.UpdatedAt - c.CreatedAt).TotalDays).Take(15))
          {
            var days = (int)(c.UpdatedAt - c.CreatedAt).TotalDays;
            <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/cases/{c.Id}")'>
              <td><strong>@c.Family?.FullName</strong></td>
              <td style="font-size:.78rem;color:var(--text-mid);">@c.Reason.ToDisplayName()</td>
              <td style="font-size:.78rem;color:var(--text-mid);">@(c.AssignedTo ?? "—")</td>
              <td style="font-weight:700;color:@(days > 21 ? "var(--red)" : days > 14 ? "var(--amber)" : "var(--green)");">@days d</td>
              <td style="font-size:.74rem;color:var(--text-light);">@c.UpdatedAt.ToString("MMM d, yyyy")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private record ReasonRow(string Reason, double AvgDays, int Count);
  private record VolRow(int VolunteerId, string Name, double AvgDays, int Count);
  private record DistBucket(string Label, int Count, string Color);

  private bool _loading = true;
  private List<PackageRequest> _fulfilled = [];
  private double _avgDays, _medianDays, _p90Days;
  private List<ReasonRow> _byReason = [];
  private List<VolRow> _byVolunteer = [];
  private List<DistBucket> _distBuckets = [];

  protected override async Task OnInitializedAsync()
  {
    var all     = await Api.GetRequestsAsync();
    _fulfilled  = all.Where(c => c.Status == CaseStatus.Fulfilled).ToList();

    if (!_fulfilled.Any()) { _loading = false; return; }

    var durations = _fulfilled.Select(c => (c.UpdatedAt - c.CreatedAt).TotalDays).OrderBy(d => d).ToList();
    _avgDays    = Math.Round(durations.Average(), 1);
    _medianDays = (int)durations[durations.Count / 2];
    _p90Days    = (int)durations[(int)(durations.Count * 0.9)];

    _byReason = _fulfilled
      .GroupBy(c => c.Reason)
      .Select(g => new ReasonRow(
          g.Key.ToDisplayName(),
          Math.Round(g.Average(c => (c.UpdatedAt - c.CreatedAt).TotalDays), 1),
          g.Count()))
      .ToList();

    _byVolunteer = _fulfilled
      .Where(c => !string.IsNullOrWhiteSpace(c.AssignedTo) && c.AssignedToId.HasValue)
      .GroupBy(c => (Id: c.AssignedToId!.Value, Name: c.AssignedTo!))
      .Select(g => new VolRow(
          g.Key.Id,
          g.Key.Name,
          Math.Round(g.Average(c => (c.UpdatedAt - c.CreatedAt).TotalDays), 1),
          g.Count()))
      .Where(v => v.Count >= 2)
      .ToList();

    _distBuckets =
    [
      new("≤ 3 days",   _fulfilled.Count(c => (c.UpdatedAt - c.CreatedAt).TotalDays <= 3),  "var(--green)"),
      new("4 – 7 days", _fulfilled.Count(c => (c.UpdatedAt - c.CreatedAt).TotalDays is > 3 and <= 7),  "var(--green)"),
      new("8 – 14 days",_fulfilled.Count(c => (c.UpdatedAt - c.CreatedAt).TotalDays is > 7 and <= 14), "var(--amber)"),
      new("15 – 21 days",_fulfilled.Count(c => (c.UpdatedAt - c.CreatedAt).TotalDays is > 14 and <= 21),"var(--amber)"),
      new("> 21 days",  _fulfilled.Count(c => (c.UpdatedAt - c.CreatedAt).TotalDays > 21), "var(--red)"),
    ];

    _loading = false;
  }
}
