@page "/admin/cases/heat-map"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Cases Heat Map — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Cases Heat Map</h2>
    <p>Priority × status matrix — find bottlenecks at a glance</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/cases" class="btn btn-sm">← All Cases</a>
    <a href="/admin/cases/by-chapter" class="btn btn-sm">By Chapter</a>
    <a href="/admin/cases/by-priority" class="btn btn-sm">By Priority</a>
    <a href="/admin/kanban" class="btn btn-sm">Kanban</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Building heat map…" />
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-red">
      <div class="kpi-icon">&#128680;</div>
      <div class="kpi-label">Urgent Open</div>
      <div class="kpi-value" style="color:var(--red)">@_cases.Count(c => c.Priority == RequestPriority.Urgent && IsOpen(c))</div>
      <div class="kpi-change change-down">highest priority</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#9203;</div>
      <div class="kpi-label">Overdue</div>
      <div class="kpi-value" style="color:var(--amber)">@_cases.Count(c => c.IsOverdue && IsOpen(c))</div>
      <div class="kpi-change change-down">past due date</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128203;</div>
      <div class="kpi-label">In Progress</div>
      <div class="kpi-value" style="color:var(--navy)">@_cases.Count(c => c.Status == CaseStatus.InProgress)</div>
      <div class="kpi-change">being worked on</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#9745;</div>
      <div class="kpi-label">Fulfilled (30d)</div>
      <div class="kpi-value" style="color:var(--green)">@_cases.Count(c => c.Status == CaseStatus.Fulfilled && c.UpdatedAt >= DateTime.UtcNow.AddDays(-30))</div>
      <div class="kpi-change change-up">last 30 days</div>
    </div>
  </div>

  <!-- HEAT MAP MATRIX -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">
      <h3>Priority × Status Matrix</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Click any cell to filter cases</span>
    </div>
    <div class="panel-body" style="overflow-x:auto;">
      @{
        var statuses   = new[] { CaseStatus.New, CaseStatus.InProgress, CaseStatus.AwaitingShipment, CaseStatus.Shipped, CaseStatus.OnHold };
        var priorities = new[] { RequestPriority.Urgent, RequestPriority.High, RequestPriority.Normal, RequestPriority.Low };
      }
      <table style="width:100%;border-collapse:collapse;min-width:520px;">
        <thead>
          <tr>
            <th style="padding:10px 14px;text-align:left;font-size:.74rem;color:var(--text-light);border-bottom:2px solid var(--border);">Priority</th>
            @foreach (var s in statuses)
            {
              <th style="padding:10px 14px;text-align:center;font-size:.74rem;color:var(--text-light);border-bottom:2px solid var(--border);">@s.ToString()</th>
            }
            <th style="padding:10px 14px;text-align:center;font-size:.74rem;color:var(--text-light);border-bottom:2px solid var(--border);">Total</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var p in priorities)
          {
            var rowTotal = statuses.Sum(s => Count(p, s));
            <tr>
              <td style="padding:10px 14px;border-bottom:1px solid var(--border);font-weight:700;color:@PriorityColor(p);white-space:nowrap;">
                @PriorityIcon(p) @p.ToString()
              </td>
              @foreach (var s in statuses)
              {
                var n   = Count(p, s);
                var heat = HeatColor(n, _maxCell);
                <td style="padding:0;border-bottom:1px solid var(--border);text-align:center;">
                  <button style="width:100%;padding:12px 8px;background:@heat;border:none;cursor:pointer;font-size:.9rem;font-weight:700;color:@(n == 0 ? "var(--text-light)" : "var(--text-dark)");"
                          @onclick='() => DrillDown(p, s)' title="@n case@(n == 1 ? "" : "s") — @p.ToString() / @s.ToString()">
                    @(n == 0 ? "—" : n.ToString())
                  </button>
                </td>
              }
              <td style="padding:10px 14px;border-bottom:1px solid var(--border);text-align:center;font-weight:700;color:var(--navy);">@rowTotal</td>
            </tr>
          }
          <!-- TOTALS ROW -->
          <tr style="background:var(--bg);">
            <td style="padding:10px 14px;font-weight:700;font-size:.78rem;color:var(--text-light);">TOTAL</td>
            @foreach (var s in statuses)
            {
              var colTotal = priorities.Sum(p => Count(p, s));
              <td style="padding:10px 14px;text-align:center;font-weight:700;font-size:.88rem;color:var(--navy);">@colTotal</td>
            }
            <td style="padding:10px 14px;text-align:center;font-weight:700;font-size:.88rem;color:var(--green);">@_cases.Count(c => IsOpen(c))</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- DRILL-DOWN RESULT -->
  @if (_drillLabel is not null)
  {
    <div class="panel" style="margin-bottom:20px;">
      <div class="panel-head">
        <h3>@_drillLabel (@_drillCases.Count)</h3>
        <button class="btn btn-sm" @onclick="ClearDrill">Clear Filter ✕</button>
      </div>
      <div class="panel-body" style="padding:0;">
        <table class="data-table">
          <thead><tr><th>Family</th><th>Reason</th><th>Assigned To</th><th>Due Date</th><th></th></tr></thead>
          <tbody>
            @foreach (var c in _drillCases.Take(25))
            {
              <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/cases/{c.Id}")'>
                <td>
                  <strong>@c.Family?.FullName</strong>
                  @if (c.IsOverdue) { <span class="badge badge-overdue" style="margin-left:4px;font-size:.6rem;">Overdue</span> }
                </td>
                <td style="font-size:.78rem;color:var(--text-mid);">@c.Reason.ToDisplayName()</td>
                <td style="font-size:.78rem;color:var(--text-mid);">@(c.AssignedTo ?? "Unassigned")</td>
                <td style="font-size:.74rem;color:@(c.DueDate < DateTime.UtcNow ? "var(--red)" : "var(--text-light)");">
                  @(c.DueDate.HasValue ? c.DueDate.Value.ToString("MMM d") : "—")
                </td>
                <td><span class="badge @StatusBadge(c.Status)">@c.Status</span></td>
              </tr>
            }
          </tbody>
        </table>
        @if (_drillCases.Count > 25)
        {
          <div style="padding:12px 18px;font-size:.8rem;color:var(--text-light);">
            Showing 25 of @_drillCases.Count — <a href="/admin/cases" style="color:var(--green);">View all cases &rarr;</a>
          </div>
        }
      </div>
    </div>
  }

  <!-- OVERDUE BY PRIORITY -->
  <div class="panel">
    <div class="panel-head">
      <h3>Overdue by Priority</h3>
      <a href="/admin/cases/overdue" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">Full Overdue List &rarr;</a>
    </div>
    <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
      @foreach (var p in new[] { RequestPriority.Urgent, RequestPriority.High, RequestPriority.Normal, RequestPriority.Low })
      {
        var n   = _cases.Count(c => c.Priority == p && c.IsOverdue && IsOpen(c));
        var pct = _cases.Any(c => c.IsOverdue && IsOpen(c))
                    ? (int)(n * 100.0 / _cases.Count(c => c.IsOverdue && IsOpen(c)))
                    : 0;
        <div>
          <div style="display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:3px;">
            <span style="font-weight:700;color:@PriorityColor(p);">@PriorityIcon(p) @p.ToString()</span>
            <span style="color:var(--text-mid);">@n overdue</span>
          </div>
          <div class="progress-bar">
            <div class="progress-fill" style="width:@pct%;background:@PriorityColor(p);"></div>
          </div>
        </div>
      }
    </div>
  </div>
}

@code {
  private bool _loading = true;
  private List<PackageRequest> _cases = [];
  private int _maxCell;
  private string? _drillLabel;
  private List<PackageRequest> _drillCases = [];

  protected override async Task OnInitializedAsync()
  {
    _cases   = await Api.GetRequestsAsync();
    _maxCell = new[] { CaseStatus.New, CaseStatus.InProgress, CaseStatus.AwaitingShipment, CaseStatus.Shipped, CaseStatus.OnHold }
      .SelectMany(s => new[] { RequestPriority.Urgent, RequestPriority.High, RequestPriority.Normal, RequestPriority.Low }
        .Select(p => Count(p, s)))
      .DefaultIfEmpty(1).Max();
    _loading = false;
  }

  private int Count(RequestPriority p, CaseStatus s) =>
      _cases.Count(c => c.Priority == p && c.Status == s);

  private static bool IsOpen(PackageRequest c) =>
      c.Status is CaseStatus.New or CaseStatus.InProgress or CaseStatus.AwaitingShipment
                or CaseStatus.Shipped or CaseStatus.OnHold;

  private void DrillDown(RequestPriority p, CaseStatus s)
  {
    _drillLabel = $"{p.ToString()} / {s.ToString()}";
    _drillCases = _cases.Where(c => c.Priority == p && c.Status == s).OrderBy(c => c.DueDate ?? DateTime.MaxValue).ToList();
  }

  private void ClearDrill() { _drillLabel = null; _drillCases = []; }

  private static string HeatColor(int n, int max)
  {
    if (n == 0)  return "transparent";
    if (max <= 0) return "#fff3cd";
    var pct = (double)n / max;
    return pct switch
    {
      > .75 => "#fee2e2",
      > .5  => "#fef3c7",
      > .25 => "#dcfce7",
      _     => "#f0fdf4"
    };
  }

  private static string PriorityColor(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "var(--red)",
    RequestPriority.High   => "var(--amber)",
    RequestPriority.Normal => "var(--navy)",
    _                      => "var(--text-light)"
  };

  private static string PriorityIcon(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "🔴",
    RequestPriority.High   => "🟠",
    RequestPriority.Normal => "🔵",
    _                      => "⚪"
  };

  private static string StatusBadge(CaseStatus s) => s switch
  {
    CaseStatus.New              => "badge-new",
    CaseStatus.InProgress       => "badge-inprogress",
    CaseStatus.AwaitingShipment => "badge-inprogress",
    CaseStatus.Shipped          => "badge-shipped",
    CaseStatus.Fulfilled        => "badge-fulfilled",
    CaseStatus.OnHold           => "badge-onhold",
    CaseStatus.Cancelled        => "badge-cancelled",
    _                           => ""
  };
}
