@page "/admin/events/summary"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Event Summary — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Event Summary</h2><p>Cross-event attendance, capacity, and revenue comparison</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events" class="btn btn-sm">← Events</a>
    <select class="form-input" style="font-size:.82rem;padding:5px 12px;width:130px;" @bind="_statusFilter" @bind:after="StateHasChanged">
      <option value="">All Statuses</option>
      @foreach (var s in Enum.GetValues<EventStatus>())
      { <option value="@s">@s</option> }
    </select>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#127880;</div>
    <div class="kpi-label">Total Events</div>
    <div class="kpi-value" style="color:var(--navy)">@_events.Count</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128100;</div>
    <div class="kpi-label">Total Registered</div>
    <div class="kpi-value" style="color:var(--green)">@_events.Sum(e => e.Registered)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#128202;</div>
    <div class="kpi-label">Avg Capacity Fill</div>
    <div class="kpi-value" style="color:var(--amber)">@AvgCapacityPct()</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#128184;</div>
    <div class="kpi-label">Est. Ticket Revenue</div>
    <div class="kpi-value" style="color:var(--gold)">@_events.Sum(e => (e.TicketPrice ?? 0) * e.Registered).ToString("C0")</div>
  </div>
</div>

<!-- FILTER CHIPS BY TYPE -->
<div class="filter-bar" style="margin-bottom:12px;">
  <button class="filter-chip @(_typeFilter == "" ? "active" : "")" @onclick='() => _typeFilter = ""'>All · @Filtered.Count()</button>
  @foreach (var t in _eventTypes)
  {
    <button class="filter-chip @(_typeFilter == t.ToString() ? "active" : "")" @onclick="() => _typeFilter = t.ToString()">
      @t · @Filtered.Count(e => e.Type == t)
    </button>
  }
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    @if (_loading)
    {
      <div style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div>
    }
    else if (!Filtered.Any())
    {
      <div style="padding:40px;text-align:center;color:var(--text-light);">No events found.</div>
    }
    else
    {
      <table class="data-table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Type</th>
            <th>Status</th>
            <th style="text-align:right;">Registered</th>
            <th style="text-align:right;">Capacity</th>
            <th style="width:140px;">Fill Rate</th>
            <th style="text-align:right;">Est. Revenue</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var e in Filtered.OrderByDescending(e => e.Date))
          {
            var fillPct = e.Capacity > 0 ? Math.Min((double)e.Registered / e.Capacity.Value * 100, 100) : 0;
            var fillColor = fillPct >= 90 ? "var(--green)" : fillPct >= 60 ? "var(--amber)" : "var(--text-mid)";
            var estRev = (e.TicketPrice ?? 0) * e.Registered;
            <tr>
              <td style="font-size:.84rem;font-weight:600;max-width:180px;overflow:hidden;text-overflow:ellipsis;">
                <a href="/admin/events/@e.Id" style="color:inherit;text-decoration:none;">@e.Title</a>
              </td>
              <td style="font-size:.76rem;color:var(--text-light);white-space:nowrap;">@e.Date.ToString("MMM d, yyyy")</td>
              <td><span class="badge badge-new" style="font-size:.6rem;">@e.Type</span></td>
              <td><span class="badge badge-@StatusBadge(e.Status)" style="font-size:.6rem;">@e.Status</span></td>
              <td style="text-align:right;font-size:.84rem;font-weight:600;">@e.Registered</td>
              <td style="text-align:right;font-size:.78rem;color:var(--text-mid);">@(e.Capacity?.ToString() ?? "—")</td>
              <td>
                @if (e.Capacity > 0)
                {
                  <div style="display:flex;align-items:center;gap:6px;">
                    <div style="flex:1;background:var(--bg);border-radius:4px;height:8px;overflow:hidden;">
                      <div style="height:100%;width:@(fillPct.ToString("F1"))%;background:@fillColor;opacity:.7;border-radius:4px;"></div>
                    </div>
                    <span style="font-size:.72rem;color:var(--text-light);width:34px;text-align:right;">@fillPct.ToString("F0")%</span>
                  </div>
                }
                else { <span style="font-size:.72rem;color:var(--text-light);">No cap.</span> }
              </td>
              <td style="text-align:right;font-size:.84rem;color:@(estRev > 0 ? "var(--green)" : "var(--text-light)");">
                @(estRev > 0 ? estRev.ToString("C0") : "—")
              </td>
            </tr>
          }
        </tbody>
        <tfoot>
          <tr style="background:var(--bg);font-weight:700;">
            <td colspan="4" style="padding:10px 14px;font-size:.82rem;">Filtered Total</td>
            <td style="padding:10px 14px;text-align:right;font-size:.84rem;">@Filtered.Sum(e => e.Registered)</td>
            <td></td>
            <td></td>
            <td style="padding:10px 14px;text-align:right;font-size:.84rem;color:var(--green);">@Filtered.Sum(e => (e.TicketPrice ?? 0) * e.Registered).ToString("C0")</td>
          </tr>
        </tfoot>
      </table>
    }
  </div>
</div>

@code {
  private List<MinistryEvent> _events = [];
  private List<EventType> _eventTypes = [];
  private string _typeFilter = "", _statusFilter = "";
  private bool _loading = true;

  private IEnumerable<MinistryEvent> Filtered => _events
    .Where(e => (string.IsNullOrEmpty(_typeFilter) || e.Type.ToString() == _typeFilter)
             && (string.IsNullOrEmpty(_statusFilter) || e.Status.ToString() == _statusFilter));

  protected override async Task OnInitializedAsync()
  {
    _events = await Api.GetEventsAsync();
    _eventTypes = _events.Select(e => e.Type).Distinct().OrderBy(t => t.ToString()).ToList();
    _loading = false;
  }

  private string AvgCapacityPct()
  {
    var withCap = _events.Where(e => e.Capacity > 0).ToList();
    if (!withCap.Any()) return "—";
    return $"{withCap.Average(e => Math.Min((double)e.Registered / e.Capacity!.Value * 100, 100)):F0}%";
  }

  private static string StatusBadge(EventStatus s) => s switch
  {
    EventStatus.Completed  => "fulfilled",
    EventStatus.Cancelled  => "cancelled",
    EventStatus.Open       => "new",
    EventStatus.Published  => "new",
    _                      => "onhold"
  };
}
