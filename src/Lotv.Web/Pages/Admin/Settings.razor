@page "/admin/settings"
@layout AdminLayout
@inject ApiService Api
@inject IJSRuntime JS

<PageTitle>Settings — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Settings</h2><p>Ministry configuration and preferences</p></div>
</div>

<div style="margin-bottom:20px;">
  <EnableNotifications />
</div>

<div class="panel" style="margin-bottom:20px;">
  <div class="panel-head"><h3>VAPID Key Pair (push notifications)</h3></div>
  <div class="panel-body">
    <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 12px;">
      Generate a VAPID key pair, then paste both values into <code>appsettings.json</code> under <code>Push:VapidPublicKey</code> and <code>Push:VapidPrivateKey</code>.
      Restart the API to take effect.
    </p>
    <button class="btn btn-primary btn-sm" type="button" @onclick="GenerateVapid" disabled="@_vapidBusy">
      @(_vapidBusy ? "Generating…" : "Generate New Key Pair")
    </button>
    @if (_vapid is not null)
    {
      <div style="margin-top:14px;display:grid;gap:10px;">
        <label class="form-label" style="margin:0;">Public key</label>
        <input class="form-input" readonly value="@_vapid.PublicKey" style="font-family:monospace;font-size:.74rem;" />
        <label class="form-label" style="margin:6px 0 0;">Private key (keep secret)</label>
        <input class="form-input" readonly value="@_vapid.PrivateKey" style="font-family:monospace;font-size:.74rem;color:var(--red);" />
      </div>
    }
    <div style="margin-top:18px;border-top:1px solid var(--border);padding-top:14px;">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 8px;">
        Download an <code>appsettings.snippet.json</code> with placeholders for all integrations (Stripe, GiveButter, SendGrid, Twilio, VAPID, JWT).
      </p>
      <button class="btn btn-sm" type="button" @onclick="DownloadAppsettings">&darr; Download appsettings.snippet.json</button>
    </div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">

  <!-- ORG INFO -->
  <div class="panel">
    <div class="panel-head"><h3>Organization Info</h3></div>
    <div class="panel-body">
      <div class="form-group">
        <label class="form-label">Ministry Name</label>
        <input class="form-input" @bind="_orgName" />
      </div>
      <div class="form-group">
        <label class="form-label">Contact Email</label>
        <input class="form-input" type="email" @bind="_orgEmail" />
      </div>
      <div class="form-group">
        <label class="form-label">Phone</label>
        <input class="form-input" @bind="_orgPhone" placeholder="(555) 000-0000" />
      </div>
      <div class="form-group">
        <label class="form-label">Website</label>
        <input class="form-input" @bind="_orgWebsite" />
      </div>
      <button class="btn btn-primary btn-sm" @onclick="SaveOrg">Save</button>
    </div>
  </div>

  <!-- CASE DEFAULTS -->
  <div class="panel">
    <div class="panel-head"><h3>Case Defaults</h3></div>
    <div class="panel-body">
      <div class="form-group">
        <label class="form-label">Overdue Threshold (days)</label>
        <input class="form-input" type="number" @bind="_overdueDays" />
        <div style="font-size:.74rem;color:var(--text-light);margin-top:4px;">Cases open longer than this are flagged as overdue.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Default Case Assignee</label>
        <select class="form-input" @bind="_defaultAssignee">
          <option value="round-robin">Round-robin (auto)</option>
          <option value="unassigned">Unassigned</option>
        </select>
      </div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chk-autoassign" @bind="_autoAssign" />
        <label for="chk-autoassign" class="form-label" style="margin:0;">Auto-assign new requests to next available volunteer</label>
      </div>
      <button class="btn btn-primary btn-sm" @onclick="SaveCaseDefaults">Save</button>
    </div>
  </div>

  <!-- NOTIFICATIONS -->
  <div class="panel">
    <div class="panel-head"><h3>Notifications</h3></div>
    <div class="panel-body">
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chk-n1" @bind="_notifyNewRequest" />
        <label for="chk-n1" class="form-label" style="margin:0;">Email on new family request</label>
      </div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chk-n2" @bind="_notifyOverdue" />
        <label for="chk-n2" class="form-label" style="margin:0;">Email on overdue case</label>
      </div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chk-n3" @bind="_notifyDigest" />
        <label for="chk-n3" class="form-label" style="margin:0;">Daily digest email</label>
      </div>
      <div class="form-group" style="display:flex;align-items:center;gap:10px;">
        <input type="checkbox" id="chk-n4" @bind="_notifyUnallocated" />
        <label for="chk-n4" class="form-label" style="margin:0;">Notify on unallocated funds (weekly)</label>
      </div>
      <button class="btn btn-primary btn-sm" @onclick="SaveNotifications">Save</button>
    </div>
  </div>

  <!-- DATA RETENTION -->
  <div class="panel">
    <div class="panel-head"><h3>Data &amp; Privacy</h3></div>
    <div class="panel-body">
      <div class="form-group">
        <label class="form-label">Audit Log Retention</label>
        <select class="form-input" @bind="_auditRetention">
          <option value="1 year">1 year</option>
          <option value="3 years">3 years</option>
          <option value="7 years">7 years</option>
          <option value="Indefinite">Indefinite</option>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label">Anonymize families after fulfillment (days)</label>
        <input class="form-input" type="number" @bind="_anonymizeDays" />
        <div style="font-size:.74rem;color:var(--text-light);margin-top:4px;">Set 0 to disable anonymization.</div>
      </div>
      <button class="btn btn-primary btn-sm" @onclick="SavePrivacy">Save</button>
    </div>
  </div>

</div>

@if (_savedMsg != null)
{
  <div style="position:fixed;bottom:24px;right:24px;background:var(--green);color:white;padding:12px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:.88rem;font-weight:600;z-index:600;">
    &#10003; @_savedMsg saved
  </div>
}

@code {
  private ApiService.VapidKeyPair? _vapid;
  private bool _vapidBusy;
  private async Task GenerateVapid()
  {
    _vapidBusy = true;
    _vapid = await Api.GenerateVapidKeysAsync();
    _vapidBusy = false;
  }

  private async Task DownloadAppsettings()
  {
    var json = "{\n" +
      "  \"ConnectionStrings\": { \"Default\": \"Server=...;Database=lotv;User Id=...;Password=...\" },\n" +
      "  \"Jwt\": { \"Issuer\": \"https://api.lotv.org\", \"Audience\": \"lotv-web\", \"Key\": \"REPLACE_WITH_64_CHAR_RANDOM_SECRET\" },\n" +
      "  \"Stripe\": { \"PublishableKey\": \"pk_live_...\", \"SecretKey\": \"sk_live_...\", \"WebhookSecret\": \"whsec_...\" },\n" +
      "  \"GiveButter\": { \"WebhookSecret\": \"...\" },\n" +
      "  \"Push\": { \"VapidSubject\": \"mailto:admin@lotv.org\", \"VapidPublicKey\": \"<paste from generator>\", \"VapidPrivateKey\": \"<paste from generator>\" },\n" +
      "  \"SendGrid\": { \"ApiKey\": \"SG....\", \"FromEmail\": \"no-reply@lotv.org\", \"FromName\": \"LOTV Ministry\" },\n" +
      "  \"Twilio\": { \"AccountSid\": \"AC...\", \"AuthToken\": \"...\", \"FromNumber\": \"+1...\" },\n" +
      "  \"AllowedOrigins\": [ \"https://app.lotv.org\" ]\n" +
      "}\n";
    await JS.InvokeVoidAsync("downloadCsv", "appsettings.snippet.json", json);
  }

  private string _orgName         = "Lily of the Valley Ministry";
  private string _orgEmail        = "info@lotvministry.org";
  private string _orgPhone        = "";
  private string _orgWebsite      = "lotvministry.org";
  private int    _overdueDays     = 7;
  private string _defaultAssignee = "round-robin";
  private bool   _autoAssign          = true;
  private bool   _notifyNewRequest    = true;
  private bool   _notifyOverdue       = true;
  private bool   _notifyDigest        = false;
  private bool   _notifyUnallocated   = true;
  private string _auditRetention  = "3 years";
  private int    _anonymizeDays   = 365;
  private string? _savedMsg;

  protected override async Task OnInitializedAsync()
  {
    var s = await Api.GetSettingsAsync();
    if (s.TryGetValue("org.name",    out var v)) _orgName    = v;
    if (s.TryGetValue("org.email",   out v))     _orgEmail   = v;
    if (s.TryGetValue("org.phone",   out v))     _orgPhone   = v;
    if (s.TryGetValue("org.website", out v))     _orgWebsite = v;
    if (s.TryGetValue("case.overdueDays",     out v) && int.TryParse(v, out var d))  _overdueDays    = d;
    if (s.TryGetValue("case.defaultAssignee", out v))                                _defaultAssignee = v;
    if (s.TryGetValue("case.autoAssign",      out v) && bool.TryParse(v, out var b)) _autoAssign     = b;
    if (s.TryGetValue("notify.newRequest",    out v) && bool.TryParse(v, out b))     _notifyNewRequest = b;
    if (s.TryGetValue("notify.overdue",       out v) && bool.TryParse(v, out b))     _notifyOverdue    = b;
    if (s.TryGetValue("notify.digest",        out v) && bool.TryParse(v, out b))     _notifyDigest     = b;
    if (s.TryGetValue("notify.unallocated",   out v) && bool.TryParse(v, out b))     _notifyUnallocated= b;
    if (s.TryGetValue("privacy.auditRetention", out v)) _auditRetention = v;
    if (s.TryGetValue("privacy.anonymizeDays",  out v) && int.TryParse(v, out d))   _anonymizeDays   = d;
  }

  private async Task SaveOrg()
  {
    await Api.SaveSettingsAsync(new Dictionary<string, string>
    {
      ["org.name"]    = _orgName,
      ["org.email"]   = _orgEmail,
      ["org.phone"]   = _orgPhone,
      ["org.website"] = _orgWebsite,
    });
    await ShowToast("Organization info");
  }

  private async Task SaveCaseDefaults()
  {
    await Api.SaveSettingsAsync(new Dictionary<string, string>
    {
      ["case.overdueDays"]     = _overdueDays.ToString(),
      ["case.defaultAssignee"] = _defaultAssignee,
      ["case.autoAssign"]      = _autoAssign.ToString(),
    });
    await ShowToast("Case defaults");
  }

  private async Task SaveNotifications()
  {
    await Api.SaveSettingsAsync(new Dictionary<string, string>
    {
      ["notify.newRequest"]  = _notifyNewRequest.ToString(),
      ["notify.overdue"]     = _notifyOverdue.ToString(),
      ["notify.digest"]      = _notifyDigest.ToString(),
      ["notify.unallocated"] = _notifyUnallocated.ToString(),
    });
    await ShowToast("Notification preferences");
  }

  private async Task SavePrivacy()
  {
    await Api.SaveSettingsAsync(new Dictionary<string, string>
    {
      ["privacy.auditRetention"] = _auditRetention,
      ["privacy.anonymizeDays"]  = _anonymizeDays.ToString(),
    });
    await ShowToast("Data & Privacy settings");
  }

  private async Task ShowToast(string section)
  {
    _savedMsg = section;
    StateHasChanged();
    await Task.Delay(2500);
    _savedMsg = null;
  }
}
