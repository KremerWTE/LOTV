@page "/admin/retreats/{RetreatId:int}/registrations/{RegId:int}/edit"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Edit Registration — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Edit Registration</h2><p>Retreat #@RetreatId — Registration #@RegId</p></div>
  <div class="page-hd-actions">
    <a href="/admin/retreats/@RetreatId/registrations" class="btn btn-sm">← Registrations</a>
    <a href="/admin/retreats/@RetreatId" class="btn btn-sm">Retreat</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_reg is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Registration #@RegId not found.</div></div>
}
else
{
  @if (_saved)
  {
    <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--green);font-weight:600;">Payment updated. <a href="/admin/retreats/@RetreatId/registrations" style="color:var(--green);">Back to registrations →</a></div>
    </div>
  }
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  <div style="max-width:560px;">
    <div class="panel">
      <div class="panel-head"><h3>Registration Details</h3></div>
      <div class="panel-body">
        <div style="margin-bottom:14px;padding:10px 12px;background:var(--bg);border-radius:6px;font-size:.82rem;">
          @_reg.FirstName @_reg.LastName &bull; @_reg.Email &bull; Registered @_reg.RegisteredAt.ToString("MMM d, yyyy")
        </div>

        <div class="form-group">
          <label class="form-label">Amount Paid *</label>
          <input class="form-input" type="number" step="10" min="0" @bind="_amountPaid" />
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Payment Status</label>
          <select class="form-input" @bind="_paymentStatus">
            <option value="Pending">Pending</option>
            <option value="Paid">Paid</option>
            <option value="Partial">Partial</option>
            <option value="Refunded">Refunded</option>
            <option value="Waived">Waived</option>
          </select>
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Payment Method</label>
          <select class="form-input" @bind="_paymentMethod">
            <option value="GiveButter">GiveButter</option>
            <option value="Cash">Cash</option>
            <option value="Check">Check</option>
            <option value="Card">Card</option>
            <option value="Other">Other</option>
          </select>
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Notes</label>
          <textarea class="form-input" rows="2" @bind="_notes" placeholder="Scholarship, partial payment arrangement…"></textarea>
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
          <a href="/admin/retreats/@RetreatId/registrations" class="btn btn-sm">Cancel</a>
          <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save Changes")</button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public int RetreatId { get; set; }
  [Parameter] public int RegId { get; set; }

  private RetreatRegistrationDto? _reg;
  private bool _loading = true, _busy, _saved;
  private string _error = "";
  private decimal _amountPaid;
  private string _paymentStatus = "Pending", _paymentMethod = "GiveButter", _notes = "";

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetRetreatRegistrationsAsync(RetreatId);
    _reg = all.FirstOrDefault(r => r.Id == RegId);
    if (_reg is not null)
    {
      _amountPaid     = _reg.AmountPaid;
      _paymentStatus  = _reg.PaymentStatus;
      _paymentMethod  = _reg.PaymentMethod ?? "GiveButter";
      _notes          = _reg.Notes ?? "";
    }
    _loading = false;
  }

  private async Task Save()
  {
    _error = ""; _saved = false;
    _busy = true;
    var body = new
    {
      amountPaid    = _amountPaid,
      paymentStatus = _paymentStatus,
      paymentMethod = _paymentMethod,
      notes         = string.IsNullOrWhiteSpace(_notes) ? null : _notes,
    };
    var ok = await Api.UpdateRegistrationPaymentAsync(RetreatId, RegId, body);
    _busy = false;
    if (ok) _saved = true;
    else _error = "Save failed. Please try again.";
  }
}
