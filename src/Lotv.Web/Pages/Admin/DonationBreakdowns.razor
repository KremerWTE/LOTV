@page "/admin/donations/breakdowns"
@layout AdminLayout

<PageTitle>Donation Breakdowns — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Donation Breakdowns</h2>
    <p>The donation ledger sliced by donor, diocese, channel, city, and amount</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/donations" class="btn btn-sm">← All Donations</a>
  </div>
</div>

<div class="tab-bar" style="display:flex;gap:4px;margin-bottom:20px;background:white;border:1px solid var(--border);border-radius:var(--radius, 10px);padding:4px;width:fit-content;flex-wrap:wrap;">
  @foreach (var t in _tabs)
  {
    <button class="tab-btn @(_active == t.Key ? "active" : "")"
            style="padding:8px 16px;border-radius:7px;border:none;background:@(_active == t.Key ? "var(--green)" : "none");color:@(_active == t.Key ? "white" : "var(--text-mid)");font-size:.85rem;font-weight:500;cursor:pointer;"
            @onclick="() => _active = t.Key">
      @t.Label
    </button>
  }
</div>

@switch (_active)
{
  case "by-donor":
    <ByDonor />
    break;
  case "by-diocese":
    <ByDiocese />
    break;
  case "by-channel":
    <ByChannel />
    break;
  case "by-city":
    <ByCity />
    break;
  case "by-amount":
    <ByAmount />
    break;
}

@code {
  private record TabDef(string Key, string Label);

  private readonly List<TabDef> _tabs =
  [
    new("by-donor", "By Donor"),
    new("by-diocese", "By Diocese"),
    new("by-channel", "By Channel"),
    new("by-city", "By City"),
    new("by-amount", "By Amount"),
  ];

  private string _active = "by-donor";
}
