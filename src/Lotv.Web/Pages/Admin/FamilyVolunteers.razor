@page "/admin/families/{Id:int}/volunteers"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Family Volunteers — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Assigned Volunteers</h2><p>@(_family is null ? $"Family #{Id}" : (_family.Parent1FirstName + " " + _family.Parent1LastName).Trim())</p></div>
  <div class="page-hd-actions">
    <a href="/admin/families/@Id" class="btn btn-sm">← Family Profile</a>
    <a href="/admin/families/@Id/requests" class="btn btn-sm">All Cases</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (!_volunteers.Any())
{
  <div class="panel">
    <div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">
      No volunteers currently assigned to any of this family's cases.
    </div>
  </div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128100;</div>
      <div class="kpi-label">Volunteers</div>
      <div class="kpi-value" style="color:var(--navy)">@_volunteers.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128149;</div>
      <div class="kpi-label">Open Cases</div>
      <div class="kpi-value" style="color:var(--green)">@_cases.Count(c => c.Status is not (CaseStatus.Fulfilled or CaseStatus.Cancelled))</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Volunteers Serving This Family (@_volunteers.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:var(--bg);">
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Volunteer</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Role</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Cases</th>
            <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var v in _volunteers.OrderBy(v => v.LastName))
          {
            var vCases = _cases.Where(c => c.AssignedToId == v.Id).ToList();
            <tr style="border-top:1px solid var(--border);">
              <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                <a href="/admin/volunteers/@v.Id" style="color:var(--navy);">@v.FullName</a>
                @if (!string.IsNullOrEmpty(v.Email))
                {
                  <div style="font-size:.74rem;color:var(--text-light);">@v.Email</div>
                }
              </td>
              <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@v.Role.ToDisplayName()</td>
              <td style="padding:10px 16px;">
                <span class="badge badge-@(v.Status == VolunteerStatus.Active ? "fulfilled" : "cancelled")" style="font-size:.68rem;">@v.Status</span>
              </td>
              <td style="padding:10px 16px;font-size:.82rem;">
                @foreach (var c in vCases)
                {
                  <div><a href="/admin/cases/@c.Id" style="color:var(--navy);font-size:.78rem;">Case #@c.Id — @c.Status</a></div>
                }
              </td>
              <td style="padding:10px 16px;text-align:center;">
                <a href="/admin/volunteers/@v.Id" style="font-size:.78rem;color:var(--navy);">Profile</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Family? _family;
  private List<PackageRequest> _cases = [];
  private List<Volunteer> _volunteers = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var familyTask = Api.GetFamilyAsync(Id);
    var casesTask  = Api.GetRequestsAsync(familyId: Id);
    await Task.WhenAll(familyTask, casesTask);
    _family = await familyTask;
    _cases  = await casesTask;

    var volIds = _cases
      .Where(c => c.AssignedToId.HasValue)
      .Select(c => c.AssignedToId!.Value)
      .Distinct()
      .ToHashSet();

    if (volIds.Any())
    {
      var all = await Api.GetVolunteersAsync();
      _volunteers = all.Where(v => volIds.Contains(v.Id)).ToList();
    }

    _loading = false;
  }
}
