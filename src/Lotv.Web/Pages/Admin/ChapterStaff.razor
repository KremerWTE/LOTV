@page "/admin/chapters/{Id:int}/staff"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Staff — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Staff</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/users" class="btn btn-sm btn-primary">Manage All Users</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128100;</div>
      <div class="kpi-label">Total Staff</div>
      <div class="kpi-value" style="color:var(--navy)">@_staff.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#9989;</div>
      <div class="kpi-label">Active</div>
      <div class="kpi-value" style="color:var(--green)">@_staff.Count(u => u.IsActive)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128081;</div>
      <div class="kpi-label">Admins</div>
      <div class="kpi-value" style="color:var(--amber)">@_staff.Count(u => u.Role == UserRole.HQAdmin || u.Role == UserRole.ChapterAdmin)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Staff Members (@_staff.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      @if (!_staff.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No staff assigned to this chapter.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Name</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Email</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Role</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var u in _staff.OrderBy(u => u.FullName))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  @if (!string.IsNullOrEmpty(u.AvatarUrl))
                  {
                    <img src="@u.AvatarUrl" style="width:24px;height:24px;border-radius:50%;object-fit:cover;margin-right:8px;vertical-align:middle;" />
                  }
                  @(u.FullName ?? u.Email ?? $"User {u.Id}")
                </td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(u.Email ?? "—")</td>
                <td style="padding:10px 16px;font-size:.82rem;">
                  <span class="badge badge-@(u.Role == UserRole.HQAdmin || u.Role == UserRole.ChapterAdmin ? "cancelled" : "new")" style="font-size:.68rem;">@u.Role</span>
                </td>
                <td style="padding:10px 16px;text-align:center;">
                  <span class="badge badge-@(u.IsActive ? "fulfilled" : "cancelled")" style="font-size:.68rem;">@(u.IsActive ? "Active" : "Inactive")</span>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<StaffUserDto> _staff = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var chapTask  = Api.GetChaptersAdminAsync();
    var userTask  = Api.GetUsersAsync();
    await Task.WhenAll(chapTask, userTask);
    var chapters  = await chapTask;
    _chapter      = chapters.FirstOrDefault(c => c.Id == Id);
    var all       = await userTask;
    _staff        = all.Where(u => u.ChapterId == Id).ToList();
    _loading = false;
  }
}
