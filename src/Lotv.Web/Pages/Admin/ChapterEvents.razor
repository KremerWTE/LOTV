@page "/admin/chapters/{Id:int}/events"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Events — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Events</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/events/new" class="btn btn-sm btn-primary">+ New Event</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <!-- KPIs -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📅</div>
      <div class="kpi-label">Total Events</div>
      <div class="kpi-value" style="color:var(--navy)">@_events.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">⏰</div>
      <div class="kpi-label">Upcoming</div>
      <div class="kpi-value" style="color:var(--green)">@_events.Count(e => e.Date >= DateTime.Today && e.Status != EventStatus.Cancelled)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">👥</div>
      <div class="kpi-label">Total Registered</div>
      <div class="kpi-value" style="color:var(--amber)">@_events.Sum(e => e.Registered)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Events (@_events.Count)</h3>
      <select class="form-input" style="width:160px;font-size:.82rem;padding:5px 10px;" @bind="_filter">
        <option value="upcoming">Upcoming</option>
        <option value="past">Past</option>
        <option value="all">All</option>
      </select>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!Filtered.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No events match filter.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Date</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Title</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Location</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);">Registered</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var e in Filtered.OrderByDescending(e => e.Date))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;white-space:nowrap;">@e.Date.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">@e.Title</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@e.Location</td>
                <td style="padding:10px 16px;text-align:center;font-size:.84rem;">
                  @e.Registered@(e.Capacity.HasValue ? $" / {e.Capacity}" : "")
                </td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@(e.Status == EventStatus.Cancelled ? "cancelled" : e.Date < DateTime.Today ? "onhold" : "new")" style="font-size:.68rem;">@e.Status</span>
                </td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/events/@e.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<MinistryEvent> _events = [];
  private string _filter = "upcoming";
  private bool _loading = true;

  private IEnumerable<MinistryEvent> Filtered => _filter switch
  {
    "upcoming" => _events.Where(e => e.Date >= DateTime.Today && e.Status != EventStatus.Cancelled),
    "past"     => _events.Where(e => e.Date < DateTime.Today || e.Status == EventStatus.Cancelled),
    _          => _events
  };

  protected override async Task OnInitializedAsync()
  {
    var chapTask  = Api.GetChaptersAdminAsync();
    var evtTask   = Api.GetEventsAsync();
    await Task.WhenAll(chapTask, evtTask);
    var chapters  = await chapTask;
    _chapter      = chapters.FirstOrDefault(c => c.Id == Id);
    var all       = await evtTask;
    _events       = all.Where(e => e.ChapterId == Id).ToList();
    _loading = false;
  }
}
