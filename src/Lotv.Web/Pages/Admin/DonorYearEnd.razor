@page "/admin/donors/{DonorId:int}/year-end"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Year-End Summary — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Year-End Summary</h2><p>@(_summary?.DonorName ?? $"Donor #{DonorId}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors/@DonorId" class="btn btn-sm">← Donor Profile</a>
    <a href="/admin/donors/@DonorId/contributions" class="btn btn-sm">All Gifts</a>
  </div>
</div>

<div class="panel" style="margin-bottom:16px;">
  <div class="panel-body" style="display:flex;align-items:center;gap:12px;">
    <label class="form-label" style="margin:0;white-space:nowrap;">Tax Year:</label>
    <select class="form-input" style="width:120px;" @bind="_year" @bind:after="Load">
      @for (var y = DateTime.Today.Year; y >= DateTime.Today.Year - 5; y--)
      {
        <option value="@y">@y</option>
      }
    </select>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_summary is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">No giving record found for @_year.</div></div>
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">💰</div>
      <div class="kpi-label">Total Given @_year</div>
      <div class="kpi-value" style="color:var(--green)">@_summary.TotalGiven.ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">🎁</div>
      <div class="kpi-label">Gift Count</div>
      <div class="kpi-value" style="color:var(--navy)">@_summary.GiftCount</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Average Gift</div>
      <div class="kpi-value" style="font-size:1rem;">@(_summary.GiftCount > 0 ? (_summary.TotalGiven / _summary.GiftCount).ToString("C0") : "—")</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Giving History — @_year</h3></div>
    <div class="panel-body" style="padding:0;">
      @if (!_summary.Gifts.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No gifts recorded for @_year.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Date</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Amount</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Channel</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Campaign</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var g in _summary.Gifts.OrderByDescending(g => g.Date))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;">@g.Date.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@g.Amount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.84rem;">@g.Channel</td>
                <td style="padding:10px 16px;font-size:.84rem;color:var(--text-light);">@(g.Campaign ?? "—")</td>
              </tr>
            }
          </tbody>
          <tfoot>
            <tr style="border-top:2px solid var(--border);font-weight:700;background:var(--bg);">
              <td style="padding:10px 16px;font-size:.84rem;">Total</td>
              <td style="padding:10px 16px;font-size:.92rem;text-align:right;color:var(--green);">@_summary.TotalGiven.ToString("C0")</td>
              <td colspan="2"></td>
            </tr>
          </tfoot>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int DonorId { get; set; }

  private YearEndSummaryDto? _summary;
  private bool _loading = true;
  private int _year = DateTime.Today.Year - 1;

  protected override async Task OnInitializedAsync() => await Load();

  private async Task Load()
  {
    _loading = true;
    _summary = await Api.GetYearEndSummaryAsync(DonorId, _year);
    _loading = false;
  }
}
