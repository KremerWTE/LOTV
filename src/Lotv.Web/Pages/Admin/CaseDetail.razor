@page "/admin/cases/{Id:int}"
@layout AdminLayout
@inject ApiService Api
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Case #@Id — LOTV Staff Portal</PageTitle>

@if (_loading)
{
  <Loading Message="Loading case…" Size="lg" />
}
else if (_request is null)
{
  <div class="empty-state">
    <div class="icon">❌</div>
    <p>Case #@Id not found.</p>
    <a href="/admin/cases" class="btn btn-sm" style="margin-top:16px;">Back to Cases</a>
  </div>
}
else
{
  <!-- BREADCRUMB / HEADER -->
  <div class="page-hd">
    <div>
      <div style="font-size:.76rem;color:var(--text-light);margin-bottom:4px;">
        <a href="/admin/cases" style="color:var(--green);text-decoration:none;">Cases</a> &rsaquo; #@_request.Id
      </div>
      <h2 style="margin:0;">Case #@_request.Id — @(_request.Family?.FullName ?? "Unknown Family")<SampleBadge Family="_request.Family" /></h2>
      <div style="margin-top:4px;display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
        <span class="badge @GetStatusBadge(_request.Status)">@_request.Status</span>
        <span class="badge @GetPriorityBadge(_request.Priority)">@_request.Priority</span>
        @if (_request.IsOverdue)
        { <span class="badge badge-overdue">Overdue</span> }
        <span style="font-size:.76rem;color:var(--text-light);">Created @_request.CreatedAt.ToString("MMM d, yyyy")</span>
      </div>
    </div>
    <div class="page-hd-actions">
      <button class="btn btn-sm" @onclick="LoadAsync">↻ Refresh</button>
      <a href="/admin/cases" class="btn btn-sm">← All Cases</a>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(_saveMsg))
  {
    <div style="background:var(--green-pale);border-radius:8px;padding:10px 16px;font-size:.84rem;color:var(--green-dark);margin-bottom:16px;">✓ @_saveMsg</div>
  }
  @if (!string.IsNullOrEmpty(_errorMsg))
  {
    <div style="background:#fff3cd;border-radius:8px;padding:10px 16px;font-size:.84rem;color:#856404;margin-bottom:16px;">⚠ @_errorMsg</div>
  }

  <DataQualityAlert Family="_request.Family" />

  @if (_familyRequests.Where(o => o.Id != _request.Id && o.Status is not (CaseStatus.Fulfilled or CaseStatus.Cancelled)).ToList() is { Count: > 0 } otherOpen)
  {
    <div data-alert="repeat-request" role="alert" style="background:#e8f0fb;color:#1f3d73;border-radius:8px;padding:12px 16px;font-size:.86rem;margin-bottom:16px;">
      <strong>This family has another open request.</strong>
      @foreach (var o in otherOpen)
      { <a href="/admin/cases/@o.Id" style="margin-left:8px;">#@o.Id (@o.Status)</a> }
      — check that this isn't a repeat before shipping a second package.
    </div>
  }

  <!-- MAIN GRID -->
  <div style="display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:start;">

    <!-- LEFT COLUMN -->
    <div style="display:flex;flex-direction:column;gap:20px;">

      <!-- CASE DETAILS PANEL -->
      <div class="panel">
        <div class="panel-header">Case Details</div>
        <div class="panel-body" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">

          <div class="form-group">
            <label class="form-label">Status</label>
            <select class="form-input" @bind="_editStatus">
              <option value="@_request.Status">@_request.Status (current)</option>
              @foreach (var s in CaseStatusTransitions.ValidNextStates(_request.Status))
              { <option value="@s">@s</option> }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Priority</label>
            <select class="form-input" @bind="_editPriority">
              @foreach (var p in Enum.GetValues<RequestPriority>())
              { <option value="@p">@p</option> }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Assigned Volunteer</label>
            <select class="form-input" @bind="_editAssignedVolId">
              <option value="">— Unassigned —</option>
              @foreach (var v in _volunteers)
              { <option value="@v.Id">@v.FullName (@v.ActiveCases active)</option> }
            </select>
          </div>

          <div class="form-group">
            <label class="form-label">Due Date</label>
            <input class="form-input" type="date"
                   value="@(_editDueDate?.ToString("yyyy-MM-dd") ?? "")"
                   @onchange='e => _editDueDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)' />
          </div>

          <div class="form-group">
            <label class="form-label">Category</label>
            <div style="padding:9px 12px;background:var(--bg);border-radius:8px;font-size:.86rem;">@_request.Reason.ToDisplayName()</div>
          </div>

          <div class="form-group">
            <label class="form-label">Chapter</label>
            <div style="padding:9px 12px;background:var(--bg);border-radius:8px;font-size:.86rem;">@_request.ChapterId</div>
          </div>

          @if (_editStatus is CaseStatus.AwaitingShipment or CaseStatus.Shipped or CaseStatus.Fulfilled)
          {
            <div class="form-group">
              <label class="form-label">Tracking Number</label>
              <input class="form-input" @bind="_editTracking" placeholder="1Z999AA10123456784" />
            </div>
            <div class="form-group">
              <label class="form-label">Shipped Date</label>
              <input class="form-input" type="date"
                     value="@(_editShippedDate?.ToString("yyyy-MM-dd") ?? "")"
                     @onchange='e => _editShippedDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)' />
            </div>
          }

          <div class="form-group" style="grid-column:1/-1;">
            <label class="form-label">Internal Notes (staff only)</label>
            <textarea class="form-textarea" @bind="_editInternalNotes" placeholder="Add notes visible only to staff…"></textarea>
          </div>

          <div style="grid-column:1/-1;display:flex;gap:10px;">
            <button class="btn btn-primary" @onclick="SaveDetailsAsync" disabled="@_saving">
              @(_saving ? "Saving…" : "Save Changes")
            </button>
            <button class="btn" @onclick="ResetDetails">Discard</button>
          </div>
        </div>
      </div>

      <!-- REQUEST INFORMATION -->
      <div class="panel" data-panel="request-info">
        <div class="panel-header">Request Information</div>
        <div class="panel-body" style="display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;font-size:.84rem;">
          <div><strong>Requested for:</strong> @(_request.IsForSelf ? "Their own family" : "Someone else")</div>
          <div><strong>Reason:</strong> @_request.Reason.ToDisplayName()</div>
          <div><strong>Submitted:</strong> @_request.CreatedAt.ToString("MMM d, yyyy h:mm tt")</div>
          <div><strong>Last updated:</strong> @_request.UpdatedAt.ToString("MMM d, yyyy h:mm tt")</div>
          <div><strong>Process stage:</strong> @_request.ProcessStage</div>
          <div><strong>Staff outreach requested:</strong> @(_request.StaffOutreachRequested ? "Yes" : "No")</div>
          <div><strong>Bracelet / children's initials:</strong> @(_request.ChildrenInitials ?? _request.Family?.ChildrenInitials ?? "—")</div>
          <div><strong>Assigned to:</strong> @(_request.AssignedTo ?? "Unassigned")</div>
          @if (!_request.IsForSelf)
          {
            <div><strong>Referred by:</strong> @(_request.ReferrerName ?? "—")</div>
            <div><strong>Referrer email:</strong> @(_request.ReferrerEmail ?? "—")</div>
          }
          @if (_request.NeedsDuplicateReview)
          {
            <div style="grid-column:1/-1;color:#856404;background:#fff3cd;border-radius:8px;padding:8px 12px;">
              ⚠ Possible duplicate of another family (@(_request.DuplicateMatchReason ?? "needs review")).
              <a href="/admin/families/duplicate-review">Review</a>
            </div>
          }
          @if (!string.IsNullOrEmpty(_request.TrackingNumber))
          { <div><strong>Tracking:</strong> @_request.TrackingNumber</div> }
          @if (_request.ShippedDate.HasValue)
          { <div><strong>Shipped:</strong> @_request.ShippedDate.Value.ToString("MMM d, yyyy")</div> }
        </div>
      </div>

      <!-- MOTHER'S DAY CARD -->
      <div class="panel" data-panel="mothers-day">
        <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
          <span>Mother's Day &amp; Father's Day Cards</span>
          <a href="/admin/mothers-day" style="font-size:.74rem;color:var(--green);text-decoration:none;font-weight:600;">Mailing list →</a>
        </div>
        <div class="panel-body" style="font-size:.84rem;">
          @if (!_mailing.Any())
          { <div style="color:var(--text-light);">Not on a Mother's Day or Father's Day mailing list yet.</div> }
          else
          {
            @foreach (var m in _mailing.OrderByDescending(x => x.Year).ThenBy(x => x.Kind))
            {
              <div style="display:flex;justify-content:space-between;gap:10px;padding:6px 0;border-bottom:1px solid var(--border);">
                <span><strong>@(m.Kind == MailingKind.FathersDay ? "Father's Day" : "Mother's Day") @m.Year</strong> — @m.RecipientName, @m.StreetAddress, @m.City, @m.State @m.Zip</span>
                <span>
                  @if (m.FlaggedForReview) { <span class="badge badge-onhold">Needs review</span> }
                  @if (m.Sent) { <span class="badge badge-fulfilled">Sent @(m.SentAt?.ToString("MMM d"))</span> }
                  else { <span class="badge badge-new">Not sent</span> }
                </span>
              </div>
            }
          }
        </div>
      </div>

      <!-- BEREAVEMENT FOLLOW-UP -->
      <div class="panel" data-panel="follow-up">
        <div class="panel-header">Bereavement Follow-Up</div>
        <div class="panel-body" style="font-size:.84rem;">
          @if (!_trackers.Any())
          { <div style="color:var(--text-light);">No follow-up schedule for this family (no date of loss recorded).</div> }
          else
          {
            @foreach (var t in _trackers)
            {
              <div style="margin-bottom:8px;">Date of loss: @(t.DateOfLoss?.ToString("MMM d, yyyy") ?? "—")</div>
              <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:8px;">
                @foreach (var ms in t.Milestones.OrderBy(x => x.Type))
                {
                  <div style="border:1px solid var(--border);border-radius:8px;padding:8px 10px;text-align:center;">
                    <div style="font-weight:600;">@ms.Type.ToDisplayName()</div>
                    <div style="font-size:.74rem;color:var(--text-light);">@(ms.DueDate?.ToString("MMM d, yyyy") ?? "—")</div>
                    <div style="font-size:.74rem;">@(ms.BookSent ? "Sent" : "Not sent")</div>
                  </div>
                }
              </div>
            }
          }
        </div>
      </div>

      <!-- OTHER REQUESTS FROM THIS FAMILY -->
      <div class="panel" data-panel="family-requests">
        <div class="panel-header">All Requests from This Family</div>
        <div class="panel-body" style="padding:0;font-size:.84rem;">
          @foreach (var o in _familyRequests.OrderByDescending(x => x.CreatedAt))
          {
            <div style="display:flex;justify-content:space-between;padding:10px 20px;border-bottom:1px solid var(--border);">
              <span>
                @if (o.Id == _request.Id) { <strong>#@o.Id (this request)</strong> }
                else { <a href="/admin/cases/@o.Id">#@o.Id</a> }
                — @o.Reason.ToDisplayName() — @o.CreatedAt.ToString("MMM d, yyyy")
              </span>
              <span class="badge @GetStatusBadge(o.Status)">@o.Status</span>
            </div>
          }
        </div>
      </div>

      <!-- NOTES THREAD -->
      <div class="panel">
        <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
          <span>Notes Thread</span>
          <span style="font-size:.76rem;color:var(--text-light);">@_notes.Count note@(_notes.Count == 1 ? "" : "s")</span>
        </div>
        <div class="panel-body">

          @* The family's story from the request form leads the thread. It is read from the family record (not copied
             into a stored note), so it is there for every request and follows any correction to the story. *@
          @if (_request.Family is { } storyFamily)
          {
            <div data-field="story" style="border-radius:10px;padding:12px 16px;background:var(--green-pale);border-left:4px solid var(--green);margin-bottom:12px;">
              <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                <span style="font-size:.8rem;font-weight:600;">Story from the request form</span>
                <span style="font-size:.72rem;color:var(--text-light);">@_request.CreatedAt.ToString("MMM d, h:mm tt")</span>
              </div>
              @if (!string.IsNullOrWhiteSpace(storyFamily.Story))
              {
                <div style="font-size:.85rem;line-height:1.6;white-space:pre-wrap;">@storyFamily.Story</div>
              }
              else
              {
                <div style="font-size:.85rem;color:var(--text-light);">No story was shared with this request.</div>
              }
            </div>
          }

          @if (!_notes.Any())
          {
            <div class="empty-state" style="padding:24px;">
              <div class="icon" style="font-size:28px;">💬</div>
              <p>No notes yet — add the first one below.</p>
            </div>
          }
          else
          {
            <div style="display:flex;flex-direction:column;gap:12px;margin-bottom:20px;">
              @foreach (var note in _notes)
              {
                <div style="border-radius:10px;padding:12px 16px;background:@(note.IsInternal ? "var(--navy-pale)" : "var(--green-pale)");">
                  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                    <span style="font-size:.8rem;font-weight:600;">@note.AuthorName</span>
                    <div style="display:flex;gap:8px;align-items:center;">
                      @if (note.IsInternal)
                      { <span style="font-size:.7rem;background:var(--navy);color:white;padding:1px 7px;border-radius:12px;">Internal</span> }
                      <span style="font-size:.72rem;color:var(--text-light);">@note.CreatedAt.ToString("MMM d, h:mm tt")</span>
                    </div>
                  </div>
                  <div style="font-size:.85rem;line-height:1.6;white-space:pre-wrap;">@note.Content</div>
                </div>
              }
            </div>
          }

          <!-- Add note form -->
          <div style="border-top:1px solid var(--border);padding-top:16px;display:flex;flex-direction:column;gap:10px;">
            <textarea class="form-textarea" @bind="_newNoteText" placeholder="Add a note…" style="min-height:80px;"></textarea>
            <div style="display:flex;align-items:center;gap:16px;">
              <label style="display:flex;align-items:center;gap:6px;font-size:.82rem;cursor:pointer;">
                <input type="checkbox" @bind="_newNoteInternal" />
                <span>Internal only (hidden from recipient)</span>
              </label>
              <button class="btn btn-sm btn-primary" @onclick="AddNoteAsync" disabled="@(string.IsNullOrWhiteSpace(_newNoteText) || _addingNote)">
                @(_addingNote ? "Adding…" : "Add Note")
              </button>
            </div>
          </div>
        </div>
      </div>

      <!-- ACTIVITY LOG -->
      <div class="panel">
        <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
          <span>Activity Log</span>
          <span style="font-size:.76rem;color:var(--text-light);">@_activity.Count events</span>
        </div>
        <div class="panel-body" style="padding:0;">
          @if (!_activity.Any())
          {
            <div class="empty-state" style="padding:24px;"><p>No activity yet.</p></div>
          }
          else
          {
            <div style="position:relative;padding:8px 0;">
              @foreach (var ev in _activity.OrderByDescending(a => a.Timestamp))
              {
                <div style="display:flex;gap:12px;padding:10px 20px;border-bottom:1px solid var(--border);">
                  <div style="width:28px;height:28px;border-radius:50%;background:var(--green-pale);display:flex;align-items:center;justify-content:center;font-size:.9rem;flex-shrink:0;">
                    @GetActivityIcon(ev.ActivityType)
                  </div>
                  <div style="flex:1;min-width:0;">
                    <div style="font-size:.84rem;">
                      <strong>@ev.ActorName</strong>
                      <span style="color:var(--text-mid);"> @GetActivityLabel(ev)</span>
                    </div>
                    <div style="font-size:.73rem;color:var(--text-light);margin-top:2px;">@ev.Timestamp.ToString("MMM d, yyyy h:mm tt")</div>
                  </div>
                </div>
              }
            </div>
          }
        </div>
      </div>

    </div>

    <!-- RIGHT COLUMN -->
    <div style="display:flex;flex-direction:column;gap:20px;">

      <!-- FAMILY INFO -->
      @if (_request.Family is not null)
      {
        <div class="panel">
          <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
            <span>Family</span>
            <a href="/admin/families/@_request.Family.Id" style="font-size:.74rem;color:var(--green);text-decoration:none;font-weight:600;">View Profile →</a>
          </div>
          <div class="panel-body" style="display:flex;flex-direction:column;gap:8px;font-size:.84rem;">
            <div><strong>Name:</strong> @_request.Family.FullName</div>
            <div><strong>Parent 1:</strong> @_request.Family.Parent1FirstName @_request.Family.Parent1LastName</div>
            @if (!string.IsNullOrEmpty(_request.Family.Parent2FirstName))
            { <div><strong>Parent 2:</strong> @_request.Family.Parent2FirstName @_request.Family.Parent2LastName</div> }
            <div><strong>Email:</strong> @_request.Family.Email</div>
            <div><strong>Phone:</strong> @(_request.Family.Phone ?? "—")</div>
            <div>
              <strong>Shipping Address:</strong>
              @if (!string.IsNullOrEmpty(_request.Family.StreetAddress))
              {
                <text>@_request.Family.StreetAddress</text>
                @if (!string.IsNullOrEmpty(_request.Family.Apt))
                { <text>, Apt @_request.Family.Apt</text> }
                <text>, @_request.Family.City, @_request.Family.State @_request.Family.Zip</text>
              }
              else
              { <text>—</text> }
            </div>
            <div><strong>Parish:</strong> @(_request.Family.ParishName ?? "—")</div>
            <div><strong>Diocese:</strong> @(_request.Family.DioceseName ?? "—")</div>
            <div><strong>Faith:</strong> @(_request.Family.FaithTradition ?? "Not specified")</div>
            @if (_request.Family.GriefSupportRequested is { } grief)
            { <div data-field="grief-support"><strong>Quarterly grief support:</strong> @(grief ? "Yes" : "No")</div> }
            @if (!string.IsNullOrEmpty(_request.Family.ChildrenInitials))
            { <div><strong>Children's Initials:</strong> @_request.Family.ChildrenInitials</div> }
            <div><strong>Date of Loss:</strong> @(_request.Family.DateOfLoss?.ToString("MMM d, yyyy") ?? "—")</div>
            <div><strong>How They Heard:</strong> @(_request.Family.HowHeard ?? "—")</div>
            <div data-field="privacy-preference"><strong>Prayer wall:</strong> @(_request.Family.PrivacyPreference switch
              {
                PrivacyPreference.Public => "Name shown publicly",
                PrivacyPreference.Private => "Prayers only — not listed",
                _ => "Listed anonymously"
              })</div>
            @* The request form saves its extra answers here, joined by " | ": the grief-support answer, any custom
               questions staff added ("Question: answer"), and newsletter / prayer-night opt-ins. *@
            @if (FormAnswerNotes(_request.Family.ContactNotes) is { Count: > 0 } formNotes)
            {
              <div data-field="form-answers">
                <strong>Other answers from the request form:</strong>
                <ul style="margin:4px 0 0;padding-left:18px;line-height:1.6;">
                  @foreach (var note in formNotes)
                  { <li>@note</li> }
                </ul>
              </div>
            }
          </div>
        </div>
      }

      <!-- ASSIGNMENT CANDIDATES -->
      <div class="panel">
        <div class="panel-header">Auto-Assignment Candidates</div>
        <div class="panel-body">
          @if (!_candidatesLoaded)
          {
            <Loading Size="sm" Message="Scoring volunteers…" />
          }
          else if (!_candidates.Any())
          {
            <div class="empty-state" style="padding:16px;"><p>No available volunteers found.</p></div>
          }
          else
          {
            <div style="display:flex;flex-direction:column;gap:8px;">
              @foreach (var c in _candidates.Take(6))
              {
                <div style="border:1px solid var(--border);border-radius:8px;padding:10px 12px;">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <span style="font-size:.84rem;font-weight:600;">@c.Name</span>
                    @if (c.Recommended)
                    { <span style="font-size:.7rem;background:var(--green);color:white;padding:1px 8px;border-radius:12px;">✓ Best fit</span> }
                  </div>
                  <div style="font-size:.76rem;color:var(--text-light);margin-top:4px;display:flex;gap:10px;flex-wrap:wrap;">
                    <span>Score: @c.CompositeScore.ToString("F0")</span>
                    <span>@c.DistanceMiles.ToString("F1") mi</span>
                  </div>
                  <button class="btn btn-sm" style="margin-top:8px;width:100%;"
                          @onclick="() => AssignAsync(c.VolunteerId)"
                          disabled="@(_assigningId == c.VolunteerId)">
                    @(_assigningId == c.VolunteerId ? "Assigning…" : "Assign")
                  </button>
                </div>
              }
            </div>
          }
        </div>
      </div>

      <!-- FUND ALLOCATIONS -->
      <div class="panel">
        <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
          <span>Fund Allocations</span>
          <a href="/admin/allocations" style="font-size:.74rem;color:var(--green);text-decoration:none;font-weight:600;">View All →</a>
        </div>
        <div class="panel-body">
          @{
            var caseKey = $"case-{_request.Id}";
            var caseAllocs = _allocations.Where(a => a.AllocatedTo == caseKey || a.AllocatedTo == _request.Id.ToString()).ToList();
          }
          @if (!caseAllocs.Any())
          {
            <div class="empty-state" style="padding:16px;"><p>No funds allocated to this case.</p></div>
          }
          else
          {
            <div style="display:flex;flex-direction:column;gap:8px;">
              @foreach (var alloc in caseAllocs)
              {
                <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:1px solid var(--border);font-size:.84rem;">
                  <div>
                    <div style="font-weight:600;">@alloc.Amount.ToString("C")</div>
                    <div style="font-size:.73rem;color:var(--text-light);">@alloc.CreatedAt.ToString("MMM d, yyyy")</div>
                  </div>
                  <span class="badge @GetAllocBadge(alloc.Status)">@alloc.Status</span>
                </div>
              }
              <div style="font-size:.8rem;font-weight:700;text-align:right;color:var(--navy);padding-top:4px;">
                Total: @caseAllocs.Sum(a => a.Amount).ToString("C")
              </div>
            </div>
          }
        </div>
      </div>

      <!-- QUICK ACTIONS -->
      <div class="panel">
        <div class="panel-header">Quick Actions</div>
        <div class="panel-body" style="display:flex;flex-direction:column;gap:8px;">
          @foreach (var s in CaseStatusTransitions.ValidNextStates(_request.Status))
          {
            <button class="btn btn-sm"
                    style="@(s == CaseStatus.Cancelled ? "background:#fff3cd;color:#856404;border-color:#f0d060;" : "")"
                    @onclick="() => QuickStatusAsync(s)" disabled="@_quickBusy">
              @QuickActionIcon(s) @QuickActionLabel(s)
            </button>
          }
          @if (_request.AssignedToId is not null && _request.Status is not (CaseStatus.Shipped or CaseStatus.Fulfilled or CaseStatus.Cancelled))
          {
            <button class="btn btn-sm" data-action="unassign" @onclick="UnassignAsync" disabled="@_quickBusy">↩ Unassign (@_request.AssignedTo)</button>
          }
          <hr style="border:none;border-top:1px solid var(--border);margin:4px 0;" />
          <a href="/admin/cases?familyId=@_request.FamilyId" class="btn btn-sm">+ New Case for This Family</a>
        </div>
      </div>

      <!-- PACKING LIST -->
      <div class="panel">
        <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
          <span>Packing List</span>
          <span style="font-size:.76rem;color:var(--text-light);">@_packageItems.Count(i => i.Packed) / @_packageItems.Count packed</span>
        </div>
        <div class="panel-body">
          @if (!_packageItems.Any())
          {
            <div class="empty-state" style="padding:16px;"><p>No items added to this package yet.</p></div>
          }
          else
          {
            <div style="display:flex;flex-direction:column;gap:6px;margin-bottom:14px;">
              @foreach (var item in _packageItems)
              {
                <div style="display:flex;align-items:center;gap:8px;padding:6px 0;border-bottom:1px solid var(--border);font-size:.84rem;">
                  <input type="checkbox" checked="@item.Packed" @onchange="() => TogglePackedAsync(item)" />
                  <span style="flex:1;@(item.Packed ? "text-decoration:line-through;color:var(--text-light);" : "")">
                    @(item.ResourceItem?.Name ?? "Item") × @item.Quantity
                  </span>
                  <button class="btn btn-sm" style="padding:2px 8px;font-size:.7rem;" @onclick="() => RemovePackageItemAsync(item)">Remove</button>
                </div>
              }
            </div>
          }
          @if (_request.Status is CaseStatus.Shipped or CaseStatus.AwaitingShipment && _packageItems.Any() && _packageItems.Any(i => !i.Packed))
          {
            <div style="font-size:.76rem;color:var(--amber);margin-bottom:10px;">⚠ Not everything is packed yet.</div>
          }
          <div style="display:flex;gap:6px;">
            <select class="form-input" style="font-size:.8rem;" @bind="_newItemResourceId">
              <option value="0">— Select item —</option>
              @foreach (var inv in _inventory.Where(i => i.QuantityAvailable > 0))
              { <option value="@inv.Id">@inv.Name (@inv.QuantityAvailable available)</option> }
            </select>
            <input class="form-input" style="width:60px;font-size:.8rem;" type="number" min="1" @bind="_newItemQty" />
            <button class="btn btn-sm" @onclick="AddPackageItemAsync" disabled="@(_newItemResourceId == 0)">Add</button>
          </div>
          @if (!string.IsNullOrEmpty(_packingError))
          { <div style="font-size:.76rem;color:var(--red);margin-top:8px;">⚠ @_packingError</div> }
        </div>
      </div>

    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private PackageRequest? _request;
  private List<RequestNote> _notes = [];
  private List<RequestActivity> _activity = [];
  private List<FundAllocation> _allocations = [];
  private List<Volunteer> _volunteers = [];
  private List<VolunteerScoreResult> _candidates = [];
  private bool _loading = true;
  private bool _candidatesLoaded;
  private bool _saving;
  private bool _addingNote;
  private int? _assigningId;

  // Edit state for case details panel
  private CaseStatus _editStatus;
  private RequestPriority _editPriority;
  private int? _editAssignedVolId;
  private DateTime? _editDueDate;
  private string? _editTracking;
  private DateTime? _editShippedDate;
  private string? _editInternalNotes;

  // New note state
  private string _newNoteText = "";
  private bool _newNoteInternal = true;

  // Feedback messages
  private string _saveMsg = "";
  private string _errorMsg = "";
  private bool _quickBusy;

  // Packing list
  private List<PackageContentItem> _packageItems = [];
  private List<ResourceItem> _inventory = [];
  private List<MailingListEntry> _mailing = [];
  private List<FollowUpTracker> _trackers = [];
  private List<PackageRequest> _familyRequests = [];
  private int _newItemResourceId;
  private int _newItemQty = 1;
  private string? _packingError;

  protected override async Task OnInitializedAsync() => await LoadAsync();

  protected override async Task OnParametersSetAsync()
  {
    if (_request?.Id != Id)
      await LoadAsync();
  }

  private async Task LoadAsync()
  {
    _loading = true;
    _saveMsg = _errorMsg = "";

    var t1 = Api.GetRequestAsync(Id);
    var t2 = Api.GetRequestNotesAsync(Id);
    var t3 = Api.GetRequestActivityAsync(Id);
    var t4 = Api.GetAllocationsAsync();
    var t5 = Api.GetVolunteersAsync("Active");
    var t6 = Api.GetPackageItemsAsync(Id);
    var t7 = Api.GetInventoryAsync();
    await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7);

    _request   = t1.Result;
    _notes     = t2.Result;
    _activity  = t3.Result;
    _allocations = t4.Result;
    _volunteers  = t5.Result;
    _packageItems = t6.Result;
    _inventory    = t7.Result;

    if (_request is not null)
    {
      var famId = _request.FamilyId;
      var m = Api.GetMailingListAsync();
      var fd = Api.GetMailingListAsync(kind: MailingKind.FathersDay);
      var f = Api.GetFollowUpTrackersAsync();
      var r = Api.GetRequestsAsync(familyId: famId);
      await Task.WhenAll(m, fd, f, r);
      _mailing = m.Result.Concat(fd.Result).Where(x => x.FamilyId == famId).ToList();
      _trackers = f.Result.Where(x => x.FamilyId == famId).ToList();
      _familyRequests = r.Result;

      _editStatus        = _request.Status;
      _editPriority      = _request.Priority;
      _editAssignedVolId = _request.AssignedToId;
      _editDueDate       = _request.DueDate;
      _editTracking      = _request.TrackingNumber;
      _editShippedDate   = _request.ShippedDate;
      _editInternalNotes = _request.InternalNotes;
    }

    _loading = false;

    // Load volunteer candidates asynchronously (non-blocking — sidebar populates after)
    _candidatesLoaded = false;
    StateHasChanged();
    _candidates = await Api.GetVolunteerCandidatesAsync(Id);
    _candidatesLoaded = true;
  }

  private void ResetDetails()
  {
    if (_request is null) return;
    _editStatus        = _request.Status;
    _editPriority      = _request.Priority;
    _editAssignedVolId = _request.AssignedToId;
    _editDueDate       = _request.DueDate;
    _editTracking      = _request.TrackingNumber;
    _editShippedDate   = _request.ShippedDate;
    _editInternalNotes = _request.InternalNotes;
    _saveMsg = _errorMsg = "";
  }

  private static List<string> FormAnswerNotes(string? contactNotes) =>
    string.IsNullOrWhiteSpace(contactNotes)
      ? []
      : contactNotes.Split(" | ", StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

  private void FailSave(string message) => (_saving, _errorMsg) = (false, message);

  private async Task SaveDetailsAsync()
  {
    if (_request is null) return;
    _saving = true;
    _saveMsg = _errorMsg = "";

    // Each step is checked: stop at the first failure and say which one, keeping the edits on screen
    // (nothing is reloaded over them), instead of reporting "saved" when part of it wasn't.
    if (_editPriority != _request.Priority && !await Api.UpdateRequestPriorityAsync(_request.Id, _editPriority))
    { FailSave("Couldn't change the priority."); return; }

    if (_editAssignedVolId.HasValue && _editAssignedVolId != _request.AssignedToId
        && !await Api.AssignRequestAsync(_request.Id, _editAssignedVolId.Value))
    { FailSave($"Couldn't change the assigned volunteer: {Api.LastAssignError ?? "please try again."}"); return; }

    if (_editDueDate.HasValue && _editDueDate != _request.DueDate && !await Api.UpdateRequestDueDateAsync(_request.Id, _editDueDate.Value))
    { FailSave("Couldn't change the due date."); return; }

    // Patch tracking BEFORE status — the backend requires a tracking number to
    // already be saved before it will allow a transition into Shipped.
    if (!await Api.PatchRequestAsync(_request.Id, _editTracking, _editShippedDate, _editInternalNotes))
    { FailSave("Couldn't save the tracking number, shipped date or internal notes."); return; }

    if (_editStatus != _request.Status)
    {
      var (ok, error) = await Api.UpdateRequestStatusWithErrorAsync(_request.Id, _editStatus);
      if (!ok)
      {
        _saving = false;
        _errorMsg = error ?? "Failed to update status.";
        return;
      }
    }

    _saving = false;
    _saveMsg = "Changes saved successfully.";
    await LoadAsync();
  }

  private async Task QuickStatusAsync(CaseStatus status)
  {
    if (_request is null || _quickBusy) return;
    _quickBusy = true;
    _saveMsg = _errorMsg = "";
    var (ok, error) = await Api.UpdateRequestStatusWithErrorAsync(_request.Id, status);
    if (ok) { _saveMsg = $"Status updated to {status}."; await LoadAsync(); }
    else _errorMsg = error ?? "Failed to update status.";
    _quickBusy = false;
  }

  private static string QuickActionIcon(CaseStatus s) => s switch
  {
    CaseStatus.InProgress       => "▶",
    CaseStatus.AwaitingShipment => "📦",
    CaseStatus.Shipped          => "🚚",
    CaseStatus.Fulfilled        => "✅",
    CaseStatus.OnHold           => "⏸",
    CaseStatus.Cancelled        => "✖",
    CaseStatus.New              => "↩",
    _ => "•"
  };

  private static string QuickActionLabel(CaseStatus s) => s switch
  {
    CaseStatus.Cancelled => "Cancel Case",
    CaseStatus.OnHold    => "Put On Hold",
    _                    => $"Mark {s}"
  };

  private async Task AddPackageItemAsync()
  {
    if (_request is null || _newItemResourceId == 0) return;
    _packingError = null;
    var (ok, error) = await Api.AddPackageItemAsync(_request.Id, _newItemResourceId, _newItemQty);
    if (!ok) { _packingError = error; return; }
    _newItemResourceId = 0;
    _newItemQty = 1;
    _packageItems = await Api.GetPackageItemsAsync(_request.Id);
    _inventory    = await Api.GetInventoryAsync();
  }

  private async Task TogglePackedAsync(PackageContentItem item)
  {
    if (_request is null) return;
    var ok = await Api.TogglePackedAsync(_request.Id, item.Id);
    if (ok)
    {
      _packageItems = await Api.GetPackageItemsAsync(_request.Id);
      _inventory    = await Api.GetInventoryAsync();
    }
  }

  private async Task RemovePackageItemAsync(PackageContentItem item)
  {
    if (_request is null) return;
    var ok = await Api.RemovePackageItemAsync(_request.Id, item.Id);
    if (ok)
    {
      _packageItems = await Api.GetPackageItemsAsync(_request.Id);
      _inventory    = await Api.GetInventoryAsync();
    }
  }

  private async Task AddNoteAsync()
  {
    if (_request is null || string.IsNullOrWhiteSpace(_newNoteText)) return;
    _addingNote = true;
    _errorMsg = "";

    var note = new RequestNote
    {
      RequestId  = _request.Id,
      AuthorName = Auth.UserName,
      Content    = _newNoteText.Trim(),
      IsInternal = _newNoteInternal,
      CreatedAt  = DateTime.UtcNow
    };
    var created = await Api.CreateRequestNoteAsync(_request.Id, note);
    if (created is not null)
    {
      _notes.Add(created);
      _newNoteText = "";
    }
    else
    {
      _errorMsg = "Failed to add note.";
    }
    _addingNote = false;
  }

  private async Task UnassignAsync()
  {
    if (_request is null || _quickBusy) return;
    _quickBusy = true;
    _saveMsg = _errorMsg = "";
    if (await Api.UnassignRequestAsync(_request.Id)) { _saveMsg = "Request unassigned."; await LoadAsync(); }
    else _errorMsg = "Couldn't unassign this request.";
    _quickBusy = false;
  }

  private async Task AssignAsync(int volunteerId)
  {
    if (_request is null) return;
    _assigningId = volunteerId;
    _errorMsg = "";
    var ok = await Api.AssignRequestAsync(_request.Id, volunteerId);
    if (ok)
    {
      _saveMsg = "Volunteer assigned successfully.";
      await LoadAsync();
    }
    else _errorMsg = $"Assignment failed: {Api.LastAssignError ?? "please try again."}";
    _assigningId = null;
  }

  private static string GetStatusBadge(CaseStatus s) => s switch
  {
    CaseStatus.New              => "badge-new",
    CaseStatus.InProgress       => "badge-inprogress",
    CaseStatus.AwaitingShipment => "badge-inprogress",
    CaseStatus.Shipped          => "badge-shipped",
    CaseStatus.Fulfilled        => "badge-fulfilled",
    CaseStatus.OnHold           => "badge-onhold",
    CaseStatus.Cancelled        => "badge-cancelled",
    _ => ""
  };

  private static string GetPriorityBadge(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "badge-overdue",
    RequestPriority.High   => "badge-inprogress",
    RequestPriority.Normal => "badge-new",
    RequestPriority.Low    => "badge-fulfilled",
    _ => ""
  };

  private static string GetAllocBadge(AllocationStatus s) => s switch
  {
    AllocationStatus.Allocated   => "badge-fulfilled",
    AllocationStatus.Restricted  => "badge-inprogress",
    AllocationStatus.PendingReview => "badge-new",
    _                            => "badge-new"
  };

  private static string GetActivityIcon(ActivityType t) => t switch
  {
    ActivityType.Created        => "📄",
    ActivityType.StatusChanged  => "🔄",
    ActivityType.Assigned       => "👤",
    ActivityType.Reassigned     => "🔁",
    ActivityType.Unassigned     => "↩",
    ActivityType.NoteAdded      => "💬",
    ActivityType.PriorityChanged => "▲",
    ActivityType.DueDateSet     => "🕐",
    ActivityType.Escalated      => "⚠",
    ActivityType.Fulfilled      => "✅",
    ActivityType.Cancelled      => "✖",
    _ => "•"
  };

  private static string GetActivityLabel(RequestActivity ev) => ev.ActivityType switch
  {
    ActivityType.Created        => "created this case",
    ActivityType.StatusChanged  => $"changed status from {ev.OldValue} → {ev.NewValue}",
    ActivityType.Assigned       => $"assigned to {ev.NewValue}",
    ActivityType.Reassigned     => $"reassigned to {ev.NewValue}",
    ActivityType.Unassigned     => $"unassigned {ev.OldValue}",
    ActivityType.NoteAdded      => "added a note",
    ActivityType.PriorityChanged => $"set priority to {ev.NewValue}",
    ActivityType.DueDateSet     => $"set due date to {ev.NewValue}",
    ActivityType.Escalated      => $"escalated — {ev.Details}",
    ActivityType.Fulfilled      => "marked as fulfilled",
    ActivityType.Cancelled      => "cancelled this case",
    _ => ev.ActivityType.ToString()
  };
}
