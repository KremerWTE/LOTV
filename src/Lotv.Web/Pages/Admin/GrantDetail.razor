@page "/admin/grants/{Id:int}"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Grant Detail — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Grant Detail</h2><p>@(_grant?.GrantorName ?? $"Grant #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/grants" class="btn btn-sm">← Grants</a>
    @if (_grant is not null)
    {
      <a href="/admin/grants/@Id/edit" class="btn btn-sm btn-primary">Edit Grant</a>
    }
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_grant is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Grant #@Id not found.</div></div>
}
else
{
  @if (!string.IsNullOrEmpty(_deleteError))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_deleteError</div>
    </div>
  }

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;">
    <div>
      <div class="panel" style="margin-bottom:16px;">
        <div class="panel-head">
          <h3>@_grant.GrantorName</h3>
          <span class="badge badge-@StatusBadge(_grant.Status)" style="font-size:.68rem;">@_grant.Status</span>
        </div>
        <div class="panel-body">
          <table style="width:100%;border-collapse:collapse;">
            <tbody>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);width:35%;">Purpose</td>
                <td style="padding:8px 0;font-size:.86rem;font-weight:600;">@_grant.Purpose</td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Amount</td>
                <td style="padding:8px 0;font-size:1rem;font-weight:700;color:var(--green);">@_grant.Amount.ToString("C0")</td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Awarded Date</td>
                <td style="padding:8px 0;font-size:.86rem;">@_grant.AwardedDate.ToString("MMM d, yyyy")</td>
              </tr>
              @if (_grant.ReportDueDate.HasValue)
              {
                <tr style="border-bottom:1px solid var(--border);">
                  <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Report Due</td>
                  <td style="padding:8px 0;font-size:.86rem;color:@(_grant.ReportDueDate.Value < DateTime.Today && _grant.Status != "Reported" ? "var(--red)" : "inherit");">
                    @_grant.ReportDueDate.Value.ToString("MMM d, yyyy")
                    @if (_grant.ReportDueDate.Value < DateTime.Today && _grant.Status != "Reported")
                    {
                      <span style="font-size:.72rem;"> — OVERDUE</span>
                    }
                  </td>
                </tr>
              }
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Grant ID</td>
                <td style="padding:8px 0;font-size:.86rem;font-family:monospace;">#@_grant.Id</td>
              </tr>
              <tr>
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Chapter</td>
                <td style="padding:8px 0;font-size:.86rem;">Chapter #@_grant.ChapterId</td>
              </tr>
            </tbody>
          </table>

          @if (!string.IsNullOrEmpty(_grant.Notes))
          {
            <div style="margin-top:14px;padding:10px 14px;background:var(--bg);border-radius:6px;font-size:.82rem;color:var(--text-mid);">
              <strong>Notes:</strong> @_grant.Notes
            </div>
          }
        </div>
      </div>
    </div>

    <div>
      <div class="panel" style="margin-bottom:16px;">
        <div class="panel-head"><h3>Actions</h3></div>
        <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
          <a href="/admin/grants/@Id/edit" class="btn btn-sm btn-primary" style="text-align:center;">Edit Grant</a>
          <button class="btn btn-sm" style="background:var(--red);color:white;border:none;"
                  @onclick="Delete" disabled="@_deleteBusy">
            @(_deleteBusy ? "Deleting…" : "Delete Grant")
          </button>
        </div>
      </div>

      @if (_grant.ReportDueDate.HasValue)
      {
        <div class="panel">
          <div class="panel-head"><h3>Reporting</h3></div>
          <div class="panel-body">
            <div style="font-size:.78rem;color:var(--text-light);margin-bottom:4px;">Report Due</div>
            <div style="font-size:.9rem;font-weight:600;margin-bottom:10px;">@_grant.ReportDueDate.Value.ToString("MMM d, yyyy")</div>
            <div style="font-size:.78rem;color:var(--text-light);margin-bottom:4px;">Status</div>
            <span class="badge badge-@StatusBadge(_grant.Status)" style="font-size:.72rem;">@_grant.Status</span>
          </div>
        </div>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private GrantDto? _grant;
  private bool _loading = true, _deleteBusy;
  private string _deleteError = "";

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetGrantsAsync();
    _grant = all.FirstOrDefault(g => g.Id == Id);
    _loading = false;
  }

  private async Task Delete()
  {
    if (!await ConfirmAsync()) return;
    _deleteBusy = true;
    var ok = await Api.DeleteGrantAsync(Id);
    _deleteBusy = false;
    if (ok) Nav.NavigateTo("/admin/grants");
    else _deleteError = "Delete failed. Please try again.";
  }

  private async Task<bool> ConfirmAsync() => true;

  private static string StatusBadge(string s) => s switch
  {
    "Received"  => "fulfilled",
    "Reported"  => "fulfilled",
    "Active"    => "new",
    "Applied"   => "onhold",
    "Denied"    => "cancelled",
    _           => "new"
  };
}
