@page "/admin/inventory/{Id:int}/edit"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Edit Inventory Item — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Edit Inventory Item</h2><p>@(_item?.Name ?? $"Item #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/inventory/@Id" class="btn btn-sm">← Item Detail</a>
    <a href="/admin/inventory" class="btn btn-sm">Inventory</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_item is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Item #@Id not found.</div></div>
}
else
{
  @if (_saved)
  {
    <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--green);font-weight:600;">Item updated. <a href="/admin/inventory/@Id" style="color:var(--green);">View detail →</a></div>
    </div>
  }
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  <div style="max-width:640px;">
    <div class="panel">
      <div class="panel-head"><h3>Item Details</h3></div>
      <div class="panel-body">
        <div class="form-group">
          <label class="form-label">Item Name *</label>
          <input class="form-input" @bind="_name" placeholder="e.g. Memory Box Set" />
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px;">
          <div class="form-group">
            <label class="form-label">Category *</label>
            <select class="form-input" @bind="_category">
              @foreach (var c in Enum.GetValues<ResourceCategory>())
              {
                <option value="@c">@c</option>
              }
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Unit *</label>
            <input class="form-input" @bind="_unit" placeholder="e.g. set, box, bag" />
          </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px;">
          <div class="form-group">
            <label class="form-label">Qty On Hand</label>
            <input class="form-input" type="number" min="0" @bind="_quantityOnHand" />
          </div>
          <div class="form-group">
            <label class="form-label">Qty Reserved</label>
            <input class="form-input" type="number" min="0" @bind="_quantityReserved" />
          </div>
        </div>

        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Description</label>
          <textarea class="form-input" rows="3" @bind="_description" placeholder="Storage location, special handling, supplier info…"></textarea>
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
          <a href="/admin/inventory/@Id" class="btn btn-sm">Cancel</a>
          <button class="btn btn-primary" @onclick="Save" disabled="@_busy">@(_busy ? "Saving…" : "Save Changes")</button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private ResourceItem? _item;
  private bool _loading = true, _busy, _saved;
  private string _error = "";
  private string _name = "", _unit = "unit", _description = "";
  private ResourceCategory _category;
  private int _quantityOnHand, _quantityReserved;

  protected override async Task OnInitializedAsync()
  {
    _item = await Api.GetInventoryItemAsync(Id);
    if (_item is not null)
    {
      _name             = _item.Name;
      _category         = _item.Category;
      _unit             = _item.Unit;
      _quantityOnHand   = _item.QuantityOnHand;
      _quantityReserved = _item.QuantityReserved;
      _description      = _item.Description ?? "";
    }
    _loading = false;
  }

  private async Task Save()
  {
    _error = ""; _saved = false;
    if (string.IsNullOrWhiteSpace(_name)) { _error = "Name is required."; return; }
    if (string.IsNullOrWhiteSpace(_unit)) { _error = "Unit is required."; return; }

    _busy = true;
    var updated = new ResourceItem
    {
      Id               = Id,
      ChapterId        = _item!.ChapterId,
      Name             = _name,
      Category         = _category,
      Unit             = _unit,
      QuantityOnHand   = _quantityOnHand,
      QuantityReserved = _quantityReserved,
      Description      = string.IsNullOrWhiteSpace(_description) ? null : _description,
      CreatedAt        = _item.CreatedAt,
      UpdatedAt        = DateTime.UtcNow,
    };
    var ok = await Api.UpdateInventoryItemAsync(Id, updated);
    _busy = false;
    if (ok) { _saved = true; _item = updated; }
    else _error = "Save failed. Please try again.";
  }
}
