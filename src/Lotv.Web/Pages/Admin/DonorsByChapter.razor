@page "/admin/donors/by-chapter"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Donors by Chapter — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Donors by Chapter</h2><p>Donor distribution across ministry chapters</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors" class="btn btn-sm">← All Donors</a>
    <a href="/admin/by-donor" class="btn btn-sm">By Donor</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">Total Donors</div>
      <div class="kpi-value" style="color:var(--navy)">@_donors.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Total Given</div>
      <div class="kpi-value" style="color:var(--green)">@_donors.Sum(d => d.TotalGiven).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#127968;</div>
      <div class="kpi-label">Chapters w/ Donors</div>
      <div class="kpi-value" style="color:var(--amber)">@_donors.Where(d => d.ChapterId > 0).Select(d => d.ChapterId).Distinct().Count()</div>
    </div>
  </div>

  @foreach (var g in _donors.GroupBy(d => d.ChapterId).OrderByDescending(g => g.Sum(d => d.TotalGiven)))
  {
    var chName = g.Key > 0 && _chapterMap.TryGetValue(g.Key, out var n) ? n : "No Chapter";
    var groupTotal = g.Sum(d => d.TotalGiven);
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head">
        <h3>@chName <span style="font-size:.78rem;font-weight:400;color:var(--text-light);">(@g.Count() donors · @groupTotal.ToString("C0") total)</span></h3>
        @if (g.Key > 0)
        {
          <a href="/admin/chapters/@g.Key/donors" style="font-size:.8rem;color:var(--navy);">View chapter →</a>
        }
      </div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Donor</th>
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Tier</th>
              <th style="padding:8px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Total Given</th>
              <th style="padding:8px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Gifts</th>
              <th style="padding:8px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var d in g.OrderByDescending(d => d.TotalGiven).Take(10))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:8px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/donors/@d.Id" style="color:var(--navy);">@d.FullName</a>
                </td>
                <td style="padding:8px 16px;font-size:.82rem;color:var(--text-light);">@d.Tier</td>
                <td style="padding:8px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@d.TotalGiven.ToString("C0")</td>
                <td style="padding:8px 16px;font-size:.82rem;text-align:right;color:var(--text-light);">@d.GiftCount</td>
                <td style="padding:8px 16px;text-align:center;">
                  <a href="/admin/donors/@d.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
            @if (g.Count() > 10)
            {
              <tr style="border-top:1px solid var(--border);">
                <td colspan="5" style="padding:8px 16px;font-size:.78rem;color:var(--text-light);text-align:center;">
                  + @(g.Count() - 10) more donors
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
}

@code {
  private List<Donor> _donors = [];
  private Dictionary<int, string> _chapterMap = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var donorTask = Api.GetDonorsAsync();
    var chapTask  = Api.GetChaptersAdminAsync();
    await Task.WhenAll(donorTask, chapTask);
    _donors     = await donorTask;
    var chapters = await chapTask;
    _chapterMap  = chapters.ToDictionary(c => c.Id, c => c.Name);
    _loading = false;
  }
}
