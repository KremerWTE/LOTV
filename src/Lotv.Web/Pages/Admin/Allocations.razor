@page "/admin/allocations"
@layout AdminLayout
@inject ApiService Api
@inject AuthService Auth

<PageTitle>Fund Allocations — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Fund Allocations</h2><p>Review and approve pending donation allocations</p></div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">✅</div>
    <div class="kpi-label">Allocated</div>
    <div class="kpi-value" style="color:var(--green)"><Money Amount="@_allocs.Where(a => a.Status == AllocationStatus.Allocated).Sum(a => a.Amount)" /></div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">🕐</div>
    <div class="kpi-label">Pending Review</div>
    <div class="kpi-value" style="color:var(--amber)"><Money Amount="@_allocs.Where(a => a.Status == AllocationStatus.PendingReview).Sum(a => a.Amount)" /></div>
  </div>
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">📋</div>
    <div class="kpi-label">Unallocated</div>
    <div class="kpi-value" style="color:var(--navy)"><Money Amount="@_allocs.Where(a => a.Status == AllocationStatus.Unallocated).Sum(a => a.Amount)" /></div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">💸</div>
    <div class="kpi-label">Total Tracked</div>
    <div class="kpi-value" style="color:var(--gold)"><Money Amount="@_allocs.Sum(a => a.Amount)" /></div>
  </div>
</div>

<div class="filter-bar">
  @foreach (var f in new[]{"All","Pending","Approved","Unallocated"})
  { <button class="filter-chip @(_filter == f ? "active" : "")" aria-pressed="@(_filter == f)" @onclick="() => _filter = f">@f</button> }
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr><th>ID</th><th>Donor</th><th>Amount</th><th>Allocated To</th><th>Status</th><th>Approved By</th><th>Date</th><th></th></tr>
      </thead>
      <tbody>
        @foreach (var a in Filtered)
        {
          <tr>
            <td style="font-size:.74rem;color:var(--text-light);">#@a.Id</td>
            <td><strong>@(a.Donation?.Donor?.FullName ?? $"Donation #{a.DonationId}")</strong></td>
            <td style="font-weight:700;color:var(--green);"><Money Amount="@a.Amount" /></td>
            <td style="font-size:.82rem;">@a.AllocatedTo</td>
            <td>
              @switch (a.Status)
              {
                case AllocationStatus.Allocated:
                  <span class="badge badge-fulfilled">Approved</span>
                  break;
                case AllocationStatus.PendingReview:
                  <span class="badge badge-inprogress">Pending</span>
                  break;
                default:
                  <span class="badge badge-onhold">Unallocated</span>
                  break;
              }
            </td>
            <td style="font-size:.78rem;color:var(--text-mid);">@(a.ApprovedBy ?? "—")</td>
            <td style="font-size:.76rem;color:var(--text-light);">@a.CreatedAt.ToString("MMM d")</td>
            <td style="display:flex;gap:6px;">
              @if (a.Status == AllocationStatus.PendingReview)
              { <button class="btn btn-sm btn-primary" @onclick="() => OpenReview(a)">Review</button> }
              @if (a.Status == AllocationStatus.Unallocated)
              { <button class="btn btn-sm btn-navy" @onclick="() => OpenReview(a)">Allocate</button> }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<!-- REVIEW DRAWER -->
@if (_reviewing is not null)
{
  <div class="drawer-overlay" @onclick="CloseReview"></div>
  <div class="drawer">
    <div class="drawer-head">
      <h3>@(_reviewing.Status == AllocationStatus.Unallocated ? "Allocate Funds" : "Review Allocation")</h3>
      <button class="drawer-close" @onclick="CloseReview">✕</button>
    </div>
    <div class="drawer-body">
      <div style="background:var(--green-pale);border-radius:10px;padding:14px 16px;font-size:.84rem;margin-bottom:4px;">
        <div><strong>Donor:</strong> @(_reviewing.Donation?.Donor?.FullName ?? $"Donation #{_reviewing.DonationId}")</div>
        <div style="margin-top:4px;"><strong>Amount:</strong> <span style="color:var(--green);font-weight:700;"><Money Amount="@_reviewing.Amount" /></span></div>
        <div style="margin-top:4px;"><strong>Received:</strong> @_reviewing.CreatedAt.ToString("MMM d, yyyy")</div>
      </div>
      <div class="form-group">
        <label class="form-label">Allocate To *</label>
        <input class="form-input" @bind="_reviewAllocTo" placeholder="e.g. Package Fund, Case #42, Gala Expenses" />
        <div style="font-size:.72rem;color:var(--text-light);margin-top:4px;">Case ID, program name, or expense category.</div>
      </div>
      <div class="form-group">
        <label class="form-label">Notes</label>
        <textarea class="form-textarea" @bind="_reviewNotes" placeholder="Optional internal notes..." rows="3"></textarea>
      </div>
      @if (!string.IsNullOrEmpty(_reviewError))
      { <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;">⚠ @_reviewError</div> }
    </div>
    <div class="drawer-footer">
      <button class="btn btn-primary" @onclick="ConfirmApproval">Approve &amp; Allocate</button>
      <button class="btn" @onclick="CloseReview">Cancel</button>
    </div>
  </div>
}

@if (_approvedMsg)
{
  <div style="position:fixed;bottom:24px;right:24px;background:var(--green);color:white;padding:12px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:.88rem;font-weight:600;z-index:600;">
    ✓ Allocation approved
  </div>
}

@code {
  private List<FundAllocation> _allocs = [];
  private string _filter = "All";
  private bool _approvedMsg;
  private FundAllocation? _reviewing;
  private string _reviewAllocTo = "";
  private string _reviewNotes   = "";
  private string _reviewError   = "";

  private IEnumerable<FundAllocation> Filtered => _allocs.Where(a => _filter switch
  {
    "Pending"     => a.Status == AllocationStatus.PendingReview,
    "Approved"    => a.Status == AllocationStatus.Allocated,
    "Unallocated" => a.Status == AllocationStatus.Unallocated,
    _             => true
  });

  protected override async Task OnInitializedAsync()
    => _allocs = await Api.GetAllocationsAsync();

  private void OpenReview(FundAllocation a)
  {
    _reviewing     = a;
    _reviewAllocTo = a.AllocatedTo ?? "";
    _reviewNotes   = a.Notes ?? "";
    _reviewError   = "";
  }

  private void CloseReview() { _reviewing = null; _reviewError = ""; }

  private async Task ConfirmApproval()
  {
    if (string.IsNullOrWhiteSpace(_reviewAllocTo))
    { _reviewError = "Please specify where these funds are allocated."; return; }

    _reviewing!.AllocatedTo = _reviewAllocTo.Trim();
    _reviewing.Notes        = string.IsNullOrWhiteSpace(_reviewNotes) ? null : _reviewNotes.Trim();
    _reviewing.Status       = AllocationStatus.Allocated;
    _reviewing.ApprovedBy   = Auth.UserName;
    _reviewing.ApprovedAt   = DateTime.UtcNow;
    var result = await Api.UpdateAllocationAsync(_reviewing.Id, _reviewing);
    if (result is null)
    { _reviewError = "Failed to approve this allocation. Please try again."; return; }

    _allocs      = await Api.GetAllocationsAsync();
    _reviewing   = null;
    _approvedMsg = true;
    StateHasChanged();
    await Task.Delay(2500);
    _approvedMsg = false;
    StateHasChanged();
  }
}
