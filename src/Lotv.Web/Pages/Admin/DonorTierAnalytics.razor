@page "/admin/donors/tier-analytics"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Donor Tier Analytics — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Donor Tier Analytics</h2><p>Giving concentration, distribution, and performance by tier</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors" class="btn btn-sm">← All Donors</a>
    <a href="/admin/donors/tiers" class="btn btn-sm">Tier Management</a>
    <a href="/admin/donors/top" class="btn btn-sm">Top Donors</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">Total Donors</div>
      <div class="kpi-value" style="color:var(--navy)">@_donors.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Total Given</div>
      <div class="kpi-value" style="color:var(--green)">@_donors.Sum(d => d.TotalGiven).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128200;</div>
      <div class="kpi-label">Avg Per Donor</div>
      <div class="kpi-value" style="color:var(--amber)">@(_donors.Any() ? _donors.Average(d => d.TotalGiven).ToString("C0") : "—")</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#127942;</div>
      <div class="kpi-label">Active Tiers</div>
      <div class="kpi-value" style="color:var(--navy)">@_donors.Select(d => d.Tier).Distinct().Count()</div>
    </div>
  </div>

  @foreach (var grp in _donors.GroupBy(d => d.Tier).OrderBy(g => TierOrder(g.Key)))
  {
    var grpTotal  = grp.Sum(d => d.TotalGiven);
    var grpAvg    = grp.Average(d => d.TotalGiven);
    var allTotal  = _donors.Sum(d => d.TotalGiven);
    var pct       = allTotal > 0 ? grpTotal / allTotal * 100m : 0m;
    <div class="panel" style="margin-bottom:16px;border-left:4px solid @TierColor(grp.Key);">
      <div class="panel-head">
        <h3>
          <span style="margin-right:6px;">@TierIcon(grp.Key)</span>
          @grp.Key
          <span style="font-size:.78rem;font-weight:400;color:var(--text-light);margin-left:8px;">— @grp.Count() donors</span>
        </h3>
        <span style="font-size:.82rem;color:var(--text-light);">@pct.ToString("F0")% of total giving</span>
      </div>
      <div class="panel-body">
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:16px;">
          <div style="text-align:center;">
            <div style="font-size:1.3rem;font-weight:700;color:@TierColor(grp.Key);">@grp.Count()</div>
            <div style="font-size:.74rem;color:var(--text-light);">Donors</div>
          </div>
          <div style="text-align:center;">
            <div style="font-size:1.3rem;font-weight:700;color:var(--green);">@grpTotal.ToString("C0")</div>
            <div style="font-size:.74rem;color:var(--text-light);">Total Given</div>
          </div>
          <div style="text-align:center;">
            <div style="font-size:1.3rem;font-weight:700;color:var(--amber);">@grpAvg.ToString("C0")</div>
            <div style="font-size:.74rem;color:var(--text-light);">Avg Per Donor</div>
          </div>
          <div style="text-align:center;">
            <div style="font-size:1.3rem;font-weight:700;color:var(--navy);">@pct.ToString("F0")%</div>
            <div style="font-size:.74rem;color:var(--text-light);">Share of Giving</div>
          </div>
        </div>
        <div style="background:var(--bg);border-radius:4px;height:8px;overflow:hidden;">
          <div style="background:@TierColor(grp.Key);height:100%;width:@Math.Min(100,pct).ToString("F0")%;transition:width .3s;"></div>
        </div>
      </div>
      <div class="panel-body" style="padding:0;border-top:1px solid var(--border);">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:8px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Donor</th>
              <th style="padding:8px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Total Given</th>
              <th style="padding:8px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var d in grp.OrderByDescending(d => d.TotalGiven).Take(5))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:8px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/donors/@d.Id" style="color:var(--navy);">@d.FullName</a>
                </td>
                <td style="padding:8px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@d.TotalGiven.ToString("C0")</td>
                <td style="padding:8px 16px;text-align:center;">
                  <a href="/admin/donors/@d.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
            @if (grp.Count() > 5)
            {
              <tr style="border-top:1px solid var(--border);">
                <td colspan="3" style="padding:8px 16px;font-size:.76rem;color:var(--text-light);text-align:center;">
                  + @(grp.Count() - 5) more in this tier
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
}

@code {
  private List<Donor> _donors = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    _donors  = await Api.GetDonorsAsync();
    _loading = false;
  }

  private static int TierOrder(DonorTier t) => t switch
  {
    DonorTier.Benefactor => 0,
    DonorTier.Champion   => 1,
    DonorTier.Supporter  => 2,
    DonorTier.Friend     => 3,
    _                    => 99
  };

  private static string TierColor(DonorTier t) => t switch
  {
    DonorTier.Benefactor => "#6366f1",
    DonorTier.Champion   => "#d97706",
    DonorTier.Supporter  => "#6b7280",
    DonorTier.Friend     => "var(--green)",
    _                    => "var(--border)"
  };

  private static string TierIcon(DonorTier t) => t switch
  {
    DonorTier.Benefactor => "◆",
    DonorTier.Champion   => "★",
    DonorTier.Supporter  => "◇",
    DonorTier.Friend     => "♥",
    _                    => "·"
  };
}
