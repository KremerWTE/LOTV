@page "/admin/events/new"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>New Event — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Create Event</h2><p>Schedule a new ministry event</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events" class="btn btn-sm">← Events</a>
  </div>
</div>

@if (_saved)
{
  <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--green);font-weight:600;">Event created. Redirecting…</div>
  </div>
}
@if (!string.IsNullOrEmpty(_error))
{
  <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--red);">@_error</div>
  </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
  <div>
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h3>Event Details</h3></div>
      <div class="panel-body">
        <div class="form-group">
          <label class="form-label">Title *</label>
          <input class="form-input" @bind="_title" placeholder="Event name" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Type</label>
          <select class="form-input" @bind="_type">
            @foreach (var t in Enum.GetValues<EventType>())
            {
              <option value="@t">@t</option>
            }
          </select>
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Description</label>
          <textarea class="form-input" rows="4" @bind="_description" placeholder="Event description for attendees…"></textarea>
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Notes (staff only)</label>
          <textarea class="form-input" rows="2" @bind="_notes" placeholder="Internal planning notes…"></textarea>
        </div>
      </div>
    </div>
  </div>

  <div>
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h3>Schedule & Location</h3></div>
      <div class="panel-body">
        <div class="form-group">
          <label class="form-label">Start Date & Time *</label>
          <input class="form-input" type="datetime-local" @bind="_date" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">End Date & Time</label>
          <input class="form-input" type="datetime-local" @bind="_endDate" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label" style="display:flex;align-items:center;gap:8px;cursor:pointer;">
            <input type="checkbox" @bind="_isVirtual" style="width:16px;height:16px;" />
            <span>Virtual event</span>
          </label>
        </div>
        @if (_isVirtual)
        {
          <div class="form-group" style="margin-top:10px;">
            <label class="form-label">Meeting Link</label>
            <input class="form-input" @bind="_meetingLink" placeholder="https://zoom.us/j/…" />
          </div>
        }
        else
        {
          <div class="form-group" style="margin-top:10px;">
            <label class="form-label">Location *</label>
            <input class="form-input" @bind="_location" placeholder="Venue name and address" />
          </div>
        }
      </div>
    </div>

    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h3>Capacity & Tickets</h3></div>
      <div class="panel-body">
        <div class="form-group">
          <label class="form-label">Capacity</label>
          <input class="form-input" type="number" min="0" @bind="_capacity" placeholder="Leave blank for unlimited" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Ticket Price</label>
          <input class="form-input" type="number" step="5" min="0" @bind="_ticketPrice" placeholder="0.00 = free" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Fundraising Goal</label>
          <input class="form-input" type="number" step="100" min="0" @bind="_goalAmount" placeholder="0.00 = no goal" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Chapter *</label>
          <select class="form-input" @bind="_chapterId">
            <option value="0">— Select chapter —</option>
            @foreach (var c in _chapters)
            {
              <option value="@c.Id">@c.Name</option>
            }
          </select>
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Status</label>
          <select class="form-input" @bind="_status">
            <option value="@EventStatus.Draft">Draft</option>
            <option value="@EventStatus.Published">Published</option>
            <option value="@EventStatus.Open">Open (accepting registrations)</option>
          </select>
        </div>
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:10px;justify-content:flex-end;margin-top:4px;">
  <a href="/admin/events" class="btn btn-sm">Cancel</a>
  <button class="btn btn-primary" @onclick="Submit" disabled="@_busy">@(_busy ? "Saving…" : "Create Event")</button>
</div>

@code {
  private string _title = "", _description = "", _notes = "", _location = "", _meetingLink = "";
  private EventType _type;
  private EventStatus _status = EventStatus.Draft;
  private DateTime _date = DateTime.Today.AddDays(7);
  private DateTime? _endDate;
  private int? _capacity;
  private decimal? _ticketPrice, _goalAmount;
  private bool _isVirtual, _busy, _saved;
  private int _chapterId;
  private string _error = "";
  private List<Chapter> _chapters = [];

  protected override async Task OnInitializedAsync()
  {
    _chapters = await Api.GetChaptersAdminAsync();
  }

  private async Task Submit()
  {
    _error = "";
    if (string.IsNullOrWhiteSpace(_title)) { _error = "Title is required."; return; }
    if (!_isVirtual && string.IsNullOrWhiteSpace(_location)) { _error = "Location is required for in-person events."; return; }
    if (_chapterId == 0) { _error = "Please select a chapter."; return; }

    _busy = true;
    var evt = new MinistryEvent
    {
      Title        = _title,
      Type         = _type,
      Status       = _status,
      ChapterId    = _chapterId,
      Date         = _date,
      EndDate      = _endDate,
      Location     = _isVirtual ? (_meetingLink ?? "Virtual") : _location,
      Description  = string.IsNullOrWhiteSpace(_description) ? null : _description,
      Capacity     = _capacity is > 0 ? _capacity : null,
      TicketPrice  = _ticketPrice is > 0 ? _ticketPrice : null,
      GoalAmount   = _goalAmount is > 0 ? _goalAmount : null,
      IsVirtual    = _isVirtual,
      MeetingLink  = _isVirtual ? _meetingLink : null,
      Notes        = string.IsNullOrWhiteSpace(_notes) ? null : _notes,
      CreatedBy    = "",
    };
    var result = await Api.CreateEventAsync(evt);
    _busy = false;
    if (result is not null)
    {
      _saved = true;
      await Task.Delay(700);
      Nav.NavigateTo("/admin/events");
    }
    else _error = "Save failed. Please try again.";
  }
}
