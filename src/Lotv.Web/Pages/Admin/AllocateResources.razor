@page "/admin/allocate/resources"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Allocate Resources — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Allocate Resource Donation</h2>
    <p>Assign donated physical goods to a specific family request</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/allocations" class="btn btn-sm">&#8592; Back to Allocations</a>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 360px;gap:20px;align-items:start;">

  <!-- FORM -->
  <div class="panel">
    <div class="panel-header">Resource Allocation</div>
    <div class="panel-body" style="display:flex;flex-direction:column;gap:16px;">

      <!-- Step 1: Resource donation -->
      <div class="form-group">
        <label class="form-label">1. Select Resource Donation *</label>
        @if (_resourceDonations.Any())
        {
          <select class="form-input" @onchange="OnResourceSelected">
            <option value="">— Choose a donated resource —</option>
            @foreach (var r in _resourceDonations)
            {
              <option value="@r.Id">@(r.Name.Length > 0 ? r.Name : CategoryLabel(r.Category)) — @r.QuantityOnHand @r.Unit</option>
            }
          </select>
        }
        else
        {
          <div style="font-size:.84rem;color:var(--text-light);padding:10px 0;">No unallocated resource donations found.</div>
        }
      </div>

      @if (_selected != null)
      {
        <div style="background:var(--green-pale);border-radius:8px;padding:12px 14px;font-size:.84rem;">
          <div style="font-weight:700;color:var(--navy);margin-bottom:4px;">@(_selected.Name.Length > 0 ? _selected.Name : CategoryLabel(_selected.Category)) @(string.IsNullOrEmpty(_selected.Description) ? "" : $"— {_selected.Description}")</div>
          <div style="color:var(--text-mid);">
            Available: <strong style="color:var(--green);">@_selected.QuantityOnHand @_selected.Unit</strong>
            &bull; Added: @_selected.CreatedAt.ToString("MMM d, yyyy")
          </div>
        </div>
      }

      <!-- Step 2: Target request -->
      <div class="form-group">
        <label class="form-label">2. Allocate To Request *</label>
        <select class="form-input" @onchange='e => int.TryParse(e.Value?.ToString(), out _requestId)'>
          <option value="0">— Select a family request —</option>
          @foreach (var req in _requests)
          {
            <option value="@req.Id">Case #@req.Id — @(req.Family?.FullName ?? $"Family #{req.FamilyId}") (@req.Category)</option>
          }
        </select>
      </div>

      <!-- Step 3: Quantity -->
      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">3. Quantity to Allocate *</label>
          <input class="form-input" type="number" min="1" @bind="_quantity" placeholder="0" />
          @if (_selected != null && _quantity > _selected.QuantityOnHand)
          {
            <div style="font-size:.76rem;color:var(--blush);margin-top:3px;">&#9888; Exceeds available quantity of @_selected.QuantityOnHand @_selected.Unit</div>
          }
        </div>
        <div class="form-group">
          <label class="form-label">Unit</label>
          <input class="form-input" value="@(_selected?.Unit ?? "")" disabled />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Delivery Notes</label>
        <textarea class="form-input" rows="3" @bind="_notes" placeholder="e.g. Confirm delivery address, leave with neighbor, etc."></textarea>
      </div>

      @if (!string.IsNullOrEmpty(_error))
      {
        <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;">&#9888; @_error</div>
      }
      @if (_success)
      {
        <div style="background:var(--green-pale);border-radius:8px;padding:10px 14px;font-size:.84rem;color:var(--green-dark);">&#10003; Resource allocation recorded. <a href="/admin/allocations" style="color:var(--green);">View ledger &rarr;</a></div>
      }

      <div style="display:flex;gap:10px;">
        <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@(_busy || _success)">
          @(_busy ? "Saving…" : "Record Allocation")
        </button>
        <button class="btn" @onclick="ResetForm">Clear</button>
      </div>
    </div>
  </div>

  <!-- SIDEBAR: summary -->
  <div>
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-header">Resource Inventory</div>
      <div class="panel-body" style="padding:0;">
        @if (!_resourceDonations.Any())
        {
          <div style="padding:16px;text-align:center;color:var(--text-light);font-size:.82rem;">No resources in inventory</div>
        }
        else
        {
          @foreach (var r in _resourceDonations.Take(8))
          {
            <div style="padding:10px 14px;border-bottom:1px solid var(--border);font-size:.8rem;">
              <div style="font-weight:600;margin-bottom:2px;">@(r.Name.Length > 0 ? r.Name : CategoryLabel(r.Category))</div>
              <div style="color:var(--text-light);">@r.QuantityOnHand @r.Unit &bull; @r.CreatedAt.ToString("MMM d")</div>
            </div>
          }
        }
      </div>
    </div>

    <div class="panel">
      <div class="panel-header">Tip</div>
      <div class="panel-body">
        <p style="font-size:.82rem;color:var(--text-mid);margin:0;line-height:1.5;">
          After recording an allocation, the family's case will show which resources have been assigned.
          Update the case status to <strong>AwaitingShipment</strong> once resources are ready to be delivered.
        </p>
      </div>
    </div>
  </div>

</div>

@code {
  private List<ResourceItem>   _resourceDonations = [];
  private List<PackageRequest> _requests          = [];

  private ResourceItem? _selected;
  private int     _requestId;
  private int     _quantity;
  private string  _notes = "";

  private bool   _busy;
  private bool   _success;
  private string _error = "";

  protected override async Task OnInitializedAsync()
  {
    var t1 = Api.GetRequestsAsync();
    var t2 = Api.GetInventoryAsync();
    await Task.WhenAll(t1, t2);
    _requests          = t1.Result.Where(r => r.Status is CaseStatus.New or CaseStatus.InProgress).ToList();
    _resourceDonations = t2.Result.Where(r => r.QuantityOnHand > 0).ToList();
  }

  private void OnResourceSelected(ChangeEventArgs e)
  {
    if (int.TryParse(e.Value?.ToString(), out var id))
    {
      _selected = _resourceDonations.FirstOrDefault(r => r.Id == id);
      _quantity  = _selected?.QuantityOnHand ?? 0;
    }
    else
    {
      _selected = null;
      _quantity  = 0;
    }
  }

  private async Task SubmitAsync()
  {
    _error = "";
    if (_selected == null)                       { _error = "Please select a resource item.";         return; }
    if (_requestId == 0)                         { _error = "Please select a request to allocate to."; return; }
    if (_quantity <= 0)                          { _error = "Quantity must be greater than zero.";     return; }
    if (_quantity > _selected.QuantityOnHand)    { _error = "Quantity exceeds available stock.";       return; }

    _busy = true;
    var ok = await Api.AllocateResourceAsync(_selected.Id, _requestId, _quantity, _notes);
    if (ok)
    {
      _selected.QuantityOnHand -= _quantity;  // update local state
      _success = true;
    }
    else
    {
      _error = "Failed to record allocation. Please try again.";
    }
    _busy = false;
  }

  private static string CategoryLabel(ResourceCategory c) => c switch
  {
    ResourceCategory.BabyClothing       => "Baby Clothing",
    ResourceCategory.MemoryBox          => "Memory Box",
    ResourceCategory.GriefBook          => "Grief Book",
    ResourceCategory.KnittedBlanket     => "Knitted Blanket",
    ResourceCategory.CarePackage        => "Care Package",
    ResourceCategory.HospitalSupply     => "Hospital Supply",
    _                                   => "Other Good"
  };

  private void ResetForm()
  {
    _selected   = null;
    _requestId  = 0;
    _quantity   = 0;
    _notes      = "";
    _error      = "";
    _success    = false;
  }
}
