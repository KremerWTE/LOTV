@page "/admin/cases/by-reason"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Cases by Reason — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Cases by Reason</h2><p>Open and fulfilled cases grouped by ministry reason</p></div>
  <div class="page-hd-actions">
    <a href="/admin/cases" class="btn btn-sm">← All Cases</a>
    <a href="/admin/cases/by-chapter" class="btn btn-sm">By Chapter</a>
    <a href="/admin/cases/heat-map" class="btn btn-sm">Heat Map</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Loading cases by reason…" />
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">💕</div>
      <div class="kpi-label">Total Open</div>
      <div class="kpi-value" style="color:var(--navy)">@_open.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">☑</div>
      <div class="kpi-label">Fulfilled (All Time)</div>
      <div class="kpi-value" style="color:var(--green)">@_fulfilled.Count</div>
    </div>
    <div class="kpi-card kpi-blush">
      <div class="kpi-icon">🏦</div>
      <div class="kpi-label">Reason Categories</div>
      <div class="kpi-value" style="color:var(--blush)">@_groups.Count</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Fulfillment Rate</div>
      <div class="kpi-value" style="color:var(--amber)">@_fulfillmentRate%</div>
      <div class="kpi-change">fulfilled of all cases</div>
    </div>
  </div>

  <!-- BREAKDOWN BAR CHART -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">
      <h3>Volume by Reason</h3>
      <div style="display:flex;gap:12px;font-size:.74rem;align-items:center;">
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:var(--navy);border-radius:2px;display:inline-block;"></span> Open</span>
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:var(--green);border-radius:2px;display:inline-block;"></span> Fulfilled</span>
      </div>
    </div>
    <div class="panel-body" style="display:flex;flex-direction:column;gap:14px;">
      @{ var maxTotal = _groups.Any() ? _groups.Max(g => g.Open + g.Fulfilled) : 1; }
      @foreach (var g in _groups.OrderByDescending(g => g.Open + g.Fulfilled))
      {
        var total    = g.Open + g.Fulfilled;
        var openPct  = maxTotal > 0 ? (int)(g.Open      * 100.0 / maxTotal) : 0;
        var fulPct   = maxTotal > 0 ? (int)(g.Fulfilled * 100.0 / maxTotal) : 0;
        var rate     = total > 0 ? (int)(g.Fulfilled * 100.0 / total) : 0;
        <div>
          <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:5px;">
            <span style="font-weight:700;color:var(--text-dark);">@g.Label</span>
            <span style="color:var(--text-mid);font-size:.76rem;">@g.Open open · @g.Fulfilled fulfilled · <span style="color:var(--green);font-weight:600;">@rate% rate</span></span>
          </div>
          <div style="display:flex;height:10px;border-radius:5px;overflow:hidden;background:var(--bg-light,#f5f5f5);">
            <div style="width:@openPct%;background:var(--navy);"></div>
            <div style="width:@fulPct%;background:var(--green);"></div>
          </div>
        </div>
      }
    </div>
  </div>

  <!-- PER-REASON PANELS -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
    @foreach (var g in _groups.OrderByDescending(g => g.Open + g.Fulfilled))
    {
      <div class="panel">
        <div class="panel-head">
          <h3>@g.Label</h3>
          <div style="display:flex;gap:8px;">
            <span class="badge badge-inprogress">@g.Open open</span>
            <span class="badge badge-fulfilled">@g.Fulfilled fulfilled</span>
          </div>
        </div>
        <div class="panel-body" style="padding:0;">
          @if (!g.OpenCases.Any())
          {
            <div style="padding:20px;text-align:center;color:var(--text-light);font-size:.82rem;">No open cases in this category.</div>
          }
          else
          {
            <table class="data-table">
              <thead><tr><th>Family</th><th>Status</th><th>Age</th><th>Assigned</th></tr></thead>
              <tbody>
                @foreach (var c in g.OpenCases.OrderBy(c => c.DueDate ?? DateTime.MaxValue).Take(5))
                {
                  <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/cases/{c.Id}")'>
                    <td>
                      <strong>@c.Family?.FullName</strong>
                      @if (c.IsOverdue) { <span class="badge badge-overdue" style="margin-left:4px;font-size:.58rem;">OD</span> }
                    </td>
                    <td><span class="badge @StatusBadge(c.Status)" style="font-size:.62rem;">@c.Status</span></td>
                    <td style="font-size:.72rem;color:var(--text-light);">@Age(c.CreatedAt)</td>
                    <td style="font-size:.72rem;color:var(--text-mid);max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(c.AssignedTo ?? "—")</td>
                  </tr>
                }
              </tbody>
            </table>
            @if (g.OpenCases.Count > 5)
            {
              <div style="padding:8px 14px;font-size:.76rem;color:var(--text-light);">
                +@(g.OpenCases.Count - 5) more — <a href="/admin/cases" style="color:var(--green);">view all</a>
              </div>
            }
          }
        </div>
      </div>
    }
  </div>
}

@code {
  private record ReasonGroup(PackageReason Reason, string Label, int Open, int Fulfilled, List<PackageRequest> OpenCases);

  private bool _loading = true;
  private List<PackageRequest> _open = [];
  private List<PackageRequest> _fulfilled = [];
  private List<ReasonGroup> _groups = [];
  private int _fulfillmentRate;

  protected override async Task OnInitializedAsync()
  {
    var all      = await Api.GetRequestsAsync();
    _open        = all.Where(c => c.Status is not CaseStatus.Fulfilled and not CaseStatus.Cancelled).ToList();
    _fulfilled   = all.Where(c => c.Status == CaseStatus.Fulfilled).ToList();
    _fulfillmentRate = all.Any() ? (int)(_fulfilled.Count * 100.0 / all.Count) : 0;

    _groups = Enum.GetValues<PackageReason>()
      .Select(r => new ReasonGroup(
          r,
          r.ToDisplayName(),
          _open.Count(c => c.Reason == r),
          _fulfilled.Count(c => c.Reason == r),
          _open.Where(c => c.Reason == r).OrderBy(c => c.DueDate ?? DateTime.MaxValue).ToList()))
      .Where(g => g.Open + g.Fulfilled > 0)
      .ToList();

    _loading = false;
  }

  private static string Age(DateTime dt)
  {
    var d = (int)(DateTime.UtcNow - dt).TotalDays;
    return d == 0 ? "today" : d == 1 ? "1d" : $"{d}d";
  }

  private static string StatusBadge(CaseStatus s) => s switch
  {
    CaseStatus.New              => "badge-new",
    CaseStatus.InProgress       => "badge-inprogress",
    CaseStatus.AwaitingShipment => "badge-inprogress",
    CaseStatus.Shipped          => "badge-shipped",
    CaseStatus.Fulfilled        => "badge-fulfilled",
    CaseStatus.OnHold           => "badge-onhold",
    _                           => ""
  };
}
