@page "/admin/volunteers/{Id:int}/notes"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Volunteer Notes — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Volunteer Notes</h2><p>@(_vol?.FullName ?? $"Volunteer #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/volunteers/@Id" class="btn btn-sm">← Volunteer Profile</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_vol is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Volunteer #@Id not found.</div></div>
}
else
{
  <!-- Volunteer summary -->
  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-body" style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;">
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Status</div>
        <span class="badge badge-@(_vol.Status == VolunteerStatus.Active ? "fulfilled" : "cancelled")" style="font-size:.72rem;">@_vol.Status</span>
      </div>
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Email</div>
        <div style="font-size:.84rem;"><a href="mailto:@_vol.Email" style="color:var(--navy);">@_vol.Email</a></div>
      </div>
      @if (!string.IsNullOrEmpty(_vol.Phone))
      {
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Phone</div>
          <div style="font-size:.84rem;">@_vol.Phone</div>
        </div>
      }
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Assignments</div>
        <div style="font-size:.84rem;font-weight:700;color:var(--navy);">@_vol.ActiveCases active</div>
      </div>
    </div>
  </div>

  <!-- ADD NOTE form -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head"><h3>Staff Notes</h3></div>
    <div class="panel-body">
      @if (!string.IsNullOrEmpty(_noteResult))
      {
        <div style="color:var(--green);font-size:.82rem;font-weight:600;margin-bottom:10px;">@_noteResult</div>
      }
      <p style="font-size:.82rem;color:var(--text-light);margin-bottom:12px;">
        Notes here are for internal staff use. Use this area for training feedback, special accommodations, availability preferences, or background context.
      </p>

      <div class="form-group">
        <label class="form-label">New Note *</label>
        <textarea class="form-input" rows="4" @bind="_newNote"
                  placeholder="e.g. Prefers weekday mornings, has infant CPR certification, available through June 2026…"></textarea>
      </div>

      <div style="display:flex;justify-content:flex-end;margin-top:10px;">
        <button class="btn btn-primary" @onclick="AppendNote" disabled="@_addBusy">
          @(_addBusy ? "Saving…" : "Save Note")
        </button>
      </div>

      @if (!string.IsNullOrEmpty(_vol.Notes))
      {
        <div style="margin-top:18px;border-top:1px solid var(--border);padding-top:16px;">
          <div style="font-size:.78rem;color:var(--text-light);margin-bottom:8px;">Current Notes</div>
          <div style="font-size:.84rem;line-height:1.7;white-space:pre-wrap;color:var(--text-mid);background:var(--bg);border-radius:6px;padding:10px 14px;">@_vol.Notes</div>
        </div>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Volunteer? _vol;
  private bool _loading = true, _addBusy;
  private string _newNote = "", _noteResult = "";

  protected override async Task OnInitializedAsync()
  {
    _vol = await Api.GetVolunteerByIdAsync(Id);
    _loading = false;
  }

  private async Task AppendNote()
  {
    if (string.IsNullOrWhiteSpace(_newNote) || _vol is null) return;
    _addBusy = true;
    var timestamp = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
    var separator = string.IsNullOrEmpty(_vol.Notes) ? "" : "\n\n";
    var updatedNotes = $"{_vol.Notes}{separator}[{timestamp}] {_newNote.Trim()}";
    var updated = new Volunteer
    {
      Id            = _vol.Id,
      FirstName     = _vol.FirstName,
      LastName      = _vol.LastName,
      Email         = _vol.Email,
      Phone         = _vol.Phone,
      Status        = _vol.Status,
      ChapterId     = _vol.ChapterId,
      Notes         = updatedNotes,
      ActiveCases   = _vol.ActiveCases,
      JoinedDate    = _vol.JoinedDate,
    };
    var result = await Api.UpdateVolunteerAsync(Id, updated);
    if (result is not null) { _vol = result; _noteResult = "Note saved."; _newNote = ""; }
    else _noteResult = "Save failed.";
    _addBusy = false;
  }
}
