@page "/admin/donors/growth"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Donor Growth — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Donor Growth</h2>
    <p>New donor acquisition, retention trends, and cohort analysis</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/donors" class="btn btn-sm">← Donors</a>
    <a href="/admin/by-donor" class="btn btn-sm">By Donor</a>
    <a href="/admin/donors/retention" class="btn btn-sm">Retention</a>
    <a href="/admin/year-end" class="btn btn-sm">Year-End</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Analyzing donor growth…" />
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#127381;</div>
      <div class="kpi-label">Total Donors</div>
      <div class="kpi-value" style="color:var(--green)">@_donors.Count</div>
      <div class="kpi-change change-up">&#9650; all time</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">New This Year</div>
      <div class="kpi-value" style="color:var(--navy)">@_newThisYear</div>
      <div class="kpi-change change-up">&#9650; vs @_newLastYear last year</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128184;</div>
      <div class="kpi-label">Avg Gift (New Donors)</div>
      <div class="kpi-value" style="color:var(--green)"><Money Amount="@_avgFirstGift" /></div>
      <div class="kpi-change">first gift average</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128260;</div>
      <div class="kpi-label">LYBUNT Donors</div>
      <div class="kpi-value" style="color:var(--amber)">@_lybunt</div>
      <div class="kpi-change change-down">gave last year, not this year</div>
    </div>
  </div>

  <!-- ACQUISITION TREND -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">
      <h3>New Donors by Month</h3>
      <span style="font-size:.78rem;color:var(--text-light);">First donation = acquisition month</span>
    </div>
    <div class="panel-body">
      @if (!_acquisitionByMonth.Any())
      {
        <div style="text-align:center;color:var(--text-light);padding:30px;">No data available.</div>
      }
      else
      {
        var maxAcq = _acquisitionByMonth.Max(m => m.Count);
        <div style="display:flex;align-items:flex-end;gap:4px;height:140px;margin-bottom:8px;">
          @foreach (var m in _acquisitionByMonth.TakeLast(12))
          {
            var h = maxAcq > 0 ? (int)(m.Count * 130.0 / maxAcq) : 0;
            <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:2px;" title="@m.Label: @m.Count new donors">
              <div style="font-size:.6rem;color:var(--navy);font-weight:700;">@m.Count</div>
              <div style="width:100%;background:var(--green);border-radius:3px 3px 0 0;height:@(h)px;min-height:2px;"></div>
            </div>
          }
        </div>
        <div style="display:flex;gap:4px;">
          @foreach (var m in _acquisitionByMonth.TakeLast(12))
          {
            <div style="flex:1;text-align:center;font-size:.58rem;color:var(--text-light);">@m.Label</div>
          }
        </div>
      }
    </div>
  </div>

  <!-- GRID: Gift Size Distribution + Retention Cohort -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

    <!-- FIRST GIFT DISTRIBUTION -->
    <div class="panel">
      <div class="panel-head">
        <h3>First Gift Size Distribution</h3>
        <a href="/admin/by-amount" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">Full Report &rarr;</a>
      </div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
        @{
          var maxBand = _bandCounts.Any() ? _bandCounts.Max(b => b.Count) : 1;
        }
        @foreach (var b in _bandCounts)
        {
          var pct = maxBand > 0 ? (int)(b.Count * 100.0 / maxBand) : 0;
          <div>
            <div style="display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:3px;">
              <span style="font-weight:600;">@b.Label</span>
              <span style="color:var(--text-mid);">@b.Count donors</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width:@pct%;background:var(--green);"></div>
            </div>
          </div>
        }
      </div>
    </div>

    <!-- YEARLY COHORT TABLE -->
    <div class="panel">
      <div class="panel-head">
        <h3>Cohort by Year</h3>
        <span style="font-size:.78rem;color:var(--text-light);">First donation year</span>
      </div>
      <div class="panel-body" style="padding:0;">
        <table class="data-table">
          <thead><tr><th>Year</th><th>New Donors</th><th>Total Given</th><th>Avg Gift</th></tr></thead>
          <tbody>
            @foreach (var c in _yearCohorts.OrderByDescending(c => c.Year))
            {
              <tr>
                <td style="font-weight:700;color:var(--navy);">@c.Year</td>
                <td>@c.DonorCount</td>
                <td><Money Amount="@c.TotalGiven" /></td>
                <td><Money Amount="@c.AvgGift" /></td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- LYBUNT LIST -->
  <div class="panel">
    <div class="panel-head">
      <h3>LYBUNT — Gave Last Year, Not This Year (@_lybunt)</h3>
      <a href="/admin/donors/outreach" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">Outreach Queue &rarr;</a>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!_lybuntList.Any())
      {
        <div style="padding:30px;text-align:center;color:var(--text-light);">No LYBUNT donors. Everyone gave this year — well done!</div>
      }
      else
      {
        <table class="data-table">
          <thead><tr><th>Donor</th><th>City</th><th>Last Gift</th><th>Last Amount</th><th></th></tr></thead>
          <tbody>
            @foreach (var d in _lybuntList.Take(20))
            {
              <tr>
                <td><strong>@d.FullName</strong></td>
                <td style="font-size:.78rem;color:var(--text-mid);">@d.City</td>
                <td style="font-size:.76rem;color:var(--text-light);">@d.LastGiftDate.ToString("MMM d, yyyy")</td>
                <td><Money Amount="@d.LastAmount" /></td>
                <td><a href="/admin/donors/@d.Id" style="font-size:.74rem;color:var(--green);">View &rarr;</a></td>
              </tr>
            }
          </tbody>
        </table>
        @if (_lybuntList.Count > 20)
        {
          <div style="padding:12px 18px;font-size:.8rem;color:var(--text-light);">
            +@(_lybuntList.Count - 20) more in <a href="/admin/donors/outreach" style="color:var(--green);">Outreach Queue</a>
          </div>
        }
      }
    </div>
  </div>
}

@code {
  private record MonthBucket(string Label, int Count);
  private record BandBucket(string Label, int Count);
  private record YearCohort(int Year, int DonorCount, decimal TotalGiven, decimal AvgGift);
  private record LybuntRow(int Id, string FullName, string City, DateTime LastGiftDate, decimal LastAmount);

  private bool _loading = true;
  private List<Donor> _donors = [];
  private List<Donation> _donations = [];
  private int _newThisYear, _newLastYear, _lybunt;
  private decimal _avgFirstGift;
  private List<MonthBucket> _acquisitionByMonth = [];
  private List<BandBucket> _bandCounts = [];
  private List<YearCohort> _yearCohorts = [];
  private List<LybuntRow> _lybuntList = [];

  protected override async Task OnInitializedAsync()
  {
    var donorsTask    = Api.GetDonorsAsync();
    var donationsTask = Api.GetDonationsAsync();
    await Task.WhenAll(donorsTask, donationsTask);
    _donors    = await donorsTask;
    _donations = await donationsTask;

    var now        = DateTime.UtcNow;
    var thisYear   = now.Year;
    var lastYear   = now.Year - 1;

    // Group first donation per donor
    var firstGifts = _donations
      .GroupBy(d => d.DonorId)
      .Select(g => g.OrderBy(d => d.Date).First())
      .ToList();

    _newThisYear  = firstGifts.Count(d => d.Date.Year == thisYear);
    _newLastYear  = firstGifts.Count(d => d.Date.Year == lastYear);
    _avgFirstGift = firstGifts.Any() ? firstGifts.Average(d => d.Amount) : 0m;

    // Acquisition by month (last 18 months)
    _acquisitionByMonth = Enumerable.Range(0, 18)
      .Select(i => now.AddMonths(-i))
      .Reverse()
      .Select(m => new MonthBucket(
          m.ToString("MMM yy"),
          firstGifts.Count(d => d.Date.Year == m.Year && d.Date.Month == m.Month)))
      .ToList();

    // First gift band distribution
    _bandCounts =
    [
      new("< $25",       firstGifts.Count(d => d.Amount < 25)),
      new("$25 – $99",   firstGifts.Count(d => d.Amount >= 25  && d.Amount < 100)),
      new("$100 – $499", firstGifts.Count(d => d.Amount >= 100 && d.Amount < 500)),
      new("$500 – $999", firstGifts.Count(d => d.Amount >= 500 && d.Amount < 1000)),
      new("$1,000+",     firstGifts.Count(d => d.Amount >= 1000)),
    ];

    // Year cohorts
    _yearCohorts = firstGifts
      .GroupBy(d => d.Date.Year)
      .Select(g =>
      {
        var donors = g.Count();
        var total  = g.Sum(d => d.Amount);
        return new YearCohort(g.Key, donors, total, donors > 0 ? total / donors : 0);
      })
      .ToList();

    // LYBUNT: gave in lastYear, no gift in thisYear
    var gaveLastYear  = _donations.Where(d => d.Date.Year == lastYear).Select(d => d.DonorId).ToHashSet();
    var gaveThisYear  = _donations.Where(d => d.Date.Year == thisYear).Select(d => d.DonorId).ToHashSet();
    var lybuntIds     = gaveLastYear.Except(gaveThisYear).ToHashSet();
    _lybunt           = lybuntIds.Count;

    _lybuntList = _donors
      .Where(d => lybuntIds.Contains(d.Id))
      .Select(d =>
      {
        var last = _donations.Where(dn => dn.DonorId == d.Id).OrderByDescending(dn => dn.Date).FirstOrDefault();
        return new LybuntRow(d.Id, d.FullName, d.City ?? "", last?.Date ?? DateTime.MinValue, last?.Amount ?? 0);
      })
      .OrderByDescending(r => r.LastAmount)
      .ToList();

    _loading = false;
  }
}
