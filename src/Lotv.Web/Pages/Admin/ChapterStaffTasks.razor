@page "/admin/chapters/{Id:int}/staff-tasks"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Staff Tasks — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Staff Tasks</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/staff-tasks/new" class="btn btn-sm btn-primary">+ New Task</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📋</div>
      <div class="kpi-label">Total</div>
      <div class="kpi-value" style="color:var(--navy)">@_tasks.Count</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">⏳</div>
      <div class="kpi-label">Open</div>
      <div class="kpi-value" style="color:var(--amber)">@_tasks.Count(t => t.Status != "Completed" && t.Status != "Cancelled")</div>
    </div>
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">⚠</div>
      <div class="kpi-label">Overdue</div>
      <div class="kpi-value" style="color:var(--red)">@_tasks.Count(t => t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != "Completed" && t.Status != "Cancelled")</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">✅</div>
      <div class="kpi-label">Completed</div>
      <div class="kpi-value" style="color:var(--green)">@_tasks.Count(t => t.Status == "Completed")</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Tasks (@_tasks.Count)</h3>
      <select class="form-input" style="width:160px;font-size:.82rem;padding:5px 10px;" @bind="_filter">
        <option value="open">Open</option>
        <option value="all">All</option>
        <option value="completed">Completed</option>
      </select>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!Filtered.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No tasks match.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Task</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Assigned To</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Priority</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Due</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var t in Filtered)
            {
              var isOverdue = t.DueDate.HasValue && t.DueDate.Value.Date < DateTime.Today && t.Status != "Completed" && t.Status != "Cancelled";
              <tr style="border-top:1px solid var(--border);@(isOverdue ? "background:#fef2f2;" : "")">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">@t.Title</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@t.AssignedToName</td>
                <td style="padding:10px 16px;">
                  <span class="badge badge-@PriorityClass(t.Priority)" style="font-size:.68rem;">@t.Priority</span>
                </td>
                <td style="padding:10px 16px;font-size:.82rem;color:@(isOverdue ? "var(--red)" : "var(--text-light)");">@(t.DueDate?.ToString("MMM d, yyyy") ?? "—")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@t.Status</td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/staff-tasks/@t.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<StaffTaskDto> _tasks = [];
  private string _filter = "open";
  private bool _loading = true;

  private IEnumerable<StaffTaskDto> Filtered => _filter switch
  {
    "open"      => _tasks.Where(t => t.Status != "Completed" && t.Status != "Cancelled").OrderBy(t => t.DueDate ?? DateTime.MaxValue),
    "completed" => _tasks.Where(t => t.Status == "Completed").OrderByDescending(t => t.CompletedAt),
    _           => _tasks.OrderBy(t => t.DueDate ?? DateTime.MaxValue)
  };

  protected override async Task OnInitializedAsync()
  {
    var chapTask = Api.GetChaptersAdminAsync();
    var taskTask = Api.GetStaffTasksAsync();
    await Task.WhenAll(chapTask, taskTask);
    var chapters = await chapTask;
    _chapter     = chapters.FirstOrDefault(c => c.Id == Id);
    var all      = await taskTask;
    _tasks       = all.Where(t => t.ChapterId == Id).ToList();
    _loading = false;
  }

  private static string PriorityClass(string priority) => priority switch
  {
    "Critical" => "cancelled",
    "High"     => "onhold",
    "Medium"   => "new",
    "Low"      => "fulfilled",
    _          => "new"
  };
}
