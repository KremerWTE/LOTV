@page "/admin/volunteers/pending"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Pending Volunteers — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Volunteer Onboarding Queue</h2><p>Review and approve new volunteer signups</p></div>
  <div class="page-hd-actions">
    <a href="/admin/volunteers" class="btn btn-sm">← All Volunteers</a>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">⏳</div>
    <div class="kpi-label">Pending Review</div>
    <div class="kpi-value" style="color:var(--amber)">@_pending.Count</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">✅</div>
    <div class="kpi-label">Approved This Session</div>
    <div class="kpi-value" style="color:var(--green)">@_approvedCount</div>
  </div>
</div>

@if (!_pending.Any())
{
  <div class="panel">
    <div class="panel-body" style="text-align:center;padding:48px;color:var(--text-light);">
      <div style="font-size:2rem;margin-bottom:12px;">🎉</div>
      <div style="font-size:.96rem;font-weight:600;">All caught up!</div>
      <div style="font-size:.84rem;margin-top:6px;">No volunteers pending onboarding review.</div>
    </div>
  </div>
}
else
{
  <div style="display:flex;flex-direction:column;gap:14px;">
    @foreach (var v in _pending)
    {
      <div class="panel" style="border-left:4px solid var(--amber);">
        <div class="panel-body">
          <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
            <div style="flex:1;">
              <div style="font-size:1rem;font-weight:700;margin-bottom:4px;">@v.FullName</div>
              <div style="display:flex;flex-wrap:wrap;gap:8px;font-size:.78rem;color:var(--text-mid);margin-bottom:8px;">
                <span>✉ @v.Email</span>
                @if (!string.IsNullOrEmpty(v.Phone)) { <span>📞 @v.Phone</span> }
                <span>🎭 @v.Role.ToDisplayName()</span>
                <span>📅 Joined @v.JoinedDate.ToString("MMM d, yyyy")</span>
              </div>
              @if (!string.IsNullOrEmpty(v.ParishName))
              { <div style="font-size:.78rem;color:var(--text-light);">⛪ @v.ParishName @(!string.IsNullOrEmpty(v.DioceseName) ? $"· {v.DioceseName}" : "")</div> }
              @if (!string.IsNullOrEmpty(v.Notes))
              { <div style="font-size:.78rem;color:var(--text-mid);margin-top:6px;font-style:italic;">@v.Notes</div> }
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
              <button class="btn btn-primary btn-sm" @onclick="() => Approve(v)" disabled="@_busy">
                ✓ Approve
              </button>
              <button class="btn btn-sm" style="color:var(--red);" @onclick="() => Reject(v)" disabled="@_busy">
                ✕ Decline
              </button>
            </div>
          </div>
        </div>
      </div>
    }
  </div>
}

@code {
  private List<Volunteer> _pending = [];
  private int _approvedCount;
  private bool _busy;

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetVolunteersAsync("Onboarding");
    _pending = all;
  }

  private async Task Approve(Volunteer v)
  {
    _busy = true;
    v.Status = VolunteerStatus.Active;
    var updated = await Api.UpdateVolunteerAsync(v.Id, v);
    if (updated is not null)
    {
      _pending.Remove(v);
      _approvedCount++;
    }
    _busy = false;
  }

  private async Task Reject(Volunteer v)
  {
    _busy = true;
    v.Status = VolunteerStatus.Inactive;
    var updated = await Api.UpdateVolunteerAsync(v.Id, v);
    if (updated is not null) _pending.Remove(v);
    _busy = false;
  }
}
