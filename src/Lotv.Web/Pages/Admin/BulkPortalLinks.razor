@page "/admin/donors/bulk-portal-links"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Bulk Portal Links — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Bulk Portal Links</h2><p>Send self-service portal access links to donors</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors" class="btn btn-sm">← Donors</a>
  </div>
</div>

@if (_result is not null)
{
  <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
    <div class="panel-body">
      <div style="font-weight:700;font-size:.9rem;color:var(--green);margin-bottom:6px;">✓ Portal links sent.</div>
      <div style="font-size:.86rem;">
        <strong>@_result.Sent</strong> emails sent &bull; <strong>@_result.Skipped</strong> skipped (no email on file)
      </div>
    </div>
  </div>
}
@if (!string.IsNullOrEmpty(_error))
{
  <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--red);">@_error</div>
  </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
  <!-- Send to all donors -->
  <div class="panel">
    <div class="panel-head"><h3>Send to All Donors</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-light);margin-bottom:16px;">
        Sends a magic-link email to every donor with an email address on file. Donors without an email are skipped.
      </p>
      <div style="padding:10px 12px;background:#fffbeb;border-radius:6px;border:1px solid #fde68a;font-size:.78rem;color:#92400e;margin-bottom:16px;">
        ⚠ This will email <strong>all</strong> donors. Use with care.
      </div>
      <div style="display:flex;justify-content:flex-end;">
        <button class="btn btn-primary" @onclick="SendAll" disabled="@_busy">
          @(_busyAll ? "Sending…" : "Send to All Donors")
        </button>
      </div>
    </div>
  </div>

  <!-- Send by diocese -->
  <div class="panel">
    <div class="panel-head"><h3>Send by Diocese</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-light);margin-bottom:16px;">
        Limit the send to donors belonging to a specific diocese.
      </p>
      <div class="form-group">
        <label class="form-label">Diocese Name *</label>
        <input class="form-input" @bind="_diocese" placeholder="e.g. Diocese of Richmond" />
      </div>
      <div style="display:flex;justify-content:flex-end;margin-top:14px;">
        <button class="btn btn-primary" @onclick="SendByDiocese" disabled="@_busy">
          @(_busyDiocese ? "Sending…" : "Send to Diocese")
        </button>
      </div>
    </div>
  </div>
</div>

@code {
  private ApiService.BulkLinkResult? _result;
  private string _error = "";
  private string _diocese = "";
  private bool _busyAll, _busyDiocese;
  private bool _busy => _busyAll || _busyDiocese;

  private async Task SendAll()
  {
    _error = ""; _result = null;
    _busyAll = true;
    _result = await Api.SendBulkPortalLinksAsync();
    _busyAll = false;
    if (_result is null) _error = "Send failed. Please try again.";
  }

  private async Task SendByDiocese()
  {
    _error = ""; _result = null;
    if (string.IsNullOrWhiteSpace(_diocese)) { _error = "Diocese name is required."; return; }
    _busyDiocese = true;
    _result = await Api.SendBulkPortalLinksByDioceseAsync(_diocese.Trim());
    _busyDiocese = false;
    if (_result is null) _error = "Send failed. Please try again.";
  }
}
