@page "/admin/audit"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Audit Log — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Audit Log</h2><p>Append-only activity trail — all staff actions recorded</p></div>
  <div class="page-hd-actions">
    <button class="btn btn-sm" @onclick="() => Refresh()">&#8635; Refresh</button>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#128196;</div>
    <div class="kpi-label">Total Entries</div>
    <div class="kpi-value" style="color:var(--navy)">@_log.Count</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128336;</div>
    <div class="kpi-label">Actions Today</div>
    <div class="kpi-value" style="color:var(--green)">@_log.Count(e => e.Timestamp.Date == DateTime.UtcNow.Date)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#128100;</div>
    <div class="kpi-label">Unique Users</div>
    <div class="kpi-value" style="color:var(--amber)">@_log.Select(e => e.UserName).Distinct().Count()</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#9998;</div>
    <div class="kpi-label">Updates Logged</div>
    <div class="kpi-value" style="color:var(--gold)">@_log.Count(e => e.Action.Equals("Updated", StringComparison.OrdinalIgnoreCase))</div>
  </div>
</div>

<!-- FILTER BAR -->
<div class="filter-bar">
  @foreach (var f in new[]{"All","Created","Updated","Approved","Exported","Flagged","Deleted"})
  { <button class="filter-chip @(_actionFilter == f ? "active" : "")" @onclick="() => _actionFilter = f">@f</button> }
  <div style="width:1px;height:20px;background:var(--border);margin:0 4px;"></div>
  @foreach (var d in new[]{"All Time","Today","This Week","This Month"})
  { <button class="filter-chip @(_dateFilter == d ? "active" : "")" @onclick="() => _dateFilter = d">@d</button> }
  <input class="form-input" style="width:200px;font-size:.82rem;padding:5px 12px;" placeholder="&#128269; Search entries..." @bind="_search" @bind:event="oninput" />
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>ID</th><th>Details</th></tr>
      </thead>
      <tbody>
        @foreach (var e in Filtered)
        {
          <tr>
            <td style="font-size:.74rem;color:var(--text-light);white-space:nowrap;">
              @e.Timestamp.ToString("MMM d, yyyy")<br />
              <span style="font-size:.68rem;">@e.Timestamp.ToString("h:mm tt")</span>
            </td>
            <td style="font-size:.82rem;font-weight:600;">@e.UserName</td>
            <td><span class="badge @ActionBadge(e.Action)" style="font-size:.66rem;">@e.Action</span></td>
            <td style="font-size:.78rem;color:var(--text-mid);">@e.Entity</td>
            <td style="font-size:.72rem;color:var(--text-light);">@(e.EntityId ?? "—")</td>
            <td style="font-size:.78rem;color:var(--text-mid);max-width:300px;">@(e.Details ?? "—")</td>
          </tr>
        }
      </tbody>
    </table>
    @if (!Filtered.Any())
    {
      <div style="text-align:center;padding:32px;color:var(--text-light);font-size:.88rem;">No matching audit entries.</div>
    }
  </div>
</div>

@code {
  private List<AuditEntry> _log = [];
  private string _actionFilter = "All";
  private string _dateFilter   = "All Time";
  private string _search       = "";

  private IEnumerable<AuditEntry> Filtered => _log.Where(e =>
  {
    var now = DateTime.UtcNow;
    var matchAction = _actionFilter == "All" || e.Action.Equals(_actionFilter, StringComparison.OrdinalIgnoreCase);
    var matchDate   = _dateFilter switch
    {
      "Today"      => e.Timestamp.Date == now.Date,
      "This Week"  => e.Timestamp >= now.AddDays(-7),
      "This Month" => e.Timestamp.Year == now.Year && e.Timestamp.Month == now.Month,
      _            => true
    };
    var matchSearch = string.IsNullOrEmpty(_search) ||
      e.UserName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
      e.Entity.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
      (e.Details?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    return matchAction && matchDate && matchSearch;
  }).OrderByDescending(e => e.Timestamp);

  protected override async Task OnInitializedAsync() => _log = await Api.GetAuditLogAsync();
  private async Task Refresh() => _log = await Api.GetAuditLogAsync();

  private static string ActionBadge(string action) => action.ToLower() switch
  {
    "created"  => "badge-new",
    "updated"  => "badge-inprogress",
    "approved" => "badge-fulfilled",
    "exported" => "badge-shipped",
    "flagged"  => "badge-onhold",
    "deleted"  => "badge-cancelled",
    _          => "badge-new"
  };
}
