@page "/admin/audit"
@layout AdminLayout
@inject ApiService Api
@inject IJSRuntime JS
@inject AuthService Auth

<PageTitle>Audit Log — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Audit Log</h2><p>Append-only activity trail — all staff actions recorded</p></div>
  <div class="page-hd-actions">
    <button class="btn btn-sm" @onclick="() => Refresh()">&#8635; Refresh</button>
    <button class="btn btn-sm" @onclick="ExportCsv">&darr; Export CSV</button>
    <button class="btn btn-sm" @onclick="ExportJson">&darr; Export JSON</button>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#128196;</div>
    <div class="kpi-label">Total Entries</div>
    <div class="kpi-value" style="color:var(--navy)">@_log.Count</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128336;</div>
    <div class="kpi-label">Actions Today</div>
    <div class="kpi-value" style="color:var(--green)">@_log.Count(e => e.Timestamp.Date == DateTime.UtcNow.Date)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#128100;</div>
    <div class="kpi-label">Unique Users</div>
    <div class="kpi-value" style="color:var(--amber)">@_log.Select(e => e.UserName).Distinct().Count()</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#9998;</div>
    <div class="kpi-label">Updates Logged</div>
    <div class="kpi-value" style="color:var(--gold)">@_log.Count(e => e.Action.Equals("Updated", StringComparison.OrdinalIgnoreCase))</div>
  </div>
</div>

<!-- TOP NOISY USERS -->
@{
  var noisy = _log.GroupBy(e => e.UserName)
    .Select(g => new { User = g.Key, Count = g.Count() })
    .OrderByDescending(x => x.Count).Take(5).ToList();
}
@if (noisy.Any())
{
  <div class="panel" style="margin-bottom:14px;">
    <div class="panel-body" style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;font-size:.84rem;">
      <strong style="color:var(--text-light);font-size:.74rem;text-transform:uppercase;letter-spacing:.08em;">Top contributors</strong>
      @foreach (var u in noisy)
      {
        <button class="filter-chip" @onclick="() => { _search = u.User; _mineOnly = false; }">
          @u.User · @u.Count
        </button>
      }
    </div>
  </div>
}

<!-- FILTER BAR -->
<div class="filter-bar">
  @foreach (var f in new[]{"All","Created","Updated","Approved","Exported","Flagged","Deleted","SignatureFailed"})
  {
    var n = f == "All" ? _log.Count : _log.Count(e => e.Action.Equals(f, StringComparison.OrdinalIgnoreCase));
    var label = f == "SignatureFailed" ? "⚠ Webhook fails" : f;
    <button class="filter-chip @(_actionFilter == f ? "active" : "")" aria-pressed="@(_actionFilter == f)" @onclick="() => _actionFilter = f">@label · @n</button>
  }
  <div style="width:1px;height:20px;background:var(--border);margin:0 4px;"></div>
  @foreach (var d in new[]{"All Time","Last 24h","Today","This Week","This Month"})
  { <button class="filter-chip @(_dateFilter == d ? "active" : "")" aria-pressed="@(_dateFilter == d)" @onclick="() => _dateFilter = d">@d</button> }
  <button class="filter-chip @(_mineOnly ? "active" : "")" aria-pressed="@_mineOnly" @onclick="() => _mineOnly = !_mineOnly">My actions</button>
  <input class="form-input" style="width:200px;font-size:.82rem;padding:5px 12px;" placeholder="&#128269; Search entries..." @bind="_search" @bind:event="oninput" />
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr><th>Time</th><th>User</th><th>Action</th><th>Entity</th><th>ID</th><th>Details</th></tr>
      </thead>
      <tbody>
        @foreach (var e in Filtered.Take(_visible))
        {
          <tr style="cursor:pointer;" @onclick="() => _selected = e">
            <td style="font-size:.74rem;color:var(--text-light);white-space:nowrap;">
              @e.Timestamp.ToString("MMM d, yyyy")<br />
              <span style="font-size:.68rem;">@e.Timestamp.ToString("h:mm tt")</span>
            </td>
            <td style="font-size:.82rem;font-weight:600;">@e.UserName</td>
            <td><span class="badge @ActionBadge(e.Action)" style="font-size:.66rem;">@e.Action</span></td>
            <td style="font-size:.78rem;color:var(--text-mid);">@e.Entity</td>
            <td style="font-size:.72rem;color:var(--text-light);">@(e.EntityId ?? "—")</td>
            <td style="font-size:.78rem;color:var(--text-mid);max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@(e.Details ?? "—")</td>
          </tr>
        }
      </tbody>
    </table>
    @if (!Filtered.Any())
    {
      <div style="text-align:center;padding:32px;color:var(--text-light);font-size:.88rem;">No matching audit entries.</div>
    }
    else if (_visible < Filtered.Count())
    {
      <div style="text-align:center;padding:14px;border-top:1px solid var(--border);">
        <button class="btn btn-sm" data-autoload @onclick="() => _visible += 100">Load 100 more (@(Filtered.Count() - _visible) hidden)</button>
      </div>
    }
  </div>
</div>

@if (_selected is not null)
{
  <div class="drawer-overlay" @onclick="() => _selected = null"></div>
  <div class="drawer">
    <div class="drawer-head">
      <h3>@_selected.Action — @_selected.Entity</h3>
      <button class="drawer-close" @onclick="() => _selected = null">&#10005;</button>
    </div>
    <div class="drawer-body">
      <div style="font-size:.78rem;color:var(--text-light);margin-bottom:14px;">
        @_selected.Timestamp.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt") · @_selected.UserName
        @if (!string.IsNullOrEmpty(_selected.IpAddress)) { <span> · @_selected.IpAddress</span> }
      </div>
      <div style="margin-bottom:10px;"><strong>Entity ID:</strong> @(_selected.EntityId ?? "—")</div>
      <div><strong>Details:</strong></div>
      <pre style="background:var(--bg);border-radius:6px;padding:12px;font-size:.78rem;overflow:auto;max-height:60vh;white-space:pre-wrap;word-break:break-all;margin-top:6px;">@(_selected.Details ?? "(none)")</pre>
    </div>
  </div>
}

@code {
  private AuditEntry? _selected;
  private List<AuditEntry> _log = [];
  private string _actionFilter = "All";
  private string _dateFilter   = "All Time";
  private string _search       = "";
  private bool _mineOnly;
  private int _visible = 100;

  private IEnumerable<AuditEntry> Filtered => _log.Where(e =>
  {
    var now = DateTime.UtcNow;
    var matchAction = _actionFilter == "All" || e.Action.Equals(_actionFilter, StringComparison.OrdinalIgnoreCase);
    var matchDate   = _dateFilter switch
    {
      "Last 24h"   => e.Timestamp >= now.AddHours(-24),
      "Today"      => e.Timestamp.Date == now.Date,
      "This Week"  => e.Timestamp >= now.AddDays(-7),
      "This Month" => e.Timestamp.Year == now.Year && e.Timestamp.Month == now.Month,
      _            => true
    };
    var matchSearch = string.IsNullOrEmpty(_search) ||
      e.UserName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
      e.Entity.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
      (e.Details?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false);
    var matchMine = !_mineOnly || string.Equals(e.UserName, Auth.UserName, StringComparison.OrdinalIgnoreCase) ||
                    string.Equals(e.UserName, Auth.UserEmail, StringComparison.OrdinalIgnoreCase);
    return matchAction && matchDate && matchSearch && matchMine;
  }).OrderByDescending(e => e.Timestamp);

  protected override async Task OnInitializedAsync() => _log = await Api.GetAuditLogAsync();
  private async Task Refresh() => _log = await Api.GetAuditLogAsync();

  private async Task ExportCsv()
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("Timestamp,User,Action,Entity,EntityId,IpAddress,Details");
    // Export only the currently rendered slice — matches what the user sees.
    foreach (var e in Filtered.Take(_visible))
    {
      string Esc(string? s) => s is null ? "" : "\"" + s.Replace("\"", "\"\"") + "\"";
      sb.AppendLine($"{e.Timestamp:O},{Esc(e.UserName)},{Esc(e.Action)},{Esc(e.Entity)},{Esc(e.EntityId)},{Esc(e.IpAddress)},{Esc(e.Details)}");
    }
    await JS.InvokeVoidAsync("downloadCsv", $"lotv-audit-{DateTime.UtcNow:yyyyMMdd-HHmm}.csv", sb.ToString());
  }

  private async Task ExportJson()
  {
    var rows = Filtered.Take(_visible).Select(e => new
    {
      e.Timestamp, e.UserName, e.Action, e.Entity, e.EntityId, e.IpAddress, e.Details,
    });
    var json = System.Text.Json.JsonSerializer.Serialize(rows, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    await JS.InvokeVoidAsync("downloadCsv", $"lotv-audit-{DateTime.UtcNow:yyyyMMdd-HHmm}.json", json);
  }

  private static string ActionBadge(string action) => action.ToLower() switch
  {
    "created"  => "badge-new",
    "updated"  => "badge-inprogress",
    "approved" => "badge-fulfilled",
    "exported" => "badge-shipped",
    "flagged"  => "badge-onhold",
    "deleted"  => "badge-cancelled",
    _          => "badge-new"
  };
}
