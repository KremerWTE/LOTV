@page "/admin/chapters/{Id:int}/donors"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Donors — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Donors</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/donors/new" class="btn btn-sm btn-primary">+ New Donor</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <!-- KPIs -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">Donors</div>
      <div class="kpi-value" style="color:var(--navy)">@_donors.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Total Given</div>
      <div class="kpi-value" style="color:var(--green)">@_donors.Sum(d => d.TotalGiven).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128260;</div>
      <div class="kpi-label">Recurring</div>
      <div class="kpi-value" style="color:var(--amber)">@_donors.Count(d => d.IsRecurring)</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">&#127942;</div>
      <div class="kpi-label">Avg Gift</div>
      <div class="kpi-value" style="font-size:.9rem;">@(_donors.Any(d => d.GiftCount > 0) ? (_donors.Where(d => d.GiftCount > 0).Sum(d => d.TotalGiven) / _donors.Where(d => d.GiftCount > 0).Sum(d => d.GiftCount)).ToString("C0") : "—")</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Donors (@_donors.Count)</h3>
      <input class="form-input" style="width:220px;font-size:.82rem;padding:5px 10px;"
             value="@_search"
             @oninput='e => _search = e.Value?.ToString() ?? ""'
             placeholder="Search by name or email…" />
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!Filtered.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">@(_donors.Any() ? "No donors match your search." : "No donors in this chapter yet.")</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Name</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Email</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Total Given</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);">Gifts</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Tier</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var d in Filtered.OrderByDescending(d => d.TotalGiven))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">@d.FullName @(d.IsRecurring ? "🔄" : "")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@d.Email</td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@d.TotalGiven.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.84rem;text-align:center;">@d.GiftCount</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@d.Tier</td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/donors/@d.Id" style="font-size:.78rem;color:var(--navy);">Profile</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<Donor> _donors = [];
  private string _search = "";
  private bool _loading = true;

  private IEnumerable<Donor> Filtered => string.IsNullOrWhiteSpace(_search)
    ? _donors
    : _donors.Where(d => d.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                         d.Email.Contains(_search, StringComparison.OrdinalIgnoreCase));

  protected override async Task OnInitializedAsync()
  {
    var chapTask  = Api.GetChaptersAdminAsync();
    var donorTask = Api.GetDonorsAsync();
    await Task.WhenAll(chapTask, donorTask);
    var chapters = await chapTask;
    _chapter = chapters.FirstOrDefault(c => c.Id == Id);
    var all  = await donorTask;
    _donors  = all.Where(d => d.ChapterId == Id).ToList();
    _loading = false;
  }
}
