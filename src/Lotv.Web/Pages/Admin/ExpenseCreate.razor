@page "/admin/expenses/new"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Log Expense — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Log Chapter Expense</h2><p>Record a ministry expenditure for reporting and reconciliation</p></div>
  <div class="page-hd-actions">
    <a href="/admin/expenses" class="btn btn-sm">← Expenses</a>
  </div>
</div>

@if (_saved)
{
  <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--green);font-weight:600;">Expense logged. Redirecting…</div>
  </div>
}
@if (!string.IsNullOrEmpty(_error))
{
  <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--red);">@_error</div>
  </div>
}

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;">
  <div>
    <div class="panel">
      <div class="panel-head"><h3>Expense Details</h3></div>
      <div class="panel-body">
        <div class="form-group">
          <label class="form-label">Description *</label>
          <input class="form-input" @bind="_description" placeholder="What was purchased or paid for?" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Amount *</label>
          <input class="form-input" type="number" step="0.01" min="0" @bind="_amount" placeholder="0.00" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Category</label>
          <select class="form-input" @bind="_category">
            <option value="Supplies">Supplies</option>
            <option value="Printing">Printing</option>
            <option value="Shipping">Shipping</option>
            <option value="Staffing">Staffing</option>
            <option value="Venue">Venue / Rental</option>
            <option value="Food">Food &amp; Beverage</option>
            <option value="Technology">Technology</option>
            <option value="Marketing">Marketing</option>
            <option value="Other">Other</option>
          </select>
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Date Paid *</label>
          <input class="form-input" type="date" @bind="_paidAt" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Paid By *</label>
          <input class="form-input" @bind="_paidBy" placeholder="Staff member or volunteer name" />
        </div>
        <div class="form-group" style="margin-top:10px;">
          <label class="form-label">Notes</label>
          <textarea class="form-input" rows="3" @bind="_notes" placeholder="Vendor, purpose, or additional context…"></textarea>
        </div>
      </div>
    </div>
  </div>

  <div>
    <div class="panel" style="margin-bottom:16px;">
      <div class="panel-head"><h3>Assignment</h3></div>
      <div class="panel-body">
        <div class="form-group">
          <label class="form-label">Chapter *</label>
          <select class="form-input" @bind="_chapterId">
            <option value="0">— Select chapter —</option>
            @foreach (var c in _chapters)
            {
              <option value="@c.Id">@c.Name — @c.City, @c.State</option>
            }
          </select>
        </div>
      </div>
    </div>

    <div class="panel" style="background:#fffbeb;border-left:3px solid var(--amber);">
      <div class="panel-body" style="font-size:.82rem;color:var(--text-mid);line-height:1.6;">
        <strong>Note:</strong> Receipts and backup documentation should be filed in the chapter's shared drive.
        Include the vendor name and invoice number in the Notes field for audit trail.
      </div>
    </div>
  </div>
</div>

<div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
  <a href="/admin/expenses" class="btn btn-sm">Cancel</a>
  <button class="btn btn-primary" @onclick="Submit" disabled="@_busy">@(_busy ? "Saving…" : "Log Expense")</button>
</div>

@code {
  private string _description = "", _category = "Supplies", _paidBy = "", _notes = "";
  private decimal _amount;
  private DateTime _paidAt = DateTime.Today;
  private int _chapterId;
  private bool _busy, _saved;
  private string _error = "";
  private List<Chapter> _chapters = [];

  protected override async Task OnInitializedAsync()
  {
    _chapters = await Api.GetChaptersAdminAsync();
  }

  private async Task Submit()
  {
    _error = "";
    if (string.IsNullOrWhiteSpace(_description)) { _error = "Description is required."; return; }
    if (_amount <= 0) { _error = "Amount must be greater than 0."; return; }
    if (string.IsNullOrWhiteSpace(_paidBy)) { _error = "Paid By is required."; return; }
    if (_chapterId == 0) { _error = "Please select a chapter."; return; }

    _busy = true;
    var expense = new Expense
    {
      Description = _description,
      Amount      = _amount,
      Category    = _category,
      PaidAt      = _paidAt,
      PaidBy      = _paidBy,
      ChapterId   = _chapterId,
      Notes       = string.IsNullOrWhiteSpace(_notes) ? null : _notes,
    };
    var result = await Api.CreateExpenseAsync(expense);
    _busy = false;
    if (result is not null)
    {
      _saved = true;
      await Task.Delay(700);
      Nav.NavigateTo("/admin/expenses");
    }
    else _error = "Save failed. Please try again.";
  }
}
