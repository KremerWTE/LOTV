@page "/admin/impact"
@layout AdminLayout
@inject ApiService Api
@inject IJSRuntime JS

<PageTitle>Impact &amp; Distribution — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Impact &amp; Distribution Dashboard</h2>
    <p>Where money and resources are going — by category, region, and time</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/export" class="btn btn-sm">⇩ Export</a>
    <button class="btn btn-sm" @onclick="LoadAsync">↻ Refresh</button>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Loading impact data…" Size="lg" />
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:24px;">
    <div class="kpi-card kpi-gold">
      <div class="kpi-icon">💸</div>
      <div class="kpi-label">Total Donated (All Time)</div>
      <div class="kpi-value" style="color:var(--gold)"><Money Amount="@_channels.Sum(c => c.TotalAmount)" /></div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">📦</div>
      <div class="kpi-label">Resources Donated</div>
      <div class="kpi-value" style="color:var(--green)">@_totalResources</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">👥</div>
      <div class="kpi-label">Families Helped</div>
      <div class="kpi-value" style="color:var(--navy)">@_familiesHelped</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">✅</div>
      <div class="kpi-label">Requests Fulfilled</div>
      <div class="kpi-value" style="color:var(--amber)">@_moneyFlow.Sum(m => m.RequestCount)</div>
    </div>
  </div>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">

    <!-- MONEY FLOW BY CATEGORY -->
    <div class="panel">
      <div class="panel-header">Money Flow by Category</div>
      <div class="panel-body">
        @if (!_moneyFlow.Any())
        {
          <div class="empty-state"><p>No allocation data.</p></div>
        }
        else
        {
          <BarChart Items="_moneyFlow.OrderByDescending(r => r.Amount)"
                    LabelFunc="r => r.Category"
                    ValueFunc="r => (double)r.Amount"
                    FormatFunc='r => $"{r.Amount:C0} — {r.RequestCount} cases"'
                    Orientation="horizontal" Color="var(--gold)" ShowPercent="true" />
          <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:10px;display:flex;justify-content:space-between;font-size:.82rem;font-weight:700;">
            <span>Total Allocated</span>
            <span><Money Amount="@_moneyFlow.Sum(m => m.Amount)" /></span>
          </div>
        }
      </div>
    </div>

    <!-- RESOURCE DISTRIBUTION BY TYPE -->
    <div class="panel">
      <div class="panel-header">Resource Distribution by Type</div>
      <div class="panel-body">
        @if (!_resourceFlow.Any())
        {
          <div class="empty-state"><p>No resource data.</p></div>
        }
        else
        {
          <BarChart Items="_resourceFlow.OrderByDescending(r => r.Quantity)"
                    LabelFunc="r => r.ResourceType"
                    ValueFunc="r => r.Quantity"
                    FormatFunc='r => $"{r.Quantity} {r.Unit} — {r.RequestCount} req."'
                    Orientation="horizontal" Color="var(--green)" ShowPercent="true" />
          <div style="border-top:1px solid var(--border);padding-top:10px;margin-top:10px;display:flex;justify-content:space-between;font-size:.82rem;font-weight:700;">
            <span>Total Items Distributed</span>
            <span>@_totalResources</span>
          </div>
        }
      </div>
    </div>
  </div>

  <!-- TIMELINE -->
  <div class="panel" style="margin-bottom:24px;">
    <div class="panel-header">Monthly Activity Timeline</div>
    <div class="panel-body" style="padding:0;">
      @if (!_timeline.Any())
      {
        <div class="empty-state"><p>No timeline data.</p></div>
      }
      else
      {
        <div style="padding:16px 20px 8px;">
          <LineChart Items="_timeline.TakeLast(12)"
                     LabelFunc="p => p.Period.Split(' ')[0]"
                     ValueFunc="p => (double)p.Donations"
                     Series2Func="p => (double)p.RequestsFulfilled"
                     Color="var(--gold)" Color2="var(--navy)"
                     Legend1="Donations" Legend2="Fulfilled"
                     Height="130" ShowArea="true" ShowDots="true" />
        </div>
        <!-- Data table -->
        <table class="data-table">
          <thead>
            <tr>
              <th>Period</th>
              <th style="text-align:right;">Donations Received</th>
              <th style="text-align:right;">Requests Fulfilled</th>
              <th style="text-align:right;">New Requests</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var pt in _timeline.AsEnumerable().Reverse().Take(12))
            {
              <tr>
                <td style="font-weight:600;">@pt.Period</td>
                <td style="text-align:right;color:var(--gold);font-weight:600;"><Money Amount="@pt.Donations" /></td>
                <td style="text-align:right;color:var(--green);font-weight:600;">@pt.RequestsFulfilled</td>
                <td style="text-align:right;">@pt.NewRequests</td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>

  <!-- TOP REGIONS / DONATION CHANNEL BREAKDOWN -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">

    <!-- DONATION CHANNELS -->
    <div class="panel">
      <div class="panel-header">Donations by Channel</div>
      <div class="panel-body">
        @if (!_channels.Any())
        {
          <div class="empty-state"><p>No channel data.</p></div>
        }
        else
        {
          <BarChart Items="_channels.OrderByDescending(c => c.TotalAmount)"
                    LabelFunc="c => c.Channel"
                    ValueFunc="c => (double)c.TotalAmount"
                    FormatFunc='c => $"{c.TotalAmount:C0} ({c.GiftCount} gifts)"'
                    Orientation="horizontal" Color="#4a6fa5" ShowPercent="true" />
        }
      </div>
    </div>

    <!-- ALLOCATION LEDGER QUICK LINK -->
    <div class="panel">
      <div class="panel-header">Allocation Ledger</div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:14px;">
        <p style="font-size:.84rem;color:var(--text-mid);margin:0;">
          The full allocation ledger shows every money and resource allocation — donor, contribution, request, and recipient — with dates and status.
        </p>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
          <div class="kpi-card kpi-gold" style="padding:14px;">
            <div class="kpi-label">Total Allocated</div>
            <div class="kpi-value" style="color:var(--gold);font-size:1.4rem;"><Money Amount="@_moneyFlow.Sum(m => m.Amount)" /></div>
          </div>
          <div class="kpi-card kpi-green" style="padding:14px;">
            <div class="kpi-label">Resource Items</div>
            <div class="kpi-value" style="color:var(--green);font-size:1.4rem;">@_totalResources</div>
          </div>
        </div>
        <div style="display:flex;gap:10px;margin-top:4px;">
          <a href="/admin/allocations" class="btn btn-primary btn-sm">View Full Ledger</a>
          <a href="/admin/export" class="btn btn-sm">⇩ Export CSV</a>
        </div>
      </div>
    </div>
  </div>

  <!-- GEOGRAPHIC IMPACT MAP -->
  @if (_dioceses.Any())
  {
    <div class="panel" style="margin-bottom:24px;">
      <div class="panel-head">
        <h3>Geographic Impact — Service Delivery by Diocese</h3>
        <span style="font-size:.8rem;color:var(--text-light);">Circle size reflects total donations; click a pin for details</span>
      </div>
      <div class="panel-body" style="padding:16px;">
        <LeafletMap Markers="_dioceseMarkers" Height="340px" />
      </div>
    </div>
  }

  <!-- PUBLIC TRANSPARENCY LINK -->
  <div style="background:var(--navy);color:white;border-radius:12px;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;">
    <div>
      <div style="font-family:var(--ff-head);font-size:1rem;font-weight:700;margin-bottom:4px;">Public Transparency Page</div>
      <div style="font-size:.82rem;opacity:.8;">Share aggregate impact data with the public — no PII, no donor names.</div>
    </div>
    <a href="/transparency" class="btn btn-sm" style="background:white;color:var(--navy);font-weight:700;">View Public Page →</a>
  </div>
}

@code {
  private bool _loading = true;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
      try { await JS.InvokeVoidAsync("lotvStickyFilter.attach"); } catch { }
  }

  private DashboardStatsDto? _stats;
  private List<MoneyFlowCategoryDto> _moneyFlow = [];
  private List<ResourceFlowTypeDto> _resourceFlow = [];
  private List<TimelinePointDto> _timeline = [];
  private List<ChannelBreakdownDto> _channels = [];
  private List<Diocese> _dioceses = [];
  private int _familiesHelped;

  private int _totalResources => _resourceFlow.Sum(r => r.Quantity);

  private List<MapMarker> _dioceseMarkers => _dioceses
    .Where(d => !string.IsNullOrEmpty(d.State))
    .Select(d => new MapMarker(
        d.Name, d.State,
        (double)d.TotalDonations,
        "var(--gold)",
        $"{d.TotalDonations:C0} donations · {d.TotalCasesFulfilled} fulfilled"))
    .ToList();

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    _loading = true;
    var t1 = Api.GetDashboardStatsAsync();
    var t2 = Api.GetMoneyFlowAsync();
    var t3 = Api.GetResourceFlowAsync();
    var t4 = Api.GetTimelineAsync();
    var t5 = Api.GetDonationsByChannelAsync();
    var t6 = Api.GetDiocesesAsync();
    var t7 = Api.GetRequestsAsync();
    await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7);
    _stats        = t1.Result;
    _moneyFlow    = t2.Result;
    _resourceFlow = t3.Result;
    _timeline     = t4.Result;
    _channels     = t5.Result;
    _dioceses     = t6.Result;
    _familiesHelped = t7.Result.Where(r => r.Status == CaseStatus.Fulfilled).Select(r => r.FamilyId).Distinct().Count();
    _loading = false;
  }
}
