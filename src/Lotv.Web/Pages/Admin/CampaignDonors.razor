@page "/admin/campaigns/{Id:int}/donors"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Campaign Donors — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Campaign Donors</h2><p>@(_campaign?.Name ?? $"Campaign #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/campaigns/@Id" class="btn btn-sm">← Campaign</a>
    <a href="/admin/campaigns/@Id/donations" class="btn btn-sm">All Gifts</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">Unique Donors</div>
      <div class="kpi-value" style="color:var(--navy)">@_donorRows.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Total Raised</div>
      <div class="kpi-value" style="color:var(--green)">@_donorRows.Sum(r => r.Total).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128200;</div>
      <div class="kpi-label">Avg Gift</div>
      <div class="kpi-value" style="color:var(--amber)">@(_donorRows.Any() ? (_donorRows.Sum(r => r.Total) / _donorRows.Sum(r => r.Count)).ToString("C0") : "—")</div>
    </div>
    @if (_campaign is not null)
    {
      <div class="kpi-card">
        <div class="kpi-icon">&#127919;</div>
        <div class="kpi-label">Goal Progress</div>
        <div class="kpi-value" style="font-size:.9rem;">
          @if (_campaign.GoalAmount > 0)
          {
            @(Math.Min(100m, _campaign.Raised / _campaign.GoalAmount * 100m).ToString("F0"))@:% of @_campaign.GoalAmount.ToString("C0")
          }
          else
          {
            <text>—</text>
          }
        </div>
      </div>
    }
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Donors (@_donorRows.Count)</h3>
      <input class="form-input" style="width:200px;font-size:.82rem;padding:5px 10px;"
             placeholder="Search…" @bind="_search" @bind:event="oninput" />
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!Filtered.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No donors match.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Donor</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Gifts</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Total</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">First Gift</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Last Gift</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var r in Filtered)
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/donors/@r.DonorId" style="color:var(--navy);">@r.DonorName</a>
                </td>
                <td style="padding:10px 16px;font-size:.82rem;text-align:right;color:var(--text-light);">@r.Count</td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@r.Total.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@r.FirstGift.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@r.LastGift.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/donors/@r.DonorId" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private CampaignDto? _campaign;
  private List<DonorRow> _donorRows = [];
  private string _search = "";
  private bool _loading = true;

  private record DonorRow(int DonorId, string DonorName, int Count, decimal Total, DateTime FirstGift, DateTime LastGift);

  private IEnumerable<DonorRow> Filtered => _donorRows
    .Where(r => string.IsNullOrEmpty(_search) || r.DonorName.Contains(_search, StringComparison.OrdinalIgnoreCase))
    .OrderByDescending(r => r.Total);

  protected override async Task OnInitializedAsync()
  {
    var campaignTask = Api.GetCampaignsAsync();
    var donationTask = Api.GetDonationsAsync();
    await Task.WhenAll(campaignTask, donationTask);
    var campaigns = await campaignTask;
    _campaign = campaigns.FirstOrDefault(c => c.Id == Id);
    var all   = await donationTask;
    var campaignName = _campaign?.Name;
    var forCampaign  = all.Where(d => d.Campaign == campaignName).ToList();
    _donorRows = forCampaign
      .GroupBy(d => d.DonorId)
      .Select(g => new DonorRow(
        g.Key,
        g.First().Donor?.FullName ?? $"Donor #{g.Key}",
        g.Count(),
        g.Sum(d => d.Amount),
        g.Min(d => d.Date),
        g.Max(d => d.Date)))
      .ToList();
    _loading = false;
  }
}
