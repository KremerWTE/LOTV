@page "/admin/events/attendees"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Event Attendance Summary — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Event Attendance Summary</h2><p>Attendance trends across all fundraising events</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events" class="btn btn-sm">← Events</a>
    <a href="/admin/events/summary" class="btn btn-sm">Event Summary</a>
    <a href="/admin/sponsorships" class="btn btn-sm">Sponsorships</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Loading attendance data…" />
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">🎈</div>
      <div class="kpi-label">Events Analyzed</div>
      <div class="kpi-value" style="color:var(--navy)">@_eventRows.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">👥</div>
      <div class="kpi-label">Total Attendees</div>
      <div class="kpi-value" style="color:var(--green)">@_eventRows.Sum(e => e.Registered)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">☑</div>
      <div class="kpi-label">Checked In</div>
      <div class="kpi-value" style="color:var(--amber)">@_eventRows.Sum(e => e.CheckedIn)</div>
      <div class="kpi-change">@_overallCheckinRate% check-in rate</div>
    </div>
    <div class="kpi-card kpi-blush">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Avg Capacity Fill</div>
      <div class="kpi-value" style="color:var(--blush)">@_avgFillRate%</div>
      <div class="kpi-change">across all events</div>
    </div>
  </div>

  <!-- ATTENDANCE BY EVENT -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">
      <h3>Attendance per Event</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Bar = registered &bull; darker = checked in</span>
    </div>
    <div class="panel-body" style="display:flex;flex-direction:column;gap:12px;">
      @{ var maxReg = _eventRows.Any() ? _eventRows.Max(e => e.Capacity > 0 ? e.Capacity : e.Registered) : 1; }
      @foreach (var e in _eventRows.OrderByDescending(e => e.Date))
      {
        var regPct     = maxReg > 0 ? (int)(e.Registered * 100.0 / maxReg) : 0;
        var checkinPct = e.Registered > 0 ? (int)(e.CheckedIn * 100.0 / e.Registered) : 0;
        var fillPct    = e.Capacity > 0 ? (int)(e.Registered * 100.0 / e.Capacity) : 0;
        var fillColor  = fillPct >= 90 ? "var(--green)" : fillPct >= 60 ? "var(--amber)" : "var(--text-light)";
        <div style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/events/{e.Id}")'>
          <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:4px;flex-wrap:wrap;gap:4px;">
            <span style="font-weight:700;">@e.Title <span style="font-size:.7rem;color:var(--text-light);font-weight:400;">@e.Date.ToString("MMM d, yyyy")</span></span>
            <span style="color:var(--text-mid);font-size:.76rem;">
              @e.Registered registered @(e.Capacity > 0 ? $"of {e.Capacity}" : "") &bull;
              @e.CheckedIn checked in (@checkinPct%) @(e.Capacity > 0 ? $"&bull; {fillPct}% capacity" : "")
            </span>
          </div>
          <div style="position:relative;height:10px;">
            <div class="progress-bar" style="height:10px;border-radius:5px;">
              <div style="width:@regPct%;background:#e2e8f0;height:10px;border-radius:5px;position:absolute;"></div>
              <div style="width:@((int)(regPct * checkinPct / 100.0))%;background:var(--green);height:10px;border-radius:5px;position:absolute;"></div>
            </div>
          </div>
          @if (e.Capacity > 0)
          {
            <div style="font-size:.66rem;color:@fillColor;margin-top:2px;text-align:right;">@fillPct% of capacity</div>
          }
        </div>
      }
    </div>
  </div>

  <!-- EVENT TYPE BREAKDOWN -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

    <div class="panel">
      <div class="panel-head"><h3>By Event Type</h3></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
        @{ var maxType = _byType.Any() ? _byType.Max(t => t.TotalAttendees) : 1; }
        @foreach (var t in _byType.OrderByDescending(t => t.TotalAttendees))
        {
          var pct = (int)(t.TotalAttendees * 100.0 / maxType);
          <div>
            <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:3px;">
              <span style="font-weight:600;">@t.Type</span>
              <span style="color:var(--text-mid);">@t.Events events &bull; @t.TotalAttendees attendees</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width:@pct%;"></div></div>
          </div>
        }
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>Check-In Rate by Event</h3></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:8px;">
        @foreach (var e in _eventRows.Where(e => e.Registered > 0).OrderByDescending(e => e.CheckedIn * 100 / e.Registered).Take(8))
        {
          var rate = (int)(e.CheckedIn * 100.0 / e.Registered);
          var col  = rate >= 80 ? "var(--green)" : rate >= 50 ? "var(--amber)" : "var(--red)";
          <div style="display:flex;align-items:center;gap:8px;font-size:.78rem;">
            <div style="flex:1;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:600;">@e.Title</div>
            <div style="width:50px;text-align:right;font-weight:700;color:@col;">@rate%</div>
          </div>
        }
      </div>
    </div>

  </div>

  <!-- FULL TABLE -->
  <div class="panel">
    <div class="panel-head"><h3>All Events Detail</h3></div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Event</th>
            <th>Date</th>
            <th>Type</th>
            <th style="text-align:right;">Capacity</th>
            <th style="text-align:right;">Registered</th>
            <th style="text-align:right;">Checked In</th>
            <th style="text-align:right;">Fill Rate</th>
            <th style="text-align:right;">Checkin %</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var e in _eventRows.OrderByDescending(e => e.Date))
          {
            var fill   = e.Capacity > 0 ? (int)(e.Registered * 100.0 / e.Capacity) : 0;
            var checkin= e.Registered > 0 ? (int)(e.CheckedIn * 100.0 / e.Registered) : 0;
            <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/events/{e.Id}")'>
              <td style="font-weight:600;">@e.Title</td>
              <td style="font-size:.76rem;color:var(--text-light);">@e.Date.ToString("MMM d, yyyy")</td>
              <td style="font-size:.74rem;color:var(--text-mid);">@e.Type</td>
              <td style="text-align:right;color:var(--text-light);">@(e.Capacity > 0 ? e.Capacity.ToString() : "—")</td>
              <td style="text-align:right;font-weight:600;">@e.Registered</td>
              <td style="text-align:right;color:var(--green);">@e.CheckedIn</td>
              <td style="text-align:right;color:@(fill >= 90 ? "var(--green)" : fill > 0 ? "var(--amber)" : "var(--text-light)");">@(e.Capacity > 0 ? $"{fill}%" : "—")</td>
              <td style="text-align:right;font-weight:700;color:@(checkin >= 80 ? "var(--green)" : checkin > 0 ? "var(--amber)" : "var(--text-light)");">@(e.Registered > 0 ? $"{checkin}%" : "—")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private record EventRow(int Id, string Title, DateTime Date, string Type, int Capacity, int Registered, int CheckedIn);
  private record TypeRow(string Type, int Events, int TotalAttendees);

  private bool _loading = true;
  private List<EventRow> _eventRows = [];
  private List<TypeRow> _byType = [];
  private int _overallCheckinRate, _avgFillRate;

  protected override async Task OnInitializedAsync()
  {
    var events = await Api.GetEventsAsync();
    var rows   = new List<EventRow>();

    foreach (var ev in events)
    {
      var attendees = await Api.GetAttendeesAsync(ev.Id);
      rows.Add(new EventRow(
          ev.Id, ev.Title, ev.Date, ev.Type.ToString(),
          ev.Capacity ?? 0, attendees.Count,
          attendees.Count(a => a.CheckedIn)));
    }

    _eventRows = rows;

    var totalReg     = _eventRows.Sum(e => e.Registered);
    var totalCheckin = _eventRows.Sum(e => e.CheckedIn);
    _overallCheckinRate = totalReg > 0 ? (int)(totalCheckin * 100.0 / totalReg) : 0;
    _avgFillRate        = _eventRows.Where(e => e.Capacity > 0).Any()
        ? (int)_eventRows.Where(e => e.Capacity > 0).Average(e => e.Registered * 100.0 / e.Capacity)
        : 0;

    _byType = _eventRows
      .GroupBy(e => e.Type)
      .Select(g => new TypeRow(g.Key, g.Count(), g.Sum(e => e.Registered)))
      .ToList();

    _loading = false;
  }
}
