@page "/admin/cases"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthService Auth

<PageTitle>Family Cases — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Family Cases</h2>
    <p>All active, pending, and fulfilled service requests</p>
  </div>
  <div class="page-hd-actions">
    <button class="btn btn-sm" @onclick="OpenNew">+ New Request</button>
    <a href="/admin/kanban" class="btn btn-sm">Kanban View</a>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">📦</div>
    <div class="kpi-label">Open Cases</div>
    <div class="kpi-value" style="color:var(--navy)">@_all.Count(r => r.Status is CaseStatus.New or CaseStatus.InProgress or CaseStatus.AwaitingShipment)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">⚠</div>
    <div class="kpi-label">Overdue</div>
    <div class="kpi-value" style="color:var(--amber)">@_all.Count(r => r.IsOverdue)</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">✅</div>
    <div class="kpi-label">Fulfilled</div>
    <div class="kpi-value" style="color:var(--green)">@_all.Count(r => r.Status == CaseStatus.Fulfilled)</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">🕐</div>
    <div class="kpi-label">Avg Age (Open)</div>
    <div class="kpi-value" style="color:var(--gold)">@_avgAgeOpen</div>
  </div>
</div>

<!-- FILTER BAR -->
<div class="filter-bar">
  @foreach (var f in _filters)
  {
    <button class="filter-chip @(_activeFilter == f ? "active" : "")" aria-pressed="@(_activeFilter == f)" @onclick="() => SetFilter(f)">@f</button>
  }
  <select class="form-input" style="width:auto;font-size:.82rem;padding:5px 10px;" @bind="_priorityFilter" @bind:after="ApplyFilter">
    <option value="">All Priorities</option>
    @foreach (var p in Enum.GetValues<RequestPriority>())
    { <option value="@p">@p</option> }
  </select>
  <select class="form-input" style="width:auto;font-size:.82rem;padding:5px 10px;" @bind="_categoryFilter" @bind:after="ApplyFilter">
    <option value="">All Categories</option>
    @foreach (var c in Enum.GetValues<RequestCategory>())
    { <option value="@c">@c</option> }
  </select>
  <input class="form-input" style="width:220px;padding:5px 12px;font-size:.82rem;" placeholder="🔍 Search families..." aria-label="Search families" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
</div>

<!-- TABLE -->
<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr>
          <th>#</th>
          <th>Family</th>
          <th>Category</th>
          <th>Status</th>
          <th>Priority</th>
          <th>Assigned To</th>
          <th>Due</th>
          <th>Age</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        @if (!_filtered.Any())
        {
          <tr><td colspan="9"><div class="empty-state"><div class="icon">💕</div><p>No cases match this filter.</p></div></td></tr>
        }
        @foreach (var r in _filtered)
        {
          <tr>
            <td style="font-size:.76rem;color:var(--text-light);">#@r.Id</td>
            <td>
              <strong>@r.Family?.FullName</strong>
              @if (r.IsOverdue)
              { <span class="badge badge-overdue" style="margin-left:6px;">Overdue</span> }
              <div style="font-size:.72rem;color:var(--text-light);">@r.Reason.ToDisplayName()</div>
            </td>
            <td style="font-size:.8rem;color:var(--text-mid);">@r.Category</td>
            <td><span class="badge @GetStatusBadge(r.Status)">@r.Status</span></td>
            <td style="font-size:.82rem;">
              <span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:@PriorityColor(r.Priority);margin-right:5px;"></span>@r.Priority
            </td>
            <td style="font-size:.82rem;">@(r.AssignedTo ?? "—")</td>
            <td style="font-size:.76rem;">
              @if (r.DueDate is null)
              { <span style="color:var(--text-light);">—</span> }
              else
              { <span style="color:@(r.DueDate < DateTime.UtcNow ? "var(--red)" : r.DueDate < DateTime.UtcNow.AddDays(3) ? "var(--amber)" : "var(--text-light)");">@r.DueDate.Value.ToString("MMM d")</span> }
            </td>
            <td style="font-size:.76rem;color:var(--text-light);">@GetAge(r.CreatedAt)</td>
            <td>
              <a href="/admin/cases/@r.Id" class="btn btn-sm">Details</a>
              <button class="btn btn-sm" @onclick="() => OpenCase(r)">Quick Edit</button>
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

<!-- NEW REQUEST DRAWER -->
@if (_showNew)
{
  <div style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;" @onclick="CloseNew"></div>
  <div style="position:fixed;right:0;top:0;bottom:0;width:520px;background:white;z-index:501;overflow-y:auto;box-shadow:-4px 0 24px rgba(0,0,0,.15);">
    <div style="padding:22px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
      <h3 style="font-family:var(--ff-head);">New Resource Request</h3>
      <button class="btn btn-sm" aria-label="Close" @onclick="CloseNew">✕</button>
    </div>
    <div style="padding:24px;display:flex;flex-direction:column;gap:16px;">

      @if (_prefillFamily is not null)
      {
        <div style="background:var(--green-pale);border-radius:8px;padding:12px 14px;font-size:.82rem;color:var(--green-dark);">
          💕 Creating a new case for existing family: <strong>@_prefillFamily.FullName</strong>. A new family record will not be created.
        </div>
      }
      else
      {
        <div style="background:var(--green-pale);border-radius:8px;padding:12px 14px;font-size:.82rem;color:var(--green-dark);">
          💕 This form creates a new family intake record and opens a case. The next available volunteer will be auto-assigned.
        </div>
      }

      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">Parent 1 First Name *</label>
          <input class="form-input" @bind="_nf.Parent1FirstName" placeholder="First" />
        </div>
        <div class="form-group">
          <label class="form-label">Parent 1 Last Name *</label>
          <input class="form-input" @bind="_nf.Parent1LastName" placeholder="Last" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Email *</label>
        <input class="form-input" type="email" @bind="_nf.Email" />
      </div>

      <div class="form-group">
        <label class="form-label">Phone</label>
        <input class="form-input" @bind="_nf.Phone" />
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">City</label>
          <input class="form-input" @bind="_nf.City" />
        </div>
        <div class="form-group">
          <label class="form-label">State</label>
          <input class="form-input" @bind="_nf.State" placeholder="IL" />
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Reason for Request *</label>
        <select class="form-input" @bind="_nf.Reason">
          @foreach (var r in Enum.GetValues<PackageReason>())
          { <option value="@r">@r.ToDisplayName()</option> }
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Parish</label>
        <input class="form-input" @bind="_nf.ParishName" placeholder="St. Mary's, Chicago" />
      </div>

      <div class="form-group">
        <label class="form-label">Faith Tradition</label>
        <select class="form-input" @bind="_nf.FaithTradition">
          <option value="">— Select —</option>
          <option>Catholic</option>
          <option>Protestant</option>
          <option>Christian (non-denominational)</option>
          <option>Orthodox</option>
          <option>Other</option>
          <option>Prefer not to say</option>
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Children's Initials (for bracelet)</label>
        <input class="form-input" @bind="_nf.ChildrenInitials" placeholder="e.g. E.M., T.J." />
      </div>

      <div class="form-group">
        <label class="form-label">Override Auto-Assign</label>
        <select class="form-input" @bind="_newAssignOverrideVolId">
          <option value="">Auto (next available)</option>
          @foreach (var v in _volunteers)
          { <option value="@v.Id">@v.FullName</option> }
        </select>
      </div>

      @if (!string.IsNullOrEmpty(_newError))
      { <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;">⚠ @_newError</div> }

      <div style="display:flex;gap:10px;">
        <button class="btn btn-primary" @onclick="SubmitNewRequestAsync" disabled="@_submitting">@(_submitting ? "Submitting…" : "Submit & Auto-Assign")</button>
        <button class="btn" @onclick="CloseNew" disabled="@_submitting">Cancel</button>
      </div>
    </div>
  </div>
}

<!-- CASE DETAIL DRAWER -->
@if (_selected is not null)
{
  <div style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:500;" @onclick="CloseCase"></div>
  <div style="position:fixed;right:0;top:0;bottom:0;width:480px;background:white;z-index:501;overflow-y:auto;box-shadow:-4px 0 24px rgba(0,0,0,.15);">
    <div style="padding:22px 24px;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;align-items:center;">
      <h3 style="font-family:var(--ff-head);">Case #@_selected.Id — @_selected.Family?.FullName</h3>
      <button class="btn btn-sm" @onclick="CloseCase">✕</button>
    </div>
    <div style="padding:24px;display:flex;flex-direction:column;gap:20px;">

      <div>
        <div class="form-label" style="margin-bottom:8px;">Status</div>
        <select class="form-select" @bind="_editStatus">
          @foreach (var s in Enum.GetValues<CaseStatus>())
          { <option value="@s">@s</option> }
        </select>
      </div>

      <div>
        <div class="form-label" style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
          <span>Assigned To</span>
          @if (!string.IsNullOrEmpty(_selected.AssignedTo))
          { <a href="/admin/volunteers?q=@Uri.EscapeDataString(_selected.AssignedTo)" style="font-size:.74rem;color:var(--green);text-decoration:none;font-weight:600;">View Volunteer &rarr;</a> }
        </div>
        <select class="form-select" @bind="_editAssignedVolId">
          <option value="">— Unassigned —</option>
          @foreach (var v in _volunteers)
          { <option value="@v.Id">@v.FullName</option> }
        </select>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label">Reason</label>
          <div style="padding:9px 12px;background:var(--bg);border-radius:8px;font-size:.86rem;">@_selected.Reason.ToDisplayName()</div>
        </div>
        <div class="form-group">
          <label class="form-label">Created</label>
          <div style="padding:9px 12px;background:var(--bg);border-radius:8px;font-size:.86rem;">@_selected.CreatedAt.ToString("MMM d, yyyy")</div>
        </div>
      </div>

      @if (_selected.Family is not null)
      {
        <div>
          <div class="form-label" style="margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;">
            <span>Family Information</span>
            <a href="/admin/families?family=@_selected.Family.Id" style="font-size:.74rem;color:var(--green);text-decoration:none;font-weight:600;">View Profile &rarr;</a>
          </div>
          <div style="background:var(--green-pale);border-radius:10px;padding:14px 16px;font-size:.84rem;display:grid;grid-template-columns:1fr 1fr;gap:8px;">
            <div><strong>Name:</strong> @_selected.Family.FullName</div>
            <div><strong>Email:</strong> @_selected.Family.Email</div>
            <div><strong>Phone:</strong> @(_selected.Family.Phone ?? "—")</div>
            <div><strong>City, State:</strong> @_selected.Family.City, @_selected.Family.State</div>
            <div><strong>Parish:</strong> @(_selected.Family.ParishName ?? "—")</div>
            <div><strong>Faith:</strong> @(_selected.Family.FaithTradition ?? "Not specified")</div>
            @if (!string.IsNullOrEmpty(_selected.Family.ChildrenInitials))
            { <div style="grid-column:1/-1;"><strong>Children's Initials:</strong> @_selected.Family.ChildrenInitials</div> }
          </div>
        </div>
      }

      @if (_editStatus is CaseStatus.AwaitingShipment or CaseStatus.Shipped or CaseStatus.Fulfilled)
      {
        <div class="form-grid-2">
          <div class="form-group">
            <label class="form-label">Tracking Number</label>
            <input class="form-input" @bind="_editTrackingNumber" placeholder="e.g. 1Z999AA10123456784" />
          </div>
          <div class="form-group">
            <label class="form-label">Shipped Date</label>
            <input class="form-input" type="date"
                   value="@(_editShippedDate?.ToString("yyyy-MM-dd") ?? "")"
                   @onchange='e => _editShippedDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)' />
          </div>
        </div>
      }

      <div class="form-group">
        <label class="form-label">Internal Notes</label>
        <textarea class="form-textarea" @bind="_editInternalNotes" placeholder="Add notes visible only to staff..."></textarea>
      </div>

      <div style="display:flex;gap:10px;">
        <button class="btn btn-primary" @onclick="SaveCaseAsync" disabled="@_saving">@(_saving ? "Saving…" : "Save Changes")</button>
        <button class="btn" @onclick="CloseCase" disabled="@_saving">Cancel</button>
      </div>

      @if (_saved)
      { <div style="background:var(--green-pale);border-radius:8px;padding:10px 14px;font-size:.84rem;color:var(--green-dark);">✓ Changes saved.</div> }
    </div>
  </div>
}

@code {
  [Parameter][SupplyParameterFromQuery(Name = "familyId")] public int FamilyId { get; set; }

  private List<PackageRequest> _all = [];
  private List<PackageRequest> _filtered = [];
  private List<Volunteer> _volunteers = [];
  private PackageRequest? _selected;

  // Case detail drawer edit state (separate from _selected to track changes)
  private CaseStatus _editStatus;
  private int? _editAssignedVolId;
  private string? _editTrackingNumber;
  private DateTime? _editShippedDate;
  private string? _editInternalNotes;

  private string _activeFilter = "All";
  private string _priorityFilter = "";
  private string _categoryFilter = "";
  private string _search = "";
  private bool _showNew;
  private bool _saved;
  private bool _saving;
  private string _avgAgeOpen = "—";

  // New request form state
  private Family _nf = new();
  private Family? _prefillFamily;
  private int? _newAssignOverrideVolId;
  private string _newError = "";
  private bool _submitting;

  private readonly string[] _filters = ["All", "New", "In Progress", "Awaiting Shipment", "Shipped", "Fulfilled", "On Hold", "Cancelled", "Overdue"];

  protected override async Task OnInitializedAsync()
  {
    _volunteers = await Api.GetVolunteersAsync("Active");
    await LoadAsync();

    if (FamilyId > 0)
    {
      _prefillFamily = await Api.GetFamilyAsync(FamilyId);
      OpenNew();
    }
    else if (Nav.Uri.Contains("?new=1") || Nav.Uri.Contains("&new=1"))
    {
      OpenNew();
    }
  }

  private async Task LoadAsync()
  {
    _all = await Api.GetRequestsAsync();
    var openAges = _all
      .Where(r => r.Status is CaseStatus.New or CaseStatus.InProgress or CaseStatus.AwaitingShipment)
      .Select(r => (DateTime.UtcNow - r.CreatedAt).TotalDays)
      .ToList();
    _avgAgeOpen = openAges.Count > 0 ? $"{openAges.Average():F0}d" : "—";
    ApplyFilter();
  }

  private void SetFilter(string f) { _activeFilter = f; ApplyFilter(); }

  private void ApplyFilter()
  {
    _filtered = _all.Where(r =>
    {
      var matchFilter = _activeFilter switch
      {
        "New"               => r.Status == CaseStatus.New,
        "In Progress"       => r.Status == CaseStatus.InProgress,
        "Awaiting Shipment" => r.Status == CaseStatus.AwaitingShipment,
        "Shipped"           => r.Status == CaseStatus.Shipped,
        "Fulfilled"         => r.Status == CaseStatus.Fulfilled,
        "On Hold"           => r.Status == CaseStatus.OnHold,
        "Cancelled"         => r.Status == CaseStatus.Cancelled,
        "Overdue"           => r.IsOverdue,
        _                   => true
      };
      var matchSearch = string.IsNullOrEmpty(_search) ||
        (r.Family?.FullName.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
        r.Reason.ToString().Contains(_search, StringComparison.OrdinalIgnoreCase);
      var matchPriority = string.IsNullOrEmpty(_priorityFilter) || r.Priority.ToString() == _priorityFilter;
      var matchCategory = string.IsNullOrEmpty(_categoryFilter) || r.Category.ToString() == _categoryFilter;
      return matchFilter && matchSearch && matchPriority && matchCategory;
    }).ToList();
  }

  private static string PriorityColor(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "var(--red)",
    RequestPriority.High   => "var(--amber)",
    RequestPriority.Normal => "var(--green)",
    RequestPriority.Low    => "var(--text-light)",
    _ => "var(--text-light)"
  };

  private void OpenCase(PackageRequest r)
  {
    _selected            = r;
    _editStatus          = r.Status;
    _editAssignedVolId   = r.AssignedToId;
    _editTrackingNumber  = r.TrackingNumber;
    _editShippedDate     = r.ShippedDate;
    _editInternalNotes   = r.InternalNotes;
    _saved               = false;
  }

  private void CloseCase() { _selected = null; _saved = false; }

  private void OpenNew()
  {
    _nf = _prefillFamily is not null
      ? new Family
        {
          Parent1FirstName = _prefillFamily.Parent1FirstName,
          Parent1LastName  = _prefillFamily.Parent1LastName,
          Email            = _prefillFamily.Email,
          Phone            = _prefillFamily.Phone ?? "",
          City             = _prefillFamily.City ?? "",
          State            = _prefillFamily.State ?? "",
          Reason           = _prefillFamily.Reason,
          ParishName       = _prefillFamily.ParishName,
          FaithTradition   = _prefillFamily.FaithTradition,
          ChildrenInitials = _prefillFamily.ChildrenInitials
        }
      : new Family();
    _newAssignOverrideVolId = null;
    _newError = "";
    _showNew = true;
  }

  private void CloseNew() { _showNew = false; _newError = ""; }

  private async Task SubmitNewRequestAsync()
  {
    if (string.IsNullOrWhiteSpace(_nf.Parent1FirstName) || string.IsNullOrWhiteSpace(_nf.Parent1LastName))
    { _newError = "First and last name are required."; return; }
    if (string.IsNullOrWhiteSpace(_nf.Email))
    { _newError = "Email address is required."; return; }

    _submitting = true;
    _newError = "";

    int familyId;
    if (_prefillFamily is not null)
    {
      familyId = _prefillFamily.Id;
    }
    else
    {
      var created = await Api.CreateFamilyAsync(_nf);
      if (created is null) { _newError = "Failed to create family record. Please try again."; _submitting = false; return; }
      familyId = created.Id;
    }

    var req = new PackageRequest
    {
      FamilyId  = familyId,
      Status    = CaseStatus.New,
      Reason    = _prefillFamily?.Reason ?? _nf.Reason,
    };
    var createdReq = await Api.CreateRequestAsync(req);
    if (createdReq is null) { _newError = "Failed to create request. Please try again."; _submitting = false; return; }

    // Override auto-assign if user selected a specific volunteer
    if (_newAssignOverrideVolId.HasValue)
      await Api.AssignRequestAsync(createdReq.Id, _newAssignOverrideVolId.Value);

    _prefillFamily = null;
    _showNew = false;
    _submitting = false;
    await LoadAsync();
  }

  private async Task SaveCaseAsync()
  {
    if (_selected is null) return;
    _saving = true;

    await Api.UpdateRequestStatusAsync(_selected.Id, _editStatus);

    if (_editAssignedVolId.HasValue && _editAssignedVolId != _selected.AssignedToId)
      await Api.AssignRequestAsync(_selected.Id, _editAssignedVolId.Value);

    await Api.PatchRequestAsync(_selected.Id, _editTrackingNumber, _editShippedDate, _editInternalNotes);

    _saving = false;
    _saved = true;
    await LoadAsync();

    // Re-sync _selected with the refreshed data
    _selected = _all.FirstOrDefault(r => r.Id == _selected.Id) ?? _selected;
  }

  private static string GetStatusBadge(CaseStatus s) => s switch
  {
    CaseStatus.New              => "badge-new",
    CaseStatus.InProgress       => "badge-inprogress",
    CaseStatus.AwaitingShipment => "badge-inprogress",
    CaseStatus.Shipped          => "badge-shipped",
    CaseStatus.Fulfilled        => "badge-fulfilled",
    CaseStatus.OnHold           => "badge-onhold",
    CaseStatus.Cancelled        => "badge-cancelled",
    _ => ""
  };

  private static string GetAge(DateTime dt)
  {
    var d = (int)(DateTime.UtcNow - dt).TotalDays;
    return d == 0 ? "Today" : $"{d}d";
  }
}
