@page "/admin/kanban"
@layout AdminLayout
@inject ApiService Api
@inject SignalRService Hub
@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Kanban Board — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Kanban Board</h2>
    <p>Visual pipeline view of all active cases</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/cases" class="btn btn-sm">List View</a>
    <a href="/admin/queue" class="btn btn-sm">🔚 Unassigned Queue</a>
    <a href="/admin/my-queue" class="btn btn-sm">📋 My Work Queue</a>
  </div>
</div>

@if (!string.IsNullOrEmpty(_dropError))
{
  <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;margin-bottom:14px;">⚠ @_dropError</div>
}

@if (_hiddenFulfilledCount > 0)
{
  <div style="color:var(--text-light);font-size:.78rem;margin-bottom:14px;" title="Fulfilled more than 3 months ago — see List View or Historical Cases">
    Fulfilled columns show the last 3 months only — @_hiddenFulfilledCount older case@(_hiddenFulfilledCount == 1 ? "" : "s") hidden.
  </div>
}

<div class="kanban">
  @foreach (var col in _columns)
  {
    var cases = _byColumn.GetValueOrDefault(col.Key) ?? [];
    var isValidTarget = _draggingCase is not null && CaseStatusTransitions.IsValid(_draggingCase.Status, TargetStatusFor(col.Key));
    <div class="kanban-col @(_dragOverKey == col.Key && isValidTarget ? "kanban-col-dragover" : "") @(_draggingCase is not null && !isValidTarget ? "kanban-col-invalid" : "")"
         @ondragover:preventDefault="true"
         @ondragenter="() => _dragOverKey = col.Key"
         @ondragleave="() => _dragOverKey = null"
         @ondrop="() => OnDropAsync(col.Key)">
      <div class="kanban-col-hd">
        <span>@col.Label</span>
        <span style="background:@col.Color;color:white;border-radius:10px;padding:1px 8px;font-size:.68rem;">@cases.Count</span>
      </div>
      @foreach (var r in cases)
      {
        <KanbanCard Request="r" OnSelect="SelectCase" OnAssign="OpenQuickAssign" OnDragStart="OnDragStart"
                    OnDragEnd="() => { _draggingCase = null; _dragOverKey = null; }"
                    GetPriorityBadge="GetPriorityBadge" GetAge="GetAge" />
      }
      @if (!cases.Any())
      {
        <div style="text-align:center;padding:20px 8px;font-size:.76rem;color:var(--text-light);border:1.5px dashed var(--border);border-radius:8px;">Empty</div>
      }
    </div>
  }
</div>

<!-- QUICK ASSIGN POPOVER -->
@if (_quickAssignCase is not null)
{
  <div class="drawer-overlay" @onclick="CloseQuickAssign"></div>
  <div class="drawer" style="width:380px;">
    <div class="drawer-head">
      <h3>Assign Case #@_quickAssignCase.Id</h3>
      <button class="drawer-close" aria-label="Close" @onclick="CloseQuickAssign">✕</button>
    </div>
    <div class="drawer-body" style="gap:14px;">
      <div style="background:var(--bg);border-radius:8px;padding:12px 14px;font-size:.84rem;">
        <div><strong>Family:</strong> @_quickAssignCase.Family?.FullName</div>
        <div><strong>Reason:</strong> @_quickAssignCase.Reason.ToDisplayName()</div>
      </div>

      <div class="form-group">
        <label class="form-label">Assign To *</label>
        <select class="form-input" @bind="_quickAssignVolId">
          <option value="0">— Select volunteer —</option>
          @foreach (var v in _volunteers)
          { <option value="@v.Id">@v.FullName@(IsAtCapacity(v) ? " (at capacity)" : "")</option> }
        </select>
      </div>

      @if (_quickAssignCandidatesLoaded && _quickAssignCandidates.Any())
      {
        <div>
          <div class="form-label" style="margin-bottom:8px;">🌟 Suggested (ranked by workload)</div>
          <div style="display:flex;flex-direction:column;gap:6px;">
            @foreach (var c in _quickAssignCandidates.Take(5))
            {
              <div style="display:flex;align-items:center;justify-content:space-between;background:var(--green-pale);border-radius:8px;padding:8px 12px;font-size:.82rem;cursor:pointer;"
                   @onclick="() => _quickAssignVolId = c.VolunteerId">
                <span><strong>@c.Name</strong> — @c.CompositeScore.ToString("F0") pts</span>
                <span style="color:var(--green);font-weight:600;">Select →</span>
              </div>
            }
          </div>
        </div>
      }

      @if (!string.IsNullOrEmpty(_quickAssignError))
      { <div style="background:#fff3cd;border-radius:8px;padding:8px 12px;font-size:.82rem;color:#856404;">⚠ @_quickAssignError</div> }
    </div>
    <div class="drawer-footer">
      <button class="btn btn-primary" @onclick="ConfirmQuickAssignAsync" disabled="@(_quickAssignVolId == 0 || _quickAssignWorking)">
        @(_quickAssignWorking ? "Assigning…" : "Confirm Assignment")
      </button>
      <button class="btn btn-sm" @onclick="CloseQuickAssign" disabled="@_quickAssignWorking">Cancel</button>
    </div>
  </div>
}

<!-- QUICK VIEW DRAWER -->
@if (_selected is not null)
{
  <div class="drawer-overlay" @onclick="CloseDrawer"></div>
  <div class="drawer" style="width:400px;">
    <div class="drawer-head">
      <h3>Case #@_selected.Id &mdash; @_selected.Family?.Parent1LastName</h3>
      <button class="drawer-close" aria-label="Close" @onclick="CloseDrawer">✕</button>
    </div>
    <div class="drawer-body" style="gap:14px;">
      <div style="background:var(--bg);border-radius:8px;padding:12px 14px;font-size:.84rem;display:flex;flex-direction:column;gap:6px;">
        <div><strong>Family:</strong> @_selected.Family?.FullName</div>
        <div><strong>Reason:</strong> @_selected.Reason.ToDisplayName()</div>
        <div><strong>Created:</strong> @_selected.CreatedAt.ToString("MMM d, yyyy") &bull; @GetAge(_selected.CreatedAt)</div>
        @if (_selected.IsOverdue)
        { <div style="color:var(--amber);font-weight:600;">⚠ Overdue</div> }
      </div>

      <div class="form-group">
        <label class="form-label">Status</label>
        <select class="form-input" @bind="_editStatus">
          <option value="@_selected.Status">@_selected.Status (current)</option>
          @foreach (var s in CaseStatusTransitions.ValidNextStates(_selected.Status))
          { <option value="@s">@s</option> }
        </select>
      </div>
      @if (!string.IsNullOrEmpty(_drawerError))
      { <div style="background:#fff3cd;border-radius:8px;padding:8px 12px;font-size:.82rem;color:#856404;">⚠ @_drawerError</div> }

      <div class="form-group">
        <label class="form-label">Assigned To</label>
        <select class="form-input" @bind="_editAssignedTo">
          <option value="">— Unassigned —</option>
          @foreach (var v in _volunteers)
          { <option value="@v.Id">@v.FullName@(IsAtCapacity(v) ? " (at capacity)" : "")</option> }
        </select>
      </div>

      <div class="form-group">
        <label class="form-label">Process Stage</label>
        <select class="form-input" @bind="_editProcessStage">
          @foreach (var s in Enum.GetValues<ProcessStage>())
          { <option value="@s">@s</option> }
        </select>
      </div>

      @if (_editStatus is CaseStatus.AwaitingShipment or CaseStatus.Shipped or CaseStatus.Fulfilled)
      {
        <div class="form-group">
          <label class="form-label">Tracking Number</label>
          <input class="form-input" @bind="_editTrackingNumber" placeholder="e.g. 1Z999AA10123456784" />
        </div>
        <div class="form-group">
          <label class="form-label">Shipped Date</label>
          <input class="form-input" type="date"
                 value="@(_editShippedDate?.ToString("yyyy-MM-dd") ?? "")"
                 @onchange='e => _editShippedDate = string.IsNullOrEmpty(e.Value?.ToString()) ? null : DateTime.Parse(e.Value.ToString()!)' />
        </div>
      }

      @if (!string.IsNullOrEmpty(_selected.InternalNotes))
      {
        <div class="form-group">
          <label class="form-label">Notes</label>
          <div style="background:var(--bg);border-radius:8px;padding:10px 12px;font-size:.82rem;color:var(--text-mid);">@_selected.InternalNotes</div>
        </div>
      }

      @if (_drawerSaved)
      { <div style="background:var(--green-pale);border-radius:8px;padding:8px 12px;font-size:.82rem;color:var(--green-dark);">✓ Status updated</div> }
    </div>
    <div class="drawer-footer">
      <button class="btn btn-primary" @onclick="SaveFromDrawer" disabled="@_saving">
        @(_saving ? "Saving…" : "Save Changes")
      </button>
      @if (_selected.Family is not null)
      { <a href="/admin/families?family=@_selected.Family.Id" class="btn btn-sm">Family Profile &rarr;</a> }
      else
      { <a href="/admin/cases" class="btn btn-sm">All Cases &rarr;</a> }
    </div>
  </div>
}

@code {
  private record Column(string Key, string Label, string Color);

  // Kanban-only column layout — a display remapping of the underlying Status +
  // ProcessStage fields. It does NOT change CaseStatus itself (still used as-is
  // by Cases/Queue/MyQueue/CaseDetail/transition rules); this page just buckets
  // cases into a more granular set of columns for visual purposes. "Awaiting
  // Shipment" folds into Packing/Shipping; "On Hold" moves to after Shipping.
  private readonly Column[] _columns =
  [
    new("New",       "New",       "#2d469d"),
    new("Assigned",  "Assigned",  "#e67e22"),
    new("Confirmed", "Confirmed", "#487336"),
    new("Packing",   "Packing",   "#9b8bb4"),
    new("Notes",     "Notes",     "#6c757d"),
    new("Shipping",  "Shipping",  "#c9a227"),
    new("OnHold",    "On Hold",   "#842029"),
    new("Fulfilled", "Fulfilled", "#198754"),
    new("Cancelled", "Cancelled", "#adb5bd"),
  ];

  // Which display column a case falls into, given its real Status + ProcessStage.
  // Terminal statuses (New/OnHold/Fulfilled/Cancelled) get their own column
  // regardless of stage; every other status (InProgress/AwaitingShipment/
  // Shipped) is "in the pipeline" and its column is driven entirely by
  // ProcessStage, so changing the stage always moves the card as expected.
  private static string ColumnKeyOf(PackageRequest r) => r.Status switch
  {
    CaseStatus.New       => "New",
    CaseStatus.OnHold    => "OnHold",
    CaseStatus.Fulfilled => "Fulfilled",
    CaseStatus.Cancelled => "Cancelled",
    _ => r.ProcessStage switch
    {
      ProcessStage.Confirmed => "Confirmed",
      ProcessStage.Packing   => "Packing",
      ProcessStage.Notes     => "Notes",
      ProcessStage.Shipping  => "Shipping",
      ProcessStage.Delivered => "Shipping",
      _                      => "Assigned"
    }
  };

  // What dropping a card into a given column key should set Status/ProcessStage
  // to. Status drives the existing CaseStatusTransitions validity check (so the
  // tracking-number-before-Shipped rule etc. still apply); ProcessStage is the
  // finer-grained stage shown via the column itself.
  private static (CaseStatus Status, ProcessStage? Stage) TargetFor(string columnKey) => columnKey switch
  {
    "New"       => (CaseStatus.New, null),
    "Assigned"  => (CaseStatus.InProgress, ProcessStage.Assigned),
    "Confirmed" => (CaseStatus.InProgress, ProcessStage.Confirmed),
    "Packing"   => (CaseStatus.InProgress, ProcessStage.Packing),
    "Notes"     => (CaseStatus.InProgress, ProcessStage.Notes),
    "Shipping"  => (CaseStatus.AwaitingShipment, ProcessStage.Shipping),
    "OnHold"    => (CaseStatus.OnHold, null),
    "Fulfilled" => (CaseStatus.Fulfilled, null),
    "Cancelled" => (CaseStatus.Cancelled, null),
    _           => (CaseStatus.InProgress, null)
  };

  private static CaseStatus TargetStatusFor(string columnKey) => TargetFor(columnKey).Status;

  private Dictionary<string, List<PackageRequest>> _byColumn = new();
  private int _hiddenFulfilledCount;
  private List<Volunteer> _volunteers = [];
  private PackageRequest? _selected;
  private CaseStatus _editStatus;
  private int _editAssignedTo;   // volunteer Id; 0 = unassigned
  private ProcessStage _editProcessStage;
  private string? _editTrackingNumber;
  private DateTime? _editShippedDate;
  private bool _drawerSaved;
  private string? _drawerError;
  private bool _saving;
  private PackageRequest? _draggingCase;
  private string? _dragOverKey;
  private string? _dropError;

  private PackageRequest? _quickAssignCase;
  private int _quickAssignVolId;
  private List<VolunteerScoreResult> _quickAssignCandidates = [];
  private bool _quickAssignCandidatesLoaded;
  private bool _quickAssignWorking;
  private string? _quickAssignError;

  protected override async Task OnInitializedAsync()
  {
    await LoadAsync();
    try { await Hub.ConnectAsync(); } catch { }
    Hub.OnCaseStatusChanged += async (_, _, _) => { await LoadAsync(); await InvokeAsync(StateHasChanged); };
    Hub.OnCaseCreated       += async (_, _, _) => { await LoadAsync(); await InvokeAsync(StateHasChanged); };
    Hub.OnCaseAssigned      += async (_, _, _) => { await LoadAsync(); await InvokeAsync(StateHasChanged); };
    Hub.OnReconnected       += async ()         => { await LoadAsync(); await InvokeAsync(StateHasChanged); };
  }

  private Dictionary<int, int> _capacityById = new();

  private async Task LoadAsync()
  {
    var vols = await Api.GetVolunteersAsync("Active");
    _volunteers = vols;

    var workload = await Api.GetWorkloadAsync();
    _capacityById = workload.ToDictionary(w => w.Id, w => w.Capacity);

    var requests = await Api.GetRequestsAsync();
    GroupByStatus(requests);
  }

  // Fulfilled cases pile up indefinitely (every closed-out request stays
  // "Fulfilled" forever) — cap the board to the last 3 months so the column
  // stays a useful "recently done" view instead of an unbounded archive.
  // Older fulfilled cases are still visible via List View / Historical Cases.
  private static readonly TimeSpan FulfilledWindow = TimeSpan.FromDays(90);

  private void GroupByStatus(List<PackageRequest> requests)
  {
    var cutoff = DateTime.UtcNow - FulfilledWindow;
    var allFulfilled = requests.Where(r => r.Status == CaseStatus.Fulfilled).ToList();
    _hiddenFulfilledCount = allFulfilled.Count(r => r.UpdatedAt < cutoff);

    var visible = requests.Where(r => r.Status != CaseStatus.Fulfilled || r.UpdatedAt >= cutoff).ToList();

    _byColumn = _columns.ToDictionary(
      col => col.Key,
      col => col.Key == "Fulfilled"
        ? visible.Where(r => ColumnKeyOf(r) == col.Key).OrderByDescending(r => r.UpdatedAt).ToList()
        : visible.Where(r => ColumnKeyOf(r) == col.Key).OrderBy(r => r.CreatedAt).ToList());
  }

  private static string GetPriorityBadge(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "badge-overdue",
    RequestPriority.High   => "badge-inprogress",
    RequestPriority.Normal => "badge-new",
    RequestPriority.Low    => "badge-fulfilled",
    _ => ""
  };

  // Manual assignment doesn't enforce the chapter's capacity cap the way
  // auto-assignment does — flag it in the dropdown so staff can see it, without
  // blocking an intentional override.
  private bool IsAtCapacity(Volunteer v) => v.ActiveCases >= _capacityById.GetValueOrDefault(v.Id, 6);

  private void SelectCase(PackageRequest r)
  {
    _selected           = r;
    _editStatus         = r.Status;
    _editAssignedTo     = r.AssignedToId ?? 0;
    _editProcessStage   = r.ProcessStage;
    _editTrackingNumber = r.TrackingNumber;
    _editShippedDate    = r.ShippedDate;
    _drawerSaved        = false;
    _drawerError        = null;
    _saving             = false;
  }

  private void CloseDrawer() { _selected = null; _drawerSaved = false; _drawerError = null; }

  private async Task SaveFromDrawer()
  {
    if (_selected is null || _saving) return;
    _saving = true;
    _drawerError = null;

    // Assign BEFORE setting status — the assign endpoint forces status to InProgress
    // as a side effect, so if it ran after an explicit status change (e.g. to
    // Shipped), it would silently overwrite it back to InProgress.
    if (_editAssignedTo > 0 && _editAssignedTo != (_selected.AssignedToId ?? 0))
      await Api.AssignRequestAsync(_selected.Id, _editAssignedTo);

    if (_editProcessStage != _selected.ProcessStage)
      await Api.UpdateRequestProcessStageAsync(_selected.Id, _editProcessStage);

    // Patch tracking BEFORE status — the backend requires a tracking number to
    // already be saved before it will allow a transition into Shipped.
    if (_editTrackingNumber != _selected.TrackingNumber || _editShippedDate != _selected.ShippedDate)
      await Api.PatchRequestAsync(_selected.Id, _editTrackingNumber, _editShippedDate, _selected.InternalNotes);

    if (_editStatus != _selected.Status)
    {
      var (ok, error) = await Api.UpdateRequestStatusWithErrorAsync(_selected.Id, _editStatus);
      if (!ok)
      {
        _drawerError = error;
        _saving = false;
        return;
      }
    }

    // Optimistic local update
    var vol = _volunteers.FirstOrDefault(v => v.Id == _editAssignedTo);
    _selected.Status         = _editStatus;
    _selected.AssignedToId   = _editAssignedTo > 0 ? _editAssignedTo : null;
    _selected.AssignedTo     = vol?.FullName;
    _selected.ProcessStage   = _editAssignedTo > 0 && _selected.ProcessStage == ProcessStage.Unassigned
                                  ? ProcessStage.Assigned : _editProcessStage;
    _selected.TrackingNumber = _editTrackingNumber;
    _selected.ShippedDate    = _editShippedDate;
    _selected.UpdatedAt      = DateTime.UtcNow;
    RegroupByStatus();
    _drawerSaved = true;
    _saving = false;
  }

  private async Task OpenQuickAssign(PackageRequest r)
  {
    _quickAssignCase = r;
    _quickAssignVolId = 0;
    _quickAssignError = null;
    _quickAssignCandidates = [];
    _quickAssignCandidatesLoaded = false;

    _quickAssignCandidates = await Api.GetVolunteerCandidatesAsync(r.Id);
    _quickAssignCandidatesLoaded = true;
  }

  private void CloseQuickAssign()
  {
    _quickAssignCase = null;
    _quickAssignError = null;
    _quickAssignCandidates = [];
    _quickAssignCandidatesLoaded = false;
  }

  private async Task ConfirmQuickAssignAsync()
  {
    if (_quickAssignCase is null || _quickAssignVolId == 0) return;
    _quickAssignWorking = true;
    _quickAssignError = null;

    var ok = await Api.AssignRequestAsync(_quickAssignCase.Id, _quickAssignVolId);
    if (!ok)
    {
      _quickAssignError = "Assignment failed. Please try again.";
      _quickAssignWorking = false;
      return;
    }

    var vol = _volunteers.FirstOrDefault(v => v.Id == _quickAssignVolId);
    _quickAssignCase.AssignedToId = _quickAssignVolId;
    _quickAssignCase.AssignedTo   = vol?.FullName;
    _quickAssignCase.Status       = CaseStatus.InProgress;
    if (_quickAssignCase.ProcessStage == ProcessStage.Unassigned) _quickAssignCase.ProcessStage = ProcessStage.Assigned;
    _quickAssignCase.UpdatedAt    = DateTime.UtcNow;
    RegroupByStatus();

    _quickAssignWorking = false;
    CloseQuickAssign();
  }

  private void OnDragStart(PackageRequest r) => _draggingCase = r;

  private async Task OnDropAsync(string columnKey)
  {
    var dragged = _draggingCase;
    _draggingCase = null;
    _dragOverKey = null;
    if (dragged is null || ColumnKeyOf(dragged) == columnKey) return;

    var (targetStatus, targetStage) = TargetFor(columnKey);

    if (targetStatus != dragged.Status && !CaseStatusTransitions.IsValid(dragged.Status, targetStatus))
    {
      _dropError = $"Can't move a case from {dragged.Status} directly to {targetStatus}.";
      return;
    }
    if (targetStatus == CaseStatus.Shipped && string.IsNullOrWhiteSpace(dragged.TrackingNumber))
    {
      _dropError = $"Case #{dragged.Id} needs a tracking number before it can be marked Shipped — open the card to add one.";
      return;
    }

    if (targetStatus != dragged.Status)
    {
      var (ok, error) = await Api.UpdateRequestStatusWithErrorAsync(dragged.Id, targetStatus);
      if (!ok) { _dropError = error; return; }
      dragged.Status = targetStatus;
    }

    if (targetStage.HasValue && targetStage.Value != dragged.ProcessStage)
      await Api.UpdateRequestProcessStageAsync(dragged.Id, targetStage.Value);

    _dropError = null;
    dragged.ProcessStage = targetStage ?? dragged.ProcessStage;
    dragged.UpdatedAt = DateTime.UtcNow;
    RegroupByStatus();
  }

  // Re-buckets the already-loaded cases by their (possibly just-changed) status,
  // without a round-trip to the API.
  private void RegroupByStatus() => GroupByStatus(_byColumn.SelectMany(kv => kv.Value).ToList());

  public void Dispose()
  {
    _ = Hub.DisconnectAsync();
  }

  private static string GetAge(DateTime dt)
  {
    var d = (int)(DateTime.UtcNow - dt).TotalDays;
    return d == 0 ? "Today" : $"{d}d";
  }
}
