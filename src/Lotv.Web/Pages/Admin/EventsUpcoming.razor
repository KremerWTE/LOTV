@page "/admin/events/upcoming"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Upcoming Events — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Upcoming Events</h2><p>Events scheduled from today forward</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events" class="btn btn-sm">← All Events</a>
    <a href="/admin/events/by-type" class="btn btn-sm">By Type</a>
    <a href="/admin/events/new" class="btn btn-sm btn-primary">+ New Event</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (!_upcoming.Any())
{
  <div class="panel" style="border-left:4px solid var(--green);">
    <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">
      No upcoming events scheduled.
    </div>
  </div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#127881;</div>
      <div class="kpi-label">Upcoming</div>
      <div class="kpi-value" style="color:var(--navy)">@_upcoming.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128101;</div>
      <div class="kpi-label">Total Registered</div>
      <div class="kpi-value" style="color:var(--green)">@_upcoming.Sum(e => e.Registered)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128197;</div>
      <div class="kpi-label">Next Event</div>
      <div class="kpi-value" style="font-size:.85rem;color:var(--amber)">@(_upcoming.First().Date.ToString("MMM d"))</div>
    </div>
    <div class="kpi-card">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">With Tickets</div>
      <div class="kpi-value" style="color:var(--navy)">@_upcoming.Count(e => e.TicketPrice.HasValue)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Upcoming Events (@_upcoming.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:var(--bg);">
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Event</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Type</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Date</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Location</th>
            <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Registered</th>
            <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Capacity</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
            <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var e in _upcoming)
          {
            var daysUntil = (int)(e.Date.Date - DateTime.Today).TotalDays;
            var pct = e.Capacity.HasValue && e.Capacity > 0 ? e.Registered * 100 / e.Capacity.Value : (int?)null;
            <tr style="border-top:1px solid var(--border);@(daysUntil <= 7 ? "background:#fffbeb;" : "")">
              <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                <a href="/admin/events/@e.Id" style="color:var(--navy);">@e.Title</a>
                @if (daysUntil == 0) { <span style="font-size:.68rem;color:var(--red);margin-left:4px;">Today</span> }
                else if (daysUntil <= 7) { <span style="font-size:.68rem;color:var(--amber);margin-left:4px;">@daysUntil days</span> }
                @if (e.IsVirtual) { <span style="font-size:.68rem;color:var(--navy);margin-left:4px;">Virtual</span> }
              </td>
              <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@e.Type</td>
              <td style="padding:10px 16px;font-size:.82rem;white-space:nowrap;">@e.Date.ToString("MMM d, yyyy")</td>
              <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@e.Location</td>
              <td style="padding:10px 16px;font-size:.82rem;text-align:right;color:var(--text-light);">@e.Registered</td>
              <td style="padding:10px 16px;font-size:.82rem;text-align:right;color:var(--text-light);">
                @if (pct.HasValue) { <text>@e.Capacity (@pct%)</text> } else { <text>—</text> }
              </td>
              <td style="padding:10px 16px;">
                <span class="badge badge-@(e.Status == EventStatus.Open ? "fulfilled" : "new")" style="font-size:.68rem;">@e.Status</span>
              </td>
              <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                <a href="/admin/events/@e.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                <span style="color:var(--border);margin:0 4px;">|</span>
                <a href="/admin/events/@e.Id/attendees" style="font-size:.78rem;color:var(--navy);">Attendees</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private List<MinistryEvent> _upcoming = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var all  = await Api.GetEventsAsync();
    _upcoming = all.Where(e => e.Date.Date >= DateTime.Today && e.Status != EventStatus.Cancelled).OrderBy(e => e.Date).ToList();
    _loading = false;
  }
}
