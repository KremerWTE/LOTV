@page "/admin/events/{EventId:int}/auction/{ItemId:int}/bid"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Place Bid — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Place Bid</h2><p>Auction Item #@ItemId — Event #@EventId</p></div>
  <div class="page-hd-actions">
    <a href="/admin/events/@EventId/auction" class="btn btn-sm">← Auction</a>
    <a href="/admin/events/@EventId" class="btn btn-sm">Event</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  @if (_placed)
  {
    <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--green);font-weight:600;">
        Bid recorded. <a href="/admin/events/@EventId/auction" style="color:var(--green);">Back to auction →</a>
      </div>
    </div>
  }
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  @if (_item is not null)
  {
    <div class="panel" style="margin-bottom:16px;border-left:4px solid var(--navy);">
      <div class="panel-body" style="display:flex;gap:20px;align-items:center;flex-wrap:wrap;">
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Item</div>
          <div style="font-weight:700;">@_item.Name</div>
        </div>
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Starting Bid</div>
          <div style="font-weight:600;color:var(--navy);">@_item.StartingBid.ToString("C0")</div>
        </div>
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Fair Market Value</div>
          <div style="font-size:.86rem;">@_item.FairMarketValue.ToString("C0")</div>
        </div>
        <div>
          <div style="font-size:.78rem;color:var(--text-light);">Status</div>
          <span class="badge badge-@(_item.Status == AuctionItemStatus.Available ? "new" : "fulfilled")" style="font-size:.68rem;">@_item.Status</span>
        </div>
      </div>
    </div>
  }

  <div style="max-width:520px;">
    <div class="panel">
      <div class="panel-head"><h3>Record Bid</h3></div>
      <div class="panel-body">
        <!-- Donor typeahead -->
        <div class="form-group">
          <label class="form-label">Bidder (Donor) *</label>
          <div style="position:relative;">
            <input class="form-input" value="@_donorSearch"
                   @oninput='e => { _donorSearch = e.Value?.ToString() ?? ""; FilterDonors(); }'
                   placeholder="Search by name or email…" autocomplete="off" />
            @if (_donorSuggestions.Any())
            {
              <ul style="position:absolute;z-index:50;background:white;border:1px solid var(--border);border-radius:6px;width:100%;list-style:none;margin:2px 0 0;padding:4px 0;box-shadow:0 4px 12px rgba(0,0,0,.1);">
                @foreach (var d in _donorSuggestions)
                {
                  var dCopy = d;
                  <li @onmousedown='() => SelectDonor(dCopy)'
                      style="padding:8px 14px;cursor:pointer;font-size:.84rem;">
                    @d.FullName <span style="color:var(--text-light);font-size:.76rem;">— @d.Email</span>
                  </li>
                }
              </ul>
            }
          </div>
          @if (_selectedDonorId.HasValue)
          {
            <div style="margin-top:5px;font-size:.78rem;color:var(--green);">✓ @_selectedDonorName</div>
          }
        </div>

        <div class="form-group" style="margin-top:12px;">
          <label class="form-label">Bid Amount *</label>
          <input class="form-input" type="number" step="5" min="0" @bind="_bidAmount" />
          @if (_item is not null)
          {
            <div style="font-size:.72rem;color:var(--text-light);margin-top:3px;">Min starting bid: @_item.StartingBid.ToString("C0")</div>
          }
        </div>

        <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
          <a href="/admin/events/@EventId/auction" class="btn btn-sm">Cancel</a>
          <button class="btn btn-primary" @onclick="Submit" disabled="@_busy">@(_busy ? "Recording…" : "Record Bid")</button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public int EventId { get; set; }
  [Parameter] public int ItemId { get; set; }

  private SilentAuctionItem? _item;
  private List<Donor> _allDonors = [];
  private List<Donor> _donorSuggestions = [];
  private int? _selectedDonorId;
  private string _donorSearch = "", _selectedDonorName = "";
  private decimal _bidAmount;
  private bool _loading = true, _busy, _placed;
  private string _error = "";

  protected override async Task OnInitializedAsync()
  {
    var itemTask  = Api.GetAuctionItemsAsync(EventId);
    var donorTask = Api.GetDonorsAsync();
    await Task.WhenAll(itemTask, donorTask);
    var items = await itemTask;
    _item = items.FirstOrDefault(i => i.Id == ItemId);
    _allDonors = await donorTask;
    if (_item is not null) _bidAmount = _item.StartingBid;
    _loading = false;
  }

  private void FilterDonors()
  {
    if (string.IsNullOrWhiteSpace(_donorSearch) || _donorSearch.Length < 2)
    { _donorSuggestions = []; return; }
    _donorSuggestions = _allDonors
      .Where(d => d.FullName.Contains(_donorSearch, StringComparison.OrdinalIgnoreCase) ||
                  d.Email.Contains(_donorSearch, StringComparison.OrdinalIgnoreCase))
      .Take(6).ToList();
  }

  private void SelectDonor(Donor d)
  {
    _selectedDonorId   = d.Id;
    _selectedDonorName = d.FullName;
    _donorSearch       = d.FullName;
    _donorSuggestions  = [];
  }

  private async Task Submit()
  {
    _error = "";
    if (!_selectedDonorId.HasValue) { _error = "Please select a bidder."; return; }
    if (_bidAmount <= 0) { _error = "Bid amount must be greater than 0."; return; }
    _busy = true;
    var ok = await Api.PlaceBidAsync(EventId, ItemId, _selectedDonorId.Value, _bidAmount);
    _busy = false;
    if (ok) { _placed = true; _selectedDonorId = null; _donorSearch = ""; }
    else _error = "Failed to record bid. Please try again.";
  }
}
