@page "/admin/cases/by-priority"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Cases by Priority — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Cases by Priority</h2><p>Open cases grouped by priority level</p></div>
  <div class="page-hd-actions">
    <a href="/admin/cases" class="btn btn-sm">← All Cases</a>
    <a href="/admin/cases/urgent" class="btn btn-sm">Urgent</a>
    <a href="/admin/cases/overdue" class="btn btn-sm">Overdue</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">🚨</div>
      <div class="kpi-label">Urgent</div>
      <div class="kpi-value" style="color:var(--red)">@_open.Count(c => c.Priority == RequestPriority.Urgent)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">⚠</div>
      <div class="kpi-label">High</div>
      <div class="kpi-value" style="color:var(--amber)">@_open.Count(c => c.Priority == RequestPriority.High)</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📋</div>
      <div class="kpi-label">Normal</div>
      <div class="kpi-value" style="color:var(--navy)">@_open.Count(c => c.Priority == RequestPriority.Normal)</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">🔴</div>
      <div class="kpi-label">Low</div>
      <div class="kpi-value" style="color:var(--green)">@_open.Count(c => c.Priority == RequestPriority.Low)</div>
    </div>
  </div>

  @foreach (var p in new[] { RequestPriority.Urgent, RequestPriority.High, RequestPriority.Normal, RequestPriority.Low })
  {
    var cases = _open.Where(c => c.Priority == p).OrderBy(c => c.DueDate ?? DateTime.MaxValue).ToList();
    @if (cases.Any())
    {
      <div class="panel" style="margin-bottom:16px;@(p == RequestPriority.Urgent ? "border-left:4px solid var(--red);" : p == RequestPriority.High ? "border-left:4px solid var(--amber);" : "")">
        <div class="panel-head">
          <h3>@p <span style="font-size:.78rem;font-weight:400;color:var(--text-light);">(@cases.Count cases)</span></h3>
        </div>
        <div class="panel-body" style="padding:0;">
          <table style="width:100%;border-collapse:collapse;">
            <thead>
              <tr style="background:var(--bg);">
                <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">#</th>
                <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Family</th>
                <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
                <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Assigned To</th>
                <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Due</th>
                <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
              </tr>
            </thead>
            <tbody>
              @foreach (var c in cases.Take(20))
              {
                var isOverdue = c.DueDate.HasValue && c.DueDate.Value.Date < DateTime.Today;
                <tr style="border-top:1px solid var(--border);@(isOverdue ? "background:#fef2f2;" : "")">
                  <td style="padding:10px 16px;font-size:.78rem;color:var(--text-light);">#@c.Id</td>
                  <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                    <a href="/admin/cases/@c.Id" style="color:var(--navy);">@(c.Family?.FullName ?? $"Family #{c.FamilyId}")</a>
                  </td>
                  <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@c.Status</td>
                  <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(c.AssignedTo ?? "Unassigned")</td>
                  <td style="padding:10px 16px;font-size:.82rem;color:@(isOverdue ? "var(--red)" : "var(--text-light)");">@(c.DueDate?.ToString("MMM d, yyyy") ?? "—")</td>
                  <td style="padding:10px 16px;text-align:center;">
                    <a href="/admin/cases/@c.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                  </td>
                </tr>
              }
              @if (cases.Count > 20)
              {
                <tr style="border-top:1px solid var(--border);">
                  <td colspan="6" style="padding:10px 16px;font-size:.78rem;color:var(--text-light);text-align:center;">
                    <a href="/admin/cases" style="color:var(--navy);">+ @(cases.Count - 20) more — view all cases →</a>
                  </td>
                </tr>
              }
            </tbody>
          </table>
        </div>
      </div>
    }
  }
}

@code {
  private List<PackageRequest> _open = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetRequestsAsync(status: null, overdue: null, familyId: null);
    _open = all.Where(c => c.Status != CaseStatus.Fulfilled && c.Status != CaseStatus.Cancelled).ToList();
    _loading = false;
  }
}
