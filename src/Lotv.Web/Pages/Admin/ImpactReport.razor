@page "/admin/impact"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Impact Report — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Impact Report</h2><p>Ministry-wide outcomes and mission metrics</p></div>
</div>

<!-- TOP KPI ROW -->
<div class="kpi-grid" style="margin-bottom:24px;">
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128149;</div>
    <div class="kpi-label">Families Served (All Time)</div>
    <div class="kpi-value" style="color:var(--green)">@_families.Count</div>
  </div>
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#128230;</div>
    <div class="kpi-label">Packages Fulfilled</div>
    <div class="kpi-value" style="color:var(--navy)">@_requests.Count(r => r.Status == CaseStatus.Fulfilled)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#128184;</div>
    <div class="kpi-label">Total Donations Raised</div>
    <div class="kpi-value" style="color:var(--amber)">@_donations.Sum(d => d.Amount).ToString("C0")</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#9195;</div>
    <div class="kpi-label">Avg. Days to Fulfill</div>
    <div class="kpi-value" style="color:var(--gold)">@_avgFulfillDays</div>
  </div>
</div>

<!-- SECOND ROW -->
<div class="kpi-grid" style="margin-bottom:28px;">
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128101;</div>
    <div class="kpi-label">Active Volunteers</div>
    <div class="kpi-value" style="color:var(--green)">@_volunteers.Count(v => v.Status == VolunteerStatus.Active)</div>
  </div>
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#9971;</div>
    <div class="kpi-label">Parishes Engaged</div>
    <div class="kpi-value" style="color:var(--navy)">@_parishes.Count(p => p.ActiveCases > 0)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#128260;</div>
    <div class="kpi-label">Recurring Donors</div>
    <div class="kpi-value" style="color:var(--amber)">@_donors.Count(d => d.IsRecurring)</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#128197;</div>
    <div class="kpi-label">Events This Year</div>
    <div class="kpi-value" style="color:var(--gold)">@_events.Count(e => e.Date.Year == DateTime.UtcNow.Year)</div>
  </div>
</div>

<!-- LOSS TYPE BREAKDOWN -->
<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px;">
  <div class="panel">
    <div class="panel-head"><h3>Families by Loss Type</h3></div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead><tr><th>Reason</th><th>Families</th><th>% of Total</th></tr></thead>
        <tbody>
          @foreach (var row in _byReason)
          {
            var pct = _families.Count > 0 ? (int)((double)row.Count / _families.Count * 100) : 0;
            <tr>
              <td>@row.Reason</td>
              <td style="font-weight:600;">@row.Count</td>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div class="progress-bar" style="width:70px;"><div class="progress-fill" style="width:@pct%;"></div></div>
                  <span style="font-size:.74rem;color:var(--text-light);">@pct%</span>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Case Status Overview</h3></div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead><tr><th>Status</th><th>Count</th><th>% of Total</th></tr></thead>
        <tbody>
          @foreach (var row in _byStatus)
          {
            var pct = _requests.Count > 0 ? (int)((double)row.Count / _requests.Count * 100) : 0;
            <tr>
              <td>@row.Status</td>
              <td style="font-weight:600;">@row.Count</td>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div class="progress-bar" style="width:70px;"><div class="progress-fill" style="width:@pct%;"></div></div>
                  <span style="font-size:.74rem;color:var(--text-light);">@pct%</span>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- FAITH TRADITION BREAKDOWN -->
<div class="panel" style="margin-bottom:20px;">
  <div class="panel-head"><h3>Families by Faith Tradition</h3></div>
  <div class="panel-body" style="display:flex;flex-wrap:wrap;gap:12px;">
    @foreach (var row in _byFaith)
    {
      <div style="background:var(--bg-page);border:1px solid var(--border);border-radius:8px;padding:12px 18px;text-align:center;min-width:100px;">
        <div style="font-size:1.4rem;font-weight:700;color:var(--navy);">@row.Count</div>
        <div style="font-size:.74rem;color:var(--text-light);margin-top:2px;">@row.Tradition</div>
      </div>
    }
  </div>
</div>

<!-- MONTHLY DONATION TREND -->
<div class="panel">
  <div class="panel-head">
    <h3>Monthly Donation Trend — Last 6 Months</h3>
    <a href="/admin/by-channel" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">Full Breakdown &rarr;</a>
  </div>
  <div class="panel-body">
    <BarChart Items="_monthlyTrend"
              LabelFunc="m => m.Label"
              ValueFunc="m => (double)m.Amount"
              FormatFunc='m => $"{m.Amount:C0} ({m.GiftCount} gifts)"'
              Color="var(--green)" MaxBarHeight="140" />
    <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);display:flex;gap:24px;">
      <div style="font-size:.82rem;"><strong>6-month total:</strong> @_monthlyTrend.Sum(m => m.Amount).ToString("C0")</div>
      <div style="font-size:.82rem;"><strong>Avg / month:</strong> @(_monthlyTrend.Count > 0 ? (_monthlyTrend.Sum(m => m.Amount) / _monthlyTrend.Count).ToString("C0") : "—")</div>
      <div style="font-size:.82rem;"><strong>Best month:</strong> @(_monthlyTrend.OrderByDescending(m => m.Amount).FirstOrDefault()?.Label ?? "—")</div>
    </div>
  </div>
</div>

@code {
  private record ReasonRow(string Reason, int Count);
  private record StatusRow(string Status, int Count);
  private record FaithRow(string Tradition, int Count);
  private record MonthRow(string Label, decimal Amount, int GiftCount, bool IsCurrent);

  private List<Family> _families = [];
  private List<PackageRequest> _requests = [];
  private List<Donation> _donations = [];
  private List<Volunteer> _volunteers = [];
  private List<Parish> _parishes = [];
  private List<Donor> _donors = [];
  private List<MinistryEvent> _events = [];

  private List<ReasonRow> _byReason = [];
  private List<StatusRow> _byStatus = [];
  private List<FaithRow>  _byFaith  = [];
  private List<MonthRow>  _monthlyTrend = [];
  private string _avgFulfillDays = "—";

  protected override async Task OnInitializedAsync()
  {
    var t1 = Api.GetFamiliesAsync();
    var t2 = Api.GetRequestsAsync();
    var t3 = Api.GetDonationsAsync();
    var t4 = Api.GetVolunteersAsync();
    var t5 = Api.GetParishesAsync();
    var t6 = Api.GetDonorsAsync();
    var t7 = Api.GetEventsAsync();
    await Task.WhenAll(t1, t2, t3, t4, t5, t6, t7);
    _families   = t1.Result;
    _requests   = t2.Result;
    _donations  = t3.Result;
    _volunteers = t4.Result;
    _parishes   = t5.Result;
    _donors     = t6.Result;
    _events     = t7.Result;

    _byReason = _families
      .GroupBy(f => f.Reason.ToDisplayName())
      .Select(g => new ReasonRow(g.Key, g.Count()))
      .OrderByDescending(r => r.Count)
      .ToList();

    _byStatus = _requests
      .GroupBy(r => r.Status.ToString())
      .Select(g => new StatusRow(g.Key, g.Count()))
      .OrderByDescending(r => r.Count)
      .ToList();

    _byFaith = _families
      .GroupBy(f => string.IsNullOrEmpty(f.FaithTradition) ? "Not specified" : f.FaithTradition)
      .Select(g => new FaithRow(g.Key, g.Count()))
      .OrderByDescending(r => r.Count)
      .ToList();

    var fulfilled = _requests
      .Where(r => r.Status == CaseStatus.Fulfilled)
      .Select(r => (r.UpdatedAt - r.CreatedAt).TotalDays)
      .ToList();

    if (fulfilled.Count > 0)
      _avgFulfillDays = $"{fulfilled.Average():F1}d";

    // Monthly trend — last 6 months
    var now = DateTime.UtcNow;
    _monthlyTrend = Enumerable.Range(0, 6)
      .Select(i =>
      {
        var target = now.AddMonths(-5 + i);
        var monthDonations = _donations
          .Where(d => d.Date.Year == target.Year && d.Date.Month == target.Month)
          .ToList();
        return new MonthRow(
          target.ToString("MMM yy"),
          monthDonations.Sum(d => d.Amount),
          monthDonations.Count,
          target.Year == now.Year && target.Month == now.Month
        );
      })
      .ToList();
  }
}
