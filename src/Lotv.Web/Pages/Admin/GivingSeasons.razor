@page "/admin/reports/giving-seasons"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Giving Seasons — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Giving Seasons</h2><p>Monthly and quarterly giving patterns — when donors give most</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donations" class="btn btn-sm">← Donations</a>
    <a href="/admin/timeline" class="btn btn-sm">Timeline</a>
    <a href="/admin/reports/goals" class="btn btn-sm">Goal Tracker</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Analyzing giving patterns…" />
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">🎄</div>
      <div class="kpi-label">Peak Month</div>
      <div class="kpi-value" style="font-size:1.1rem;color:var(--green)">@_peakMonth</div>
      <div class="kpi-change"><Money Amount="@_peakMonthAvg" /> avg</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Q4 Share</div>
      <div class="kpi-value" style="color:var(--navy)">@_q4Pct%</div>
      <div class="kpi-change">of annual giving (Oct–Dec)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">🌘</div>
      <div class="kpi-label">Quietest Month</div>
      <div class="kpi-value" style="font-size:1.1rem;color:var(--amber)">@_quietMonth</div>
      <div class="kpi-change"><Money Amount="@_quietMonthAvg" /> avg</div>
    </div>
    <div class="kpi-card kpi-blush">
      <div class="kpi-icon">📅</div>
      <div class="kpi-label">Years of Data</div>
      <div class="kpi-value" style="color:var(--blush)">@_yearsOfData</div>
      <div class="kpi-change">averaging across @_yearsOfData year@(_yearsOfData == 1 ? "" : "s")</div>
    </div>
  </div>

  <!-- SEASONAL WAVE CHART -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-head">
      <h3>Average Monthly Giving Pattern</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Normalized average across all years of data</span>
    </div>
    <div class="panel-body">
      @{
        var maxAvg = _monthlyAvg.Max(m => m.AvgAmount);
        var months = new[] { "Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec" };
        var seasons = new[] { "❄️","❄️","🌸","🌸","🌸","☀️","☀️","☀️","🍂","🍂","🍂","🎄" };
        var highlights = new[] { false,false,false,true,false,false,false,false,false,true,true,true }; // Easter/Q4
      }
      <div style="display:flex;align-items:flex-end;gap:6px;height:160px;margin-bottom:8px;">
        @for (int i = 0; i < 12; i++)
        {
          var m     = _monthlyAvg[i];
          var h     = maxAvg > 0 ? (int)(m.AvgAmount / (decimal)maxAvg * 145) : 2;
          var isTop = m.AvgAmount == maxAvg;
          var col   = isTop ? "var(--green)" : highlights[i] ? "var(--blush)" : "var(--navy)";
          <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:2px;">
            <div style="font-size:.56rem;color:@col;font-weight:700;">@m.AvgAmount.ToString("C0")</div>
            <div style="width:100%;background:@col;border-radius:4px 4px 0 0;height:@(Math.Max(h,3))px;@(isTop ? "outline:2px solid var(--green);" : "")"></div>
          </div>
        }
      </div>
      <div style="display:flex;gap:6px;">
        @for (int i = 0; i < 12; i++)
        {
          <div style="flex:1;text-align:center;">
            <div style="font-size:.58rem;color:var(--text-light);">@months[i]</div>
            <div style="font-size:.7rem;">@seasons[i]</div>
          </div>
        }
      </div>
      <!-- SEASON LEGEND -->
      <div style="display:flex;gap:16px;margin-top:10px;font-size:.72rem;flex-wrap:wrap;">
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:var(--green);border-radius:2px;display:inline-block;"></span> Peak month</span>
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:var(--blush);border-radius:2px;display:inline-block;"></span> Easter + Q4</span>
        <span style="display:flex;align-items:center;gap:4px;"><span style="width:10px;height:10px;background:var(--navy);border-radius:2px;display:inline-block;"></span> Other months</span>
      </div>
    </div>
  </div>

  <!-- QUARTERLY BREAKDOWN -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

    <div class="panel">
      <div class="panel-head"><h3>Quarterly Average</h3></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
        @{
          var quarters = new[] {
            ("Q1 Jan–Mar", _monthlyAvg[0..3].Sum(m => m.AvgAmount), "❄️"),
            ("Q2 Apr–Jun", _monthlyAvg[3..6].Sum(m => m.AvgAmount), "🌸"),
            ("Q3 Jul–Sep", _monthlyAvg[6..9].Sum(m => m.AvgAmount), "☀️"),
            ("Q4 Oct–Dec", _monthlyAvg[9..12].Sum(m => m.AvgAmount), "🎄"),
          };
          var totalAvg = quarters.Sum(q => q.Item2);
        }
        @foreach (var (label, amount, icon) in quarters.OrderByDescending(q => q.Item2))
        {
          var pct = totalAvg > 0 ? (int)(amount / totalAvg * 100m) : 0;
          <div>
            <div style="display:flex;justify-content:space-between;font-size:.82rem;margin-bottom:3px;">
              <span style="font-weight:700;">@icon @label</span>
              <span style="color:var(--text-mid);"><Money Amount="@amount" /> avg &bull; @pct%</span>
            </div>
            <div class="progress-bar"><div class="progress-fill" style="width:@pct%;"></div></div>
          </div>
        }
      </div>
    </div>

    <!-- YEAR-OVER-YEAR -->
    <div class="panel">
      <div class="panel-head"><h3>Year-over-Year Comparison</h3></div>
      <div class="panel-body" style="padding:0;">
        <table class="data-table">
          <thead><tr><th>Year</th><th style="text-align:right;">Total</th><th style="text-align:right;">Gifts</th><th style="text-align:right;">Avg/Gift</th><th>vs Prior</th></tr></thead>
          <tbody>
            @{
              var yoyList = _byYear.OrderByDescending(y => y.Year).ToList();
            }
            @for (int i = 0; i < yoyList.Count; i++)
            {
              var y    = yoyList[i];
              var prev = i < yoyList.Count - 1 ? yoyList[i + 1] : null;
              var delta= prev is not null && prev.Total > 0 ? (int)((y.Total - prev.Total) / prev.Total * 100) : 0;
              <tr>
                <td style="font-weight:700;">@y.Year</td>
                <td style="text-align:right;font-weight:700;color:var(--green);"><Money Amount="@y.Total" /></td>
                <td style="text-align:right;color:var(--text-mid);">@y.GiftCount</td>
                <td style="text-align:right;color:var(--text-mid);"><Money Amount="@y.AvgGift" /></td>
                <td style="font-size:.76rem;color:@(delta > 0 ? "var(--green)" : delta < 0 ? "var(--red)" : "var(--text-light)");">
                  @(prev is null ? "—" : delta >= 0 ? $"▲ {delta}%" : $"▼ {Math.Abs(delta)}%")
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- HOLIDAY / SEASON CALLOUTS -->
  <div class="panel">
    <div class="panel-head"><h3>Seasonal Giving Notes</h3></div>
    <div class="panel-body" style="display:flex;gap:14px;flex-wrap:wrap;">
      @foreach (var note in _seasonNotes)
      {
        <div style="flex:1;min-width:160px;padding:14px;background:var(--bg);border-radius:10px;border:1px solid var(--border);text-align:center;">
          <div style="font-size:1.5rem;">@note.Icon</div>
          <div style="font-size:.78rem;font-weight:700;margin-top:4px;color:var(--text-dark);">@note.Label</div>
          <div style="font-size:.72rem;color:var(--text-mid);margin-top:2px;">@note.Detail</div>
        </div>
      }
    </div>
  </div>
}

@code {
  private record MonthAvg(int Month, decimal AvgAmount, int AvgGiftCount);
  private record YearRow(int Year, decimal Total, int GiftCount, decimal AvgGift);
  private record SeasonNote(string Icon, string Label, string Detail);

  private bool _loading = true;
  private string _peakMonth = "", _quietMonth = "";
  private decimal _peakMonthAvg, _quietMonthAvg;
  private int _q4Pct, _yearsOfData;
  private List<MonthAvg> _monthlyAvg = [];
  private List<YearRow> _byYear = [];
  private List<SeasonNote> _seasonNotes = [];

  protected override async Task OnInitializedAsync()
  {
    var donations = await Api.GetDonationsAsync();
    if (!donations.Any()) { _loading = false; return; }

    var years = donations.Select(d => d.Date.Year).Distinct().OrderBy(y => y).ToList();
    _yearsOfData = years.Count;

    // Monthly averages across all years
    var mNames = new[] { "January","February","March","April","May","June","July","August","September","October","November","December" };
    _monthlyAvg = Enumerable.Range(1, 12).Select(m =>
    {
      var mDons = donations.Where(d => d.Date.Month == m).ToList();
      var avgAmt = _yearsOfData > 0 && mDons.Any()
          ? mDons.Sum(d => d.Amount) / _yearsOfData
          : 0m;
      var avgCnt = _yearsOfData > 0 ? mDons.Count / _yearsOfData : 0;
      return new MonthAvg(m, Math.Round(avgAmt, 0), avgCnt);
    }).ToList();

    var peak  = _monthlyAvg.MaxBy(m => m.AvgAmount)!;
    var quiet = _monthlyAvg.MinBy(m => m.AvgAmount)!;
    _peakMonth     = mNames[peak.Month - 1];
    _peakMonthAvg  = peak.AvgAmount;
    _quietMonth    = mNames[quiet.Month - 1];
    _quietMonthAvg = quiet.AvgAmount;

    var totalAvg = _monthlyAvg.Sum(m => m.AvgAmount);
    var q4Total  = _monthlyAvg.Skip(9).Sum(m => m.AvgAmount);
    _q4Pct = totalAvg > 0 ? (int)(q4Total / totalAvg * 100m) : 0;

    _byYear = years.Select(y =>
    {
      var yDons = donations.Where(d => d.Date.Year == y).ToList();
      var total = yDons.Sum(d => d.Amount);
      return new YearRow(y, total, yDons.Count, yDons.Any() ? total / yDons.Count : 0m);
    }).ToList();

    // Season notes
    var decAvg  = _monthlyAvg[11].AvgAmount;
    var aprAvg  = _monthlyAvg[3].AvgAmount;
    var julyAvg = _monthlyAvg[6].AvgAmount;
    _seasonNotes =
    [
      new("🎄", "Year-End Giving",    $"Dec avg: {decAvg.ToString("C0")} — tax deadline drives giving"),
      new("🌸", "Easter / Spring",    $"Apr avg: {aprAvg.ToString("C0")} — faith season engagement"),
      new("☀️", "Summer Lull",        $"Jul avg: {julyAvg.ToString("C0")} — historically quieter"),
      new("💌", "GivingTuesday",      "Last Tue of Nov — plan major campaign"),
      new("📱", "End-of-Quarter",     "Mar/Jun/Sep/Dec — fiscal deadlines boost giving"),
    ];

    _loading = false;
  }
}
