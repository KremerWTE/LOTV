@page "/admin/export"
@layout AdminLayout
@inject ApiService Api
@inject AuthService Auth
@inject IJSRuntime JS

<PageTitle>Export Data — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Export Data</h2><p>Download ministry records for reporting and compliance</p></div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:20px;">

  <!-- FAMILIES -->
  <div class="panel">
    <div class="panel-head"><h3>&#128149; Family Records</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 14px;">
        All family intake records including contact info, loss type, and case status.
        <strong>@_families.Count</strong> records.
      </p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <button class="btn btn-primary btn-sm" @onclick="ExportFamilies">Export All (CSV)</button>
        <button class="btn btn-sm" @onclick="ExportFamiliesActive">Active Cases Only</button>
      </div>
    </div>
  </div>

  <!-- DONATIONS -->
  <div class="panel">
    <div class="panel-head"><h3>&#128184; Donation Ledger</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 14px;">
        Complete donation history with donor, amount, channel, and allocation status.
        <strong>@_donations.Count</strong> records.
      </p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <button class="btn btn-primary btn-sm" @onclick="ExportDonations">Export All (CSV)</button>
        <button class="btn btn-sm" @onclick="ExportDonationsYtd">Year-to-Date Only</button>
        <button class="btn btn-sm" @onclick="ExportDonationsUnallocated">Unallocated Only</button>
      </div>
    </div>
  </div>

  <!-- DONORS -->
  <div class="panel">
    <div class="panel-head"><h3>&#128101; Donor Directory</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 14px;">
        Donor profiles including tier, giving history, and recurring status.
        <strong>@_donors.Count</strong> records.
      </p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <button class="btn btn-primary btn-sm" @onclick="ExportDonors">Export All (CSV)</button>
        <button class="btn btn-sm" @onclick="ExportDonorsRecurring">Recurring Only</button>
      </div>
    </div>
  </div>

  <!-- VOLUNTEERS -->
  <div class="panel">
    <div class="panel-head"><h3>&#9997;&#65039; Volunteer Roster</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 14px;">
        Volunteer contact info, roles, and case load.
        <strong>@_volunteers.Count</strong> records.
      </p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <button class="btn btn-primary btn-sm" @onclick="ExportVolunteers">Export All (CSV)</button>
        <button class="btn btn-sm" @onclick="ExportVolunteersActive">Active Only</button>
      </div>
    </div>
  </div>

  <!-- ALLOCATIONS -->
  <div class="panel">
    <div class="panel-head"><h3>&#128200; Fund Allocations</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 14px;">
        Fund allocation records for financial reporting and auditing.
        <strong>@_allocations.Count</strong> records.
      </p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <button class="btn btn-primary btn-sm" @onclick="ExportAllocations">Export All (CSV)</button>
        <button class="btn btn-sm" @onclick="ExportAllocationsApproved">Approved Only</button>
      </div>
    </div>
  </div>

  <!-- AUDIT LOG -->
  <div class="panel">
    <div class="panel-head"><h3>&#128196; Audit Log</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 14px;">
        Full activity audit trail for compliance and review.
        <strong>@_auditLog.Count</strong> entries.
      </p>
      <div style="display:flex;flex-direction:column;gap:8px;">
        <button class="btn btn-primary btn-sm" @onclick="ExportAuditLog">Export Full Log (CSV)</button>
      </div>
    </div>
  </div>

</div>

<!-- TOAST -->
@if (_toastMsg != null)
{
  <div style="position:fixed;bottom:24px;right:24px;background:var(--navy);color:white;padding:12px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:.88rem;font-weight:600;z-index:600;">
    &#10003; @_toastMsg queued for download
  </div>
}

<!-- RECENT EXPORTS -->
@{
  var recentExports = _auditLog
    .Where(e => e.Action.Equals("Exported", StringComparison.OrdinalIgnoreCase))
    .Take(8)
    .ToList();
}
@if (recentExports.Any())
{
  <div class="panel" style="margin-top:28px;">
    <div class="panel-head"><h3>&#128196; Recent Exports</h3></div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead><tr><th>Date</th><th>User</th><th>Export</th></tr></thead>
        <tbody>
          @foreach (var e in recentExports)
          {
            <tr>
              <td style="font-size:.76rem;color:var(--text-light);">@e.Timestamp.ToString("MMM d, yyyy h:mm tt")</td>
              <td style="font-size:.82rem;font-weight:600;">@e.UserName</td>
              <td style="font-size:.82rem;color:var(--text-mid);">@(e.Details ?? "—")</td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

<div class="panel" style="margin-top:28px;border-left:4px solid var(--amber);">
  <div class="panel-body" style="display:flex;align-items:flex-start;gap:12px;">
    <span style="font-size:1.4rem;">&#9888;</span>
    <div>
      <strong style="font-size:.88rem;">Data Privacy Notice</strong>
      <p style="font-size:.82rem;color:var(--text-mid);margin:4px 0 0;">
        Exported files contain personally identifiable information (PII). Handle with care per your
        organization's data privacy policy. Do not share externally without authorization.
        All exports are logged in the audit trail.
      </p>
    </div>
  </div>
</div>

@code {
  private List<Family> _families = [];
  private List<Donation> _donations = [];
  private List<Donor> _donors = [];
  private List<Volunteer> _volunteers = [];
  private List<FundAllocation> _allocations = [];
  private List<AuditEntry> _auditLog = [];
  private string? _toastMsg;

  protected override async Task OnInitializedAsync()
  {
    var t1 = Api.GetFamiliesAsync();
    var t2 = Api.GetDonationsAsync();
    var t3 = Api.GetDonorsAsync();
    var t4 = Api.GetVolunteersAsync();
    var t5 = Api.GetAllocationsAsync();
    var t6 = Api.GetAuditLogAsync();
    await Task.WhenAll(t1, t2, t3, t4, t5, t6);
    _families    = t1.Result;
    _donations   = t2.Result;
    _donors      = t3.Result;
    _volunteers  = t4.Result;
    _allocations = t5.Result;
    _auditLog    = t6.Result;
  }

  // ── CSV helpers ──────────────────────────────────────────────────────────

  private static string Esc(string? v)
  {
    if (v is null) return "";
    if (!v.Contains(',') && !v.Contains('"') && !v.Contains('\n')) return v;
    return "\"" + v.Replace("\"", "\"\"") + "\"";
  }

  private async Task Download(string filename, string label, string csv)
  {
    await JS.InvokeVoidAsync("downloadCsv", filename, csv);
    _toastMsg = label;
    StateHasChanged();
    await Task.Delay(2500);
    _toastMsg = null;
  }

  // ── Families ─────────────────────────────────────────────────────────────

  private Task ExportFamilies() => ExportFamiliesFiltered(_families, "families_all.csv", "Family Records");
  private Task ExportFamiliesActive()
  {
    var rows = _families.Where(f => f.Status == FamilyStatus.Active).ToList();
    return ExportFamiliesFiltered(rows, "families_active.csv", "Active Families");
  }
  private Task ExportFamiliesFiltered(List<Family> rows, string filename, string label)
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("FirstName,LastName,Email,Phone,City,State,Parish,Reason,Status,Created,ContactNotes");
    foreach (var f in rows)
      sb.AppendLine($"{Esc(f.Parent1FirstName)},{Esc(f.Parent1LastName)},{Esc(f.Email)},{Esc(f.Phone)},{Esc(f.City)},{Esc(f.State)},{Esc(f.ParishName)},{Esc(f.Reason.ToDisplayName())},{f.Status},{f.CreatedAt:yyyy-MM-dd},{Esc(f.ContactNotes)}");
    return Download(filename, label, sb.ToString());
  }

  // ── Donations ────────────────────────────────────────────────────────────

  private Task ExportDonations() => ExportDonationsFiltered(_donations, "donations_all.csv", "Donation Ledger");
  private Task ExportDonationsYtd()
  {
    var rows = _donations.Where(d => d.Date.Year == DateTime.UtcNow.Year).ToList();
    return ExportDonationsFiltered(rows, "donations_ytd.csv", "YTD Donations");
  }
  private Task ExportDonationsUnallocated()
  {
    var rows = _donations.Where(d => d.AllocationStatus == AllocationStatus.Unallocated).ToList();
    return ExportDonationsFiltered(rows, "donations_unallocated.csv", "Unallocated Donations");
  }
  private Task ExportDonationsFiltered(List<Donation> rows, string filename, string label)
  {
    var donorMap = _donors.ToDictionary(d => d.Id);
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("Date,DonorName,Amount,Channel,Campaign,Recurring,AllocationStatus");
    foreach (var d in rows)
    {
      var name = donorMap.TryGetValue(d.DonorId, out var donor) ? donor.FullName : $"Donor#{d.DonorId}";
      sb.AppendLine($"{d.Date:yyyy-MM-dd},{Esc(name)},{d.Amount:F2},{d.Channel},{Esc(d.Campaign)},{d.IsRecurring},{d.AllocationStatus}");
    }
    return Download(filename, label, sb.ToString());
  }

  // ── Donors ───────────────────────────────────────────────────────────────

  private Task ExportDonors() => ExportDonorsFiltered(_donors, "donors_all.csv", "Donor Directory");
  private Task ExportDonorsRecurring()
  {
    var rows = _donors.Where(d => d.IsRecurring).ToList();
    return ExportDonorsFiltered(rows, "donors_recurring.csv", "Recurring Donors");
  }
  private Task ExportDonorsFiltered(List<Donor> rows, string filename, string label)
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("FirstName,LastName,Email,Phone,Tier,TotalGiven,GiftCount,Recurring,RecurringAmount,Parish,LastGiftDate");
    foreach (var d in rows)
      sb.AppendLine($"{Esc(d.FirstName)},{Esc(d.LastName)},{Esc(d.Email)},{Esc(d.Phone)},{d.Tier},{d.TotalGiven:F2},{d.GiftCount},{d.IsRecurring},{d.RecurringAmount?.ToString("F2") ?? ""},{Esc(d.ParishName)},{d.LastGiftDate:yyyy-MM-dd}");
    return Download(filename, label, sb.ToString());
  }

  // ── Volunteers ────────────────────────────────────────────────────────────

  private Task ExportVolunteers() => ExportVolunteersFiltered(_volunteers, "volunteers_all.csv", "Volunteer Roster");
  private Task ExportVolunteersActive()
  {
    var rows = _volunteers.Where(v => v.Status == VolunteerStatus.Active).ToList();
    return ExportVolunteersFiltered(rows, "volunteers_active.csv", "Active Volunteers");
  }
  private Task ExportVolunteersFiltered(List<Volunteer> rows, string filename, string label)
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("FirstName,LastName,Email,Phone,Role,Status,Parish,ActiveCases,TotalFulfilled,JoinedDate");
    foreach (var v in rows)
      sb.AppendLine($"{Esc(v.FirstName)},{Esc(v.LastName)},{Esc(v.Email)},{Esc(v.Phone)},{v.Role},{v.Status},{Esc(v.ParishName)},{v.ActiveCases},{v.TotalCasesFulfilled},{v.JoinedDate:yyyy-MM-dd}");
    return Download(filename, label, sb.ToString());
  }

  // ── Allocations ───────────────────────────────────────────────────────────

  private Task ExportAllocations() => ExportAllocationsFiltered(_allocations, "allocations_all.csv", "Fund Allocations");
  private Task ExportAllocationsApproved()
  {
    var rows = _allocations.Where(a => a.Status == AllocationStatus.Allocated).ToList();
    return ExportAllocationsFiltered(rows, "allocations_approved.csv", "Approved Allocations");
  }
  private Task ExportAllocationsFiltered(List<FundAllocation> rows, string filename, string label)
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("Id,DonationId,Amount,AllocatedTo,Status,ApprovedBy,ApprovedAt,Notes,CreatedAt");
    foreach (var a in rows)
      sb.AppendLine($"{a.Id},{a.DonationId},{a.Amount:F2},{Esc(a.AllocatedTo)},{a.Status},{Esc(a.ApprovedBy)},{a.ApprovedAt?.ToString("yyyy-MM-dd") ?? ""},{Esc(a.Notes)},{a.CreatedAt:yyyy-MM-dd}");
    return Download(filename, label, sb.ToString());
  }

  // ── Audit Log ─────────────────────────────────────────────────────────────

  private Task ExportAuditLog()
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("Timestamp,User,Action,Entity,EntityId,Details");
    foreach (var e in _auditLog.OrderByDescending(x => x.Timestamp))
      sb.AppendLine($"{e.Timestamp:yyyy-MM-dd HH:mm:ss},{Esc(e.UserName)},{Esc(e.Action)},{Esc(e.Entity)},{Esc(e.EntityId)},{Esc(e.Details)}");
    return Download("audit_log.csv", "Audit Log", sb.ToString());
  }
}
