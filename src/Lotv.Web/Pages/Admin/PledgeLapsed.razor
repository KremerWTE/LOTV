@page "/admin/pledges/lapsed"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Lapsed Pledges — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Lapsed Pledges</h2><p>Pledges where the donor did not fulfill by the target date</p></div>
  <div class="page-hd-actions">
    <a href="/admin/pledges" class="btn btn-sm">← All Pledges</a>
    <a href="/admin/pledge-renewals" class="btn btn-sm">Renewals</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (!_lapsed.Any())
{
  <div class="panel" style="border-left:4px solid var(--green);">
    <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">
      ✓ No lapsed pledges. All donors are on track.
    </div>
  </div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">&#9888;</div>
      <div class="kpi-label">Lapsed</div>
      <div class="kpi-value" style="color:var(--red)">@_lapsed.Count</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Unfulfilled Amount</div>
      <div class="kpi-value" style="color:var(--amber)">@_lapsed.Sum(p => p.RemainingAmount).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#9989;</div>
      <div class="kpi-label">Partially Paid</div>
      <div class="kpi-value" style="color:var(--navy)">@_lapsed.Count(p => p.FulfilledAmount > 0)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Lapsed Pledges (@_lapsed.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      <table style="width:100%;border-collapse:collapse;">
        <thead>
          <tr style="background:var(--bg);">
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Donor</th>
            <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Pledged</th>
            <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Paid</th>
            <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Remaining</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Target Date</th>
            <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Campaign</th>
            <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var p in _lapsed.OrderBy(p => p.TargetDate))
          {
            <tr style="border-top:1px solid var(--border);">
              <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                <a href="/admin/donors/@p.DonorId" style="color:var(--navy);">@(p.Donor?.FullName ?? $"Donor #{p.DonorId}")</a>
                @if (!string.IsNullOrEmpty(p.Donor?.Email))
                {
                  <div style="font-size:.74rem;color:var(--text-light);">@p.Donor!.Email</div>
                }
              </td>
              <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--navy);">@p.PledgedAmount.ToString("C0")</td>
              <td style="padding:10px 16px;font-size:.84rem;text-align:right;color:var(--green);">@p.FulfilledAmount.ToString("C0")</td>
              <td style="padding:10px 16px;font-size:.84rem;text-align:right;color:var(--red);">@p.RemainingAmount.ToString("C0")</td>
              <td style="padding:10px 16px;font-size:.82rem;color:var(--red);">@p.TargetDate.ToString("MMM d, yyyy")</td>
              <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(p.Campaign ?? "—")</td>
              <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                <a href="/admin/pledges/@p.Id" style="font-size:.78rem;color:var(--navy);">View</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private List<DonorPledge> _lapsed = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    _lapsed = await Api.GetPledgesAsync(status: "Lapsed");
    _loading = false;
  }
}
