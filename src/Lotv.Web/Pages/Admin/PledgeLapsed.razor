@page "/admin/pledges/lapsed"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Lapsed Pledges — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Lapsed Pledges</h2><p>Unfulfilled pledges — prioritized by recovery potential</p></div>
  <div class="page-hd-actions">
    <a href="/admin/pledges" class="btn btn-sm">← All Pledges</a>
    <a href="/admin/pledge-renewals" class="btn btn-sm">Renewals</a>
    <a href="/admin/pledges/summary" class="btn btn-sm">Summary</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Loading lapsed pledges…" />
}
else if (!_lapsed.Any())
{
  <div class="panel" style="border-left:4px solid var(--green);">
    <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">
      ✓ No lapsed pledges. All donors fulfilled their commitments.
    </div>
  </div>
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-red">
      <div class="kpi-icon">&#128683;</div>
      <div class="kpi-label">Lapsed</div>
      <div class="kpi-value" style="color:var(--red)">@_lapsed.Count</div>
      <div class="kpi-change change-down">missed target date</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Recoverable Amount</div>
      <div class="kpi-value" style="color:var(--amber)"><Money Amount="@_totalRemaining" /></div>
      <div class="kpi-change">unfulfilled balance</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128200;</div>
      <div class="kpi-label">Partially Fulfilled</div>
      <div class="kpi-value" style="color:var(--navy)">@_partial</div>
      <div class="kpi-change change-up">already gave something</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#127775;</div>
      <div class="kpi-label">Avg Fulfillment</div>
      <div class="kpi-value" style="color:var(--green)">@_avgFulfillPct%</div>
      <div class="kpi-change">of pledged amount received</div>
    </div>
  </div>

  <!-- RECOVERY PRIORITY SEGMENTS -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:20px;">
    <div class="panel" style="border-left:3px solid var(--green);cursor:pointer;" @onclick='() => _filter = "High"'>
      <div class="panel-body" style="padding:12px 16px;">
        <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;color:var(--green);margin-bottom:4px;">High Recovery</div>
        <div style="font-size:1.4rem;font-weight:700;">@_lapsed.Count(p => p.FulfilledAmount / p.PledgedAmount >= 0.5m)</div>
        <div style="font-size:.72rem;color:var(--text-light);">≥ 50% already paid</div>
      </div>
    </div>
    <div class="panel" style="border-left:3px solid var(--amber);cursor:pointer;" @onclick='() => _filter = "Partial"'>
      <div class="panel-body" style="padding:12px 16px;">
        <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;color:var(--amber);margin-bottom:4px;">Partial</div>
        <div style="font-size:1.4rem;font-weight:700;">@_lapsed.Count(p => p.FulfilledAmount > 0 && p.FulfilledAmount / p.PledgedAmount < 0.5m)</div>
        <div style="font-size:.72rem;color:var(--text-light);">Gave something, not half</div>
      </div>
    </div>
    <div class="panel" style="border-left:3px solid var(--red);cursor:pointer;" @onclick='() => _filter = "None"'>
      <div class="panel-body" style="padding:12px 16px;">
        <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;color:var(--red);margin-bottom:4px;">No Payment</div>
        <div style="font-size:1.4rem;font-weight:700;">@_lapsed.Count(p => p.FulfilledAmount == 0)</div>
        <div style="font-size:.72rem;color:var(--text-light);">Zero received</div>
      </div>
    </div>
  </div>

  <!-- FILTER + TABLE -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px;">
    <button class="chip @(_filter == "All" ? "chip-active" : "")" @onclick='() => _filter = "All"'>All (@_lapsed.Count)</button>
    <button class="chip @(_filter == "High" ? "chip-active" : "")" @onclick='() => _filter = "High"'>High Recovery</button>
    <button class="chip @(_filter == "Partial" ? "chip-active" : "")" @onclick='() => _filter = "Partial"'>Partial</button>
    <button class="chip @(_filter == "None" ? "chip-active" : "")" @onclick='() => _filter = "None"'>No Payment</button>
  </div>

  <div class="panel">
    <div class="panel-head">
      <h3>Lapsed Pledges (@Filtered.Count())</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Sorted by recovery potential</span>
    </div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Donor</th>
            <th style="text-align:right;">Pledged</th>
            <th style="text-align:right;">Paid</th>
            <th style="text-align:right;">Remaining</th>
            <th>Progress</th>
            <th>Target Date</th>
            <th>Campaign</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var p in Filtered)
          {
            var pct = p.PledgedAmount > 0 ? (int)(p.FulfilledAmount / p.PledgedAmount * 100m) : 0;
            var barColor = pct >= 50 ? "var(--green)" : pct > 0 ? "var(--amber)" : "var(--red)";
            var daysLapsed = (int)(DateTime.UtcNow - p.TargetDate).TotalDays;
            <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/pledges/{p.Id}")'>
              <td>
                <strong>@(p.Donor?.FullName ?? $"Donor #{p.DonorId}")</strong>
                @if (!string.IsNullOrEmpty(p.Donor?.Email))
                { <div style="font-size:.72rem;color:var(--text-light);">@p.Donor!.Email</div> }
              </td>
              <td style="text-align:right;font-weight:700;"><Money Amount="@p.PledgedAmount" /></td>
              <td style="text-align:right;color:var(--green);"><Money Amount="@p.FulfilledAmount" /></td>
              <td style="text-align:right;font-weight:700;color:var(--red);"><Money Amount="@p.RemainingAmount" /></td>
              <td style="min-width:100px;">
                <div style="display:flex;align-items:center;gap:6px;">
                  <div class="progress-bar" style="flex:1;height:6px;">
                    <div class="progress-fill" style="width:@pct%;background:@barColor;"></div>
                  </div>
                  <span style="font-size:.7rem;color:@barColor;font-weight:700;white-space:nowrap;">@pct%</span>
                </div>
              </td>
              <td style="font-size:.76rem;color:var(--red);">
                @p.TargetDate.ToString("MMM d, yyyy")
                <div style="font-size:.68rem;color:var(--text-light);">@daysLapsed d ago</div>
              </td>
              <td style="font-size:.76rem;color:var(--text-light);">@(p.Campaign ?? "—")</td>
              <td>
                <a href="/admin/donors/@p.DonorId/touchpoints" class="btn btn-sm" style="font-size:.68rem;" @onclick:stopPropagation>Contact</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private bool _loading = true;
  private string _filter = "All";
  private List<DonorPledge> _lapsed = [];
  private decimal _totalRemaining;
  private int _partial, _avgFulfillPct;

  private IEnumerable<DonorPledge> Filtered => _filter switch
  {
    "High"    => _lapsed.Where(p => p.PledgedAmount > 0 && p.FulfilledAmount / p.PledgedAmount >= 0.5m),
    "Partial" => _lapsed.Where(p => p.FulfilledAmount > 0 && p.PledgedAmount > 0 && p.FulfilledAmount / p.PledgedAmount < 0.5m),
    "None"    => _lapsed.Where(p => p.FulfilledAmount == 0),
    _         => _lapsed
  };

  protected override async Task OnInitializedAsync()
  {
    _lapsed        = await Api.GetPledgesAsync(status: "Lapsed");
    _totalRemaining= _lapsed.Sum(p => p.RemainingAmount);
    _partial       = _lapsed.Count(p => p.FulfilledAmount > 0);
    _avgFulfillPct = _lapsed.Any() && _lapsed.Any(p => p.PledgedAmount > 0)
        ? (int)_lapsed.Where(p => p.PledgedAmount > 0)
                      .Average(p => p.FulfilledAmount / p.PledgedAmount * 100m)
        : 0;

    // Sort: high recovery first (most paid %), then by remaining amount desc
    _lapsed = _lapsed.OrderByDescending(p => p.PledgedAmount > 0 ? p.FulfilledAmount / p.PledgedAmount : 0)
                     .ThenByDescending(p => p.RemainingAmount)
                     .ToList();
    _loading = false;
  }
}
