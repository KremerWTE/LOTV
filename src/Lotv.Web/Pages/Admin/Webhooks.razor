@page "/admin/webhooks"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Webhook Events — LOTV Staff</PageTitle>

<div class="page-hd">
  <div><h2>Webhook Events</h2><p>Last 100 inbound webhook deliveries (idempotency ledger).</p></div>
  <div class="page-hd-actions" style="display:flex;gap:8px;">
    <button class="btn btn-sm @(_filter is null ? "btn-primary" : "")" @onclick="() => Apply(null)">All</button>
    <button class="btn btn-sm @(_filter == "stripe" ? "btn-primary" : "")" @onclick='() => Apply("stripe")'>Stripe</button>
    <button class="btn btn-sm @(_filter == "givebutter" ? "btn-primary" : "")" @onclick='() => Apply("givebutter")'>GiveButter</button>
    <button class="btn btn-sm" @onclick="Load">&#8635; Refresh</button>
  </div>
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead>
        <tr><th>Received</th><th>Source</th><th>Event Type</th><th>External ID</th></tr>
      </thead>
      <tbody>
        @if (_rows.Count == 0)
        {
          <tr><td colspan="4" style="padding:32px;text-align:center;color:var(--text-light);">No webhook events match this filter.</td></tr>
        }
        @foreach (var r in _rows)
        {
          <tr style="cursor:pointer;" @onclick="() => OpenDetail(r.Id)">
            <td style="font-size:.78rem;color:var(--text-light);">@r.ReceivedAt.ToLocalTime().ToString("MMM d, h:mm:ss tt")</td>
            <td><span class="badge">@r.Source</span></td>
            <td style="font-family:monospace;font-size:.78rem;">@r.EventType</td>
            <td style="font-family:monospace;font-size:.72rem;color:var(--text-light);">@r.ExternalId</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@if (_detail is not null)
{
  <div class="drawer-overlay" @onclick="() => _detail = null"></div>
  <div class="drawer">
    <div class="drawer-head">
      <h3>@_detail.Source — @_detail.EventType</h3>
      <button class="drawer-close" @onclick="() => _detail = null">&#10005;</button>
    </div>
    <div class="drawer-body">
      <div style="font-size:.78rem;color:var(--text-light);margin-bottom:8px;">
        @_detail.ReceivedAt.ToLocalTime().ToString("MMM d, yyyy h:mm:ss tt") · @_detail.ExternalId
      </div>
      <pre style="background:var(--bg);border-radius:6px;padding:12px;font-size:.72rem;overflow:auto;max-height:60vh;white-space:pre-wrap;word-break:break-all;">@(_detail.Payload ?? "(payload not stored)")</pre>
    </div>
  </div>
}

@code {
  private List<ApiService.WebhookEventRow> _rows = new();
  private string? _filter;
  private ApiService.WebhookEventDetail? _detail;
  private async Task OpenDetail(int id) => _detail = await Api.GetWebhookEventAsync(id);

  protected override async Task OnInitializedAsync() => await Load();

  private async Task Apply(string? src)
  {
    _filter = src;
    await Load();
  }

  private async Task Load() => _rows = await Api.GetWebhookEventsAsync(_filter);
}
