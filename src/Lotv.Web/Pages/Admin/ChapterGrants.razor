@page "/admin/chapters/{Id:int}/grants"
@layout AdminLayout
@inject ApiService Api

<PageTitle>Chapter Grants — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Grants</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/grants" class="btn btn-sm">All Grants</a>
    <a href="/admin/grants/new" class="btn btn-sm btn-primary">+ Add Grant</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">&#128176;</div>
      <div class="kpi-label">Total Awarded</div>
      <div class="kpi-value" style="color:var(--green)">@_grants.Sum(g => g.Amount).ToString("C0")</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">&#128203;</div>
      <div class="kpi-label">Grants</div>
      <div class="kpi-value" style="color:var(--navy)">@_grants.Count</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">&#128197;</div>
      <div class="kpi-label">Reports Due</div>
      <div class="kpi-value" style="color:var(--amber)">@_grants.Count(g => g.ReportDueDate.HasValue && g.ReportDueDate.Value >= DateTime.Today && g.ReportDueDate.Value <= DateTime.Today.AddDays(30))</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Grants (@_grants.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      @if (!_grants.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No grants recorded for this chapter.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Grantor</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Purpose</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Amount</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Awarded</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Report Due</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Status</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var g in _grants.OrderByDescending(g => g.AwardedDate))
            {
              var reportSoon = g.ReportDueDate.HasValue && g.ReportDueDate.Value <= DateTime.Today.AddDays(30) && g.ReportDueDate.Value >= DateTime.Today;
              <tr style="border-top:1px solid var(--border);@(reportSoon ? "background:#fffbeb;" : "")">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">@g.GrantorName</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@g.Purpose</td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--green);">@g.Amount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@g.AwardedDate.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:@(reportSoon ? "var(--amber)" : "var(--text-light)");">
                  @(g.ReportDueDate?.ToString("MMM d, yyyy") ?? "—")
                  @if (reportSoon)
                  {
                    <span style="margin-left:4px;">⚠</span>
                  }
                </td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@g.Status</td>
                <td style="padding:10px 16px;text-align:center;">
                  <a href="/admin/grants/@g.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Lotv.Core.Models.Chapter? _chapter;
  private List<GrantDto> _grants = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var chapTask  = Api.GetChaptersAdminAsync();
    var grantTask = Api.GetGrantsAsync();
    await Task.WhenAll(chapTask, grantTask);
    var chapters = await chapTask;
    _chapter     = chapters.FirstOrDefault(c => c.Id == Id);
    var all      = await grantTask;
    _grants      = all.Where(g => g.ChapterId == Id).ToList();
    _loading = false;
  }
}
