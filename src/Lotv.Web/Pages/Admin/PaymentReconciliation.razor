@page "/admin/reconciliation"
@layout AdminLayout
@inject ApiService Api
@inject IJSRuntime JS

<PageTitle>Payment Reconciliation — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Payment Reconciliation</h2>
    <p>Compare Stripe records against internal contribution records to surface discrepancies</p>
  </div>
  <div style="display:flex;gap:10px;align-items:center;">
    <select class="form-input" @bind="_periodKey" style="max-width:180px;font-size:.84rem;">
      <option value="this-month">This Month</option>
      <option value="last-month">Last Month</option>
      <option value="this-quarter">This Quarter</option>
      <option value="this-year">This Year</option>
    </select>
    <button class="btn btn-primary" @onclick="RunAsync" disabled="@_loading">
      @(_loading ? "Running…" : "Run Report")
    </button>
    @if (_rows.Any())
    {
      <button class="btn" @onclick="ExportCsv">Export CSV</button>
    }
  </div>
</div>

@if (_loading)
{
  <Loading Message="Comparing Stripe and internal records…" />
}
else if (_ran)
{
  <!-- Summary strip -->
  <div class="kpi-grid" style="margin-bottom:24px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">✓</div>
      <div class="kpi-label">Matched</div>
      <div class="kpi-value" style="color:var(--green);">@_matched</div>
    </div>
    <div class="kpi-card kpi-red">
      <div class="kpi-icon">⚠</div>
      <div class="kpi-label">Discrepancies</div>
      <div class="kpi-value" style="color:#b91c1c;">@_discrepancies</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">📋</div>
      <div class="kpi-label">Stripe Only</div>
      <div class="kpi-value" style="color:var(--amber);">@_stripeOnly</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📑</div>
      <div class="kpi-label">Internal Only</div>
      <div class="kpi-value" style="color:var(--navy);">@_internalOnly</div>
    </div>
  </div>

  @if (_discrepancies == 0 && _stripeOnly == 0 && _internalOnly == 0)
  {
    <div class="panel">
      <div class="panel-body" style="text-align:center;padding:40px;">
        <div style="font-size:2rem;margin-bottom:12px;">✓</div>
        <div style="font-weight:700;color:var(--green);font-size:1rem;">All records match!</div>
        <p style="color:var(--text-light);font-size:.85rem;margin:8px 0 0;">
          @_matched Stripe payment@(_matched != 1 ? "s" : "") reconciled perfectly against internal records for the selected period.
        </p>
      </div>
    </div>
  }
  else
  {
    <!-- Filter chips -->
    <div class="filter-bar" style="margin-bottom:20px;">
      @foreach (var f in new[]{"All","Matched","Discrepancy","Stripe Only","Internal Only"})
      {
        <button class="filter-chip @(_filter == f ? "active" : "")" aria-pressed="@(_filter == f)" @onclick="() => _filter = f">@f</button>
      }
    </div>
  }

  <!-- Results table -->
  <div class="panel">
    <div class="panel-head">
      <h3>Reconciliation Results — @PeriodLabel</h3>
      <span style="font-size:.8rem;color:var(--text-light);">@FilteredRows.Count() record@(FilteredRows.Count() != 1 ? "s" : "")</span>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!FilteredRows.Any())
      {
        <div style="padding:32px;text-align:center;color:var(--text-light);font-size:.85rem;">
          No records match this filter.
        </div>
      }
      else
      {
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Stripe ID</th>
              <th>Internal ID</th>
              <th>Donor</th>
              <th style="text-align:right;">Stripe Amount</th>
              <th style="text-align:right;">Internal Amount</th>
              <th style="text-align:right;">Delta</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var row in FilteredRows)
            {
              <tr>
                <td style="white-space:nowrap;">@row.Date.ToString("MM/dd/yyyy")</td>
                <td style="font-family:monospace;font-size:.78rem;color:var(--text-light);">
                  @(row.StripeId is not null ? row.StripeId[..Math.Min(18, row.StripeId.Length)] + "…" : "—")
                </td>
                <td style="font-family:monospace;font-size:.78rem;color:var(--text-light);">
                  @(row.InternalId is not null ? $"#{row.InternalId}" : "—")
                </td>
                <td>@(row.DonorName ?? "Unknown")</td>
                <td style="text-align:right;">@(row.StripeAmount?.ToString("C2") ?? "—")</td>
                <td style="text-align:right;">@(row.InternalAmount?.ToString("C2") ?? "—")</td>
                <td style="text-align:right;font-weight:700;color:@DeltaColor(row.Delta);">
                  @(row.Delta == 0 ? "—" : row.Delta > 0 ? $"+{row.Delta:C2}" : row.Delta.ToString("C2"))
                </td>
                <td>
                  <span style="display:inline-block;padding:3px 10px;border-radius:12px;font-size:.72rem;font-weight:700;
                               background:@StatusBg(row.RecordStatus);color:@StatusColor(row.RecordStatus);">
                    @row.RecordStatus
                  </span>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>

  <!-- Guidance panel -->
  @if (_discrepancies > 0 || _stripeOnly > 0 || _internalOnly > 0)
  {
    <div class="panel" style="margin-top:20px;">
      <div class="panel-head"><h3>Resolution Guide</h3></div>
      <div class="panel-body">
        <div style="display:flex;flex-direction:column;gap:12px;font-size:.84rem;line-height:1.7;">
          <div style="display:flex;gap:12px;align-items:flex-start;">
            <div style="width:12px;height:12px;border-radius:3px;background:#fff3cd;border:1px solid #ffc107;margin-top:4px;flex-shrink:0;"></div>
            <div><strong>Discrepancy</strong> — Stripe and internal records exist but amounts differ. Check for partial refunds, manual adjustments, or data entry errors. Correct in Donations → edit the internal record.</div>
          </div>
          <div style="display:flex;gap:12px;align-items:flex-start;">
            <div style="width:12px;height:12px;border-radius:3px;background:#5a2d9a;margin-top:4px;flex-shrink:0;"></div>
            <div><strong>Stripe Only</strong> — Stripe received payment but no internal donation record exists. This may indicate a webhook failure. Create a manual donation record linking the Stripe payment intent ID.</div>
          </div>
          <div style="display:flex;gap:12px;align-items:flex-start;">
            <div style="width:12px;height:12px;border-radius:3px;background:var(--navy);margin-top:4px;flex-shrink:0;"></div>
            <div><strong>Internal Only</strong> — A donation record exists internally but has no linked Stripe payment. Verify this was an offline gift (check, cash) or a data-entry error. Add the Stripe Payment Intent ID if applicable.</div>
          </div>
        </div>
      </div>
    </div>
  }
}
else
{
  <div class="panel">
    <div class="panel-body" style="text-align:center;padding:48px 24px;">
      <div style="font-size:2.5rem;margin-bottom:16px;">🔢</div>
      <div style="font-weight:700;color:var(--navy);font-size:1.1rem;margin-bottom:8px;">Ready to reconcile</div>
      <p style="color:var(--text-light);font-size:.85rem;max-width:420px;margin:0 auto 20px;line-height:1.7;">
        Select a time period above and click <strong>Run Report</strong> to compare Stripe payment records against internal donation entries.
      </p>
    </div>
  </div>
}

@code {
  private bool   _loading;
  private bool   _ran;
  private string _periodKey = "this-month";
  private string _filter    = "All";

  private List<ReconciliationRowDto> _rows = new();

  private int _matched      => _rows.Count(r => r.RecordStatus == "Matched");
  private int _discrepancies => _rows.Count(r => r.RecordStatus == "Discrepancy");
  private int _stripeOnly   => _rows.Count(r => r.RecordStatus == "Stripe Only");
  private int _internalOnly => _rows.Count(r => r.RecordStatus == "Internal Only");

  private IEnumerable<ReconciliationRowDto> FilteredRows => _filter switch
  {
    "Matched"       => _rows.Where(r => r.RecordStatus == "Matched"),
    "Discrepancy"   => _rows.Where(r => r.RecordStatus == "Discrepancy"),
    "Stripe Only"   => _rows.Where(r => r.RecordStatus == "Stripe Only"),
    "Internal Only" => _rows.Where(r => r.RecordStatus == "Internal Only"),
    _               => _rows
  };

  private string PeriodLabel => _periodKey switch
  {
    "last-month"   => "Last Month",
    "this-quarter" => "This Quarter",
    "this-year"    => "This Year",
    _              => "This Month"
  };

  private async Task RunAsync()
  {
    _loading = true;
    _ran     = false;
    StateHasChanged();
    _rows    = await Api.GetReconciliationAsync(_periodKey);
    _ran     = true;
    _loading = false;
  }

  private async Task ExportCsv()
  {
    var sb = new System.Text.StringBuilder();
    sb.AppendLine("Date,Stripe ID,Internal ID,Donor,Stripe Amount,Internal Amount,Delta,Status");
    foreach (var row in _rows)
    {
      sb.AppendLine($"{row.Date:yyyy-MM-dd},{row.StripeId ?? ""}," +
                    $"{(row.InternalId != null ? "#" + row.InternalId : "")}," +
                    $"{row.DonorName ?? ""}," +
                    $"{row.StripeAmount?.ToString("F2") ?? ""}," +
                    $"{row.InternalAmount?.ToString("F2") ?? ""}," +
                    $"{row.Delta:F2},{row.RecordStatus}");
    }
    await JS.InvokeVoidAsync("downloadCsv",
        $"reconciliation-{_periodKey}-{DateTime.Today:yyyy-MM-dd}.csv", sb.ToString());
  }

  private static string DeltaColor(decimal delta) => delta switch
  {
    0     => "var(--text-light)",
    > 0   => "#b91c1c",
    _     => "#b91c1c"
  };

  private static string StatusBg(string status) => status switch
  {
    "Matched"       => "#f0faf0",
    "Discrepancy"   => "#fff3cd",
    "Stripe Only"   => "#f3e8ff",
    "Internal Only" => "#eff6ff",
    _               => "var(--bg)"
  };

  private static string StatusColor(string status) => status switch
  {
    "Matched"       => "#2d6a2d",
    "Discrepancy"   => "#856404",
    "Stripe Only"   => "#5a2d9a",
    "Internal Only" => "var(--navy)",
    _               => "var(--text-body)"
  };

}
