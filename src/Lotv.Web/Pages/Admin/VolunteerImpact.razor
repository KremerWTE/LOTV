@page "/admin/volunteers/{Id:int}/impact"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Volunteer Impact — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Volunteer Impact</h2>
    <p>@(_volunteer?.FullName ?? $"Volunteer #{Id}") — full impact record</p>
  </div>
  <div class="page-hd-actions">
    <a href="/admin/volunteers" class="btn btn-sm">← Volunteers</a>
    <a href="/admin/volunteers/@Id" class="btn btn-sm">Profile</a>
    <a href="/admin/volunteers/@Id/cases" class="btn btn-sm">Cases</a>
    <a href="/admin/volunteers/leaderboard" class="btn btn-sm">Leaderboard</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Calculating impact…" />
}
else
{
  <!-- PROFILE HEADER -->
  <div class="panel" style="margin-bottom:20px;">
    <div class="panel-body" style="display:flex;gap:20px;align-items:center;flex-wrap:wrap;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:white;font-weight:700;flex-shrink:0;">
        @Initials(_volunteer?.FullName ?? "V")
      </div>
      <div style="flex:1;min-width:180px;">
        <div style="font-size:1.1rem;font-weight:700;">@(_volunteer?.FullName ?? $"Volunteer #{Id}")</div>
        <div style="font-size:.82rem;color:var(--text-light);">@_volunteer?.ParishName @(string.IsNullOrEmpty(_volunteer?.DioceseName) ? "" : $"· {_volunteer.DioceseName}")</div>
        <div style="margin-top:6px;display:flex;gap:8px;flex-wrap:wrap;">
          <span class="badge badge-@StatusBadge(_volunteer?.Status)">@(_volunteer?.Status.ToString() ?? "—")</span>
          @if (_streak > 0)
          {
            <span style="background:#fff3cd;color:#856404;border:1px solid #ffc107;border-radius:12px;padding:2px 10px;font-size:.7rem;font-weight:700;">
              🔥 @_streak week streak
            </span>
          }
        </div>
      </div>
      <div style="text-align:center;">
        <div style="font-size:2rem;font-weight:700;color:var(--green);line-height:1;">@_fulfilled</div>
        <div style="font-size:.72rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.05em;">Cases Fulfilled</div>
      </div>
    </div>
  </div>

  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">👥</div>
      <div class="kpi-label">Families Helped</div>
      <div class="kpi-value" style="color:var(--green)">@_familiesHelped</div>
      <div class="kpi-change change-up">unique families</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">☑</div>
      <div class="kpi-label">Cases This Year</div>
      <div class="kpi-value" style="color:var(--navy)">@_thisYear</div>
      <div class="kpi-change change-up">▲ @_lastYear last year</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">📋</div>
      <div class="kpi-label">Currently Active</div>
      <div class="kpi-value" style="color:var(--amber)">@_activeCases</div>
      <div class="kpi-change">open assignments</div>
    </div>
    <div class="kpi-card kpi-blush">
      <div class="kpi-icon">🕐</div>
      <div class="kpi-label">Avg Days to Fulfill</div>
      <div class="kpi-value" style="color:var(--blush)">@_avgDays</div>
      <div class="kpi-change">days average</div>
    </div>
  </div>

  <!-- CATEGORY BREAKDOWN + MONTHLY TREND -->
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

    <!-- CATEGORY BREAKDOWN -->
    <div class="panel">
      <div class="panel-head"><h3>Cases by Category</h3></div>
      <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
        @if (!_byCategory.Any())
        {
          <div style="text-align:center;color:var(--text-light);">No data.</div>
        }
        @{
          var maxCat = _byCategory.Any() ? _byCategory.Max(c => c.Count) : 1;
        }
        @foreach (var cat in _byCategory.OrderByDescending(c => c.Count))
        {
          var pct = (int)(cat.Count * 100.0 / maxCat);
          <div>
            <div style="display:flex;justify-content:space-between;font-size:.8rem;margin-bottom:3px;">
              <span style="font-weight:600;">@cat.Category</span>
              <span style="color:var(--text-mid);">@cat.Count cases</span>
            </div>
            <div class="progress-bar">
              <div class="progress-fill" style="width:@pct%;background:var(--green);"></div>
            </div>
          </div>
        }
      </div>
    </div>

    <!-- MONTHLY TREND -->
    <div class="panel">
      <div class="panel-head"><h3>Monthly Activity (12 months)</h3></div>
      <div class="panel-body">
        @if (!_monthlyTrend.Any())
        {
          <div style="text-align:center;color:var(--text-light);">No data.</div>
        }
        else
        {
          var maxM = _monthlyTrend.Any() ? Math.Max(_monthlyTrend.Max(m => m.Count), 1) : 1;
          <div style="display:flex;align-items:flex-end;gap:3px;height:120px;margin-bottom:6px;">
            @foreach (var m in _monthlyTrend)
            {
              var h = (int)(m.Count * 110.0 / maxM);
              <div style="flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;gap:2px;" title="@m.Label: @m.Count">
                @if (m.Count > 0) { <div style="font-size:.55rem;color:var(--navy);font-weight:700;">@m.Count</div> }
                <div style="width:100%;background:@(m.Count > 0 ? "var(--green)" : "var(--border)");border-radius:3px 3px 0 0;height:@(Math.Max(h,2))px;"></div>
              </div>
            }
          </div>
          <div style="display:flex;gap:3px;">
            @foreach (var m in _monthlyTrend)
            {
              <div style="flex:1;text-align:center;font-size:.55rem;color:var(--text-light);">@m.Label</div>
            }
          </div>
        }
      </div>
    </div>

  </div>

  <!-- RECENT FULFILLED CASES -->
  <div class="panel">
    <div class="panel-head">
      <h3>Recent Fulfilled Cases</h3>
      <a href="/admin/volunteers/@Id/cases" style="font-size:.78rem;color:var(--green);text-decoration:none;font-weight:600;">All Cases &rarr;</a>
    </div>
    <div class="panel-body" style="padding:0;">
      @if (!_fulfilledCases.Any())
      {
        <div style="padding:30px;text-align:center;color:var(--text-light);">No fulfilled cases yet.</div>
      }
      else
      {
        <table class="data-table">
          <thead><tr><th>Family</th><th>Category</th><th>Fulfilled</th><th>Days Taken</th></tr></thead>
          <tbody>
            @foreach (var c in _fulfilledCases.Take(12))
            {
              <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/cases/{c.Id}")'>
                <td><strong>@c.Family?.FullName</strong></td>
                <td style="font-size:.78rem;color:var(--text-mid);">@c.Reason.ToDisplayName()</td>
                <td style="font-size:.76rem;color:var(--text-light);">@c.UpdatedAt.ToString("MMM d, yyyy")</td>
                <td style="font-size:.76rem;color:var(--text-mid);">@((int)(c.UpdatedAt - c.CreatedAt).TotalDays)d</td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private record CatBucket(string Category, int Count);
  private record MonthBucket(string Label, int Count);

  private bool _loading = true;
  private Volunteer? _volunteer;
  private List<PackageRequest> _fulfilledCases = [];
  private int _fulfilled, _familiesHelped, _thisYear, _lastYear, _activeCases, _streak;
  private double _avgDays;
  private List<CatBucket> _byCategory = [];
  private List<MonthBucket> _monthlyTrend = [];

  protected override async Task OnInitializedAsync()
  {
    var volTask   = Api.GetVolunteerByIdAsync(Id);
    var caseTask  = Api.GetRequestsAsync();
    await Task.WhenAll(volTask, caseTask);

    _volunteer = await volTask;
    var all    = await caseTask;
    var mine   = all.Where(c => c.AssignedToId == Id).ToList();

    _fulfilledCases = mine.Where(c => c.Status == CaseStatus.Fulfilled)
                          .OrderByDescending(c => c.UpdatedAt).ToList();
    _fulfilled      = _fulfilledCases.Count;
    _familiesHelped = mine.Select(c => c.FamilyId).Distinct().Count();
    _activeCases    = mine.Count(c => c.Status is CaseStatus.New or CaseStatus.InProgress or CaseStatus.AwaitingShipment);

    var now      = DateTime.UtcNow;
    _thisYear    = _fulfilledCases.Count(c => c.UpdatedAt.Year == now.Year);
    _lastYear    = _fulfilledCases.Count(c => c.UpdatedAt.Year == now.Year - 1);
    _avgDays     = _fulfilledCases.Any()
                     ? Math.Round(_fulfilledCases.Average(c => (c.UpdatedAt - c.CreatedAt).TotalDays), 1)
                     : 0;

    _byCategory = mine.Where(c => c.Status == CaseStatus.Fulfilled)
      .GroupBy(c => c.Reason.ToDisplayName())
      .Select(g => new CatBucket(g.Key, g.Count()))
      .ToList();

    _monthlyTrend = Enumerable.Range(0, 12)
      .Select(i => now.AddMonths(-i))
      .Reverse()
      .Select(m => new MonthBucket(
          m.ToString("MMM"),
          _fulfilledCases.Count(c => c.UpdatedAt.Year == m.Year && c.UpdatedAt.Month == m.Month)))
      .ToList();

    // Streak: consecutive weeks with at least 1 fulfilled case
    _streak = 0;
    for (int w = 0; w < 52; w++)
    {
      var wStart = now.AddDays(-7 * (w + 1));
      var wEnd   = now.AddDays(-7 * w);
      if (_fulfilledCases.Any(c => c.UpdatedAt >= wStart && c.UpdatedAt < wEnd))
        _streak++;
      else
        break;
    }

    _loading = false;
  }

  private static string Initials(string name)
  {
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name.Length > 0 ? name[0].ToString() : "V";
  }

  private static string StatusBadge(VolunteerStatus? s) => s switch
  {
    VolunteerStatus.Active     => "fulfilled",
    VolunteerStatus.Inactive   => "cancelled",
    VolunteerStatus.Onboarding => "inprogress",
    _                          => "new"
  };
}
