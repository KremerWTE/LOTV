@page "/admin/reports/schedule-hub"
@layout AdminLayout

<PageTitle>Scheduled Reports — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Scheduled Reports</h2>
    <p>Configure recurring reports, preview the weekly digest, and review past runs</p>
  </div>
</div>

<div class="tab-bar" style="display:flex;gap:4px;margin-bottom:20px;background:white;border:1px solid var(--border);border-radius:var(--radius, 10px);padding:4px;width:fit-content;">
  @foreach (var t in _tabs)
  {
    <button class="tab-btn @(_active == t.Key ? "active" : "")"
            style="padding:8px 16px;border-radius:7px;border:none;background:@(_active == t.Key ? "var(--green)" : "none");color:@(_active == t.Key ? "white" : "var(--text-mid)");font-size:.85rem;font-weight:500;cursor:pointer;"
            @onclick="() => _active = t.Key">
      @t.Label
    </button>
  }
</div>

@switch (_active)
{
  case "schedule":
    <ScheduledReports />
    break;
  case "weekly":
    <WeeklyDigest />
    break;
  case "history":
    <ReportHistory />
    break;
}

@code {
  private record TabDef(string Key, string Label);

  private readonly List<TabDef> _tabs =
  [
    new("schedule", "Schedule"),
    new("weekly", "Weekly Digest"),
    new("history", "Report History"),
  ];

  private string _active = "schedule";
}
