@page "/admin/expenses/{Id:int}"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Expense Detail — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Expense Detail</h2><p>@(_expense?.Description ?? $"Expense #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/expenses" class="btn btn-sm">← Expenses</a>
    @if (_expense is not null)
    {
      <a href="/admin/expenses/@Id/edit" class="btn btn-sm btn-primary">Edit</a>
    }
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_expense is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Expense #@Id not found.</div></div>
}
else
{
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px;">
    <div>
      <div class="panel">
        <div class="panel-head"><h3>@_expense.Description</h3></div>
        <div class="panel-body">
          <table style="width:100%;border-collapse:collapse;">
            <tbody>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);width:35%;">Amount</td>
                <td style="padding:8px 0;font-size:1.1rem;font-weight:700;color:var(--navy);">@_expense.Amount.ToString("C2")</td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Category</td>
                <td style="padding:8px 0;font-size:.86rem;">@_expense.Category</td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Paid</td>
                <td style="padding:8px 0;font-size:.86rem;">@_expense.PaidAt.ToString("MMM d, yyyy")</td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Paid By</td>
                <td style="padding:8px 0;font-size:.86rem;">@_expense.PaidBy</td>
              </tr>
              <tr style="border-bottom:1px solid var(--border);">
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Expense ID</td>
                <td style="padding:8px 0;font-size:.86rem;font-family:monospace;">#@_expense.Id</td>
              </tr>
              <tr>
                <td style="padding:8px 0;font-size:.78rem;color:var(--text-light);">Logged</td>
                <td style="padding:8px 0;font-size:.86rem;">@_expense.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
              </tr>
            </tbody>
          </table>

          @if (!string.IsNullOrEmpty(_expense.Notes))
          {
            <div style="margin-top:14px;padding:10px 14px;background:var(--bg);border-radius:6px;font-size:.82rem;color:var(--text-mid);">
              <strong>Notes:</strong> @_expense.Notes
            </div>
          }

          @if (!string.IsNullOrEmpty(_expense.ReceiptBlobUrl))
          {
            <div style="margin-top:12px;">
              <a href="@_expense.ReceiptBlobUrl" target="_blank" class="btn btn-sm">View Receipt ↗</a>
            </div>
          }
        </div>
      </div>
    </div>

    <div>
      <div class="panel">
        <div class="panel-head"><h3>Actions</h3></div>
        <div class="panel-body" style="display:flex;flex-direction:column;gap:10px;">
          <a href="/admin/expenses/@Id/edit" class="btn btn-sm btn-primary" style="text-align:center;">Edit Expense</a>
          <button class="btn btn-sm" style="background:var(--red);color:white;border:none;"
                  @onclick="Delete" disabled="@_deleteBusy">
            @(_deleteBusy ? "Deleting…" : "Delete Expense")
          </button>
        </div>
      </div>
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Expense? _expense;
  private bool _loading = true, _deleteBusy;
  private string _error = "";

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetExpensesAsync();
    _expense = all.FirstOrDefault(e => e.Id == Id);
    _loading = false;
  }

  private async Task Delete()
  {
    _deleteBusy = true;
    var ok = await Api.DeleteExpenseAsync(Id);
    _deleteBusy = false;
    if (ok) Nav.NavigateTo("/admin/expenses");
    else _error = "Delete failed. Please try again.";
  }
}
