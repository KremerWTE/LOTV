@page "/admin/volunteers-hub"
@layout AdminLayout

<PageTitle>Volunteers — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Volunteers</h2>
    <p>Directory plus scheduling, certifications, skills, matching, and recognition</p>
  </div>
</div>

<div class="tab-bar" style="display:flex;gap:4px;margin-bottom:20px;background:white;border:1px solid var(--border);border-radius:var(--radius, 10px);padding:4px;width:fit-content;flex-wrap:wrap;">
  @foreach (var t in _tabs)
  {
    <button class="tab-btn @(_active == t.Key ? "active" : "")"
            style="padding:8px 16px;border-radius:7px;border:none;background:@(_active == t.Key ? "var(--green)" : "none");color:@(_active == t.Key ? "white" : "var(--text-mid)");font-size:.85rem;font-weight:500;cursor:pointer;white-space:nowrap;"
            @onclick="() => _active = t.Key">
      @t.Label
    </button>
  }
</div>

@switch (_active)
{
  case "directory":
    <Volunteers />
    break;
  case "schedule":
    <VolunteerSchedule />
    break;
  case "certifications":
    <VolunteerCertifications />
    break;
  case "skills":
    <VolunteerSkills />
    break;
  case "availability":
    <VolunteerAvailability />
    break;
  case "match-overview":
    <VolunteerMatchOverview />
    break;
  case "recognition":
    <VolunteerRecognition />
    break;
  case "pending":
    <VolunteerPending />
    break;
  case "reactivation":
    <VolunteerReactivation />
    break;
}

@code {
  private record TabDef(string Key, string Label);

  private readonly List<TabDef> _tabs =
  [
    new("directory", "Directory"),
    new("schedule", "Schedule"),
    new("certifications", "Certifications"),
    new("skills", "Skill Directory"),
    new("availability", "Availability"),
    new("match-overview", "Match Overview"),
    new("recognition", "Recognition"),
    new("pending", "Pending Onboarding"),
    new("reactivation", "Reactivation Queue"),
  ];

  private string _active = "directory";
}
