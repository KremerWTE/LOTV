@page "/admin/retreats/{Id:int}/sync"
@layout AdminLayout
@inject ApiService Api

<PageTitle>GiveButter Sync — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>GiveButter Sync</h2><p>Retreat #@Id — registrations from GiveButter</p></div>
  <div class="page-hd-actions">
    <a href="/admin/retreats/@Id" class="btn btn-sm">← Retreat</a>
    <a href="/admin/retreats/@Id/registrations" class="btn btn-sm">Registrations</a>
  </div>
</div>

@if (_result is not null)
{
  <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
    <div class="panel-body">
      <div style="font-weight:700;color:var(--green);margin-bottom:8px;">✓ Sync complete</div>
      <div style="font-size:.86rem;">
        <strong>@_result.Synced</strong> registrations synced &bull; <strong>@_result.Skipped</strong> skipped
      </div>
      @if (_result.Errors.Any())
      {
        <div style="margin-top:10px;font-size:.82rem;color:var(--red);">
          <strong>Errors (@_result.Errors.Count):</strong>
          <ul style="margin:6px 0 0 18px;padding:0;">
            @foreach (var e in _result.Errors)
            {
              <li>@e</li>
            }
          </ul>
        </div>
      }
    </div>
  </div>
}
@if (!string.IsNullOrEmpty(_error))
{
  <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
    <div class="panel-body" style="color:var(--red);">@_error</div>
  </div>
}

<div style="max-width:540px;">
  <div class="panel">
    <div class="panel-head"><h3>Trigger Sync</h3></div>
    <div class="panel-body">
      <p style="font-size:.84rem;color:var(--text-light);margin-bottom:16px;">
        Pull registrations from the GiveButter campaign linked to this retreat. New registrations are added; existing records are updated.
      </p>

      <div class="form-group">
        <label class="form-label">Sync Since (optional)</label>
        <input class="form-input" type="date" @bind="_since" />
        <div style="font-size:.72rem;color:var(--text-light);margin-top:3px;">Leave blank to sync all registrations.</div>
      </div>

      <div style="display:flex;justify-content:flex-end;margin-top:16px;">
        <button class="btn btn-primary" @onclick="TriggerSync" disabled="@_busy">
          @(_busy ? "Syncing…" : "Run Sync")
        </button>
      </div>
    </div>
  </div>
</div>

@code {
  [Parameter] public int Id { get; set; }

  private GbSyncResultDto? _result;
  private bool _busy;
  private string _error = "";
  private DateTime? _since;

  private async Task TriggerSync()
  {
    _error = ""; _result = null;
    _busy = true;
    var sinceStr = _since.HasValue ? _since.Value.ToString("yyyy-MM-dd") : null;
    _result = await Api.TriggerGiveButterSyncAsync(Id, sinceStr);
    _busy = false;
    if (_result is null) _error = "Sync failed. Please verify the GiveButter campaign ID is configured for this retreat.";
  }
}
