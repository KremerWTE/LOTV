@page "/admin/chapters/{Id:int}/inventory"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Chapter Inventory — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Chapter Inventory</h2><p>@(_chapter?.Name ?? $"Chapter #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/chapters/@Id" class="btn btn-sm">← Chapter</a>
    <a href="/admin/inventory" class="btn btn-sm">All Inventory</a>
    <a href="/admin/inventory/new" class="btn btn-sm btn-primary">+ Add Item</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">📦</div>
      <div class="kpi-label">Item Types</div>
      <div class="kpi-value" style="color:var(--navy)">@_items.Count</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">✅</div>
      <div class="kpi-label">Total On Hand</div>
      <div class="kpi-value" style="color:var(--green)">@_items.Sum(i => i.QuantityOnHand)</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">🔒</div>
      <div class="kpi-label">Reserved</div>
      <div class="kpi-value" style="color:var(--amber)">@_items.Sum(i => i.QuantityReserved)</div>
    </div>
    <div class="kpi-card" style="border-top:3px solid var(--red);">
      <div class="kpi-icon">⚠</div>
      <div class="kpi-label">Low Stock</div>
      <div class="kpi-value" style="color:var(--red)">@_items.Count(i => i.QuantityAvailable <= 2)</div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-head"><h3>Items (@_items.Count)</h3></div>
    <div class="panel-body" style="padding:0;">
      @if (!_items.Any())
      {
        <div style="padding:40px;text-align:center;color:var(--text-light);">No inventory items for this chapter.</div>
      }
      else
      {
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Item</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Category</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">On Hand</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Reserved</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Available</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in _items.OrderBy(i => i.Category).ThenBy(i => i.Name))
            {
              <tr style="border-top:1px solid var(--border);@(item.QuantityAvailable <= 2 ? "background:#fef2f2;" : "")">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">@item.Name</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@item.Category</td>
                <td style="padding:10px 16px;text-align:right;font-size:.84rem;">@item.QuantityOnHand @item.Unit</td>
                <td style="padding:10px 16px;text-align:right;font-size:.82rem;color:var(--text-light);">@item.QuantityReserved</td>
                <td style="padding:10px 16px;text-align:right;font-size:.88rem;font-weight:700;color:@(item.QuantityAvailable <= 2 ? "var(--red)" : item.QuantityAvailable <= 5 ? "var(--amber)" : "var(--green)");">
                  @item.QuantityAvailable
                </td>
                <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                  <a href="/admin/inventory/@item.Id/adjust" style="font-size:.78rem;color:var(--navy);margin-right:8px;">Adjust</a>
                  <a href="/admin/inventory/@item.Id" style="font-size:.78rem;color:var(--navy);">View</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      }
    </div>
  </div>
}

@code {
  [Parameter] public int Id { get; set; }

  private Chapter? _chapter;
  private List<ResourceItem> _items = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var chapTask = Api.GetChaptersAdminAsync();
    var invTask  = Api.GetInventoryAsync();
    await Task.WhenAll(chapTask, invTask);
    var chapters = await chapTask;
    _chapter     = chapters.FirstOrDefault(c => c.Id == Id);
    var all      = await invTask;
    _items       = all.Where(i => i.ChapterId == Id).ToList();
    _loading = false;
  }
}
