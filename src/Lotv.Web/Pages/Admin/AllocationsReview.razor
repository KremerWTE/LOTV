@page "/admin/allocations/review"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Allocations Review — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Allocation Review Queue</h2><p>Pending fund allocations awaiting approval</p></div>
  <div class="page-hd-actions">
    <a href="/admin/allocations" class="btn btn-sm">← All Allocations</a>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">⏳</div>
    <div class="kpi-label">Pending Review</div>
    <div class="kpi-value" style="color:var(--amber)">@_pending.Count</div>
  </div>
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">💸</div>
    <div class="kpi-label">Total Pending Amount</div>
    <div class="kpi-value" style="color:var(--navy)">@_pending.Sum(a => a.Amount).ToString("C0")</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">✓</div>
    <div class="kpi-label">Approved This Session</div>
    <div class="kpi-value" style="color:var(--green)">@_approvedCount</div>
  </div>
  <div class="kpi-card" style="background:#fff1f2;">
    <div class="kpi-icon">🚫</div>
    <div class="kpi-label">Rejected This Session</div>
    <div class="kpi-value" style="color:var(--red)">@_rejectedCount</div>
  </div>
</div>

@if (!_pending.Any())
{
  <div class="panel">
    <div class="panel-body" style="text-align:center;padding:48px;color:var(--text-light);">
      <div style="font-size:2rem;margin-bottom:12px;">✓</div>
      <div style="font-weight:600;font-size:.96rem;">Queue is clear!</div>
      <div style="font-size:.84rem;margin-top:6px;">No fund allocations are pending review.</div>
    </div>
  </div>
}
else
{
  <div class="panel">
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Allocated To</th>
            <th style="text-align:right;">Amount</th>
            <th>Donation #</th>
            <th>Submitted</th>
            <th>Notes</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var a in _pending.OrderBy(a => a.CreatedAt))
          {
            <tr>
              <td style="font-size:.78rem;color:var(--text-light);">#@a.Id</td>
              <td style="font-size:.84rem;font-weight:600;">@a.AllocatedTo</td>
              <td style="text-align:right;font-size:.84rem;color:var(--navy);font-weight:600;">@a.Amount.ToString("C2")</td>
              <td style="font-size:.76rem;color:var(--text-mid);">Donation #@a.DonationId</td>
              <td style="font-size:.76rem;color:var(--text-light);">@a.CreatedAt.ToString("MMM d, yyyy")</td>
              <td style="font-size:.74rem;color:var(--text-light);max-width:160px;overflow:hidden;text-overflow:ellipsis;">@(a.Notes ?? "—")</td>
              <td style="display:flex;gap:4px;">
                <button class="btn btn-sm btn-primary" style="font-size:.7rem;" @onclick="() => Approve(a)" disabled="@_busy">✓ Approve</button>
                <button class="btn btn-sm" style="font-size:.7rem;color:var(--red);" @onclick="() => Reject(a)" disabled="@_busy">✕ Reject</button>
              </td>
            </tr>
          }
        </tbody>
        <tfoot>
          <tr style="background:var(--bg);font-weight:700;">
            <td colspan="2" style="padding:10px 14px;font-size:.82rem;">Total Pending</td>
            <td style="padding:10px 14px;text-align:right;font-size:.84rem;color:var(--navy);">@_pending.Sum(a => a.Amount).ToString("C2")</td>
            <td colspan="4"></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>
}

@code {
  private List<FundAllocation> _pending = [];
  private bool _busy;
  private int _approvedCount, _rejectedCount;

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetAllocationsAsync("PendingReview");
    _pending = all;
  }

  private async Task Approve(FundAllocation a)
  {
    _busy = true;
    a.Status = AllocationStatus.Allocated;
    var updated = await Api.UpdateAllocationAsync(a.Id, a);
    if (updated is not null) { _pending.Remove(a); _approvedCount++; }
    _busy = false;
  }

  private async Task Reject(FundAllocation a)
  {
    _busy = true;
    a.Status = AllocationStatus.Restricted;
    var updated = await Api.UpdateAllocationAsync(a.Id, a);
    if (updated is not null) { _pending.Remove(a); _rejectedCount++; }
    _busy = false;
  }
}
