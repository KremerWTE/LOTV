@page "/admin/prayer-list"
@page "/admin/prayer-dashboard"
@layout AdminLayout
@inject ApiService Api
@inject AuthService Auth
@using Lotv.Core.Models
@using static Lotv.Web.Services.ApiService

<PageTitle>Prayer Dashboard — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Prayer Dashboard</h2>
    <p>Families who need prayer. Tap a button to add or remove yourself.</p>
  </div>
</div>

@if (!_loaded)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  @if (!string.IsNullOrEmpty(_error))
  { <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;margin-bottom:16px;">⚠ @_error</div> }

  @if (_candidates.Count == 0)
  {
    <div class="empty-state" style="padding:32px;"><p>No open families right now.</p></div>
  }
  else
  {
    <div style="display:flex;flex-direction:column;gap:12px;">
      @foreach (var c in _candidates.OrderByDescending(c => c.AlreadyPraying).ThenByDescending(c => c.CreatedAt))
      {
        <div class="panel">
          <div class="panel-body" style="padding:16px 22px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;flex-wrap:wrap;">
            <div>
              <strong>@(c.FamilyName ?? "A family")</strong>
              @if (!string.IsNullOrWhiteSpace(c.ChildName))
              { <span style="font-size:.9rem;color:var(--text-mid);"> — in memory of <em>@c.ChildName</em></span> }
              <div style="font-size:.84rem;color:var(--text-mid);">@c.Reason.ToDisplayName() &bull; @c.CreatedAt.ToString("MMM d, yyyy")</div>
              @if (!string.IsNullOrWhiteSpace(c.Story))
              { <div style="font-size:.85rem;line-height:1.6;margin-top:8px;max-width:640px;white-space:pre-wrap;">@c.Story</div> }
              <div style="font-size:.8rem;color:var(--text-mid);margin-top:8px;">
                🙏 <strong>@(c.PrayingNames?.Count ?? 0)</strong> praying@(c.PrayingNames is { Count: > 0 } ? ": " + string.Join(", ", c.PrayingNames) : " — be the first")
              </div>
            </div>
            @if (Auth.UserRole == "Board")
            { }
            else if (c.AlreadyPraying)
            { <button class="btn btn-sm" @onclick="() => LeaveAsync(c.Id)">🙏 Praying — stop</button> }
            else
            { <button class="btn btn-sm btn-primary" @onclick="() => JoinAsync(c.Id)">I'll pray for this family</button> }
          </div>
        </div>
      }
    </div>
  }
}

@code {
  private bool _loaded;
  private Volunteer? _myVolunteer;
  private List<PrayerCandidateDto> _candidates = [];
  private string _error = "";

  protected override async Task OnInitializedAsync() => await LoadAsync();

  // Everyone can look; nobody has to join. A volunteer record is only made (as a Prayer Ambassador) at the moment
  // someone first taps "I'll pray for this family" and doesn't have one yet.
  private async Task LoadAsync()
  {
    _loaded = false;
    _myVolunteer = await Api.GetMyVolunteerAsync();
    _candidates = await Api.GetPrayerCandidatesAsync();
    _loaded = true;
  }

  private async Task JoinAsync(int requestId)
  {
    _myVolunteer ??= await Api.CreateMyVolunteerAsync(VolunteerRole.PrayerAmbassador);
    if (_myVolunteer is null) { _error = "You can't add yourself to a prayer team with this account."; return; }
    var (ok, error) = await Api.AddToPrayerTeamAsync(requestId, _myVolunteer.Id);
    if (!ok) { _error = error ?? "That could not be done."; return; }
    _error = "";
    await LoadAsync();
  }

  private async Task LeaveAsync(int requestId)
  {
    if (_myVolunteer is null) return;
    if (await Api.RemoveFromPrayerTeamAsync(requestId, _myVolunteer.Id)) await LoadAsync();
  }
}
