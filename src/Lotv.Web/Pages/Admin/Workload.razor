@page "/admin/workload"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Workload View — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div>
    <h2>Workload View</h2>
    <p>Open, overdue, and capacity per volunteer</p>
  </div>
  <div class="page-hd-actions">
    <button class="btn btn-sm @(_activeOnly ? "btn-primary" : "")" @onclick="() => _activeOnly = !_activeOnly">
      @(_activeOnly ? "Active Only" : "All Volunteers")
    </button>
    <button class="btn btn-sm btn-primary" @onclick='() => Nav.NavigateTo("/admin/cases?new=1")'>&#43; New Request</button>
    <a href="/admin/cases" class="btn btn-sm">All Cases</a>
  </div>
</div>

<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:18px;">
  @foreach (var row in _activeOnly ? _rows.Where(r => r.Volunteer.Status == VolunteerStatus.Active) : _rows)
  {
    <div class="panel">
      <div class="panel-head">
        <div style="display:flex;align-items:center;gap:10px;">
          <div class="user-avatar" style="width:36px;height:36px;font-size:.82rem;">@Initials(row.Volunteer.FullName)</div>
          <div>
            <div style="font-weight:700;font-size:.9rem;">@row.Volunteer.FullName</div>
            <div style="font-size:.73rem;color:var(--text-light);">@row.Volunteer.Role.ToDisplayName() &bull; @(row.Volunteer.ParishName ?? "No parish")</div>
          </div>
        </div>
        <span class="badge @(row.Volunteer.Status == VolunteerStatus.Active ? "badge-fulfilled" : "badge-onhold")">
          @row.Volunteer.Status
        </span>
      </div>
      <div class="panel-body">
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:16px;text-align:center;">
          <div>
            <div style="font-size:1.4rem;font-weight:700;font-family:var(--ff-head);color:var(--navy);">@row.OpenCases</div>
            <div style="font-size:.7rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.05em;">Open</div>
          </div>
          <div>
            <div style="font-size:1.4rem;font-weight:700;font-family:var(--ff-head);color:var(--red);">@row.OverdueCases</div>
            <div style="font-size:.7rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.05em;">Overdue</div>
          </div>
          <div>
            <div style="font-size:1.4rem;font-weight:700;font-family:var(--ff-head);color:var(--green);">@row.Volunteer.TotalCasesFulfilled</div>
            <div style="font-size:.7rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.05em;">Total Done</div>
          </div>
        </div>

        <div style="font-size:.74rem;color:var(--text-mid);margin-bottom:6px;">Capacity (@row.OpenCases / 6 cases)</div>
        <div class="progress-bar">
          <div class="progress-fill @(row.OpenCases >= 5 ? "amber" : "")" style="width:@Math.Min(row.OpenCases * 16, 100)%;"></div>
        </div>

        @if (row.Cases.Any())
        {
          <div style="margin-top:14px;display:flex;flex-direction:column;gap:6px;">
            @foreach (var c in row.Cases.Take(3))
            {
              <div style="display:flex;align-items:center;justify-content:space-between;font-size:.78rem;padding:5px 8px;background:var(--bg);border-radius:6px;gap:6px;">
                <span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">#@c.Id — @(c.Family?.Parent1LastName ?? "Family")</span>
                <span class="badge @GetBadge(c.Status)" style="font-size:.65rem;">@c.Status</span>
                <button class="btn btn-sm" style="font-size:.65rem;padding:2px 7px;" @onclick="() => OpenReassign(c)">Reassign</button>
              </div>
            }
            @if (row.Cases.Count > 3)
            { <div style="font-size:.72rem;color:var(--text-light);text-align:center;">+@(row.Cases.Count - 3) more</div> }
          </div>
        }
      </div>
    </div>
  }
</div>

<!-- REASSIGN DRAWER -->
@if (_reassignCase is not null)
{
  <div class="drawer-overlay" @onclick="CloseReassign"></div>
  <div class="drawer" style="width:360px;">
    <div class="drawer-head">
      <h3>Reassign Case #@_reassignCase.Id</h3>
      <button class="drawer-close" @onclick="CloseReassign">&#10005;</button>
    </div>
    <div class="drawer-body">
      <div style="font-size:.84rem;color:var(--text-mid);margin-bottom:4px;">
        <strong>Family:</strong> @(_reassignCase.Family?.FullName ?? "—")<br />
        <strong>Status:</strong> @_reassignCase.Status
      </div>
      <div class="form-group">
        <label class="form-label">Reassign To</label>
        <select class="form-input" @bind="_reassignToVolId">
          <option value="">— Select volunteer —</option>
          @foreach (var v in _allVolunteers)
          { <option value="@v.Id">@v.FullName (@v.ActiveCases open)</option> }
        </select>
      </div>
    </div>
    <div class="drawer-footer">
      <button class="btn btn-primary" @onclick="SaveReassignAsync">Save</button>
      <button class="btn" @onclick="CloseReassign">Cancel</button>
    </div>
  </div>
}

@if (_reassignToast)
{
  <div style="position:fixed;bottom:24px;right:24px;background:var(--green);color:white;padding:12px 20px;border-radius:10px;box-shadow:0 4px 20px rgba(0,0,0,.2);font-size:.88rem;font-weight:600;z-index:600;">
    &#10003; Case reassigned
  </div>
}

@code {
  private record WorkloadRow(Volunteer Volunteer, List<PackageRequest> Cases)
  {
    public int OpenCases    => Cases.Count(c => c.Status is CaseStatus.New or CaseStatus.InProgress or CaseStatus.AwaitingShipment);
    public int OverdueCases => Cases.Count(c => c.IsOverdue);
  }

  private List<WorkloadRow> _rows = [];
  private List<Volunteer> _allVolunteers = [];
  private bool _activeOnly = true;
  private PackageRequest? _reassignCase;
  private int? _reassignToVolId;
  private bool _reassignToast;

  protected override async Task OnInitializedAsync() => await LoadAsync();

  private async Task LoadAsync()
  {
    var volunteers = await Api.GetVolunteersAsync();
    var requests   = await Api.GetRequestsAsync();

    _allVolunteers = volunteers.Where(v => v.Status == VolunteerStatus.Active).ToList();

    _rows = volunteers
      .Select(v => new WorkloadRow(v, requests.Where(r => r.AssignedToId == v.Id).ToList()))
      .OrderByDescending(r => r.OpenCases)
      .ToList();
  }

  private void OpenReassign(PackageRequest c)
  {
    _reassignCase    = c;
    _reassignToVolId = c.AssignedToId;
  }

  private void CloseReassign() => _reassignCase = null;

  private async Task SaveReassignAsync()
  {
    if (_reassignCase is null || !_reassignToVolId.HasValue) return;
    await Api.AssignRequestAsync(_reassignCase.Id, _reassignToVolId.Value);
    _reassignCase  = null;
    _reassignToast = true;
    StateHasChanged();
    await Task.Delay(2000);
    _reassignToast = false;
    await LoadAsync();
  }

  private static string Initials(string name)
  {
    var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    return parts.Length >= 2 ? $"{parts[0][0]}{parts[^1][0]}" : name[..1];
  }

  private static string GetBadge(CaseStatus s) => s switch
  {
    CaseStatus.New        => "badge-new",
    CaseStatus.InProgress => "badge-inprogress",
    CaseStatus.Shipped    => "badge-shipped",
    CaseStatus.Fulfilled  => "badge-fulfilled",
    CaseStatus.OnHold     => "badge-onhold",
    CaseStatus.Cancelled  => "badge-cancelled",
    _ => ""
  };
}
