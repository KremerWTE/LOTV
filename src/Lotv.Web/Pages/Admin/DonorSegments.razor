@page "/admin/donors/segments"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Donor Segments — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Donor Segments</h2><p>Giving tier breakdown and portfolio analysis</p></div>
  <div class="page-hd-actions">
    <a href="/admin/donors" class="btn btn-sm">← Donors</a>
    <a href="/admin/donors/retention" class="btn btn-sm">Retention Analysis</a>
  </div>
</div>

<!-- KPI STRIP -->
<div class="kpi-grid" style="margin-bottom:20px;">
  <div class="kpi-card kpi-navy">
    <div class="kpi-icon">&#128184;</div>
    <div class="kpi-label">Total Donors</div>
    <div class="kpi-value" style="color:var(--navy)">@_donors.Count</div>
  </div>
  <div class="kpi-card kpi-green">
    <div class="kpi-icon">&#128260;</div>
    <div class="kpi-label">Recurring Donors</div>
    <div class="kpi-value" style="color:var(--green)">@_donors.Count(d => d.IsRecurring)</div>
  </div>
  <div class="kpi-card kpi-gold">
    <div class="kpi-icon">&#127942;</div>
    <div class="kpi-label">Major Donors (Benefactor)</div>
    <div class="kpi-value" style="color:var(--gold)">@_donors.Count(d => d.Tier == DonorTier.Benefactor)</div>
  </div>
  <div class="kpi-card kpi-amber">
    <div class="kpi-icon">&#128202;</div>
    <div class="kpi-label">Avg Gift Size</div>
    <div class="kpi-value" style="color:var(--amber)">@(_donors.Where(d => d.GiftCount > 0).Any() ? (_donors.Sum(d => d.TotalGiven) / _donors.Sum(d => d.GiftCount)).ToString("C0") : "—")</div>
  </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:20px;">

  <!-- TIER DISTRIBUTION -->
  <div class="panel">
    <div class="panel-head"><h3>Tier Distribution</h3></div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead><tr><th>Tier</th><th>Range</th><th style="text-align:right;">Donors</th><th style="text-align:right;">Total Given</th><th style="width:130px;">Share of Donors</th></tr></thead>
        <tbody>
          @foreach (var t in _tierStats.OrderByDescending(t => (int)t.Tier))
          {
            var pct = _donors.Any() ? (double)t.Count / _donors.Count * 100 : 0;
            <tr>
              <td><span class="badge @TierBadge(t.Tier)" style="font-size:.62rem;">@t.Tier</span></td>
              <td style="font-size:.74rem;color:var(--text-light);">@TierRange(t.Tier)</td>
              <td style="text-align:right;font-size:.84rem;font-weight:600;">@t.Count</td>
              <td style="text-align:right;font-size:.84rem;color:var(--green);font-weight:600;">@t.TotalGiven.ToString("C0")</td>
              <td>
                <div style="display:flex;align-items:center;gap:6px;">
                  <div style="flex:1;background:var(--bg);border-radius:4px;height:8px;overflow:hidden;">
                    <div style="height:100%;width:@(pct.ToString("F1"))%;background:var(--navy);opacity:.5;border-radius:4px;"></div>
                  </div>
                  <span style="font-size:.72rem;color:var(--text-light);width:34px;text-align:right;">@pct.ToString("F0")%</span>
                </div>
              </td>
            </tr>
          }
        </tbody>
        <tfoot>
          <tr style="background:var(--bg);font-weight:700;">
            <td colspan="2" style="padding:10px 14px;font-size:.82rem;">Total</td>
            <td style="padding:10px 14px;text-align:right;font-size:.84rem;">@_donors.Count</td>
            <td style="padding:10px 14px;text-align:right;font-size:.84rem;color:var(--green);">@_donors.Sum(d => d.TotalGiven).ToString("C0")</td>
            <td></td>
          </tr>
        </tfoot>
      </table>
    </div>
  </div>

  <!-- RECURRING VS ONE-TIME -->
  <div class="panel">
    <div class="panel-head"><h3>Recurring vs. One-Time</h3></div>
    <div class="panel-body">
      <div style="display:flex;gap:20px;margin-bottom:20px;">
        <div style="flex:1;text-align:center;padding:16px;background:var(--bg);border-radius:10px;">
          <div style="font-size:2rem;font-weight:800;color:var(--green);">@_donors.Count(d => d.IsRecurring)</div>
          <div style="font-size:.78rem;color:var(--text-mid);margin-top:4px;">Recurring</div>
          <div style="font-size:.72rem;color:var(--text-light);">@_donors.Where(d => d.IsRecurring).Sum(d => d.TotalGiven).ToString("C0") total</div>
        </div>
        <div style="flex:1;text-align:center;padding:16px;background:var(--bg);border-radius:10px;">
          <div style="font-size:2rem;font-weight:800;color:var(--navy);">@_donors.Count(d => !d.IsRecurring)</div>
          <div style="font-size:.78rem;color:var(--text-mid);margin-top:4px;">One-Time</div>
          <div style="font-size:.72rem;color:var(--text-light);">@_donors.Where(d => !d.IsRecurring).Sum(d => d.TotalGiven).ToString("C0") total</div>
        </div>
      </div>

      <!-- TOP DONORS IN SELECTED TIER -->
      <div style="font-size:.78rem;font-weight:700;text-transform:uppercase;color:var(--text-light);margin-bottom:8px;">Top Benefactor Donors</div>
      @foreach (var d in _donors.Where(d => d.Tier == DonorTier.Benefactor).OrderByDescending(d => d.TotalGiven).Take(5))
      {
        <div style="display:flex;justify-content:space-between;align-items:center;padding:6px 0;border-bottom:1px solid var(--border);">
          <div>
            <div style="font-size:.84rem;font-weight:600;">@(d.IsAnonymous ? "Anonymous Donor" : d.FullName)</div>
            <div style="font-size:.72rem;color:var(--text-light);">@d.GiftCount gifts · Since @d.FirstGiftDate.ToString("MMM yyyy")</div>
          </div>
          <div style="font-size:.9rem;font-weight:700;color:var(--green);">@d.TotalGiven.ToString("C0")</div>
        </div>
      }
    </div>
  </div>

</div>

<!-- ACTIVE TAB: full tier list -->
<div class="filter-bar" style="margin-bottom:12px;">
  @foreach (var tier in Enum.GetValues<DonorTier>().Reverse())
  {
    <button class="filter-chip @(_tierFilter == tier ? "active" : "")" @onclick="() => _tierFilter = tier">
      @tier · @_donors.Count(d => d.Tier == tier)
    </button>
  }
</div>

<div class="panel">
  <div class="panel-body" style="padding:0;">
    <table class="data-table">
      <thead><tr><th>Donor</th><th>Email</th><th style="text-align:right;">Total Given</th><th style="text-align:right;">Gifts</th><th>Last Gift</th><th>Type</th></tr></thead>
      <tbody>
        @foreach (var d in _donors.Where(d => d.Tier == _tierFilter).OrderByDescending(d => d.TotalGiven))
        {
          <tr>
            <td style="font-size:.84rem;font-weight:600;">@(d.IsAnonymous ? "Anonymous" : d.FullName)</td>
            <td style="font-size:.78rem;color:var(--text-mid);">@d.Email</td>
            <td style="text-align:right;font-size:.84rem;color:var(--green);font-weight:600;">@d.TotalGiven.ToString("C0")</td>
            <td style="text-align:right;font-size:.78rem;color:var(--text-mid);">@d.GiftCount</td>
            <td style="font-size:.76rem;color:var(--text-light);">@d.LastGiftDate.ToString("MMM d, yyyy")</td>
            <td>
              @if (d.IsRecurring) { <span class="badge badge-fulfilled" style="font-size:.6rem;">Recurring</span> }
              else { <span class="badge badge-new" style="font-size:.6rem;">One-Time</span> }
            </td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {
  private List<Donor> _donors = [];
  private DonorTier _tierFilter = DonorTier.Benefactor;

  private record TierStat(DonorTier Tier, int Count, decimal TotalGiven);
  private List<TierStat> _tierStats = [];

  protected override async Task OnInitializedAsync()
  {
    _donors = await Api.GetDonorsAsync();
    _tierStats = Enum.GetValues<DonorTier>()
      .Select(t => new TierStat(t, _donors.Count(d => d.Tier == t), _donors.Where(d => d.Tier == t).Sum(d => d.TotalGiven)))
      .ToList();
  }

  private static string TierBadge(DonorTier t) => t switch
  {
    DonorTier.Benefactor => "badge-cancelled",
    DonorTier.Champion   => "badge-onhold",
    DonorTier.Supporter  => "badge-new",
    _                    => "badge-fulfilled"
  };

  private static string TierRange(DonorTier t) => t switch
  {
    DonorTier.Benefactor => "$5,000+",
    DonorTier.Champion   => "$1,000–$4,999",
    DonorTier.Supporter  => "$250–$999",
    _                    => "< $250"
  };
}
