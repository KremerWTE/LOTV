@page "/admin/pledges/{Id:int}/payment"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Apply Pledge Payment — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Apply Pledge Payment</h2><p>@(_pledge?.Donor?.FullName ?? $"Pledge #{Id}")</p></div>
  <div class="page-hd-actions">
    <a href="/admin/pledges" class="btn btn-sm">← Pledges</a>
    @if (_pledge is not null)
    {
      <a href="/admin/pledges/@Id/edit" class="btn btn-sm">Edit Pledge</a>
    }
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else if (_pledge is null)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--red);">Pledge #@Id not found.</div></div>
}
else
{
  @if (_applied)
  {
    <div class="panel" style="border-left:4px solid var(--green);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--green);font-weight:600;">
        ✓ Payment of @_paymentApplied.ToString("C0") applied.
        <a href="/admin/pledges" style="color:var(--green);margin-left:8px;">Back to pledges →</a>
      </div>
    </div>
  }
  @if (!string.IsNullOrEmpty(_error))
  {
    <div class="panel" style="border-left:4px solid var(--red);margin-bottom:16px;">
      <div class="panel-body" style="color:var(--red);">@_error</div>
    </div>
  }

  <!-- Pledge summary -->
  <div class="panel" style="margin-bottom:16px;">
    <div class="panel-body" style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;">
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Donor</div>
        <div style="font-weight:700;"><a href="/admin/donors/@_pledge.DonorId" style="color:var(--navy);">@(_pledge.Donor?.FullName ?? $"Donor #{_pledge.DonorId}")</a></div>
      </div>
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Pledged</div>
        <div style="font-weight:700;color:var(--navy);">@_pledge.PledgedAmount.ToString("C0")</div>
      </div>
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Fulfilled</div>
        <div style="font-weight:700;color:var(--green);">@_pledge.FulfilledAmount.ToString("C0")</div>
      </div>
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Remaining</div>
        <div style="font-weight:700;color:@(_pledge.RemainingAmount > 0 ? "var(--amber)" : "var(--green)");">@_pledge.RemainingAmount.ToString("C0")</div>
      </div>
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Status</div>
        <span class="badge badge-@StatusBadge(_pledge.Status)" style="font-size:.68rem;">@_pledge.Status</span>
      </div>
      <div>
        <div style="font-size:.78rem;color:var(--text-light);">Target Date</div>
        <div style="font-size:.84rem;@(_pledge.IsOverdue ? "color:var(--red);font-weight:600;" : "")">@_pledge.TargetDate.ToString("MMM d, yyyy")@(_pledge.IsOverdue ? " (overdue)" : "")</div>
      </div>
    </div>

    @if (_pledge.FulfilledAmount > 0)
    {
      <div style="margin-top:12px;padding-top:12px;border-top:1px solid var(--border);">
        <div style="background:var(--bg);border-radius:4px;height:8px;overflow:hidden;">
          <div style="height:100%;background:var(--green);width:@(Math.Min(100m, _pledge.FulfillmentPercent).ToString("F0"))%;transition:width .4s;"></div>
        </div>
        <div style="font-size:.72rem;color:var(--text-light);margin-top:4px;">@_pledge.FulfillmentPercent.ToString("F0")% fulfilled</div>
      </div>
    }
  </div>

  @if (_pledge.Status == PledgeStatus.Fulfilled)
  {
    <div class="panel">
      <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">This pledge is fully fulfilled.</div>
    </div>
  }
  else if (_pledge.Status == PledgeStatus.Cancelled || _pledge.Status == PledgeStatus.Lapsed)
  {
    <div class="panel">
      <div class="panel-body" style="padding:32px;text-align:center;color:var(--text-light);">This pledge is @_pledge.Status.ToString().ToLower() and cannot receive payments.</div>
    </div>
  }
  else
  {
    <div style="max-width:440px;">
      <div class="panel">
        <div class="panel-head"><h3>Apply Payment</h3></div>
        <div class="panel-body">
          <div class="form-group">
            <label class="form-label">Payment Amount *</label>
            <input class="form-input" type="number" step="5" min="0.01" @bind="_amount" />
            @if (_pledge.RemainingAmount > 0)
            {
              <div style="font-size:.72rem;color:var(--text-light);margin-top:3px;">
                Remaining balance: @_pledge.RemainingAmount.ToString("C0")
                <button type="button" style="font-size:.72rem;color:var(--navy);background:none;border:none;cursor:pointer;padding:0 4px;"
                        @onclick='() => _amount = _pledge.RemainingAmount'>Pay in full</button>
              </div>
            }
          </div>

          <div style="display:flex;gap:10px;justify-content:flex-end;margin-top:16px;">
            <a href="/admin/pledges" class="btn btn-sm">Cancel</a>
            <button class="btn btn-primary" @onclick="Apply" disabled="@_busy">@(_busy ? "Applying…" : "Apply Payment")</button>
          </div>
        </div>
      </div>
    </div>
  }
}

@code {
  [Parameter] public int Id { get; set; }

  private DonorPledge? _pledge;
  private decimal _amount, _paymentApplied;
  private bool _loading = true, _busy, _applied;
  private string _error = "";

  protected override async Task OnInitializedAsync()
  {
    var all = await Api.GetPledgesAsync();
    _pledge = all.FirstOrDefault(p => p.Id == Id);
    if (_pledge is not null) _amount = _pledge.RemainingAmount > 0 ? _pledge.RemainingAmount : 0;
    _loading = false;
  }

  private async Task Apply()
  {
    _error = ""; _applied = false;
    if (_amount <= 0) { _error = "Amount must be greater than 0."; return; }
    _busy = true;
    var ok = await Api.ApplyPledgePaymentAsync(Id, _amount);
    _busy = false;
    if (ok)
    {
      _applied = true;
      _paymentApplied = _amount;
      if (_pledge is not null)
      {
        _pledge.FulfilledAmount += _amount;
        if (_pledge.FulfilledAmount >= _pledge.PledgedAmount)
          _pledge.Status = PledgeStatus.Fulfilled;
      }
    }
    else _error = "Failed to apply payment. Please try again.";
  }

  private static string StatusBadge(PledgeStatus s) => s switch
  {
    PledgeStatus.Active    => "new",
    PledgeStatus.Fulfilled => "fulfilled",
    PledgeStatus.Overdue   => "pending",
    PledgeStatus.Cancelled => "cancelled",
    PledgeStatus.Lapsed    => "cancelled",
    _                      => "new"
  };
}
