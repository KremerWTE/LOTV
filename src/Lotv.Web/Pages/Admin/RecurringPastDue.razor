@page "/admin/recurring/past-due"
@layout AdminLayout
@inject ApiService Api
@inject NavigationManager Nav
@using Lotv.Core.Models

<PageTitle>Past-Due Recurring Gifts — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Past-Due Recurring Gifts</h2><p>Recurring schedules needing outreach — sorted by recovery priority</p></div>
  <div class="page-hd-actions">
    <a href="/admin/recurring" class="btn btn-sm">← All Recurring</a>
    <a href="/admin/donors/outreach" class="btn btn-sm">Outreach Queue</a>
    <a href="/admin/donors/upgrade-path" class="btn btn-sm">Upgrade Path</a>
  </div>
</div>

@if (_loading)
{
  <Loading Message="Loading past-due schedules…" />
}
else if (!_pastDue.Any())
{
  <div class="panel" style="border-left:4px solid var(--green);">
    <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">
      ✓ No past-due recurring gift schedules. All payments are current.
    </div>
  </div>
}
else
{
  <!-- KPI STRIP -->
  <div class="kpi-grid" style="margin-bottom:20px;">
    <div class="kpi-card kpi-red">
      <div class="kpi-icon">⚠</div>
      <div class="kpi-label">Past Due</div>
      <div class="kpi-value" style="color:var(--red)">@_pastDue.Count</div>
      <div class="kpi-change change-down">need outreach</div>
    </div>
    <div class="kpi-card kpi-amber">
      <div class="kpi-icon">💰</div>
      <div class="kpi-label">Monthly Revenue at Risk</div>
      <div class="kpi-value" style="color:var(--amber)"><Money Amount="@_monthlyAtRisk" /></div>
      <div class="kpi-change">if unrecovered</div>
    </div>
    <div class="kpi-card kpi-navy">
      <div class="kpi-icon">🕐</div>
      <div class="kpi-label">Avg Days Overdue</div>
      <div class="kpi-value" style="color:var(--navy)">@_avgDaysOverdue</div>
    </div>
    <div class="kpi-card kpi-green">
      <div class="kpi-icon">📈</div>
      <div class="kpi-label">Annual Impact</div>
      <div class="kpi-value" style="color:var(--green)"><Money Amount="@_annualAtRisk" /></div>
      <div class="kpi-change">projected yearly loss</div>
    </div>
  </div>

  <!-- PRIORITY BUCKETS -->
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:20px;">
    @foreach (var bucket in _buckets)
    {
      <div class="panel" style="border-left:3px solid @bucket.Color;cursor:pointer;" @onclick="() => _urgencyFilter = bucket.Label">
        <div class="panel-body" style="padding:12px 16px;">
          <div style="font-size:.68rem;font-weight:700;text-transform:uppercase;color:@bucket.Color;margin-bottom:4px;">@bucket.Label</div>
          <div style="font-size:1.4rem;font-weight:700;color:var(--text-dark);">@bucket.Count</div>
          <div style="font-size:.72rem;color:var(--text-light);">@bucket.Range</div>
        </div>
      </div>
    }
  </div>

  <!-- FILTER CHIPS -->
  <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
    <button class="chip @(_urgencyFilter == "All" ? "chip-active" : "")" @onclick='() => _urgencyFilter = "All"'>All (@_pastDue.Count)</button>
    @foreach (var b in _buckets)
    {
      <button class="chip @(_urgencyFilter == b.Label ? "chip-active" : "")" @onclick="() => _urgencyFilter = b.Label">@b.Label (@b.Count)</button>
    }
  </div>

  <!-- RECOVERY TABLE -->
  <div class="panel">
    <div class="panel-head">
      <h3>Recovery Queue (@Filtered.Count())</h3>
      <span style="font-size:.78rem;color:var(--text-light);">Sorted by urgency — highest value, longest overdue first</span>
    </div>
    <div class="panel-body" style="padding:0;">
      <table class="data-table">
        <thead>
          <tr>
            <th>Priority</th>
            <th>Donor</th>
            <th style="text-align:right;">Amount</th>
            <th>Frequency</th>
            <th style="text-align:right;">Days Overdue</th>
            <th>Last Charged</th>
            <th>Campaign</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var r in Filtered)
          {
            var daysOver = r.LastChargedAt.HasValue ? (int)(DateTime.UtcNow - r.NextChargeDate).TotalDays : 999;
            var urgColor = daysOver > 60 ? "var(--red)" : daysOver > 30 ? "var(--amber)" : "var(--text-mid)";
            var priority = daysOver > 60 ? "🔴" : daysOver > 30 ? "🟠" : "🟡";
            <tr style="cursor:pointer;" @onclick='() => Nav.NavigateTo($"/admin/donors/{r.DonorId}/summary")'>
              <td style="font-size:1rem;text-align:center;">@priority</td>
              <td>
                <strong>@(r.Donor?.FullName ?? $"Donor #{r.DonorId}")</strong>
                @if (!string.IsNullOrEmpty(r.Donor?.Email))
                { <div style="font-size:.72rem;color:var(--text-light);">@r.Donor!.Email</div> }
              </td>
              <td style="text-align:right;font-weight:700;color:var(--navy);"><Money Amount="@r.Amount" /></td>
              <td style="font-size:.78rem;color:var(--text-mid);">@r.Frequency.ToDisplayName()</td>
              <td style="text-align:right;font-weight:700;color:@urgColor;">@(daysOver == 999 ? "?" : daysOver.ToString())</td>
              <td style="font-size:.76rem;color:var(--text-light);">@(r.LastChargedAt?.ToString("MMM d, yyyy") ?? "Never")</td>
              <td style="font-size:.76rem;color:var(--text-light);">@(r.Campaign ?? "—")</td>
              <td>
                <a href="/admin/recurring/@r.Id/manage" class="btn btn-sm" style="font-size:.68rem;" @onclick:stopPropagation>Manage</a>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
}

@code {
  private record UrgencyBucket(string Label, string Range, int Count, string Color);

  private bool _loading = true;
  private string _urgencyFilter = "All";
  private List<RecurringDonation> _pastDue = [];
  private List<UrgencyBucket> _buckets = [];
  private decimal _monthlyAtRisk, _annualAtRisk;
  private int _avgDaysOverdue;

  private IEnumerable<RecurringDonation> Filtered => _urgencyFilter switch
  {
    "Critical"  => _pastDue.Where(r => DaysOver(r) > 60),
    "High"      => _pastDue.Where(r => DaysOver(r) is > 30 and <= 60),
    "Moderate"  => _pastDue.Where(r => DaysOver(r) <= 30),
    _           => _pastDue
  };

  protected override async Task OnInitializedAsync()
  {
    _pastDue = await Api.GetAllRecurringAsync(status: "PastDue");
    var now  = DateTime.UtcNow;

    _monthlyAtRisk = _pastDue.Sum(r => r.Amount);
    _annualAtRisk  = _pastDue.Sum(r => AnnualValue(r));
    _avgDaysOverdue= _pastDue.Any()
        ? (int)_pastDue.Average(r => DaysOver(r))
        : 0;

    _buckets =
    [
      new("Critical", "> 60 days",   _pastDue.Count(r => DaysOver(r) > 60),           "var(--red)"),
      new("High",     "31–60 days",  _pastDue.Count(r => DaysOver(r) is > 30 and <= 60), "var(--amber)"),
      new("Moderate", "≤ 30 days",   _pastDue.Count(r => DaysOver(r) <= 30),           "var(--text-mid)"),
    ];

    // Sort: urgency (days over) desc, then amount desc
    _pastDue = _pastDue.OrderByDescending(r => DaysOver(r)).ThenByDescending(r => r.Amount).ToList();
    _loading = false;
  }

  private static int DaysOver(RecurringDonation r) =>
      (int)(DateTime.UtcNow - r.NextChargeDate).TotalDays;

  private static decimal AnnualValue(RecurringDonation r) => r.Frequency switch
  {
    RecurringFrequency.Weekly     => r.Amount * 52,
    RecurringFrequency.BiWeekly   => r.Amount * 26,
    RecurringFrequency.Monthly    => r.Amount * 12,
    RecurringFrequency.Quarterly  => r.Amount * 4,
    RecurringFrequency.Annually   => r.Amount,
    _                             => r.Amount * 12
  };
}
