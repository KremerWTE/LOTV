@page "/admin/recurring/past-due"
@layout AdminLayout
@inject ApiService Api
@using Lotv.Core.Models

<PageTitle>Past-Due Recurring Gifts — LOTV Staff Portal</PageTitle>

<div class="page-hd">
  <div><h2>Past-Due Recurring Gifts</h2><p>Recurring gift schedules requiring follow-up</p></div>
  <div class="page-hd-actions">
    <a href="/admin/recurring" class="btn btn-sm">← All Recurring</a>
  </div>
</div>

@if (_loading)
{
  <div class="panel"><div class="panel-body" style="padding:40px;text-align:center;color:var(--text-light);">Loading…</div></div>
}
else
{
  @if (!_pastDue.Any())
  {
    <div class="panel" style="border-left:4px solid var(--green);">
      <div class="panel-body" style="padding:32px;text-align:center;color:var(--green);font-weight:600;">
        ✓ No past-due recurring gift schedules. All payments are current.
      </div>
    </div>
  }
  else
  {
    <!-- Summary -->
    <div class="kpi-grid" style="margin-bottom:20px;">
      <div class="kpi-card" style="border-top:3px solid var(--red);">
        <div class="kpi-icon">&#9888;</div>
        <div class="kpi-label">Past Due</div>
        <div class="kpi-value" style="color:var(--red)">@_pastDue.Count</div>
      </div>
      <div class="kpi-card kpi-amber">
        <div class="kpi-icon">&#128176;</div>
        <div class="kpi-label">Monthly at Risk</div>
        <div class="kpi-value" style="color:var(--amber)">@_pastDue.Sum(r => r.Amount).ToString("C0")</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>Past-Due Schedules (@_pastDue.Count)</h3></div>
      <div class="panel-body" style="padding:0;">
        <table style="width:100%;border-collapse:collapse;">
          <thead>
            <tr style="background:var(--bg);">
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Donor</th>
              <th style="padding:10px 16px;text-align:right;font-size:.74rem;font-weight:600;color:var(--text-light);">Amount</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Frequency</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Last Charged</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Next Charge</th>
              <th style="padding:10px 16px;text-align:left;font-size:.74rem;font-weight:600;color:var(--text-light);">Campaign</th>
              <th style="padding:10px 16px;text-align:center;font-size:.74rem;font-weight:600;color:var(--text-light);"></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var r in _pastDue.OrderBy(r => r.NextChargeDate))
            {
              <tr style="border-top:1px solid var(--border);">
                <td style="padding:10px 16px;font-size:.84rem;font-weight:600;">
                  <a href="/admin/donors/@r.DonorId" style="color:var(--navy);">@(r.Donor?.FullName ?? $"Donor #{r.DonorId}")</a>
                  @if (!string.IsNullOrEmpty(r.Donor?.Email))
                  {
                    <div style="font-size:.74rem;color:var(--text-light);">@r.Donor!.Email</div>
                  }
                </td>
                <td style="padding:10px 16px;font-size:.88rem;font-weight:700;text-align:right;color:var(--red);">@r.Amount.ToString("C0")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@r.Frequency.ToDisplayName()</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(r.LastChargedAt?.ToString("MMM d, yyyy") ?? "Never")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--red);">@r.NextChargeDate.ToString("MMM d, yyyy")</td>
                <td style="padding:10px 16px;font-size:.82rem;color:var(--text-light);">@(r.Campaign ?? "—")</td>
                <td style="padding:10px 16px;text-align:center;white-space:nowrap;">
                  <a href="/admin/recurring/@r.Id/manage" style="font-size:.78rem;color:var(--navy);">Manage</a>
                </td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>
  }
}

@code {
  private List<RecurringDonation> _pastDue = [];
  private bool _loading = true;

  protected override async Task OnInitializedAsync()
  {
    var all  = await Api.GetAllRecurringAsync(status: "PastDue");
    _pastDue = all;
    _loading = false;
  }
}
