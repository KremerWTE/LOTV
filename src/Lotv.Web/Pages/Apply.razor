@page "/apply"
@layout PublicLayout
@inject ApiService Api
@inject LocalizationService Loc
@using Lotv.Core.Models

<PageTitle>@Loc["apply.title"] — Lily of the Valley Ministry</PageTitle>

@if (_submitted)
{
  <!-- CONFIRMATION -->
  <div style="max-width:600px;margin:80px auto;padding:0 24px;text-align:center;">
    <div style="font-size:3rem;margin-bottom:16px;">&#128149;</div>
    <h2 style="font-family:var(--ff-head);font-size:1.8rem;color:var(--navy);margin:0 0 14px;">Your request has been received.</h2>
    <p style="color:var(--text-mid);font-size:.96rem;line-height:1.7;margin:0 0 28px;">
      Thank you for reaching out. A member of our team will review your request and be in touch soon.
      Please know that you and your family are being held in our prayers.
    </p>
    <div style="background:var(--green-pale);border-radius:12px;padding:22px 24px;text-align:left;margin-bottom:28px;">
      <div style="font-weight:700;color:var(--navy);font-size:.9rem;margin-bottom:10px;">What happens next:</div>
      <ul style="margin:0;padding-left:18px;font-size:.86rem;color:var(--text-mid);line-height:2;">
        <li>Our case team reviews your request (usually within 1–2 business days)</li>
        <li>A volunteer is assigned to assemble your comfort package</li>
        <li>Your package ships directly to you — no cost, ever</li>
        <li>A prayer ambassador will begin praying for your family by name</li>
      </ul>
    </div>
    <a href="/" style="padding:12px 28px;background:var(--navy);color:white;border-radius:9px;font-weight:700;font-size:.9rem;text-decoration:none;">Return Home</a>
  </div>
}
else
{
  <!-- HERO -->
  <div style="background:var(--green-pale);padding:52px 24px 44px;text-align:center;border-bottom:1px solid var(--border);">
    <div style="max-width:580px;margin:0 auto;">
      <div style="font-size:.76rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green);margin-bottom:10px;">Free — No Eligibility Requirements</div>
      <h1 style="font-family:var(--ff-head);font-size:2rem;color:var(--navy);margin:0 0 12px;">Request a Comfort Package</h1>
      <p style="color:var(--text-mid);font-size:.94rem;line-height:1.7;margin:0;">
        Our hand-assembled packages include a personalized bracelet with your baby's initials, prayer resources,
        and a note of love from our community. There is no cost and no faith requirement.
      </p>
    </div>
  </div>

  <!-- FORM -->
  <div style="max-width:680px;margin:48px auto 80px;padding:0 24px;">
    <div style="background:white;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 16px rgba(0,0,0,.06);padding:36px 40px;">

      <!-- ── FOR ME / SOMEONE ELSE ───────────────────────────────────────── -->
      <div style="margin-bottom:28px;">
        <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--border);">Who is this request for?</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <button type="button"
                  style="@RadioCardStyle(_forSelf)"
                  aria-pressed="@_forSelf"
                  @onclick='() => _forSelf = true'>
            <div style="font-size:1.4rem;margin-bottom:6px;">&#128149;</div>
            <div style="font-weight:700;color:var(--navy);font-size:.94rem;">This is for me</div>
            <div style="font-size:.8rem;color:var(--text-mid);margin-top:3px;">I am requesting for myself or my family</div>
          </button>
          <button type="button"
                  style="@RadioCardStyle(!_forSelf)"
                  aria-pressed="@(!_forSelf)"
                  @onclick='() => _forSelf = false'>
            <div style="font-size:1.4rem;margin-bottom:6px;">&#128106;</div>
            <div style="font-weight:700;color:var(--navy);font-size:.94rem;">This is for someone else</div>
            <div style="font-size:.8rem;color:var(--text-mid);margin-top:3px;">I know a family who needs support</div>
          </button>
        </div>
      </div>

      <!-- ── RECIPIENT INFO ──────────────────────────────────────────────── -->
      <div style="margin-bottom:28px;">
        <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border);">
          @(_forSelf ? "About You" : "About the Recipient")
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-group">
            <label class="form-label" for="apply-first-name">First Name *</label>
            <input id="apply-first-name" class="form-input" @bind="_f.Parent1FirstName" placeholder="First name" aria-required="true" autocomplete="given-name" />
          </div>
          <div class="form-group">
            <label class="form-label" for="apply-last-name">Last Name *</label>
            <input id="apply-last-name" class="form-input" @bind="_f.Parent1LastName" placeholder="Last name" aria-required="true" autocomplete="family-name" />
          </div>
        </div>
        <div class="form-group" style="margin-top:12px;">
          <label class="form-label" for="apply-email">Email Address *</label>
          <input id="apply-email" class="form-input" type="email" @bind="_f.Email" placeholder="you@example.com" aria-required="true" autocomplete="email" />
        </div>
        <div class="form-group" style="margin-top:12px;">
          <label class="form-label" for="apply-phone">Phone (optional)</label>
          <input id="apply-phone" class="form-input" @bind="_f.Phone" placeholder="(555) 000-0000" autocomplete="tel" />
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:12px;">
          <div class="form-group">
            <label class="form-label" for="apply-city">City</label>
            <input id="apply-city" class="form-input" @bind="_f.City" placeholder="City" autocomplete="address-level2" />
          </div>
          <div class="form-group">
            <label class="form-label" for="apply-state">State</label>
            <input id="apply-state" class="form-input" @bind="_f.State" placeholder="IL" autocomplete="address-level1" />
          </div>
        </div>
      </div>

      <!-- ── REFERRER INFO (shown only when "someone else") ─────────────── -->
      @if (!_forSelf)
      {
        <div style="margin-bottom:28px;background:#f8f9fb;border-radius:10px;padding:20px 24px;border:1px solid var(--border);">
          <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:14px;">About You (Referrer)</div>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
            <div class="form-group">
              <label class="form-label" for="ref-first">Your First Name</label>
              <input id="ref-first" class="form-input" @bind="_referrerFirstName" placeholder="Your first name" autocomplete="given-name" />
            </div>
            <div class="form-group">
              <label class="form-label" for="ref-last">Your Last Name</label>
              <input id="ref-last" class="form-input" @bind="_referrerLastName" placeholder="Your last name" autocomplete="family-name" />
            </div>
          </div>
          <div class="form-group" style="margin-top:12px;">
            <label class="form-label" for="ref-email">Your Email</label>
            <input id="ref-email" class="form-input" type="email" @bind="_referrerEmail" placeholder="your@email.com" autocomplete="email" />
          </div>
          <div style="font-size:.78rem;color:var(--text-light);margin-top:10px;">
            We may reach out to you with updates on this family's package delivery.
          </div>
        </div>
      }

      <!-- ── PACKAGE TYPE ────────────────────────────────────────────────── -->
      <div style="margin-bottom:28px;">
        <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--border);">Choose a Package Type</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          @foreach (var pkg in _packageOptions)
          {
            <button type="button"
                    style="@PackageCardStyle(_selectedPackage == pkg.Key)"
                    aria-pressed="@(_selectedPackage == pkg.Key)"
                    @onclick="() => _selectedPackage = pkg.Key">
              <div style="font-size:1.3rem;margin-bottom:5px;">@pkg.Icon</div>
              <div style="font-weight:700;color:var(--navy);font-size:.9rem;">@pkg.Label</div>
              <div style="font-size:.76rem;color:var(--text-mid);margin-top:3px;line-height:1.4;">@pkg.Description</div>
            </button>
          }
        </div>
      </div>

      <!-- ── LOSS INFO ───────────────────────────────────────────────────── -->
      <div style="margin-bottom:28px;">
        <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border);">About the Loss</div>
        <div class="form-group">
          <label class="form-label" for="apply-reason">Type of Loss *</label>
          <select id="apply-reason" class="form-input" @bind="_f.Reason" aria-required="true">
            @foreach (var r in Enum.GetValues<PackageReason>())
            { <option value="@r">@r.ToDisplayName()</option> }
          </select>
        </div>
        <div class="form-group" style="margin-top:12px;">
          <label class="form-label" for="apply-initials">Children's Initials (for bracelet)</label>
          <input id="apply-initials" class="form-input" @bind="_f.ChildrenInitials" placeholder="e.g. E.M., T.J. — leave blank if preferred" aria-describedby="apply-initials-hint" />
          <div id="apply-initials-hint" style="font-size:.74rem;color:var(--text-light);margin-top:4px;">We personalize each bracelet. You can include initials for multiple babies.</div>
        </div>
        <div class="form-group" style="margin-top:12px;">
          <label class="form-label" for="apply-story">Share your story (optional)</label>
          <textarea id="apply-story" class="form-textarea" @bind="_f.Story" placeholder="You may share as much or as little as you like. This helps our team care for you personally." rows="4"></textarea>
        </div>
      </div>

      <!-- ── PRIVACY SETTINGS ───────────────────────────────────────────── -->
      <div style="margin-bottom:28px;">
        <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:14px;padding-bottom:8px;border-bottom:1px solid var(--border);">Prayer Wall Listing</div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;">
          <button type="button"
                  style="@PrivacyCardStyle(_f.PrivacyPreference == PrivacyPreference.Public)"
                  aria-pressed="@(_f.PrivacyPreference == PrivacyPreference.Public)"
                  @onclick='() => _f.PrivacyPreference = PrivacyPreference.Public'>
            <div style="font-size:1.2rem;margin-bottom:4px;">&#127758;</div>
            <div style="font-weight:700;color:var(--navy);font-size:.85rem;">Public</div>
            <div style="font-size:.72rem;color:var(--text-mid);margin-top:2px;line-height:1.4;">Name visible on our prayer wall</div>
          </button>
          <button type="button"
                  style="@PrivacyCardStyle(_f.PrivacyPreference == PrivacyPreference.Anonymous)"
                  aria-pressed="@(_f.PrivacyPreference == PrivacyPreference.Anonymous)"
                  @onclick='() => _f.PrivacyPreference = PrivacyPreference.Anonymous'>
            <div style="font-size:1.2rem;margin-bottom:4px;">&#129664;</div>
            <div style="font-weight:700;color:var(--navy);font-size:.85rem;">Anonymous</div>
            <div style="font-size:.72rem;color:var(--text-mid);margin-top:2px;line-height:1.4;">On wall but name hidden</div>
          </button>
          <button type="button"
                  style="@PrivacyCardStyle(_f.PrivacyPreference == PrivacyPreference.Private)"
                  aria-pressed="@(_f.PrivacyPreference == PrivacyPreference.Private)"
                  @onclick='() => _f.PrivacyPreference = PrivacyPreference.Private'>
            <div style="font-size:1.2rem;margin-bottom:4px;">&#128274;</div>
            <div style="font-weight:700;color:var(--navy);font-size:.85rem;">Private</div>
            <div style="font-size:.72rem;color:var(--text-mid);margin-top:2px;line-height:1.4;">Prayers only — not listed</div>
          </button>
        </div>
      </div>

      <!-- ── FAITH & PARISH ──────────────────────────────────────────────── -->
      <div style="margin-bottom:28px;">
        <div style="font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-light);margin-bottom:16px;padding-bottom:8px;border-bottom:1px solid var(--border);">Faith &amp; Parish (optional)</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
          <div class="form-group">
            <label class="form-label" for="apply-parish">Parish Name</label>
            <input id="apply-parish" class="form-input" @bind="_f.ParishName" placeholder="St. Mary's, Chicago" />
          </div>
          <div class="form-group">
            <label class="form-label" for="apply-faith">Faith Tradition</label>
            <select id="apply-faith" class="form-input" @bind="_f.FaithTradition">
              <option value="">— Prefer not to say —</option>
              <option>Catholic</option>
              <option>Protestant</option>
              <option>Christian (non-denominational)</option>
              <option>Orthodox</option>
              <option>Other</option>
            </select>
          </div>
        </div>
      </div>

      <!-- ── DONATION PROMPT ─────────────────────────────────────────────── -->
      <div style="background:linear-gradient(135deg,#fef9ee,#fef3d0);border:1px solid #e8c87a;border-radius:10px;padding:18px 22px;margin-bottom:24px;display:flex;gap:14px;align-items:center;">
        <div style="font-size:1.6rem;flex-shrink:0;">&#127873;</div>
        <div>
          <div style="font-weight:700;color:#7a5a00;font-size:.88rem;margin-bottom:3px;">Consider a $50 donation to cover this package</div>
          <div style="font-size:.8rem;color:#9a7a20;line-height:1.5;">Each comfort package costs about $50 to assemble and ship. No payment required — but every gift helps us serve the next family. <a href="/give" style="color:var(--green);font-weight:700;text-decoration:none;">Give here &#8594;</a></div>
        </div>
      </div>

      @if (!string.IsNullOrEmpty(_error))
      {
        <div role="alert" aria-live="assertive" style="background:#fff3cd;border-radius:8px;padding:12px 16px;font-size:.86rem;color:#856404;margin-bottom:16px;">&#9888; @_error</div>
      }

      <button class="btn btn-primary" style="width:100%;padding:14px;font-size:.96rem;" @onclick="SubmitAsync" disabled="@_busy">
        @(_busy ? "Submitting…" : "Submit Request")
      </button>

      <p style="font-size:.76rem;color:var(--text-light);text-align:center;margin:14px 0 0;line-height:1.6;">
        Your information is kept strictly confidential and used only to fulfill your request.<br />
        There is never any cost or obligation.
      </p>
    </div>
  </div>
}

@code {
  private Family _f = new();
  private bool _forSelf = true;
  private string _referrerFirstName = "";
  private string _referrerLastName = "";
  private string _referrerEmail = "";
  private string _selectedPackage = "Comfort";
  private bool _submitted;
  private bool _busy;
  private string _error = "";

  private record PackageOption(string Key, string Icon, string Label, string Description);

  private readonly List<PackageOption> _packageOptions =
  [
    new("Comfort",  "&#129944;", "Comfort Package",  "Prayer cards, essential oil & tea, sacramentals, personalized bracelet"),
    new("Memory",   "&#128214;", "Memory-Keeping",   "Grief book, memory box, keepsake items for your family"),
    new("Meals",    "&#127815;", "Meals Support",    "Gift cards or coordination with local parish meal train"),
    new("AllThree", "&#129502;", "All Three",        "Everything above — full comfort, memory, and meal support"),
  ];

  private async Task SubmitAsync()
  {
    if (string.IsNullOrWhiteSpace(_f.Parent1FirstName) || string.IsNullOrWhiteSpace(_f.Parent1LastName))
    {
      _error = "Please provide the recipient's first and last name.";
      return;
    }
    if (string.IsNullOrWhiteSpace(_f.Email))
    {
      _error = "Please provide a contact email address.";
      return;
    }

    _f.Status    = FamilyStatus.Active;
    _f.CreatedAt = DateTime.UtcNow;

    // Compose referrer info into ContactNotes if submitting on behalf of someone
    if (!_forSelf && !string.IsNullOrWhiteSpace(_referrerFirstName))
      _f.ContactNotes = $"Referred by: {_referrerFirstName} {_referrerLastName} <{_referrerEmail}>";

    _busy = true;
    var ok = await Api.PublicApplyAsync(_f, _forSelf, _selectedPackage,
        _referrerFirstName, _referrerLastName, _referrerEmail);
    _busy = false;

    if (!ok) { _error = "Unable to submit your request. Please try again."; return; }
    _submitted = true;
  }

  // Card styles
  private static string RadioCardStyle(bool selected) =>
    $"border-radius:10px;padding:14px 16px;border:2px solid {(selected ? "var(--green)" : "var(--border)")};background:{(selected ? "var(--green-pale)" : "white")};cursor:pointer;text-align:center;width:100%;transition:all .15s;";

  private static string PackageCardStyle(bool selected) =>
    $"border-radius:10px;padding:14px 16px;border:2px solid {(selected ? "var(--green)" : "var(--border)")};background:{(selected ? "var(--green-pale)" : "white")};cursor:pointer;text-align:center;width:100%;transition:all .15s;";

  private static string PrivacyCardStyle(bool selected) =>
    $"border-radius:10px;padding:12px;border:2px solid {(selected ? "var(--navy)" : "var(--border)")};background:{(selected ? "#eef1fa" : "white")};cursor:pointer;text-align:center;width:100%;transition:all .15s;";
}
