@page "/apply"
@inject NavigationManager Nav

@* /apply is the same Prayer Care Package request form as inside the dashboard (served at /request-prayer-care-package),
   so there is one form to keep up to date. Anything linking to /apply lands on it. *@
<PageTitle>Request a Prayer Care Package — Lily of the Valley Ministry</PageTitle>
<p style="text-align:center;margin:80px 24px;">Taking you to the request form… <a href="/request-prayer-care-package">Continue</a></p>

@code {
  protected override void OnAfterRender(bool firstRender)
  {
    if (firstRender) Nav.NavigateTo("/request-prayer-care-package", forceLoad: true, replace: true);
  }
}
