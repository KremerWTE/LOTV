@page "/volunteer/dashboard"
@inject NavigationManager Nav

@code {
  // The real, working volunteer hub is VolunteerPortal.razor (/volunteer/portal) — it's what
  // VolunteerLogin.razor actually sends people to after their magic link verifies, and its
  // "My Assignments" / "Available Requests" / "History" / "Update Profile" tiles already link
  // to the other volunteer-portal pages correctly. This route used to duplicate that hub with
  // its own copy of the same summary cards, but called ApiService methods that only ever send
  // the staff JWT (never the magic-link token) and had no VolunteerId parameter at all, so it
  // showed either nothing or everyone's cases rather than "mine." Keeping this as a redirect
  // — not a second hub — means an old bookmark or link still lands somewhere real and correctly
  // scoped, instead of two half-built "volunteer dashboard" pages disagreeing with each other.
  [Parameter, SupplyParameterFromQuery] public int? VolunteerId { get; set; }

  protected override void OnInitialized() =>
    Nav.NavigateTo(VolunteerId is > 0 ? $"/volunteer/portal?VolunteerId={VolunteerId}" : "/volunteer/portal", replace: true);
}
