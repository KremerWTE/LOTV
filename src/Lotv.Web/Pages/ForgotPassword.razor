@page "/forgot-password"
@layout EmptyLayout
@inject AuthService Auth

<PageTitle>Forgot Password — LOTV Ministry</PageTitle>

<div style="min-height:100vh;background:linear-gradient(135deg,var(--navy) 0%,#1a3a6e 100%);display:flex;align-items:center;justify-content:center;padding:24px;">
  <div style="width:100%;max-width:400px;">

    <div style="text-align:center;margin-bottom:32px;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;border:3px solid rgba(255,255,255,.3);margin:0 auto 14px;">🌻</div>
      <div style="font-family:var(--ff-head);font-size:1.4rem;font-weight:700;color:white;">LOTV Ministry</div>
      <div style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:4px;letter-spacing:.06em;text-transform:uppercase;">Staff Portal</div>
    </div>

    <div style="background:white;border-radius:16px;padding:36px 36px 32px;box-shadow:0 24px 48px rgba(0,0,0,.3);">
      <h2 style="font-family:var(--ff-head);font-size:1.2rem;color:var(--navy);margin:0 0 8px;text-align:center;">Reset your password</h2>
      <p style="font-size:.82rem;color:var(--text-light);text-align:center;margin:0 0 24px;">
        Enter your username. If a recovery email is on file for that account, we'll send a reset link to it.
      </p>

      @if (_sent)
      {
        <div style="background:var(--green-pale);border-radius:8px;padding:14px 16px;font-size:.86rem;color:var(--green-dark);text-align:center;">
          ✓ If that account has a recovery email on file, a reset link has been sent.
        </div>
      }
      else
      {
        <div class="form-group" style="margin-bottom:20px;">
          <label class="form-label" for="fp-username">Username</label>
          <input id="fp-username" class="form-input" type="text" @bind="_username" @onkeydown="OnKeyDown"
                 placeholder="e.g. jane.doe" style="font-size:.9rem;"
                 autocomplete="username" aria-required="true" />
        </div>

        <button class="btn btn-primary" style="width:100%;padding:13px;font-size:.95rem;font-weight:700;"
                @onclick="SubmitAsync" disabled="@(_loading || string.IsNullOrWhiteSpace(_username))">
          @(_loading ? "Sending…" : "Send Reset Link")
        </button>
      }

      <div style="margin-top:20px;padding-top:16px;border-top:1px solid var(--border);text-align:center;">
        <a href="/login" style="font-size:.82rem;color:var(--green);text-decoration:none;font-weight:600;">← Back to sign in</a>
      </div>
    </div>
  </div>
</div>

@code {
  private string _username = "";
  private bool _loading;
  private bool _sent;

  private async Task SubmitAsync()
  {
    if (string.IsNullOrWhiteSpace(_username) || _loading) return;
    _loading = true;
    await Auth.ForgotPasswordAsync(_username.Trim());
    _loading = false;
    _sent = true;
  }

  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter") await SubmitAsync();
  }
}
