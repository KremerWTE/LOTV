@page "/volunteer/pending/{Id:int}"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Pending Assignment — LOTV Volunteer Portal</PageTitle>

<!-- PUBLIC NAV -->
<div style="background:var(--navy);color:white;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;">
  <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;color:white;">
    <div style="width:32px;height:32px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1rem;">&#127803;</div>
    <strong style="font-family:var(--ff-head);">LOTV Volunteer Portal</strong>
  </a>
  <a href="/volunteer/dashboard" style="color:white;font-size:.84rem;text-decoration:none;opacity:.85;">My Dashboard</a>
</div>

<div style="max-width:640px;margin:48px auto;padding:0 24px;">

  @if (_loading)
  {
    <Loading Message="Loading assignment details…" Size="lg" />
  }
  else if (_request == null)
  {
    <div class="panel" style="text-align:center;padding:48px;">
      <div style="font-size:2rem;margin-bottom:12px;">&#10007;</div>
      <h3 style="font-family:var(--ff-head);color:var(--navy);">Assignment Not Found</h3>
      <p style="color:var(--text-mid);">This assignment may have already been accepted or reassigned.</p>
      <a href="/volunteer/dashboard" class="btn btn-primary" style="margin-top:16px;">Return to Dashboard</a>
    </div>
  }
  else if (_accepted)
  {
    <div class="panel" style="text-align:center;padding:48px;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;margin:0 auto 20px;">&#10003;</div>
      <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 8px;">Assignment Accepted!</h2>
      <p style="color:var(--text-mid);margin:0 0 24px;">You're now assigned to help <strong>@(_request.Family?.FullName ?? $"Family #{_request.FamilyId}")</strong>. Thank you for stepping up.</p>
      <div style="display:flex;gap:12px;justify-content:center;">
        <a href="/volunteer/my-assignments" class="btn btn-primary">View My Assignments</a>
        <a href="/volunteer/dashboard" class="btn btn-sm">Back to Dashboard</a>
      </div>
    </div>
  }
  else if (_declined)
  {
    <div class="panel" style="text-align:center;padding:48px;">
      <div style="font-size:2.5rem;margin-bottom:16px;">&#128522;</div>
      <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 8px;">Assignment Declined</h2>
      <p style="color:var(--text-mid);margin:0 0 24px;">No worries — this request has been returned to the queue for another volunteer to pick up.</p>
      <div style="display:flex;gap:12px;justify-content:center;">
        <a href="/volunteer/available" class="btn btn-sm">Browse Available Requests</a>
        <a href="/volunteer/dashboard" class="btn btn-sm">Back to Dashboard</a>
      </div>
    </div>
  }
  else
  {
    <!-- ASSIGNMENT CARD -->
    <div style="text-align:center;margin-bottom:28px;">
      <div style="font-size:2rem;margin-bottom:8px;">&#128281;</div>
      <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 6px;">You have a new assignment</h2>
      <p style="color:var(--text-mid);font-size:.9rem;">Please review the details below and accept or decline.</p>
    </div>

    <div class="panel" style="margin-bottom:20px;">
      <div class="panel-header" style="display:flex;justify-content:space-between;align-items:center;">
        <span>Request #@_request.Id</span>
        <span class="badge @GetPriorityBadge(_request.Priority)" style="font-size:.68rem;">@_request.Priority</span>
      </div>
      <div class="panel-body">
        <table style="width:100%;border-collapse:collapse;font-size:.86rem;">
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:9px 0;color:var(--text-light);width:120px;">Family</td>
            <td style="padding:9px 0;font-weight:600;">@(_request.Family?.FullName ?? $"Family #{_request.FamilyId}")</td>
          </tr>
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:9px 0;color:var(--text-light);">Need Type</td>
            <td style="padding:9px 0;font-weight:600;">@_request.Reason</td>
          </tr>
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:9px 0;color:var(--text-light);">Category</td>
            <td style="padding:9px 0;">@_request.Category</td>
          </tr>
          @if (_request.DueDate.HasValue)
          {
            <tr style="border-bottom:1px solid var(--border);">
              <td style="padding:9px 0;color:var(--text-light);">Due Date</td>
              <td style="padding:9px 0;font-weight:600;color:@(_request.DueDate < DateTime.UtcNow ? "var(--blush)" : "inherit");">
                @_request.DueDate.Value.ToString("MMMM d, yyyy")
                @if (_request.DueDate < DateTime.UtcNow)
                { <span class="badge badge-overdue" style="margin-left:6px;font-size:.62rem;">Overdue</span> }
              </td>
            </tr>
          }
          <tr style="border-bottom:1px solid var(--border);">
            <td style="padding:9px 0;color:var(--text-light);">Submitted</td>
            <td style="padding:9px 0;color:var(--text-mid);">@_request.CreatedAt.ToString("MMMM d, yyyy")</td>
          </tr>
          @if (!string.IsNullOrEmpty(_request.InternalNotes))
          {
            <tr>
              <td style="padding:9px 0;color:var(--text-light);vertical-align:top;">Notes</td>
              <td style="padding:9px 0;font-size:.82rem;color:var(--text-mid);">@_request.InternalNotes</td>
            </tr>
          }
        </table>
      </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
      <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;margin-bottom:14px;">&#9888; @_error</div>
    }

    <!-- ACTION BUTTONS -->
    <div style="display:flex;gap:12px;">
      <button class="btn btn-primary" style="flex:1;padding:14px;" @onclick="AcceptAsync" disabled="@_busy">
        @(_busy ? "Processing…" : "&#10003; Accept Assignment")
      </button>
      <button class="btn" style="flex:1;padding:14px;" @onclick="DeclineAsync" disabled="@_busy">
        &#10007; Decline
      </button>
    </div>
    <p style="text-align:center;font-size:.76rem;color:var(--text-light);margin-top:12px;">
      If you decline, this request returns to the unassigned queue for another volunteer.
    </p>
  }
</div>

@code {
  [Parameter] public int Id { get; set; }

  private PackageRequest? _request;
  private bool _loading  = true;
  private bool _accepted;
  private bool _declined;
  private bool _busy;
  private string _error = "";

  protected override async Task OnParametersSetAsync()
  {
    _loading = true;
    _request = await Api.GetRequestAsync(Id);
    _loading = false;
  }

  private async Task AcceptAsync()
  {
    _busy = true; _error = "";
    var ok = await Api.UpdateRequestStatusAsync(Id, CaseStatus.InProgress);
    if (ok) _accepted = true;
    else _error = "Could not accept the assignment. Please try again or contact staff.";
    _busy = false;
  }

  private async Task DeclineAsync()
  {
    _busy = true; _error = "";
    // Return to queue: set back to New so staff can reassign
    var ok = await Api.UpdateRequestStatusAsync(Id, CaseStatus.New);
    if (ok) _declined = true;
    else _error = "Could not decline the assignment. Please try again or contact staff.";
    _busy = false;
  }

  private static string GetPriorityBadge(RequestPriority p) => p switch
  {
    RequestPriority.Urgent => "badge-overdue",
    RequestPriority.High   => "badge-onhold",
    _                      => "badge-new"
  };
}
