@page "/give"
@layout PublicLayout

<PageTitle>Donate — Lily of the Valley Ministry</PageTitle>

<!-- HERO -->
<div style="background:var(--navy);color:white;padding:52px 24px 44px;text-align:center;">
  <div style="max-width:540px;margin:0 auto;">
    <h1 style="font-family:var(--ff-head);font-size:2rem;margin:0 0 12px;">Support a Grieving Family</h1>
    <p style="color:rgba(255,255,255,.8);font-size:.94rem;line-height:1.7;margin:0;">
      Every gift funds a hand-assembled comfort package delivered free of charge to a family navigating pregnancy or infant loss.
    </p>
  </div>
</div>

<!-- DONATION WIDGET -->
<!--
  All donations go through GiveButter — the same real widget (id "Lv36Zg")
  used on lotvministry.org/donate/ and on the Duda prayer-care intake form's
  confirmation screen. GiveButter's own checkout collects donor name/email/
  card and handles recurring frequency; LOTV's database picks up completed
  donations automatically via the GiveButter webhook
  (POST /api/v1/payments/givebutter/webhook -> Donor/Donation records),
  so this page doesn't need its own donor-info form or payment collection.
-->
<div style="max-width:640px;margin:48px auto 80px;padding:0 24px;">
  <div class="donate-card" style="background:white;border-radius:14px;border:1px solid var(--border);box-shadow:0 2px 16px rgba(0,0,0,.06);padding:36px 40px;">
    <div id="lotv-givebutter-widget">
      <script async data-wp-strategy="async" id="givebutter-widget-library-js"
              src="https://widgets.givebutter.com/latest.umd.cjs?acct=esQKeyJhOUHIb71A&p=wordpress"></script>
      <givebutter-widget id="Lv36Zg"></givebutter-widget>
    </div>
    <p style="font-size:.76rem;color:var(--text-light);text-align:center;margin:20px 0 0;line-height:1.6;">
      LOTV Ministry is a 501(c)(3) non-profit organization.
    </p>
  </div>
</div>

<script>
// GiveButter's widget hardcodes its inner panel to max-width:440px via an
// attribute on a nested custom element buried in its shadow DOM — not
// reachable through normal CSS. Poll for it once the widget's own script has
// mounted, then override the attribute so the panel fills this page's
// donation card instead of leaving empty space. Fragile by design (reaches
// into GiveButter's undocumented internal markup) — if their widget library
// restructures this, the override silently stops applying rather than
// breaking anything; the widget still renders correctly at its default width.
(function widenGiveButterOnGivePage(attemptsLeft) {
  var host = document.querySelector("#lotv-givebutter-widget givebutter-widget");
  var inner = host && host.shadowRoot ? host.shadowRoot.querySelector("givebutter-giving-form") : null;
  if (inner) {
    // Both levels matter: the outer <givebutter-widget> host is otherwise
    // shrink-wrapped to its content's natural size, so widening only the
    // inner element (whose max-width:100% is relative to ITS container,
    // i.e. the still-narrow host) has no visible effect on its own.
    host.style.display = "block";
    host.style.width = "100%";
    inner.setAttribute("max-width", "100%");
    inner.style.maxWidth = "100%";
    inner.style.width = "100%";
    return;
  }
  if (attemptsLeft > 0) setTimeout(function () { widenGiveButterOnGivePage(attemptsLeft - 1); }, 300);
})(20);
</script>
