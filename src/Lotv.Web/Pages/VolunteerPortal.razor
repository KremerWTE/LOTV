@page "/volunteer/portal"
@layout PublicLayout
@inject ApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Volunteer Portal — LOTV Ministry</PageTitle>

<div style="max-width:980px;margin:48px auto 80px;padding:0 24px;">
  @if (VolunteerId is null or 0)
  {
    <div class="panel">
      <div class="panel-body" style="text-align:center;padding:48px 24px;">
        <div style="font-size:2.4rem;margin-bottom:14px;">&#128274;</div>
        <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 12px;">Sign In Required</h2>
        <p style="color:var(--text-mid);margin:0 0 18px;">Use your magic-link email to access your volunteer portal.</p>
        <a href="/volunteer/login" class="btn btn-primary">Go to sign-in</a>
      </div>
    </div>
  }
  else
  {
    <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:24px;">
      <h1 style="font-family:var(--ff-head);color:var(--navy);margin:0;">Welcome back.</h1>
      @if (_sessionExpiresIn is not null)
      {
        <span title="Magic-link session expiry"
              style="font-size:.74rem;background:var(--bg);border:1px solid var(--border);border-radius:14px;padding:3px 10px;color:var(--text-light);">
          ⏱ @_sessionExpiresIn
        </span>
      }
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:18px;">
      <a href="@($"/volunteer/my-assignments?VolunteerId={VolunteerId}")" class="panel" style="text-decoration:none;position:relative;">
        @if (_activeCount > 0)
        {
          <span style="position:absolute;top:14px;right:14px;background:var(--blush);color:white;font-size:.7rem;font-weight:700;padding:2px 9px;border-radius:11px;">@_activeCount</span>
        }
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">&#128203;</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">My Assignments</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Active and pending requests assigned to you.</p>
        </div>
      </a>
      <a href="@($"/volunteer/available?VolunteerId={VolunteerId}")" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">&#128205;</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Available Requests Near Me</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Pick up unassigned work in your area.</p>
        </div>
      </a>
      <a href="@($"/volunteer/history?VolunteerId={VolunteerId}")" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">&#128202;</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Service History</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Your fulfillment record across all chapters served.</p>
        </div>
      </a>
      <a href="@($"/my-profile?VolunteerId={VolunteerId}")" class="panel" style="text-decoration:none;">
        <div class="panel-body">
          <div style="font-size:1.4rem;margin-bottom:8px;">&#9881;</div>
          <strong style="font-family:var(--ff-head);color:var(--navy);">Update Profile</strong>
          <p style="font-size:.84rem;color:var(--text-mid);margin:6px 0 0;line-height:1.5;">Phone, address, availability, communication preferences.</p>
        </div>
      </a>
    </div>
  }
</div>

@code {
  [Parameter, SupplyParameterFromQuery] public int? VolunteerId { get; set; }
  private int _activeCount;
  private string? _sessionExpiresIn;

  protected override async Task OnInitializedAsync()
  {
    if (VolunteerId is int id && id > 0)
      _activeCount = await Api.GetVolunteerAssignmentCountAsync(id);
    try
    {
      var token = await JS.InvokeAsync<string?>("sessionStorage.getItem", "lotv.volunteerToken");
      if (!string.IsNullOrEmpty(token))
      {
        var newExp = await Api.RefreshVolunteerSessionAsync(token);
        if (newExp is not null)
          await JS.InvokeVoidAsync("sessionStorage.setItem", "lotv.volunteerTokenExpires", newExp.Value.ToString("O"));
      }
      var iso = await JS.InvokeAsync<string?>("sessionStorage.getItem", "lotv.volunteerTokenExpires");
      if (DateTime.TryParse(iso, null, System.Globalization.DateTimeStyles.RoundtripKind, out var exp))
      {
        var rem = exp - DateTime.UtcNow;
        _sessionExpiresIn = rem.TotalDays >= 1
          ? $"{(int)rem.TotalDays}d remaining"
          : rem.TotalHours >= 1
            ? $"{(int)rem.TotalHours}h remaining"
            : $"{Math.Max(0, (int)rem.TotalMinutes)}m remaining";
      }
    }
    catch { }
  }
}
