@page "/my-requests"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>My Requests — LOTV Ministry</PageTitle>

<!-- PUBLIC NAV HEADER -->
<div style="background:var(--navy);color:white;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;">
  <div style="display:flex;align-items:center;gap:12px;">
    <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1.1rem;">&#127803;</div>
    <div>
      <div style="font-family:var(--ff-head);font-size:1rem;font-weight:700;">LOTV Ministry</div>
      <div style="font-size:.7rem;opacity:.7;">My Service Requests</div>
    </div>
  </div>
  <div style="display:flex;gap:12px;align-items:center;">
    <a href="/" style="color:white;font-size:.84rem;text-decoration:none;opacity:.85;">Home</a>
    <a href="/apply" class="btn btn-sm" style="background:white;color:var(--navy);font-weight:700;">&#43; New Request</a>
  </div>
</div>

<div style="max-width:860px;margin:0 auto;padding:32px 24px;">

  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <div>
      <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 4px;">My Assistance Requests</h2>
      <p style="font-size:.84rem;color:var(--text-mid);margin:0;">Track the status of your submitted requests</p>
    </div>
    <a href="/apply" class="btn btn-primary">&#43; Submit New Request</a>
  </div>

  @if (_loading)
  {
    <Loading Message="Loading your requests…" />
  }
  else if (!_requests.Any())
  {
    <div class="panel" style="text-align:center;padding:48px;">
      <div style="font-size:3rem;margin-bottom:12px;">&#128149;</div>
      <h3 style="font-family:var(--ff-head);color:var(--navy);">No Requests Yet</h3>
      <p style="color:var(--text-mid);margin-bottom:20px;">You have not submitted any assistance requests.<br>We are here to help — please reach out.</p>
      <a href="/apply" class="btn btn-primary">Apply for Assistance</a>
    </div>
  }
  else
  {
    <!-- FILTER -->
    <div class="filter-bar" style="margin-bottom:16px;">
      @foreach (var f in new[]{"All","Active","Fulfilled","Closed"})
      { <button class="filter-chip @(_filter == f ? "active" : "")" @onclick="() => _filter = f">@f</button> }
    </div>

    <!-- REQUEST CARDS -->
    @foreach (var req in Filtered)
    {
      var isPast = req.Status is "Fulfilled" or "Shipped" or "Cancelled";
      <div class="panel" style="margin-bottom:16px;@(isPast ? "opacity:.8;" : "")">
        <div style="padding:16px 20px;display:flex;justify-content:space-between;align-items:flex-start;border-bottom:1px solid var(--border);">
          <div>
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
              <span style="font-weight:700;font-size:.95rem;color:var(--navy);">@req.Category Assistance</span>
              <span class="badge @GetStatusBadge(req.Status)" style="font-size:.66rem;">@req.Status</span>
              @if (req.Priority == "Urgent")
              { <span class="badge badge-overdue" style="font-size:.66rem;">Urgent</span> }
            </div>
            <div style="font-size:.82rem;color:var(--text-mid);">
              Submitted @req.CreatedAt.ToString("MMM d, yyyy")
              @if (req.DueDate.HasValue)
              { <span style="margin-left:8px;">&#128197; Due @req.DueDate.Value.ToString("MMM d")</span> }
            </div>
          </div>
          <a href="/my-requests/@req.Id" class="btn btn-sm">View Details</a>
        </div>
        <div style="padding:14px 20px;">
          <p style="font-size:.84rem;color:var(--text-mid);margin:0 0 12px;line-height:1.5;">@req.Reason.Replace("PrenatalLifeLimiting", "Prenatal Life-Limiting ")</p>
          <!-- PROGRESS TRACK -->
          <div style="display:flex;align-items:center;gap:4px;flex-wrap:wrap;">
            @foreach (var (label, active, done) in GetSteps(req.Status))
            {
              <div style="display:flex;align-items:center;gap:4px;">
                <div style="padding:3px 10px;border-radius:20px;font-size:.66rem;font-weight:700;white-space:nowrap;
                  background:@(done ? "var(--green)" : active ? "var(--navy)" : "var(--bg)");
                  color:@(done || active ? "white" : "var(--text-light)");">
                  @(done ? "✓ " : "")@label
                </div>
                @if (label != "Complete")
                { <span style="color:var(--border);font-size:.7rem;">›</span> }
              </div>
            }
          </div>
          @if (!string.IsNullOrEmpty(req.AssignedTo))
          {
            <div style="margin-top:10px;font-size:.78rem;color:var(--text-light);">
              &#129309; Assigned to <strong style="color:var(--navy);">@req.AssignedTo</strong>
            </div>
          }
        </div>
      </div>
    }
  }
</div>

@code {
  [Parameter, SupplyParameterFromQuery] public int? FamilyId { get; set; }

  private List<PublicFamilyRequestDto> _requests = [];
  private bool _loading = true;
  private string _filter = "All";

  private IEnumerable<PublicFamilyRequestDto> Filtered => _requests.Where(r => _filter switch
  {
    "Active"    => r.Status is "New" or "InProgress" or "AwaitingShipment" or "OnHold",
    "Fulfilled" => r.Status is "Fulfilled" or "Shipped",
    "Closed"    => r.Status == "Cancelled",
    _           => true
  }).OrderByDescending(r => r.CreatedAt);

  protected override async Task OnInitializedAsync()
  {
    _loading = true;
    if (FamilyId.HasValue && FamilyId.Value > 0)
      _requests = await Api.GetPublicFamilyRequestsAsync(FamilyId.Value);
    _loading = false;
  }

  private static string GetStatusBadge(string s) => s switch
  {
    "New"              => "badge-new",
    "InProgress"       => "badge-shipped",
    "AwaitingShipment" => "badge-onhold",
    "Shipped"          => "badge-onhold",
    "Fulfilled"        => "badge-delivered",
    "OnHold"           => "badge-onhold",
    "Cancelled"        => "badge-overdue",
    _                  => ""
  };

  private static List<(string Label, bool Active, bool Done)> GetSteps(string s)
  {
    var order = new[] { "New", "InProgress", "AwaitingShipment", "Shipped", "Fulfilled" };
    var idx = Array.IndexOf(order, s);
    if (idx < 0) idx = 0;
    return order.Select((step, i) => (
      Label: step switch
      {
        "New"              => "Received",
        "InProgress"       => "In Progress",
        "AwaitingShipment" => "Packing",
        "Shipped"          => "On Its Way",
        "Fulfilled"        => "Complete",
        _                  => step
      },
      Active: i == idx,
      Done: i < idx
    )).ToList();
  }
}
