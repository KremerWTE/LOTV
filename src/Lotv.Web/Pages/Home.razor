@page "/"
@layout PublicLayout
@inject ApiService Api

<PageTitle>Lily of the Valley Ministry — Home</PageTitle>

<!-- HERO -->
<div style="background:linear-gradient(135deg,var(--navy) 0%,#1a3a6e 100%);color:white;padding:80px 24px 72px;">
  <div style="max-width:720px;margin:0 auto;text-align:center;">
    <div style="font-size:.78rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:14px;">A Catholic Apostolate</div>
    <h1 style="font-family:var(--ff-head);font-size:2.6rem;font-weight:700;line-height:1.2;margin:0 0 18px;">
      You are not alone<br /><span style="color:#a8c8f0;">in your grief.</span>
    </h1>
    <p style="font-size:1.06rem;color:rgba(255,255,255,.82);line-height:1.7;max-width:560px;margin:0 auto 32px;">
      Lily of the Valley Ministry walks alongside families experiencing pregnancy loss, infant loss, and infertility —
      offering comfort packages, prayer, and community rooted in Catholic faith.
    </p>
    <div style="display:flex;justify-content:center;gap:14px;flex-wrap:wrap;">
      <a href="/apply" style="padding:14px 32px;background:var(--green);color:white;border-radius:10px;font-weight:700;font-size:.96rem;text-decoration:none;">Request a Comfort Package</a>
      <a href="/give" style="padding:14px 32px;background:rgba(255,255,255,.12);border:2px solid rgba(255,255,255,.3);color:white;border-radius:10px;font-weight:700;font-size:.96rem;text-decoration:none;">Support Our Mission</a>
    </div>
  </div>
</div>

<!-- IMPACT STRIP -->
<div style="background:white;border-bottom:1px solid var(--border);">
  <div style="max-width:900px;margin:0 auto;padding:32px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:20px;text-align:center;">
    <div>
      <div style="font-family:var(--ff-head);font-size:2rem;font-weight:700;color:var(--green);">@_families+</div>
      <div style="font-size:.78rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Families Served</div>
    </div>
    <div>
      <div style="font-family:var(--ff-head);font-size:2rem;font-weight:700;color:var(--navy);">@_fulfilled+</div>
      <div style="font-size:.78rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Packages Fulfilled</div>
    </div>
    <div>
      <div style="font-family:var(--ff-head);font-size:2rem;font-weight:700;color:var(--amber);">@_volunteers+</div>
      <div style="font-size:.78rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Active Volunteers</div>
    </div>
    <div>
      <div style="font-family:var(--ff-head);font-size:2rem;font-weight:700;color:var(--gold);">@_dioceses+</div>
      <div style="font-size:.78rem;color:var(--text-light);text-transform:uppercase;letter-spacing:.06em;margin-top:2px;">Dioceses Reached</div>
    </div>
  </div>
</div>

<!-- HOW WE HELP -->
<div style="max-width:1000px;margin:60px auto;padding:0 24px;">
  <div style="text-align:center;margin-bottom:40px;">
    <h2 style="font-family:var(--ff-head);font-size:1.8rem;color:var(--navy);margin:0 0 10px;">How We Help</h2>
    <p style="color:var(--text-mid);font-size:.94rem;max-width:520px;margin:0 auto;">
      Whether you are grieving a recent loss or seeking support after years of suffering, we are here for you.
    </p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:22px;">

    <div style="background:white;border-radius:14px;padding:28px 26px;border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,.05);">
      <div style="font-size:2rem;margin-bottom:12px;">&#128149;</div>
      <h3 style="font-family:var(--ff-head);font-size:1.1rem;color:var(--navy);margin:0 0 10px;">Comfort Packages</h3>
      <p style="font-size:.86rem;color:var(--text-mid);line-height:1.65;margin:0 0 18px;">
        Hand-assembled packages with memory items, prayer resources, and a personalized bracelet with your baby's initials.
      </p>
      <a href="/apply" style="font-size:.84rem;font-weight:700;color:var(--green);text-decoration:none;">Request yours &rarr;</a>
    </div>

    <div style="background:white;border-radius:14px;padding:28px 26px;border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,.05);">
      <div style="font-size:2rem;margin-bottom:12px;">&#128591;</div>
      <h3 style="font-family:var(--ff-head);font-size:1.1rem;color:var(--navy);margin:0 0 10px;">Prayer &amp; Community</h3>
      <p style="font-size:.86rem;color:var(--text-mid);line-height:1.65;margin:0 0 18px;">
        Our prayer ambassadors commit to praying for each family by name. You are remembered and loved.
      </p>
      <a href="/volunteer" style="font-size:.84rem;font-weight:700;color:var(--green);text-decoration:none;">Become a prayer ambassador &rarr;</a>
    </div>

    <div style="background:white;border-radius:14px;padding:28px 26px;border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,.05);">
      <div style="font-size:2rem;margin-bottom:12px;">&#9971;</div>
      <h3 style="font-family:var(--ff-head);font-size:1.1rem;color:var(--navy);margin:0 0 10px;">Parish Network</h3>
      <p style="font-size:.86rem;color:var(--text-mid);line-height:1.65;margin:0 0 18px;">
        We partner with parishes across multiple dioceses to ensure every grieving family is reached — regardless of location.
      </p>
      <a href="/give" style="font-size:.84rem;font-weight:700;color:var(--green);text-decoration:none;">Support the network &rarr;</a>
    </div>

  </div>
</div>

<!-- WHO WE SERVE -->
<div style="background:var(--green-pale);padding:56px 24px;">
  <div style="max-width:800px;margin:0 auto;text-align:center;">
    <h2 style="font-family:var(--ff-head);font-size:1.6rem;color:var(--navy);margin:0 0 14px;">Who We Serve</h2>
    <p style="color:var(--text-mid);font-size:.94rem;line-height:1.7;margin:0 0 28px;">
      Our ministry is open to all families regardless of faith background who have experienced:
    </p>
    <div style="display:flex;flex-wrap:wrap;justify-content:center;gap:10px;">
      @foreach (var r in new[]{"Miscarriage","Stillbirth","Prenatal Diagnosis","Prenatal Life-Limiting Diagnosis","Infant Loss","Infertility","Past Loss"})
      {
        <span style="background:white;border:1px solid var(--border);border-radius:20px;padding:8px 18px;font-size:.84rem;font-weight:600;color:var(--navy);">@r</span>
      }
    </div>
    <div style="margin-top:32px;">
      <a href="/apply" style="display:inline-block;padding:14px 36px;background:var(--navy);color:white;border-radius:10px;font-weight:700;font-size:.96rem;text-decoration:none;">Request a Comfort Package</a>
    </div>
  </div>
</div>

<!-- GET INVOLVED -->
<div style="max-width:900px;margin:60px auto 80px;padding:0 24px;">
  <div style="text-align:center;margin-bottom:36px;">
    <h2 style="font-family:var(--ff-head);font-size:1.8rem;color:var(--navy);margin:0 0 10px;">Get Involved</h2>
  </div>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:22px;">
    <div style="background:white;border-radius:14px;padding:32px;border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,.05);text-align:center;">
      <div style="font-size:2.4rem;margin-bottom:12px;">&#128184;</div>
      <h3 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 10px;">Make a Donation</h3>
      <p style="font-size:.86rem;color:var(--text-mid);line-height:1.6;margin:0 0 20px;">Every gift directly funds a comfort package for a grieving family.</p>
      <a href="/give" style="display:inline-block;padding:11px 28px;background:var(--green);color:white;border-radius:8px;font-weight:700;font-size:.88rem;text-decoration:none;">Donate Now</a>
    </div>
    <div style="background:white;border-radius:14px;padding:32px;border:1px solid var(--border);box-shadow:0 2px 12px rgba(0,0,0,.05);text-align:center;">
      <div style="font-size:2.4rem;margin-bottom:12px;">&#129309;</div>
      <h3 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 10px;">Volunteer</h3>
      <p style="font-size:.86rem;color:var(--text-mid);line-height:1.6;margin:0 0 20px;">Assemble packages, pray for families, or serve as a parish liaison.</p>
      <a href="/volunteer" style="display:inline-block;padding:11px 28px;background:var(--navy);color:white;border-radius:8px;font-weight:700;font-size:.88rem;text-decoration:none;">Sign Up</a>
    </div>
  </div>
</div>

@code {
  private int _families;
  private int _fulfilled;
  private int _volunteers;
  private int _dioceses;

  protected override async Task OnInitializedAsync()
  {
    var impact = await Api.GetPublicImpactAsync();
    if (impact is not null)
    {
      _families   = impact.FamiliesServed;
      _fulfilled  = impact.PeopleHelped;
      _volunteers = impact.ActiveVolunteers;
      _dioceses   = impact.DiocesesReached;
    }
  }
}
