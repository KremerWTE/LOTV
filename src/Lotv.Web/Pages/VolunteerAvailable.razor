@page "/volunteer/available"
@inject ApiService Api

<PageTitle>Available Requests — LOTV Volunteer</PageTitle>

<!-- NAV -->
<div style="background:var(--navy);color:white;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;">
  <div style="font-family:var(--ff-head);font-size:1rem;font-weight:700;">LOTV Ministry — Volunteer Portal</div>
  <div style="display:flex;gap:16px;">
    <a href="@($"/volunteer/portal?VolunteerId={VolunteerId}")" style="color:white;font-size:.84rem;text-decoration:none;opacity:.8;">Dashboard</a>
    <a href="@($"/volunteer/available?VolunteerId={VolunteerId}")" style="color:white;font-size:.84rem;text-decoration:none;font-weight:600;">Available Requests</a>
    <a href="@($"/volunteer/my-assignments?VolunteerId={VolunteerId}")" style="color:white;font-size:.84rem;text-decoration:none;opacity:.8;">My Assignments</a>
    <a href="@($"/volunteer/history?VolunteerId={VolunteerId}")" style="color:white;font-size:.84rem;text-decoration:none;opacity:.8;">History</a>
  </div>
</div>

<div style="max-width:900px;margin:0 auto;padding:32px 24px;">

  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <div>
      <h2 style="font-family:var(--ff-head);color:var(--navy);margin:0 0 4px;">Available Requests In Your Chapter</h2>
      <p style="color:var(--text-mid);margin:0;">Unassigned package requests, first come first served</p>
    </div>
  </div>

  @if (VolunteerId is null or 0)
  {
    <div class="panel"><div class="panel-body" style="padding:24px;">Please sign in from your <a href="/volunteer/login" style="color:var(--navy);">volunteer portal link</a> to see requests.</div></div>
  }
  else if (_loading)
  {
    <Loading Message="Loading available requests…" />
  }
  else if (!_requests.Any())
  {
    <div class="panel" style="text-align:center;padding:48px;">
      <div style="font-size:3rem;margin-bottom:12px;">✅</div>
      <h3 style="font-family:var(--ff-head);color:var(--navy);">All Clear!</h3>
      <p style="color:var(--text-mid);">No unassigned requests in your chapter right now. Check back soon.</p>
    </div>
  }
  else
  {
    @if (!string.IsNullOrEmpty(_error))
    { <div style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;margin-bottom:16px;">⚠ @_error</div> }

    <!-- FILTER -->
    <div class="filter-bar" style="margin-bottom:16px;">
      @foreach (var f in new[]{"All","PackageDelivery","PrayerSupport","CounselingReferral","HospitalVisit"})
      { <button class="filter-chip @(_filter == f ? "active" : "")" aria-pressed="@(_filter == f)" @onclick="() => _filter = f">@f</button> }
    </div>

    @foreach (var req in Filtered)
    {
      <div class="panel" style="margin-bottom:14px;">
        <div style="padding:16px 20px;display:flex;justify-content:space-between;align-items:flex-start;gap:12px;">
          <div style="flex:1;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px;">
              <span style="font-weight:700;color:var(--navy);">@req.Category Assistance</span>
              <span style="font-size:.78rem;color:var(--text-mid);">@req.Reason</span>
            </div>
            <div style="font-size:.78rem;color:var(--text-mid);display:flex;gap:12px;flex-wrap:wrap;">
              <span>📅 Submitted @req.CreatedAt.ToString("MMM d, yyyy")</span>
              @if (!string.IsNullOrWhiteSpace(req.City))
              { <span>📍 @req.City, @req.State</span> }
            </div>
          </div>
          <button class="btn btn-primary btn-sm" @onclick="() => AcceptAsync(req)">Accept Request</button>
        </div>
      </div>
    }
  }

  @if (!string.IsNullOrEmpty(_toast))
  {
    <div style="position:fixed;bottom:24px;right:24px;background:var(--green);color:white;border-radius:10px;padding:12px 20px;font-weight:600;box-shadow:0 4px 16px rgba(0,0,0,.2);">
      ✓ @_toast
    </div>
  }
</div>

@code {
  [Parameter, SupplyParameterFromQuery] public int? VolunteerId { get; set; }

  private List<ApiService.VolunteerAvailableDto> _requests = [];
  private bool _loading = true;
  private string _filter = "All";
  private string _toast = "";
  private string _error = "";

  private IEnumerable<ApiService.VolunteerAvailableDto> Filtered =>
    _requests.Where(r => _filter == "All" || r.Category == _filter).OrderBy(r => r.CreatedAt);

  protected override async Task OnInitializedAsync()
  {
    if (VolunteerId is not > 0) { _loading = false; return; }
    _loading = true;
    _requests = await Api.GetVolunteerAvailableAsync(VolunteerId.Value);
    _loading = false;
  }

  private async Task AcceptAsync(ApiService.VolunteerAvailableDto req)
  {
    if (VolunteerId is not > 0) return;
    var (ok, error) = await Api.ClaimVolunteerAssignmentAsync(VolunteerId.Value, req.Id);
    if (!ok) { _error = error ?? "That could not be done — someone may have already claimed it."; return; }
    _error = "";
    _requests.Remove(req);
    _toast = $"Request #{req.Id} accepted! Check My Assignments for next steps.";
    StateHasChanged();
    await Task.Delay(3000);
    _toast = "";
  }
}
