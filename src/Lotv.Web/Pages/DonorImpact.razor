@page "/my-impact"
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>My Impact — LOTV Ministry</PageTitle>

<!-- PUBLIC NAV -->
<div style="background:var(--navy);color:white;padding:14px 32px;display:flex;justify-content:space-between;align-items:center;">
  <div style="display:flex;align-items:center;gap:12px;">
    <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1.1rem;">&#127803;</div>
    <div style="font-family:var(--ff-head);font-size:1rem;font-weight:700;">LOTV Ministry</div>
  </div>
  <div style="display:flex;gap:12px;">
    <a href="/" style="color:white;font-size:.84rem;text-decoration:none;opacity:.85;">Home</a>
    <a href="/give" class="btn btn-sm" style="background:white;color:var(--navy);font-weight:700;">Give Again &#9829;</a>
  </div>
</div>

<!-- HERO -->
<div style="background:linear-gradient(135deg,var(--gold) 0%,#c8962a 100%);color:white;padding:48px 32px;text-align:center;">
  <div style="font-size:2.5rem;margin-bottom:10px;">&#9829;</div>
  <h1 style="font-family:var(--ff-head);font-size:2rem;margin:0 0 8px;">Your Impact</h1>
  <p style="font-size:.95rem;opacity:.9;max-width:540px;margin:0 auto;">See how your generous giving has helped real families through LOTV Ministry</p>
</div>

<div style="max-width:820px;margin:0 auto;padding:36px 24px;">

  @if (_loading)
  {
    <Loading Message="Loading your impact story…" />
  }
  else
  {
    <!-- IMPACT HEADLINE -->
    <div style="text-align:center;margin-bottom:36px;">
      <div style="font-size:3rem;font-family:var(--ff-head);font-weight:800;color:var(--gold);"><Money Amount="@_totalGiven" /></div>
      <div style="font-size:1.1rem;color:var(--navy);font-weight:600;margin:6px 0;">Total contributed to LOTV Ministry</div>
      <p style="color:var(--text-mid);font-size:.88rem;">Thank you for your generosity. Your gifts have helped @_familiesHelped families across @_chaptersServed chapters.</p>
    </div>

    <!-- IMPACT CARDS -->
    <div class="kpi-grid" style="margin-bottom:32px;">
      <div class="kpi-card kpi-gold">
        <div class="kpi-icon">&#128184;</div>
        <div class="kpi-label">Total Given</div>
        <div class="kpi-value" style="color:var(--gold)"><Money Amount="@_totalGiven" /></div>
      </div>
      <div class="kpi-card kpi-navy">
        <div class="kpi-icon">&#127873;</div>
        <div class="kpi-label">Total Gifts</div>
        <div class="kpi-value" style="color:var(--navy)">@_giftCount</div>
      </div>
      <div class="kpi-card kpi-green">
        <div class="kpi-icon">&#127975;</div>
        <div class="kpi-label">Families Helped</div>
        <div class="kpi-value" style="color:var(--green)">@_familiesHelped</div>
      </div>
      <div class="kpi-card kpi-amber">
        <div class="kpi-icon">&#127803;</div>
        <div class="kpi-label">Avg Gift</div>
        <div class="kpi-value" style="color:var(--amber)">@if (_giftCount > 0) { <Money Amount="@(_totalGiven / _giftCount)" /> } else { <text>$0</text> }</div>
      </div>
    </div>

    <!-- WHERE YOUR MONEY WENT -->
    <div class="panel" style="margin-bottom:24px;">
      <div class="panel-header">Where Your Gifts Went</div>
      <div class="panel-body">
        @if (!_categoryBreakdown.Any())
        {
          <p style="color:var(--text-mid);text-align:center;">No allocation breakdown available yet.</p>
        }
        else
        {
          @foreach (var item in _categoryBreakdown)
          {
            var barPct = (int)item.Percentage;
            <div style="margin-bottom:14px;">
              <div style="display:flex;justify-content:space-between;font-size:.84rem;margin-bottom:4px;">
                <span style="font-weight:600;">@item.Category</span>
                <span><Money Amount="@item.Amount" /> &mdash; @item.Percentage.ToString("F0")%</span>
              </div>
              <div style="height:12px;background:var(--bg);border-radius:6px;overflow:hidden;">
                <div style="height:100%;width:@barPct%;background:var(--gold);border-radius:6px;transition:width .3s;"></div>
              </div>
            </div>
          }
        }
      </div>
    </div>

    <!-- DONATION HISTORY -->
    <div class="panel" style="margin-bottom:24px;">
      <div class="panel-header">My Donation History</div>
      <div class="panel-body" style="padding:0;">
        @if (!_donations.Any())
        {
          <div style="text-align:center;padding:24px;color:var(--text-light);">No donations on record.</div>
        }
        else
        {
          <table class="data-table">
            <thead>
              <tr>
                <th>Date</th>
                <th style="text-align:right;">Amount</th>
                <th>Channel</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              @foreach (var d in _donations)
              {
                <tr>
                  <td>@d.Date.ToString("MMM d, yyyy")</td>
                  <td style="text-align:right;font-weight:700;color:var(--gold);"><Money Amount="@d.Amount" /></td>
                  <td>@d.Channel</td>
                  <td><span class="badge badge-delivered" style="font-size:.66rem;">@d.Status</span></td>
                </tr>
              }
            </tbody>
          </table>
        }
      </div>
    </div>

    <!-- THANK YOU + CTA -->
    <div style="background:linear-gradient(135deg,var(--navy) 0%,var(--navy-dark,#0a1628) 100%);color:white;border-radius:14px;padding:28px 32px;text-align:center;">
      <div style="font-size:1.8rem;margin-bottom:10px;">&#127800;</div>
      <h3 style="font-family:var(--ff-head);margin:0 0 8px;">Thank You for Your Generosity</h3>
      <p style="opacity:.85;font-size:.88rem;max-width:500px;margin:0 auto 20px;">Your giving fuels LOTV Ministry's mission to serve families experiencing loss. Every gift is an act of love.</p>
      <a href="/give" class="btn btn-sm" style="background:var(--gold);color:white;font-weight:700;">&#9829; Give Again</a>
    </div>
  }
</div>

@code {
  [Parameter, SupplyParameterFromQuery] public int? DonorId { get; set; }

  private bool _loading = true;
  private decimal _totalGiven;
  private int _giftCount;
  private int _familiesHelped;
  private int _chaptersServed;
  private List<DonorImpactCategoryDto> _categoryBreakdown = [];
  private List<DonorDonationDto> _donations = [];

  protected override async Task OnInitializedAsync()
  {
    _loading = true;

    if (DonorId.HasValue && DonorId.Value > 0)
    {
      var impact = await Api.GetPublicDonorImpactAsync(DonorId.Value);
      if (impact is not null)
      {
        _totalGiven        = impact.TotalGiven;
        _giftCount         = impact.GiftCount;
        _familiesHelped    = impact.FamiliesHelped;
        _chaptersServed    = impact.ChaptersServed;
        _categoryBreakdown = impact.CategoryBreakdown;
        _donations         = impact.DonationHistory;
      }
    }

    _loading = false;
  }
}
