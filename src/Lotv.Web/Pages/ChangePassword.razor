@page "/change-password"
@layout EmptyLayout
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Set Your Password — LOTV Ministry</PageTitle>

<div style="min-height:100vh;background:linear-gradient(135deg,var(--navy) 0%,#1a3a6e 100%);display:flex;align-items:center;justify-content:center;padding:24px;">
  <div style="width:100%;max-width:400px;">

    <!-- LOGO -->
    <div style="text-align:center;margin-bottom:32px;">
      <div style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:2rem;border:3px solid rgba(255,255,255,.3);margin:0 auto 14px;"><img src="images/lily-white.svg" alt="" style="width:68%;height:68%;" /></div>
      <div style="font-family:var(--ff-head);font-size:1.4rem;font-weight:700;color:white;">LOTV Ministry</div>
      <div style="font-size:.78rem;color:rgba(255,255,255,.6);margin-top:4px;letter-spacing:.06em;text-transform:uppercase;">Staff Portal</div>
    </div>

    <!-- CARD -->
    <div style="background:white;border-radius:16px;padding:36px 36px 32px;box-shadow:0 24px 48px rgba(0,0,0,.3);">
      @if (!Auth.IsAuthenticated)
      {
        <p style="text-align:center;color:var(--text-mid);">Please <a href="/login">sign in</a> first.</p>
      }
      else
      {
        <h2 style="font-family:var(--ff-head);font-size:1.2rem;color:var(--navy);margin:0 0 6px;text-align:center;">Set your own password</h2>
        <p style="font-size:.84rem;color:var(--text-light);text-align:center;margin:0 0 24px;">
          You signed in with a temporary password. Choose one only you know before continuing.
        </p>

        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label" for="cp-current">Temporary Password</label>
          <input id="cp-current" class="form-input" type="password" @bind="_current" @bind:event="oninput"
                 autocomplete="current-password" aria-required="true" />
        </div>
        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label" for="cp-new">New Password</label>
          <input id="cp-new" class="form-input" type="password" @bind="_new1" @bind:event="oninput" @onkeydown="OnKeyDown"
                 autocomplete="new-password" aria-required="true" />
          <div style="font-size:.74rem;color:var(--text-light);margin-top:4px;">At least 12 characters, with an uppercase letter, a digit, and a symbol.</div>
        </div>
        <div class="form-group" style="margin-bottom:20px;">
          <label class="form-label" for="cp-new2">Confirm New Password</label>
          <input id="cp-new2" class="form-input" type="password" @bind="_new2" @bind:event="oninput" @onkeydown="OnKeyDown"
                 autocomplete="new-password" aria-required="true" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
          <div role="alert" style="background:#fff3cd;border-radius:8px;padding:10px 14px;font-size:.84rem;color:#856404;margin-bottom:16px;">⚠ @_error</div>
        }

        <button class="btn btn-primary" style="width:100%;padding:12px;" @onclick="SubmitAsync" disabled="@_loading">
          @(_loading ? "Saving…" : "Set Password")
        </button>
      }
    </div>
  </div>
</div>

@code {
  private string _current = "";
  private string _new1 = "";
  private string _new2 = "";
  private string _error = "";
  private bool _loading;

  private void OnKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
  {
    if (e.Key == "Enter") _ = SubmitAsync();
  }

  private async Task SubmitAsync()
  {
    _error = "";
    if (string.IsNullOrWhiteSpace(_current)) { _error = "Enter the temporary password you just signed in with."; return; }
    if (string.IsNullOrWhiteSpace(_new1)) { _error = "Enter a new password."; return; }
    if (_new1 != _new2) { _error = "The two new passwords don't match."; return; }

    _loading = true;
    var (ok, error) = await Auth.ChangePasswordAsync(_current, _new1);
    _loading = false;
    if (!ok) { _error = error ?? "Could not change your password."; return; }

    Nav.NavigateTo(Auth.UserRole == "Volunteer" ? "/admin/prayer-list" : "/admin/dashboard", replace: true);
  }
}
