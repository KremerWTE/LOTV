@inherits LayoutComponentBase
@inject LocalizationService Loc
@implements IDisposable

<div style="min-height:100vh;display:flex;flex-direction:column;background:#f8f9fb;font-family:var(--ff-body);">

  <!-- HEADER -->
  <header style="background:white;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100;">
    <div style="max-width:1080px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
        <div style="width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;">&#127803;</div>
        <div>
          <div style="font-family:var(--ff-head);font-weight:700;font-size:.94rem;color:var(--navy);">Lily of the Valley</div>
          <div style="font-size:.66rem;color:var(--text-light);letter-spacing:.04em;text-transform:uppercase;">@Loc["layout.tagline"]</div>
        </div>
      </a>
      <nav style="display:flex;align-items:center;gap:6px;">
        <a href="/" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">@Loc["nav.home"]</a>
        <a href="/apply" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">@Loc["nav.gethelp"]</a>
        <a href="/give" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">@Loc["nav.donate"]</a>
        <a href="/volunteer" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">@Loc["nav.volunteer"]</a>
        <a href="/events" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">@Loc["nav.events"]</a>
        <a href="/transparency" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">@Loc["nav.impact"]</a>
        <span style="margin-left:8px;"><LanguageSwitcher /></span>
        <a href="/login" style="margin-left:8px;padding:7px 16px;font-size:.82rem;font-weight:700;color:white;background:var(--navy);border-radius:8px;text-decoration:none;">@Loc["nav.staffLogin"]</a>
      </nav>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <main style="flex:1;">
    @Body
  </main>

  <!-- FOOTER -->
  <footer style="background:var(--navy);color:rgba(255,255,255,.7);padding:28px 24px;text-align:center;font-size:.78rem;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="font-weight:700;color:white;font-size:.9rem;margin-bottom:4px;">@Loc["layout.footerTitle"]</div>
      <div style="margin-bottom:10px;">@Loc["layout.footerBlurb"]</div>
      <div style="display:flex;justify-content:center;gap:20px;font-size:.74rem;">
        <a href="/" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.home"]</a>
        <a href="/apply" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.gethelp"]</a>
        <a href="/give" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.donate"]</a>
        <a href="/volunteer" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.volunteer"]</a>
        <a href="/events" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.events"]</a>
        <a href="/transparency" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.impact"]</a>
        <a href="/login" style="color:rgba(255,255,255,.6);text-decoration:none;">@Loc["nav.staffPortal"]</a>
      </div>
      <div style="margin-top:12px;font-size:.7rem;color:rgba(255,255,255,.4);">&copy; @DateTime.UtcNow.Year @Loc["layout.footerCredit"]</div>
    </div>
  </footer>

</div>

@code {
  protected override void OnInitialized() => Loc.OnCultureChanged += Refresh;
  private void Refresh() => InvokeAsync(StateHasChanged);
  public void Dispose() => Loc.OnCultureChanged -= Refresh;
}
