@inherits LayoutComponentBase

<div style="min-height:100vh;display:flex;flex-direction:column;background:#f8f9fb;font-family:var(--ff-body);">

  <!-- HEADER -->
  <header style="background:white;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100;">
    <div style="max-width:1080px;margin:0 auto;padding:0 24px;height:64px;display:flex;align-items:center;justify-content:space-between;">
      <a href="/" style="display:flex;align-items:center;gap:10px;text-decoration:none;">
        <img src="https://lotvministry.org/wp-content/uploads/2023/02/cropped-Lily-of-valley-Final-01-2.jpg"
             alt="LOTV" style="width:36px;height:36px;border-radius:50%;object-fit:cover;" />
        <div>
          <div style="font-family:var(--ff-head);font-weight:700;font-size:.94rem;color:var(--navy);">Lily of the Valley</div>
          <div style="font-size:.66rem;color:var(--text-light);letter-spacing:.04em;text-transform:uppercase;">Catholic Apostolate</div>
        </div>
      </a>
      <nav style="display:flex;align-items:center;gap:6px;">
        <a href="/" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">Home</a>
        <a href="/apply" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">Get Help</a>
        <a href="/give" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">Donate</a>
        <a href="/volunteer" style="padding:7px 14px;font-size:.84rem;font-weight:600;color:var(--text-mid);text-decoration:none;border-radius:7px;" onmouseover="this.style.background='var(--bg)'" onmouseout="this.style.background='transparent'">Volunteer</a>
        <a href="/admin/dashboard" style="margin-left:8px;padding:7px 16px;font-size:.82rem;font-weight:700;color:white;background:var(--navy);border-radius:8px;text-decoration:none;">Staff Login</a>
      </nav>
    </div>
  </header>

  <!-- PAGE CONTENT -->
  <main style="flex:1;">
    @Body
  </main>

  <!-- FOOTER -->
  <footer style="background:var(--navy);color:rgba(255,255,255,.7);padding:28px 24px;text-align:center;font-size:.78rem;">
    <div style="max-width:1080px;margin:0 auto;">
      <div style="font-weight:700;color:white;font-size:.9rem;margin-bottom:4px;">Lily of the Valley Ministry</div>
      <div style="margin-bottom:10px;">A Catholic Apostolate supporting families through pregnancy and infant loss</div>
      <div style="display:flex;justify-content:center;gap:20px;font-size:.74rem;">
        <a href="/" style="color:rgba(255,255,255,.6);text-decoration:none;">Home</a>
        <a href="/apply" style="color:rgba(255,255,255,.6);text-decoration:none;">Get Help</a>
        <a href="/give" style="color:rgba(255,255,255,.6);text-decoration:none;">Donate</a>
        <a href="/volunteer" style="color:rgba(255,255,255,.6);text-decoration:none;">Volunteer</a>
        <a href="/admin/dashboard" style="color:rgba(255,255,255,.6);text-decoration:none;">Staff Portal</a>
      </div>
      <div style="margin-top:12px;font-size:.7rem;color:rgba(255,255,255,.4);">&copy; @DateTime.UtcNow.Year LOTV Catholic Apostolate &bull; Built by WTE Solutions</div>
    </div>
  </footer>

</div>
