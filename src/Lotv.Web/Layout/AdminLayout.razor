@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AuthService Auth
@inject ApiService Api
@inject SignalRService Hub
@implements IDisposable

<div class="lotv-app @(_sidebarCollapsed ? "sidebar-collapsed" : "")">

  <!-- MOBILE SIDEBAR BACKDROP -->
  @if (_sidebarOpen)
  {
    <div class="sidebar-backdrop open" @onclick="CloseSidebar"></div>
  }

  <!-- SIDEBAR -->
  <aside class="sidebar @(_sidebarOpen ? "open" : "")" role="navigation" aria-label="Main navigation" @onclick:stopPropagation="true">
    <div class="sidebar-logo">
      <div style="width:34px;height:34px;border-radius:50%;background:linear-gradient(135deg,var(--green),var(--green-dark));display:flex;align-items:center;justify-content:center;font-size:1rem;flex-shrink:0;">&#127803;</div>
      <div class="sidebar-logo-text">
        <strong>LOTV Ministry</strong>
        <span>Staff Portal &bull; Catholic Apostolate</span>
      </div>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-label">Overview</div>
      <NavLink class="sidebar-link" href="/admin/dashboard" Match="NavLinkMatch.All">
        <span class="icon">&#9776;</span> Dashboard
      </NavLink>
      @if (Auth.IsHqAdmin)
      {
        <NavLink class="sidebar-link" href="/admin/hq">
          <span class="icon">&#127968;</span> HQ Dashboard
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/hq-board">
          <span class="icon">&#9783;</span> HQ Operations Board
        </NavLink>
      }
      @if (_canSeeCases)
      {
        <NavLink class="sidebar-link" href="/admin/families">
          <span class="icon">&#128101;</span> Families
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/cases">
          <span class="icon">&#128149;</span> Cases
          <span class="sidebar-badge">@_openCount</span>
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/kanban">
          <span class="icon">&#9783;</span> Kanban Board
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/queue">
          <span class="icon">&#128282;</span> Unassigned Queue
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/my-queue">
          <span class="icon">&#128203;</span> My Work Queue
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/workload">
          <span class="icon">&#128101;</span> Workload View
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/cases/new">
          <span class="icon">&#43;</span> New Case
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/cases/overdue">
          <span class="icon">&#128680;</span> Overdue Cases
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/cases/bulk">
          <span class="icon">&#9999;</span> Bulk Update
        </NavLink>
      }
    </div>

    @if (_canSeeDonations)
    {
      <div class="sidebar-section">
        <div class="sidebar-section-label">Donations</div>
        <NavLink class="sidebar-link" href="/admin/donations">
          <span class="icon">&#128184;</span> All Donations
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/by-donor">
          <span class="icon">&#128100;</span> By Donor
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/by-diocese">
          <span class="icon">&#9961;</span> By Diocese
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/by-channel">
          <span class="icon">&#128243;</span> By Channel
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/by-city">
          <span class="icon">&#127970;</span> By City
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/by-amount">
          <span class="icon">&#128202;</span> By Amount
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/allocations">
          <span class="icon">&#128203;</span> Fund Allocations
          <span class="sidebar-badge">@_pendingAlloc</span>
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/allocations/review">
          <span class="icon">&#9989;</span> Allocation Review
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/allocate/money">
          <span class="icon">&#128184;</span> Allocate Funds
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/allocate/resources">
          <span class="icon">&#128230;</span> Allocate Resources
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/year-end">
          <span class="icon">&#128190;</span> Year-End Giving
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/donors/retention">
          <span class="icon">&#128260;</span> Donor Retention
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/donors/segments">
          <span class="icon">&#127942;</span> Donor Segments
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/donors/outreach">
          <span class="icon">&#128140;</span> Outreach Queue
        </NavLink>
      </div>
    }

    <div class="sidebar-section">
      <div class="sidebar-section-label">People</div>
      @if (_canSeeVolunteers)
      {
        <NavLink class="sidebar-link" href="/admin/volunteers">
          <span class="icon">&#129309;</span> Volunteers
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/volunteer-schedule">
          <span class="icon">&#128197;</span> Schedule
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/volunteer-certifications">
          <span class="icon">&#128203;</span> Certifications
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/volunteer-skills">
          <span class="icon">&#127979;</span> Skill Directory
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/volunteers/pending">
          <span class="icon">&#9203;</span> Pending Onboarding
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/volunteers/reactivation">
          <span class="icon">&#9654;</span> Reactivation Queue
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/sponsorships">
          <span class="icon">&#127970;</span> Sponsorships
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/events">
          <span class="icon">&#127880;</span> Events
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/events/summary">
          <span class="icon">&#128202;</span> Event Summary
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/sponsors/report">
          <span class="icon">&#127970;</span> Sponsors Report
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/wishlist/analytics">
          <span class="icon">&#128230;</span> Wish List Analytics
        </NavLink>
      }
      @if (_canSeeDonations)
      {
        <NavLink class="sidebar-link" href="/admin/donors">
          <span class="icon">&#127873;</span> Donors Database
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/pledges">
          <span class="icon">&#129309;</span> Pledges
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/recurring">
          <span class="icon">&#128260;</span> Recurring
        </NavLink>
      }
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-label">Retreats</div>
      <NavLink class="sidebar-link" href="/admin/retreats" Match="NavLinkMatch.All">
        <span class="icon">&#9670;</span> Retreat Manager
      </NavLink>
    </div>

    <div class="sidebar-section">
      <div class="sidebar-section-label">Admin</div>
      <NavLink class="sidebar-link" href="/admin/notify">
        <span class="icon">&#128140;</span> Send Notification
      </NavLink>
      <NavLink class="sidebar-link" href="/admin/marketing">
        <span class="icon">&#128233;</span> Marketing Email
      </NavLink>
      <NavLink class="sidebar-link" href="/admin/impact">
        <span class="icon">&#128200;</span> Impact Dashboard
      </NavLink>
      @if (_canSeeDonations)
      {
        <NavLink class="sidebar-link" href="/admin/reconciliation">
          <span class="icon">&#128290;</span> Reconciliation
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/export">
          <span class="icon">&#128190;</span> Export Data
        </NavLink>
      }
      @if (Auth.IsHqAdmin)
      {
        <NavLink class="sidebar-link" href="/admin/reports/schedule">
          <span class="icon">&#128336;</span> Scheduled Reports
        </NavLink>
      }
      @if (_isAdmin)
      {
        <NavLink class="sidebar-link" href="/admin/audit">
          <span class="icon">&#128269;</span> Audit Log
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/diocese-data">
          <span class="icon">&#127760;</span> Diocese &amp; Parish Data
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/health">
          <span class="icon">&#128268;</span> Platform Health
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/settings">
          <span class="icon">&#9881;</span> Settings
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/users">
          <span class="icon">&#128274;</span> User Management
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/push-subscriptions">
          <span class="icon">&#128276;</span> Push Subscriptions
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/migrations">
          <span class="icon">&#128203;</span> DB Migrations
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/webhooks">
          <span class="icon">&#128231;</span> Webhook Events
          @if (_webhook24h > 0) { <span class="sidebar-badge">@_webhook24h</span> }
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/chapters">
          <span class="icon">&#127968;</span> Chapters
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/chapter-analytics">
          <span class="icon">&#128202;</span> Chapter Analytics
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/grants">
          <span class="icon">&#128179;</span> Grants
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/notification-prefs">
          <span class="icon">&#128276;</span> Notification Prefs
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/campaigns">
          <span class="icon">&#127919;</span> Campaigns
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/pledge-renewals">
          <span class="icon">&#128197;</span> Pledge Renewals
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/staff-tasks">
          <span class="icon">&#128203;</span> Staff Tasks
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/announcements">
          <span class="icon">&#128226;</span> Announcements
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/financial">
          <span class="icon">&#128200;</span> Financial Overview
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/inventory">
          <span class="icon">&#128230;</span> Inventory
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/sms-log">
          <span class="icon">&#128241;</span> SMS Log
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/expenses">
          <span class="icon">&#129534;</span> Expenses
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/budget">
          <span class="icon">&#128176;</span> Budget Summary
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/api-keys">
          <span class="icon">&#128272;</span> API Keys
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/resources/flow">
          <span class="icon">&#128200;</span> Resource Flow
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/reports/history">
          <span class="icon">&#128203;</span> Report History
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/chapters/health">
          <span class="icon">&#128200;</span> Chapter Health
        </NavLink>
        <NavLink class="sidebar-link" href="/admin/grants/calendar">
          <span class="icon">&#128197;</span> Grants Calendar
        </NavLink>
      }
    </div>

    <div class="sidebar-footer">
      LOTV Catholic Apostolate &bull; v1.0 &bull; WTE Solutions
    </div>
  </aside>

  <!-- MAIN -->
  <div class="lotv-main">

    <!-- TOPBAR -->
    <div class="topbar">
      <div class="topbar-left">
        <!-- Mobile hamburger toggle -->
        <button class="sidebar-toggle" @onclick="ToggleSidebar" aria-label="Open navigation menu" aria-expanded="@_sidebarOpen">
          &#9776;
        </button>
        <div class="topbar-title">@_pageTitle</div>
        <div class="topbar-breadcrumb">LOTV Staff Portal</div>
      </div>
      <div class="topbar-right">

        <!-- GLOBAL SEARCH -->
        <div style="position:relative;" role="search">
          <input class="topbar-search" type="search" placeholder="&#128269; Search families, donors..."
                 aria-label="Search families, donors, and volunteers"
                 value="@_searchText"
                 @oninput='async e => await OnSearchChanged(e.Value?.ToString() ?? string.Empty)'
                 @onfocus="() => _searchOpen = true"
                 @onblur="HideSearch" />
          @if (_searchOpen && !string.IsNullOrWhiteSpace(_searchText) && _searchText.Length >= 2)
          {
            <div style="position:absolute;top:calc(100% + 6px);left:0;right:0;background:white;border:1px solid var(--border);border-radius:10px;box-shadow:0 8px 24px rgba(0,0,0,.15);z-index:900;overflow:hidden;min-width:320px;">
              @if (_searchFamilies.Any())
              {
                <div style="padding:6px 12px;font-size:.66rem;font-weight:700;text-transform:uppercase;color:var(--text-light);background:var(--bg);border-bottom:1px solid var(--border);">Families</div>
                @foreach (var f in _searchFamilies.Take(4))
                {
                  <div style="padding:9px 14px;cursor:pointer;font-size:.84rem;border-bottom:1px solid var(--border);"
                       @onmousedown='() => GoTo($"/admin/families?family={f.Id}")'>
                    <strong>@f.FullName</strong>
                    <span style="font-size:.74rem;color:var(--text-light);margin-left:6px;">@f.Reason &bull; @f.City</span>
                  </div>
                }
              }
              @if (_searchDonors.Any())
              {
                <div style="padding:6px 12px;font-size:.66rem;font-weight:700;text-transform:uppercase;color:var(--text-light);background:var(--bg);border-bottom:1px solid var(--border);">Donors</div>
                @foreach (var d in _searchDonors.Take(4))
                {
                  <div style="padding:9px 14px;cursor:pointer;font-size:.84rem;border-bottom:1px solid var(--border);"
                       @onmousedown='() => GoTo($"/admin/donors?donor={d.Id}")'>
                    <strong>@d.FullName</strong>
                    <span style="font-size:.74rem;color:var(--text-light);margin-left:6px;">@d.Email &bull; @d.TotalGiven.ToString("C0")</span>
                  </div>
                }
              }
              @if (_searchVolunteers.Any())
              {
                <div style="padding:6px 12px;font-size:.66rem;font-weight:700;text-transform:uppercase;color:var(--text-light);background:var(--bg);border-bottom:1px solid var(--border);">Volunteers</div>
                @foreach (var v in _searchVolunteers.Take(3))
                {
                  <div style="padding:9px 14px;cursor:pointer;font-size:.84rem;border-bottom:1px solid var(--border);"
                       @onmousedown='() => GoTo($"/admin/volunteers?q={Uri.EscapeDataString(v.FullName)}")'>
                    <strong>@v.FullName</strong>
                    <span style="font-size:.74rem;color:var(--text-light);margin-left:6px;">@v.Role &bull; @(v.Status)</span>
                  </div>
                }
              }
              @if (!_searchFamilies.Any() && !_searchDonors.Any() && !_searchVolunteers.Any())
              {
                <div style="padding:14px;font-size:.84rem;color:var(--text-light);text-align:center;">No results for &ldquo;@_searchText&rdquo;</div>
              }
            </div>
          }
        </div>

        <!-- NOTIFICATIONS -->
        <div style="position:relative;">
          <div class="notif-btn" role="button" tabindex="0"
               aria-label="@(_notifCount > 0 ? $"Notifications, {_notifCount} unread" : "Notifications")"
               aria-expanded="@_notifOpen"
               @onclick="() => _notifOpen = !_notifOpen"
               @onkeydown='e => { if (e.Key == "Enter" || e.Key == " ") _notifOpen = !_notifOpen; }'
               style="cursor:pointer;">
            &#128276;
            @if (_notifCount > 0)
            { <div class="notif-dot" aria-hidden="true">@(_notifCount > 9 ? "9+" : _notifCount.ToString())</div> }
          </div>
          @if (_notifOpen)
          {
            <div style="position:fixed;inset:0;z-index:799;" @onclick="() => _notifOpen = false"></div>
            <div style="position:absolute;top:calc(100% + 8px);right:0;width:340px;background:white;border:1px solid var(--border);border-radius:12px;box-shadow:0 8px 28px rgba(0,0,0,.15);z-index:800;overflow:hidden;">
              <div style="padding:12px 16px;border-bottom:1px solid var(--border);font-weight:700;font-size:.88rem;display:flex;justify-content:space-between;align-items:center;">
                <span>Notifications</span>
                @if (_notifCount > 0)
                { <span style="font-size:.72rem;color:var(--text-light);">@_notifCount unresolved</span> }
              </div>
              @if (_overdueItems.Any())
              {
                <div style="padding:8px 16px 4px;font-size:.68rem;font-weight:700;text-transform:uppercase;color:var(--amber);">Overdue Cases</div>
                @foreach (var r in _overdueItems.Take(5))
                {
                  <a href="/admin/cases" style="display:flex;gap:10px;padding:8px 16px;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;" @onclick="() => _notifOpen = false">
                    <span style="font-size:1rem;">&#9888;</span>
                    <div>
                      <div style="font-size:.82rem;font-weight:600;">Case #@r.Id &mdash; @(r.Family?.Parent1LastName ?? "Family")</div>
                      <div style="font-size:.72rem;color:var(--text-light);">@(r.AssignedTo ?? "Unassigned") &bull; @GetNotifAge(r.CreatedAt) overdue</div>
                    </div>
                  </a>
                }
              }
              @if (_pendingAllocItems.Any())
              {
                <div style="padding:8px 16px 4px;font-size:.68rem;font-weight:700;text-transform:uppercase;color:var(--navy);">Pending Allocations</div>
                @foreach (var a in _pendingAllocItems.Take(3))
                {
                  <a href="/admin/allocations" style="display:flex;gap:10px;padding:8px 16px;border-bottom:1px solid var(--border);text-decoration:none;color:inherit;" @onclick="() => _notifOpen = false">
                    <span style="font-size:1rem;">&#128197;</span>
                    <div>
                      <div style="font-size:.82rem;font-weight:600;">@a.Amount.ToString("C0") &rarr; @a.AllocatedTo</div>
                      <div style="font-size:.72rem;color:var(--text-light);">Awaiting approval</div>
                    </div>
                  </a>
                }
              }
              @if (_notifCount == 0)
              {
                <div style="padding:20px;text-align:center;font-size:.84rem;color:var(--text-light);">&#10003; All clear — no pending actions</div>
              }
              <div style="padding:10px 16px;background:var(--bg);text-align:center;">
                <a href="/admin/audit" style="font-size:.78rem;color:var(--green);font-weight:600;text-decoration:none;" @onclick="() => _notifOpen = false">View Full Audit Log &rarr;</a>
              </div>
            </div>
          }
        </div>

        <button type="button" @onclick="OpenCmdK" aria-label="Open command palette"
                title="Open command palette (Ctrl+K)"
                style="background:transparent;border:1px solid var(--border);border-radius:7px;padding:5px 10px;cursor:pointer;font-size:.74rem;color:var(--text-mid);margin-right:8px;font-family:monospace;">
          ⌘K
        </button>
        <button type="button" @onclick="ToggleSidebarCollapse"
                aria-label="@(_sidebarCollapsed ? "Expand sidebar" : "Collapse sidebar")"
                style="background:transparent;border:1px solid var(--border);border-radius:7px;padding:6px 10px;cursor:pointer;font-size:.95rem;color:var(--text-mid);margin-right:8px;">
          @(_sidebarCollapsed ? "»" : "«")
        </button>
        @if (_pendingMigrations > 0 && _isAdmin)
        {
          <a href="/admin/migrations" title="@_pendingMigrations pending migration(s)"
             style="background:#fef3c7;color:#92400e;border:1px solid #fde68a;border-radius:7px;padding:5px 10px;font-size:.74rem;font-weight:700;text-decoration:none;margin-right:8px;">
            &#9888; @_pendingMigrations migration@(_pendingMigrations != 1 ? "s" : "")
          </a>
        }
        <button type="button" @onclick="ToggleTheme" aria-label="Toggle dark mode"
                style="background:transparent;border:1px solid var(--border);border-radius:7px;padding:6px 10px;cursor:pointer;font-size:.95rem;color:var(--text-mid);margin-right:8px;">
          @(_dark ? "☀" : "🌙")
        </button>
        <span style="margin-right:8px;"><LanguageSwitcher /></span>
        <span style="margin-right:8px;"><CurrencySwitcher /></span>

        <div class="user-pill" style="gap:8px;">
          @if (!string.IsNullOrEmpty(Auth.UserAvatarUrl))
          {
            <img src="@Auth.UserAvatarUrl" alt="" class="user-avatar" style="object-fit:cover;" />
          }
          else
          {
            <div class="user-avatar">@Auth.UserInitials</div>
          }
          <div>
            <div style="font-size:.82rem;font-weight:600;line-height:1.2;">@Auth.UserName</div>
            <div style="font-size:.68rem;color:var(--text-light);line-height:1;">@Auth.UserRole</div>
          </div>
          <button style="background:none;border:none;cursor:pointer;padding:2px 6px;font-size:.76rem;color:var(--text-light);border-radius:5px;"
                  title="Sign out" aria-label="Sign out" @onclick="Logout">&#x2715;</button>
        </div>
      </div>
    </div>

    <!-- DEMO BANNER -->
    @if (_showDemoBanner)
    {
      <div style="background:#fffbeb;border-bottom:1px solid #fde68a;padding:7px 24px;display:flex;align-items:center;justify-content:space-between;font-size:.78rem;color:#92400e;">
        <span>&#9888; <strong>Demo mode</strong> — all data is in-memory and resets on page refresh. No real data is stored.</span>
        <button style="background:none;border:none;cursor:pointer;color:#92400e;font-size:.8rem;padding:2px 6px;" @onclick='() => _showDemoBanner = false'>Dismiss</button>
      </div>
    }

    <!-- PAGE CONTENT -->
    <div class="lotv-content">
      @Body
    </div>

  </div>
</div>

<ToastNotification />
<CommandPalette @ref="_cmdK" />

@inject IJSRuntime JS

@code {
  private int _openCount;
  private int _pendingAlloc;
  private string _pageTitle = "Dashboard Overview";
  private bool _dark;
  private bool _sidebarCollapsed;
  private int _pendingMigrations;
  private int _webhook24h;

  private bool _showDemoBanner = false;

  // Mobile sidebar state
  private bool _sidebarOpen;
  private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;
  private void CloseSidebar()  => _sidebarOpen = false;

  // Role-based visibility (matches UserRole enum in Lotv.Core)
  private bool _isAdmin          => Auth.UserRole is "HQAdmin" or "ChapterAdmin";
  private bool _canSeeCases      => Auth.UserRole is "HQAdmin" or "ChapterAdmin" or "ChapterStaff" or "Volunteer";
  private bool _canSeeDonations  => Auth.UserRole is "HQAdmin" or "ChapterAdmin";
  private bool _canSeeVolunteers => Auth.UserRole is "HQAdmin" or "ChapterAdmin" or "ChapterStaff";

  // Search
  private string _searchText = "";
  private bool _searchOpen;
  private List<Family>    _searchFamilies   = [];
  private List<Donor>     _searchDonors     = [];
  private List<Volunteer> _searchVolunteers = [];

  // Notifications
  private bool _notifOpen;
  private int _notifCount;
  private List<PackageRequest> _overdueItems     = [];
  private List<FundAllocation> _pendingAllocItems = [];

  protected override async Task OnInitializedAsync()
  {
    if (!Auth.IsAuthenticated)
    {
      Nav.NavigateTo("/login", replace: true);
      return;
    }

    await LoadNotificationsAsync();
    await Hub.ConnectAsync();

    Hub.OnReconnected += async () =>
    {
      await LoadNotificationsAsync();
      await InvokeAsync(StateHasChanged);
    };
    Hub.OnCaseCreated += async (_, _, _) => { await LoadNotificationsAsync(); await InvokeAsync(StateHasChanged); };
    Hub.OnCaseEscalated += async (_, _) => { await LoadNotificationsAsync(); await InvokeAsync(StateHasChanged); };

    Auth.OnChange += StateHasChanged;
    Nav.LocationChanged += (_, _) => { UpdateTitle(); CloseSidebar(); InvokeAsync(StateHasChanged); };
    UpdateTitle();

    try { _dark = (await JS.InvokeAsync<string>("lotvTheme.get")) == "dark"; } catch { }
    try { _sidebarCollapsed = (await JS.InvokeAsync<string?>("localStorage.getItem", "lotv.sidebar")) == "collapsed"; } catch { }
    try { await JS.InvokeVoidAsync("lotvScrollShadow.attach"); } catch { }
    try { await JS.InvokeVoidAsync("lotvSlashSearch.attach"); } catch { }
    Nav.LocationChanged += async (_, _) => { try { await JS.InvokeVoidAsync("lotvAutoLoad.attach"); } catch { } };
    _ = Auth.RefreshAvatarAsync();

    if (_isAdmin)
    {
      try
      {
        var diag = await Api.GetDiagnosticsAsync();
        if (diag is not null)
        {
          _pendingMigrations = diag.PendingMigrations;
          _webhook24h        = diag.WebhookEvents24h;
        }
      }
      catch { }
    }
  }

  private async Task ToggleTheme()
  {
    _dark = !_dark;
    try { await JS.InvokeVoidAsync("lotvTheme.set", _dark ? "dark" : "light"); } catch { }
  }

  private CommandPalette? _cmdK;
  private void OpenCmdK() => _cmdK?.Open();

  private async Task ToggleSidebarCollapse()
  {
    _sidebarCollapsed = !_sidebarCollapsed;
    try { await JS.InvokeVoidAsync("localStorage.setItem", "lotv.sidebar", _sidebarCollapsed ? "collapsed" : "expanded"); } catch { }
  }

  private async Task LoadNotificationsAsync()
  {
    var stats = await Api.GetDashboardStatsAsync();
    _openCount    = stats?.OpenCases ?? 0;
    _pendingAlloc = stats?.Overdue ?? 0;

    _overdueItems      = await Api.GetOverdueRequestsAsync();
    _pendingAllocItems = await Api.GetAllocationsAsync("PendingReview");
    _notifCount        = _overdueItems.Count + _pendingAllocItems.Count;
  }

  private async Task Logout()
  {
    await Auth.LogoutAsync();
    Nav.NavigateTo("/login", replace: true);
  }

  public void Dispose()
  {
    Auth.OnChange -= StateHasChanged;
    _ = Hub.DisconnectAsync();
  }

  private async Task OnSearchChanged(string text)
  {
    _searchText = text;
    if (text.Length < 2) { _searchFamilies = []; _searchDonors = []; _searchVolunteers = []; return; }
    var families   = await Api.GetFamiliesAsync(text);
    var donors     = await Api.GetDonorsAsync(text);
    var volunteers = await Api.GetVolunteersAsync();
    _searchFamilies   = families.Take(4).ToList();
    _searchDonors     = donors.Take(4).ToList();
    _searchVolunteers = volunteers
      .Where(v => v.FullName.Contains(text, StringComparison.OrdinalIgnoreCase))
      .Take(3).ToList();
  }

  private async Task HideSearch()
  {
    await Task.Delay(150); // let onmousedown fire first
    _searchOpen = false;
  }

  private void GoTo(string url)
  {
    _searchOpen = false;
    _searchText = "";
    Nav.NavigateTo(url);
  }

  private static string GetNotifAge(DateTime dt)
  {
    var d = (int)(DateTime.UtcNow - dt).TotalDays;
    return $"{d}d";
  }

