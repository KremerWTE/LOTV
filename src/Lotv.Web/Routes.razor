@if (_ready)
{
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Routes).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Page Not Found — LOTV</PageTitle>
                <LayoutView Layout="@typeof(PublicLayout)">
                    <div style="max-width:520px;margin:100px auto;padding:0 24px;text-align:center;">
                      <div style="font-size:4rem;font-weight:700;color:var(--navy);font-family:var(--ff-head);opacity:.15;margin-bottom:8px;">404</div>
                      <h2 style="font-family:var(--ff-head);font-size:1.6rem;color:var(--navy);margin:0 0 12px;">Page not found</h2>
                      <p style="color:var(--text-mid);font-size:.94rem;line-height:1.7;margin:0 0 28px;">
                        The page you're looking for doesn't exist or may have moved.
                      </p>
                      <div style="display:flex;justify-content:center;gap:12px;">
                        <a href="/" style="padding:11px 24px;background:var(--navy);color:white;border-radius:8px;font-weight:700;font-size:.88rem;text-decoration:none;">Go Home</a>
                        <a href="/admin/dashboard" style="padding:11px 24px;background:var(--green);color:white;border-radius:8px;font-weight:700;font-size:.88rem;text-decoration:none;">Staff Portal</a>
                      </div>
                    </div>
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    // Runs once per circuit (Blazor Server's per-user equivalent of the old
    // WASM host's one-time startup) - restores the JWT session and user
    // prefs before the router's first render.
    //
    // Gating the whole <Router> behind _ready matters: unlike the old WASM
    // Program.cs (where `await ...TryRestoreSessionAsync()` ran before
    // host.RunAsync() even started the app), this component's own markup -
    // including <AuthorizeRouteView> - gets created on Blazor's FIRST render
    // pass, before OnInitializedAsync's awaits resolve. Without this guard,
    // AuthorizeRouteView evaluates against JwtAuthStateProvider's default
    // anonymous state and redirects to /login before the session restore
    // (which reads the refresh token from sessionStorage) has a chance to
    // run - confirmed live: a hard reload of a protected route bounced to
    // login every time until this guard was added.
    [Inject] private AuthService Auth { get; set; } = default!;
    [Inject] private LocalizationService Localization { get; set; } = default!;
    [Inject] private CurrencyService Currency { get; set; } = default!;

    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        await Auth.TryRestoreSessionAsync();
        await Localization.InitializeAsync();
        await Currency.InitializeAsync();
        _ready = true;
    }
}
