<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Holds SQL-Server-specific EF Core migrations only. The main Migrations/
    folder in Lotv.Api was scaffolded while the active provider was SQLite,
    so its Up() methods bake in SQLite column types (e.g. type: "TEXT") that
    don't produce correct DDL against SQL Server. EF Core's supported fix for
    running the same DbContext against multiple providers is a separate
    migrations assembly per provider (see Program.cs's UseSqlServer(...
    MigrationsAssembly(...)) call) - this project is that assembly.
  -->

  <!--
    Transitive vulnerability overrides.
    Microsoft.OpenApi: same 2.x lock as Lotv.Api — cannot upgrade to 3.x. CVE GHSA-v5pm-xwqc-g5wc suppressed.
    System.Security.Cryptography.Xml: bumped to 10.0.12 which patches all known CVEs.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.OpenApi" Version="2.1.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v5pm-xwqc-g5wc" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lotv.Api\Lotv.Api.csproj" />
  </ItemGroup>

</Project>
