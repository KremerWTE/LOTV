    { "id": "husband-email", "key": "husbandEmail", "type": "email", "label": "Husband's Email", "required": true, "visible": true, "width": "half", "standard": true },
    { "id": "wife-email", "key": "wifeEmail", "type": "email", "label": "Wife's Email", "required": true, "visible": true, "width": "half", "standard": true },
    { "id": "husband-phone", "key": "husbandPhone", "type": "tel", "label": "Husband's Phone", "visible": true, "width": "half", "standard": true },
    { "id": "wife-phone", "key": "wifePhone", "type": "tel", "label": "Wife's Phone", "visible": true, "width": "half", "standard": true },
    { "id": "phone-hint", "key": "", "type": "hint", "label": "Phone numbers are optional.", "visible": true, "width": "full" },
