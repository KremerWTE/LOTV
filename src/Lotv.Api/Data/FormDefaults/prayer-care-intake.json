        { "value": "Infertility", "label": "Infertility" },
        { "value": "PrenatalDiagnosis", "label": "Prenatal Diagnosis" },
        { "value": "Miscarriage", "label": "Miscarriage (before 20 weeks)" },
        { "value": "Stillbirth", "label": "Stillbirth (20 weeks or later)" },
        { "value": "InfantLoss", "label": "Infant Loss (after birth, up to age 1)" },
        { "value": "PostnatalMedical", "label": "Postnatal Medical Concern" }
      ]
    },
    {
      "id": "date-of-loss", "key": "dateOfLoss", "type": "date", "label": "Date of Recent Loss",
      "visible": true, "width": "full", "standard": true,
      "showWhen": [ { "field": "reason", "in": [ "Miscarriage", "Stillbirth", "InfantLoss" ] } ]
