        { "value": "Catholic", "label": "Catholic" }, { "value": "Christian", "label": "Christian" },
        { "value": "Jewish", "label": "Jewish" }, { "value": "Muslim", "label": "Muslim" },
        { "value": "Others", "label": "Others" }, { "value": "Prefer Not to Say", "label": "Prefer Not to Say" }
      ],
      "showWhen": [ { "field": "reason", "notEmpty": true } ]
    },
    {
      "id": "diocese", "key": "diocese", "type": "text", "label": "Diocese",
      "visible": true, "width": "half", "standard": true,
      "showWhen": [ { "field": "faithTradition", "in": [ "Catholic" ] } ]
    },
    {
      "id": "parish", "key": "parish", "type": "text", "label": "Parish",
      "visible": true, "width": "half", "standard": true,
      "showWhen": [ { "field": "faithTradition", "in": [ "Catholic" ] } ]
    },

    {
      "id": "how-heard", "key": "howHeard", "type": "select", "label": "How did you hear about us?",
      "required": true, "visible": true, "width": "full", "standard": true,
      "options": [
        { "value": "Friend", "label": "Friend" }, { "value": "Family", "label": "Family" },
        { "value": "Instagram", "label": "Instagram" }, { "value": "Facebook", "label": "Facebook" },
        { "value": "Google Search", "label": "Google Search" }, { "value": "Medical Provider", "label": "Medical Provider" },
        { "value": "Parish Website", "label": "Parish Website" }, { "value": "Diocese's Website", "label": "Diocese's Website" },
        { "value": "Lily of the Valley Event", "label": "Lily of the Valley Event" }, { "value": "Other", "label": "Other" }
      ]
    },
    {
      "id": "how-heard-other", "key": "howHeardOther", "type": "text", "label": "Tell us more", "placeholder": "Please tell us more...",
      "visible": true, "width": "full", "standard": true,
      "showWhen": [ { "field": "howHeard", "in": [ "Other" ] } ]
    },

    {
      "id": "custom-message", "key": "customMessage", "type": "textarea", "label": "Include a custom message to your recipient",
      "visible": true, "width": "full", "standard": true,
      "showWhen": [ { "branch": "someone" } ]
    },
    {
      "id": "story", "key": "story", "type": "textarea",
      "label": "Please share with us, as much as you're comfortable, your story:",
      "labelMe": "Please share with us, as much as you're comfortable, your story:",
      "labelSomeone": "Please share with us, as much as you're comfortable, your recipient's story:",
      "visible": true, "width": "full", "standard": true
    },

    {
      "id": "bracelet", "key": "childrenInitials", "type": "bracelet", "required": true, "visible": true, "width": "full", "standard": true,
      "label": "Children for Bracelet: We would like to include a personalized bracelet in your Prayer Care Package. Please share the initials of all your children in birth order, including those in heaven. If your child was not named or if you're experiencing infertility, we will place special Heart beads on your bracelet.",
      "labelMe": "Children for Bracelet: We would like to include a personalized bracelet in your Prayer Care Package. Please share the initials of all your children in birth order, including those in heaven. If your child was not named or if you're experiencing infertility, we will place special Heart beads on your bracelet.",
      "labelSomeone": "Children for Bracelet: We would like to include a personalized bracelet in your recipient's Prayer Care Package. Please share the initials of all your recipient's children in birth order, including those in heaven. If your recipient's child was not named or if they are experiencing infertility, we will place special Heart beads on their bracelet.",
      "buttonLabel": "+ Add Another Child",
      "buttonLabelSomeone": "+ Add New"
    },

    {
      "id": "requester-heading", "key": "", "type": "heading", "label": "About You (the person referring this family)",
      "visible": true, "width": "full", "showWhen": [ { "branch": "someone" } ]
    },
    { "id": "req-first", "key": "requesterFirst", "type": "text", "label": "Your First Name", "required": true, "visible": true, "width": "half", "standard": true, "showWhen": [ { "branch": "someone" } ] },
    { "id": "req-last", "key": "requesterLast", "type": "text", "label": "Your Last Name", "required": true, "visible": true, "width": "half", "standard": true, "showWhen": [ { "branch": "someone" } ] },
    { "id": "req-email", "key": "requesterEmail", "type": "email", "label": "Your Email", "required": true, "visible": true, "width": "half", "standard": true, "showWhen": [ { "branch": "someone" } ] },
    { "id": "req-phone", "key": "requesterPhone", "type": "tel", "label": "Your Phone", "visible": true, "width": "half", "standard": true, "showWhen": [ { "branch": "someone" } ] },

    { "id": "optin-heading", "key": "", "type": "heading", "label": "Opt-in Communications", "visible": true, "width": "full" },
    {
      "id": "optin-newsletter", "key": "optinNewsletter", "type": "checkbox", "optinLabel": "Newsletter",
      "label": "Join Our Newsletter - monthly updates and event links", "visible": true, "width": "full", "standard": true
    },
    {
      "id": "optin-prayer-night", "key": "optinPrayerNight", "type": "checkbox", "optinLabel": "Prayer Night Invites",
      "label": "Send me Prayer Night Invites - our monthly Prayer Night Zoom", "visible": true, "width": "full", "standard": true
    }
  ]
