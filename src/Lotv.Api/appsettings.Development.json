{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}",
          "restrictedToMinimumLevel": "Debug"
        }
      }
    ]
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "dev-secret-key-change-before-production-32chars",
    "Issuer": "lotv-api",
    "Audience": "lotv-web"
  },
  "GiveButter": {
    "ApiKey": "",
    "WebhookSecret": ""
  },
  "Duda": {
    "VerifySignature": false,
    "WebhookSecret": ""
  },
  "SendGrid": {
    "ApiKey": ""
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "FromNumber": ""
  },
  "Notifications": {
    "IntakeTeamEmails": "info@lotvministry.org"
  },
  "AllowedOrigins": [
    "http://localhost:5101",
    "https://localhost:7101"
  ]
}
