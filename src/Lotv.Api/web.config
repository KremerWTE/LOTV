<?xml version="1.0" encoding="utf-8"?>
<!--
  The SDK merges the ASP.NET Core module handler and <aspNetCore> settings into this file at publish
  (the deploy workflow then adds ASPNETCORE_ENVIRONMENT). What lives here by hand:

  IIS's WebDAV module answers PUT and DELETE itself ("405 Method Not Allowed", Allow: GET, HEAD, OPTIONS, TRACE)
  before the request reaches the app, so every PUT/DELETE endpoint (assign, unassign, status, priority, due date,
  remove QA sample data, ...) fails on the server while POST and PATCH work. Removing the module and its handler
  for this site lets those verbs through. Removing something that isn't installed is harmless.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
      </handlers>
    </system.webServer>
  </location>
</configuration>
